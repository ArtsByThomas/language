Metoda JeCisteKonstantniVyraz(vyraz : AST_Node) {
    Pokud (vyraz == 0) { Vrat 1 }
    Pokud (vyraz->op == 34) { Vrat 1 } // TOKEN_NUMBER
    Pokud (vyraz->op == 35) { Vrat 0 } // Promenne uvnitr cyklu se mohou menit
    Pokud (vyraz->type == 20) { Vrat 0 } // Volani funkce neni konstanta
    
    Lokalni levy_ok = Volej JeCisteKonstantniVyraz(vyraz->left)
    Lokalni pravy_ok = Volej JeCisteKonstantniVyraz(vyraz->right)
    Pokud (levy_ok == 1 && pravy_ok == 1) { Vrat 1 }
    Vrat 0
}

Metoda OptimalizujLICM(blok : AST_Node) {
    Pokud (blok == 0) { Vrat 0 }
    
    Pokud (blok->type == 1) { // AST_BLOCK
        Lokalni i = 0
        Dokud (i < blok->stmt_count) {
            Lokalni adr = blok->stmts + (i * 8)
            Lokalni prikaz : AST_Node = Volej CtiUkazatel(adr)
            
            Pokud (prikaz != 0) {
                Pokud (prikaz->type == 7 || prikaz->type == 8) { // WHILE (7) nebo FOR (8)
                    Lokalni telo_cyklu : AST_Node = 0
                    Pokud (prikaz->type == 7) { telo_cyklu = prikaz->right }
                    Pokud (prikaz->type == 8) { telo_cyklu = Volej CtiUkazatel(prikaz->stmts) }
                    
                    Pokud (telo_cyklu != 0 && telo_cyklu->type == 1) {
                        Lokalni c = 0
                        Dokud (c < telo_cyklu->stmt_count) {
                            Lokalni t_adr = telo_cyklu->stmts + (c * 8)
                            Lokalni t_prikaz : AST_Node = Volej CtiUkazatel(t_adr)
                            
                            // Pokud je to prirazeni ciste konstantni matematiky
                            Pokud (t_prikaz != 0 && t_prikaz->type == 4) { 
                                Pokud (Volej JeCisteKonstantniVyraz(t_prikaz->right) == 1) {
                                    Volej printf(">> LICM Magie (-O3): Vytahuji nemmenny vypocet '%s' pred cyklus!\n", t_prikaz->name)
                                    
                                    // Trik: Cyklus obalime novym blokem [Vytazeny_Prikaz, Samotny_Cyklus]
                                    Lokalni novy_blok : AST_Node = Volej VytvorUzel(1, prikaz->line)
                                    novy_blok->stmt_count = 2
                                    novy_blok->stmts = Volej calloc(2, 8)
                                    
                                    Lokalni vytazeny = Volej KopirujUzel(t_prikaz)
                                    Volej ZapisUkazatel(novy_blok->stmts + 0, vytazeny)
                                    Volej ZapisUkazatel(novy_blok->stmts + 8, prikaz) 
                                    
                                    Volej ZapisUkazatel(adr, novy_blok)
                                    prikaz = novy_blok 
                                    
                                    t_prikaz->type = 100 // V cyklu smazeme (AST_NOP)
                                }
                            }
                            c = c + 1
                        }
                    }
                }
                Volej OptimalizujLICM(prikaz)
            }
            i = i + 1
        }
    }
    
    Pokud (blok->type == 6) { Volej OptimalizujLICM(blok->right); Pokud (blok->alt != 0) { Volej OptimalizujLICM(blok->alt) } }
    Pokud (blok->type == 7 || blok->type == 8) { 
        Pokud (blok->right != 0) { Volej OptimalizujLICM(blok->right) }
        Pokud (blok->type == 8 && blok->stmts != 0) { Volej OptimalizujLICM(Volej CtiUkazatel(blok->stmts)) }
    }
    Pokud (blok->type == 10) { Volej OptimalizujLICM(blok->right) }
    Vrat 0
}
Metoda OptimalizujDCE(koren : AST_Node) {
    Pokud (koren == 0) { Vrat 0 }
    
    Pokud (koren->type == 1 || koren->type == 0) { // AST_BLOCK, AST_PROGRAM
        Lokalni i = 0
        Lokalni mrtvo = 0
        Dokud (i < koren->stmt_count) {
            Pokud (mrtvo == 1) {
                // Odrizneme zbytek pole prikazu
                koren->stmt_count = i
                Volej printf(">> DCE Magie (-O3): Odstranen mrtvy kod za Ukonci/Vrat!\n")
                Vrat 0
            }
            Lokalni adr = koren->stmts + (i * 8)
            Lokalni prikaz : AST_Node = Volej CtiUkazatel(adr)
            Pokud (prikaz != 0) {
                // 11 = AST_RETURN, 22 = AST_BREAK, 23 = AST_CONTINUE
                Pokud (prikaz->type == 11 || prikaz->type == 22 || prikaz->type == 23) {
                    mrtvo = 1
                } Jinak {
                    Volej OptimalizujDCE(prikaz)
                }
            }
            i = i + 1
        }
    }
    
    Pokud (koren->type == 6) { Volej OptimalizujDCE(koren->right); Pokud (koren->alt != 0) { Volej OptimalizujDCE(koren->alt) } }
    Pokud (koren->type == 7 || koren->type == 8) { 
        Pokud (koren->stmts != 0) { Volej OptimalizujDCE(Volej CtiUkazatel(koren->stmts)) }
        Pokud (koren->right != 0) { Volej OptimalizujDCE(koren->right) }
    }
    Pokud (koren->type == 10) { Volej OptimalizujDCE(koren->right) }
    
    Vrat 0
}
Metoda OptimalizujBezpecnyInlining(koren : AST_Node) {
    Pokud (koren == 0) { Vrat 0 }

    Pokud (koren->type == 0 || koren->type == 1) { // 0 = AST_PROGRAM, 1 = AST_BLOCK
        Lokalni i = 0
        Dokud (i < koren->stmt_count) {
            Lokalni adr = koren->stmts + (i * 8)
            Lokalni prikaz : AST_Node = Volej CtiUkazatel(adr)
            
            Pokud (prikaz != 0) {
                Pokud (prikaz->type == 20) { // 20 = AST_CALL
                    Lokalni sym : Symbol = Volej NajdiSymbol(prikaz->name)
                    Pokud (sym != 0 && sym->is_function == 1) {
                        Lokalni func_ast : AST_Node = sym->func_node
                        // POJISTKA: Bez argumentu A ZAROVEN bez lokalnich promennych
                        Pokud (func_ast->arg_count == 0 && func_ast->int_val == 0) {
                            Volej printf(">> Safe Inlining (-O3): Vkladam telo metody '%s'!\n", prikaz->name)
                            Lokalni klonovane_telo = Volej KopirujUzel(func_ast->right)
                            Volej ZapisUkazatel(adr, klonovane_telo)
                        }
                    }
                } Jinak {
                    Volej OptimalizujBezpecnyInlining(prikaz)
                }
            }
            i = i + 1
        }
    }
    
    Pokud (koren->type == 6) { Volej OptimalizujBezpecnyInlining(koren->right); Pokud (koren->alt != 0) { Volej OptimalizujBezpecnyInlining(koren->alt) } }
    Pokud (koren->type == 7 || koren->type == 8) { 
        Pokud (koren->stmts != 0) { Volej OptimalizujBezpecnyInlining(Volej CtiUkazatel(koren->stmts)) }
        Pokud (koren->right != 0) { Volej OptimalizujBezpecnyInlining(koren->right) }
    }
    Pokud (koren->type == 10) { Volej OptimalizujBezpecnyInlining(koren->right) }
    
    Vrat 0
}
Metoda OptimalizujCSE(blok : AST_Node) {
    Pokud (blok == 0) { Vrat 0 }
    Pokud (blok->type == 1) { // 1 = AST_BLOCK
        Lokalni i = 0
        Dokud (i < (blok->stmt_count - 1)) {
            Lokalni prikaz1 : AST_Node = Volej CtiUkazatel(blok->stmts + (i * 8))
            Lokalni prikaz2 : AST_Node = Volej CtiUkazatel(blok->stmts + ((i + 1) * 8))
            
            // Pokud jsou to obe prirazeni
            Pokud (prikaz1 != 0 && prikaz2 != 0 && prikaz1->type == 4 && prikaz2->type == 4) { // 4 = AST_ASSIGN
                Lokalni vyraz1 : AST_Node = prikaz1->right
                Lokalni vyraz2 : AST_Node = prikaz2->right
                
                // Pokud jsou to obe binarmi operace stejneho typu (napr. TOKEN_MUL)
                Pokud (vyraz1 != 0 && vyraz2 != 0 && vyraz1->op == vyraz2->op && vyraz1->left != 0 && vyraz1->right != 0) {
                    Lokalni l1 : AST_Node = vyraz1->left; Lokalni r1 : AST_Node = vyraz1->right
                    Lokalni l2 : AST_Node = vyraz2->left; Lokalni r2 : AST_Node = vyraz2->right
                    
                    // Pokud jsou operandy identicke promenne/konstanty
                    Pokud (l1->op == l2->op && r1->op == r2->op && Volej strcmp(l1->name, l2->name) == 0 && Volej strcmp(r1->name, r2->name) == 0) {
                        
                        Volej printf(">> CSE Magie (-O3): Nalezen shodny vypocet, pouzivam predchozi vysledek '%s'!\n", prikaz1->name)
                        
                        // Zmenime druhy vyraz jen na nacteni proměnné z prvniho prikazu
                        vyraz2->op = 35 // TOKEN_IDENTIFIER
                        Volej strncpy(vyraz2->name, prikaz1->name, 255)
                        vyraz2->left = 0
                        vyraz2->right = 0
                    }
                }
            }
            Volej OptimalizujCSE(prikaz1)
            i = i + 1
        }
    }
    
    // Prohledame vnoreni
    Pokud (blok->type == 10) { Volej OptimalizujCSE(blok->right) } // AST_METHOD
    Pokud (blok->type == 7 || blok->type == 6) { Volej OptimalizujCSE(blok->right); Pokud (blok->alt != 0) { Volej OptimalizujCSE(blok->alt) } }
    Vrat 0
}
Metoda OptimalizujInlining(koren : AST_Node) {
    Pokud (koren == 0) { Vrat 0 }

    // Prochazime program nebo blok
    Pokud (koren->type == 0 || koren->type == 1) { // 0 = AST_PROGRAM, 1 = AST_BLOCK
        Lokalni i = 0
        Dokud (i < koren->stmt_count) {
            Lokalni adr = koren->stmts + (i * 8)
            Lokalni prikaz : AST_Node = Volej CtiUkazatel(adr)
            
            Pokud (prikaz != 0) {
                Pokud (prikaz->type == 20) { // 20 = AST_CALL
                    Lokalni sym : Symbol = Volej NajdiSymbol(prikaz->name)
                    // Inlinujeme jen metody, ktere nemaji argumenty (vyhneme se kolizi jmen promennych)
                    Pokud (sym != 0 && sym->is_function == 1) {
                        Lokalni func_ast : AST_Node = sym->func_node
                        Pokud (func_ast->arg_count == 0) {
                            Volej printf(">> Inlining Magie (-O3): Vkladam telo metody '%s' primo do kodu!\n", prikaz->name)
                            Lokalni klonovane_telo = Volej KopirujUzel(func_ast->right) // Pravy uzel metody je vzdy AST_BLOCK
                            Volej ZapisUkazatel(adr, klonovane_telo)
                        }
                    }
                } Jinak {
                    // Rekurze do hloubky
                    Volej OptimalizujInlining(prikaz)
                }
            }
            i = i + 1
        }
    }
    
    // Prochazime vnorene struktury
    Pokud (koren->type == 6) { // AST_IF
        Volej OptimalizujInlining(koren->right)
        Pokud (koren->alt != 0) { Volej OptimalizujInlining(koren->alt) }
    }
    Pokud (koren->type == 7 || koren->type == 8) { // AST_WHILE, AST_FOR
        Volej OptimalizujInlining(koren->right)
        Volej OptimalizujInlining(koren->stmts)
    }
    Pokud (koren->type == 10) { // AST_METHOD
        Volej OptimalizujInlining(koren->right)
    }
    
    Vrat 0
}
Metoda KopirujUzel(uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    
    Lokalni kopie : AST_Node = Volej VytvorUzel(uzel->type, uzel->line)
    kopie->op = uzel->op
    kopie->int_val = uzel->int_val
    Volej strncpy(kopie->name, uzel->name, 255)
    Volej strncpy(kopie->sub_name, uzel->sub_name, 63)
    Volej strncpy(kopie->type_name, uzel->type_name, 63)

    kopie->left = Volej KopirujUzel(uzel->left)
    kopie->right = Volej KopirujUzel(uzel->right)
    kopie->alt = Volej KopirujUzel(uzel->alt)

    Pokud (uzel->stmt_count > 0) {
        kopie->stmts = Volej calloc(uzel->stmt_count, 8)
        kopie->stmt_count = uzel->stmt_count
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Lokalni adr = uzel->stmts + (i * 8)
            Lokalni pod_uzel : AST_Node = Volej CtiUkazatel(adr)
            Lokalni p_kopie = Volej KopirujUzel(pod_uzel)
            Volej ZapisUkazatel(kopie->stmts + (i * 8), p_kopie)
            i = i + 1
        }
    }
    Vrat kopie
}
Metoda OptimalizujSCEV(uzel_cyklu : AST_Node) {
    Pokud (uzel_cyklu->type != 7) { Vrat 0 } // 7 = AST_WHILE
    
    // 1. Zjisteni podminky: promenna < MAX
    Lokalni podminka : AST_Node = uzel_cyklu->left
    Pokud (podminka == 0 || podminka->op != 45) { Vrat 0 } // 45 = TOKEN_LESS
    
    Lokalni iter_uzel : AST_Node = podminka->left
    Lokalni max_uzel : AST_Node = podminka->right
    Pokud (iter_uzel == 0 || max_uzel == 0) { Vrat 0 }
    Pokud (iter_uzel->op != 35) { Vrat 0 } // 35 = TOKEN_IDENTIFIER
    
    Lokalni iter_jmeno = iter_uzel->name
    
    // 2. Kontrola tela cyklu (musi to byt blok s 1 nebo 2 prikazy)
    Lokalni telo : AST_Node = uzel_cyklu->right
    Pokud (telo == 0 || telo->type != 1) { Vrat 0 } // OPRAVA: AST_BLOCK je 1 (bylo 10)
    Pokud (telo->stmt_count == 0 || telo->stmt_count > 2) { Vrat 0 }
    
    // 3. Posledni prikaz musi byt zvysovani iteratoru: i = i + 1
    Lokalni posl_adr = telo->stmts + ((telo->stmt_count - 1) * 8)
    Lokalni posl_prikaz : AST_Node = Volej CtiUkazatel(posl_adr)
    
    Pokud (posl_prikaz->type != 4) { Vrat 0 } // 4 = AST_ASSIGN
    Pokud (Volej strcmp(posl_prikaz->name, iter_jmeno) != 0) { Vrat 0 }
    
    Lokalni inkrement : AST_Node = posl_prikaz->right
    Pokud (inkrement == 0 || inkrement->op != 67) { Vrat 0 } // OPRAVA: TOKEN_PLUS je 67 (bylo 43)
    Lokalni ink_l : AST_Node = inkrement->left
    Lokalni ink_p : AST_Node = inkrement->right
    Pokud (ink_l == 0 || ink_p == 0) { Vrat 0 }
    Pokud (ink_l->op != 35 || Volej strcmp(ink_l->name, iter_jmeno) != 0) { Vrat 0 }
    Pokud (ink_p->op != 34) { Vrat 0 } // 34 = TOKEN_NUMBER
    Pokud (Volej atoi(ink_p->name) != 1) { Vrat 0 } // Zatim resime jen krok +1
    
    // ========================================================
    // MAGIE A: Prazdny cyklus
    // ========================================================
    Pokud (telo->stmt_count == 1) {
        Volej printf(">> SCEV Magie (-O3): Prazdny cyklus '%s' preveden na O(1) cas!\n", iter_jmeno)
        uzel_cyklu->type = 4 
        Volej strncpy(uzel_cyklu->name, iter_jmeno, 255)
        
        Lokalni novy_max : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line) 
        novy_max->op = max_uzel->op
        Volej strncpy(novy_max->name, max_uzel->name, 255)
        
        uzel_cyklu->right = novy_max
        uzel_cyklu->left = 0
        Vrat 1
    }
    
    // ========================================================
    // MAGIE B: Cyklus sbirajici soucet (suma = suma + X)
    // ========================================================
    Pokud (telo->stmt_count == 2) {
        Lokalni prvni_adr = telo->stmts + 0
        Lokalni prvni_prikaz : AST_Node = Volej CtiUkazatel(prvni_adr)
        
        Pokud (prvni_prikaz->type == 4) { 
            Lokalni suma_jmeno = prvni_prikaz->name
            Lokalni s_vyraz : AST_Node = prvni_prikaz->right
            Pokud (s_vyraz != 0 && s_vyraz->op == 67) { // OPRAVA: TOKEN_PLUS je 67 (bylo 43)
                Lokalni s_levy : AST_Node = s_vyraz->left
                Lokalni s_pravy : AST_Node = s_vyraz->right
                
                Pokud (s_levy != 0 && s_pravy != 0 && s_levy->op == 35 && Volej strcmp(s_levy->name, suma_jmeno) == 0 && s_pravy->op == 34) {
                    
                    Volej printf(">> SCEV Magie (-O3): Soucet v cyklu '%s' preveden na O(1) matematiku!\n", iter_jmeno)
                    
                    uzel_cyklu->type = 1 // OPRAVA: AST_BLOCK je 1 (bylo 10)
                    uzel_cyklu->stmts = Volej calloc(2, 8)
                    uzel_cyklu->stmt_count = 2
                    
                    Lokalni a_suma : AST_Node = Volej VytvorUzel(4, uzel_cyklu->line)
                    Volej strncpy(a_suma->name, suma_jmeno, 255)
                    
                    Lokalni st_plus : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line); st_plus->op = 67 // OPRAVA: TOKEN_PLUS = 67
                    Lokalni st_suma_id : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line); st_suma_id->op = 35
                    Volej strncpy(st_suma_id->name, suma_jmeno, 255)
                    Lokalni st_mul : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line); st_mul->op = 49 // Nasobeni
                    Lokalni st_sub : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line); st_sub->op = 44 // Odcitani
                    
                    Lokalni k_max : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line); k_max->op = max_uzel->op
                    Volej strncpy(k_max->name, max_uzel->name, 255)
                    Lokalni k_iter : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line); k_iter->op = 35
                    Volej strncpy(k_iter->name, iter_jmeno, 255)
                    
                    st_sub->left = k_max; st_sub->right = k_iter 
                    
                    Lokalni k_X : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line); k_X->op = s_pravy->op
                    Volej strncpy(k_X->name, s_pravy->name, 255) 
                    
                    st_mul->left = st_sub; st_mul->right = k_X 
                    st_plus->left = st_suma_id; st_plus->right = st_mul 
                    
                    a_suma->right = st_plus
                    
                    Lokalni a_iter : AST_Node = Volej VytvorUzel(4, uzel_cyklu->line)
                    Volej strncpy(a_iter->name, iter_jmeno, 255)
                    Lokalni k_max2 : AST_Node = Volej VytvorUzel(5, uzel_cyklu->line); k_max2->op = max_uzel->op
                    Volej strncpy(k_max2->name, max_uzel->name, 255)
                    a_iter->right = k_max2
                    
                    Volej ZapisUkazatel(uzel_cyklu->stmts + 0, a_suma)
                    Volej ZapisUkazatel(uzel_cyklu->stmts + 8, a_iter)
                    
                    uzel_cyklu->left = 0
                    uzel_cyklu->right = 0
                    Vrat 1
                }
            }
        }
    }
    Vrat 0
}
Metoda OptimalizujRozbaleniOpakuj(uzel_for : AST_Node) {
    Pokud (uzel_for->type != 8) { Vrat 0 } // 8 = AST_FOR

    Lokalni init_uzel : AST_Node = uzel_for->left
    Lokalni cond_uzel : AST_Node = uzel_for->right
    Lokalni inc_uzel : AST_Node = uzel_for->alt

    // 1. Zjisteni startu (napr. i = 0)
    Pokud (init_uzel == 0 || init_uzel->type != 4) { Vrat 0 } // 4 = AST_ASSIGN
    Lokalni start_vyraz : AST_Node = init_uzel->right
    Pokud (start_vyraz == 0 || start_vyraz->op != 34) { Vrat 0 } // 34 = TOKEN_NUMBER
    Lokalni iter_jmeno = init_uzel->name
    Lokalni start_val = Volej atoi(start_vyraz->name)

    // 2. Zjisteni konce (napr. i < 5)
    Pokud (cond_uzel == 0 || cond_uzel->op != 45) { Vrat 0 } // 45 = TOKEN_LESS
    Lokalni cond_l : AST_Node = cond_uzel->left
    Lokalni cond_p : AST_Node = cond_uzel->right
    Pokud (cond_l == 0 || cond_p == 0) { Vrat 0 }
    Pokud (cond_l->op != 35 || Volej strcmp(cond_l->name, iter_jmeno) != 0) { Vrat 0 } 
    Pokud (cond_p->op != 34) { Vrat 0 }
    Lokalni end_val = Volej atoi(cond_p->name)

    // 3. Zjisteni kroku (napr. i += 1)
    Pokud (inc_uzel == 0 || inc_uzel->type != 4) { Vrat 0 }
    Pokud (Volej strcmp(inc_uzel->name, iter_jmeno) != 0) { Vrat 0 }
    Lokalni inc_vyraz : AST_Node = inc_uzel->right
    Pokud (inc_vyraz == 0 || inc_vyraz->op != 67) { Vrat 0 } // 67 = TOKEN_PLUS
    Lokalni inc_p : AST_Node = inc_vyraz->right
    Pokud (inc_p == 0 || inc_p->op != 34) { Vrat 0 }
    Lokalni krok_val = Volej atoi(inc_p->name)

    Pokud (krok_val != 1) { Vrat 0 } // Resime jen krok +1

    Lokalni pocet_iteraci = end_val - start_val
    
    // Pokud je iteraci rozumna hrstka (1 az 10), cyklus rozbalime!
    Pokud (pocet_iteraci > 0 && pocet_iteraci <= 10) {
        Volej printf(">> Unrolling Magie (-O3): Opakuj cyklus '%s' se %d iteracemi rozbalen!\n", iter_jmeno, pocet_iteraci)

        Lokalni telo : AST_Node = Volej CtiUkazatel(uzel_for->stmts)
        Lokalni prikazu_v_tele = 1
        Pokud (telo->type == 1) { prikazu_v_tele = telo->stmt_count } // 1 = AST_BLOCK

        // Pretvoreni FOR cyklu na obycenjy AST_BLOCK
        uzel_for->type = 1 
        Lokalni celkem_prikazu = 1 + (pocet_iteraci * (prikazu_v_tele + 1))
        Lokalni nove_stmts = Volej calloc(celkem_prikazu, 8)
        Lokalni idx = 0

        // A. Prikaz na inicializaci (i = 0)
        Volej ZapisUkazatel(nove_stmts + (idx * 8), init_uzel)
        idx = idx + 1

        // B. N-krat za sebou zkopirujeme telo a inkrementaci
        Lokalni iter = 0
        Dokud (iter < pocet_iteraci) {
            Pokud (telo->type == 1) {
                Lokalni p = 0
                Dokud (p < prikazu_v_tele) {
                    Lokalni orig_prikaz : AST_Node = Volej CtiUkazatel(telo->stmts + (p * 8))
                    Lokalni kopie_prikazu = Volej KopirujUzel(orig_prikaz)
                    Volej ZapisUkazatel(nove_stmts + (idx * 8), kopie_prikazu)
                    idx = idx + 1
                    p = p + 1
                }
            } Jinak {
                Lokalni kopie_prikazu2 = Volej KopirujUzel(telo)
                Volej ZapisUkazatel(nove_stmts + (idx * 8), kopie_prikazu2)
                idx = idx + 1
            }

            Lokalni kopie_incu = Volej KopirujUzel(inc_uzel)
            Volej ZapisUkazatel(nove_stmts + (idx * 8), kopie_incu)
            idx = idx + 1
            iter = iter + 1
        }

        // C. Odstraneni pod-vetvi, uzel je nyni jen cisty blok!
        uzel_for->stmts = nove_stmts
        uzel_for->stmt_count = idx
        uzel_for->left = 0
        uzel_for->right = 0
        uzel_for->alt = 0

        Vrat 1
    }
    Vrat 0
}
Metoda ZkontrolujKapacituSymbolu() {
    Pokud (pocet_symbolu >= (kapacita_symbolu - 10)) {
        kapacita_symbolu = kapacita_symbolu * 2
        pamet_symbolu = Volej realloc(pamet_symbolu, kapacita_symbolu * Velikost(Symbol))
    }
    Vrat 0
}
Metoda ZkontrolujKapacituIR() {
    Pokud (pocet_ir >= (kapacita_ir - 10)) {
        kapacita_ir = kapacita_ir * 2
        pamet_ir = Volej realloc(pamet_ir, kapacita_ir * Velikost(IR_Instrukce))
    }
    Vrat 0
}

Metoda NovyTempRegistr() {
    Lokalni t = citac_temp_reg
    citac_temp_reg = citac_temp_reg + 1
    
    // Automaticka evidence pro Linear Scan Register Allocation
    Pokud (pocet_intervalu >= (kapacita_intervalu - 10)) {
        kapacita_intervalu = kapacita_intervalu * 2
        pamet_intervalu = Volej realloc(pamet_intervalu, kapacita_intervalu * Velikost(LiveInterval))
    }
    Lokalni interval : LiveInterval = pamet_intervalu + (pocet_intervalu * Velikost(LiveInterval))
    interval->var_id = t
    interval->start_instr = pocet_ir  // Oziva prave ted
    interval->end_instr = pocet_ir    // Zatim konci tady
    interval->fyzicky_reg = 0 - 1     // Zatim v RAM
    pocet_intervalu = pocet_intervalu + 1
    
    Vrat t
}

Metoda EmitujIR(op, dest, s1, t1, s2, t2) {
    Volej ZkontrolujKapacituIR()
    Lokalni inst : IR_Instrukce = pamet_ir + (pocet_ir * Velikost(IR_Instrukce))
    inst->opcode = op
    inst->dest = dest
    inst->src1 = s1
    inst->src1_typ = t1
    inst->src2 = s2
    inst->src2_typ = t2
    
    // Prodlouzeni zivota (Liveness) pouzitych registru
    Lokalni i = 0
    Dokud (i < pocet_intervalu) {
        Lokalni interval : LiveInterval = pamet_intervalu + (i * Velikost(LiveInterval))
        Pokud (t1 == 0 && interval->var_id == s1) { interval->end_instr = pocet_ir }
        Pokud (t2 == 0 && interval->var_id == s2) { interval->end_instr = pocet_ir }
        i = i + 1
    }
    
    pocet_ir = pocet_ir + 1
    Vrat dest
}
Metoda GenerujIR_Vyraz(uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }

    // --- BEZPECNOSTNI POJISTKA PRO FPU A STRINGY ---
    // Pokud je to Float nebo String, IR to vzda a necha preklad na velkem AST!
    Lokalni typ_uzlu = Volej ZiskejTypUzlu(uzel)
    Pokud (Volej strcmp(typ_uzlu, "Float") == 0) { Vrat 0 }
    Pokud (Volej strcmp(typ_uzlu, "String") == 0) { Vrat 0 }

    Pokud (uzel->op == 34) {
        Lokalni t = Volej NovyTempRegistr()
        Lokalni hodnota = Volej atoi(uzel->name)
        Volej EmitujIR(1, t, hodnota, 1, 0, 0)
        Vrat t
    }

    Pokud (uzel->op == 35) {
        Lokalni sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym->is_global || sym->is_const) { Vrat 0 } 
        
        Lokalni t2 = Volej NovyTempRegistr()
        Volej EmitujIR(2, t2, sym->offset, 2, 0, 0)
        Vrat t2
    }

    Pokud (uzel->op == 67 || uzel->op == 44 || uzel->op == 49 || uzel->op == 50 || uzel->op == 43 || uzel->op == 64 || uzel->op == 45 || uzel->op == 46 || uzel->op == 61 || uzel->op == 62 || uzel->op == 58 || uzel->op == 124 || uzel->op == 83 || uzel->op == 84 || uzel->op == 85) {
        
        Lokalni l_reg = Volej GenerujIR_Vyraz(uzel->left)
        Pokud (l_reg == 0) { Vrat 0 }
        
        Lokalni pravy_uzel : AST_Node = uzel->right
        Pokud (pravy_uzel != 0) {
            Pokud (pravy_uzel->op == 34) {
                Lokalni val = Volej atoi(pravy_uzel->name)
                Pokud (uzel->op == 49) {
                    Pokud (val == 2) { uzel->op = 84; Volej sprintf(pravy_uzel->name, "1") }
                    Jinak Pokud (val == 4) { uzel->op = 84; Volej sprintf(pravy_uzel->name, "2") }
                    Jinak Pokud (val == 8) { uzel->op = 84; Volej sprintf(pravy_uzel->name, "3") }
                    Jinak Pokud (val == 16) { uzel->op = 84; Volej sprintf(pravy_uzel->name, "4") }
                } Jinak Pokud (uzel->op == 50) {
                    Pokud (val == 2) { uzel->op = 85; Volej sprintf(pravy_uzel->name, "1") }
                    Jinak Pokud (val == 4) { uzel->op = 85; Volej sprintf(pravy_uzel->name, "2") }
                    Jinak Pokud (val == 8) { uzel->op = 85; Volej sprintf(pravy_uzel->name, "3") }
                    Jinak Pokud (val == 16) { uzel->op = 85; Volej sprintf(pravy_uzel->name, "4") }
                }
            }
        }
        
        Lokalni r_reg = 0
        Lokalni r_typ = 0
        Lokalni je_konstanta = 0
        
        Pokud (pravy_uzel != 0) {
            Pokud (pravy_uzel->op == 34) {
                je_konstanta = 1
            }
        }
        
        Pokud (je_konstanta == 1) {
            r_reg = Volej atoi(pravy_uzel->name)
            r_typ = 1 
        } Jinak {
            r_reg = Volej GenerujIR_Vyraz(uzel->right)
            Pokud (r_reg == 0) { Vrat 0 }
        }
        
        Lokalni vysledek_reg = Volej NovyTempRegistr()
        Lokalni opcode = 0
        
        Pokud (uzel->op == 67) { opcode = 4 }
        Pokud (uzel->op == 44) { opcode = 5 }
        Pokud (uzel->op == 49) { opcode = 6 }
        Pokud (uzel->op == 50) { opcode = 7 }
        Pokud (uzel->op == 43) { opcode = 12 }
        Pokud (uzel->op == 64) { opcode = 13 }
        Pokud (uzel->op == 45) { opcode = 14 }
        Pokud (uzel->op == 46) { opcode = 15 }
        Pokud (uzel->op == 61) { opcode = 16 }
        Pokud (uzel->op == 62) { opcode = 17 }
        Pokud (uzel->op == 58) { opcode = 18 }
        Pokud (uzel->op == 124) { opcode = 19 }
        Pokud (uzel->op == 83) { opcode = 20 }
        Pokud (uzel->op == 84) { opcode = 21 }
        Pokud (uzel->op == 85) { opcode = 22 }
        
        Volej EmitujIR(opcode, vysledek_reg, l_reg, 0, r_reg, r_typ)
        Vrat vysledek_reg
    }

    Pokud (uzel->type == 20) { 
        Pokud (uzel->stmt_count <= 4) { 
            Lokalni arg_regs = Volej malloc(uzel->stmt_count * 8)
            Lokalni i = 0
            Lokalni fallback = 0
            
            Dokud (i < uzel->stmt_count) {
                Lokalni addr_call = uzel->stmts + (i * 8)
                Lokalni arg_node : AST_Node = Volej CtiUkazatel(addr_call)
                Lokalni reg = Volej GenerujIR_Vyraz(arg_node)
                Pokud (reg == 0) { fallback = 1 }
                Volej ZapisUkazatel(arg_regs + (i * 8), reg)
                i = i + 1
            }
            
            Pokud (fallback == 0) {
                i = 0
                Dokud (i < uzel->stmt_count) {
                    Lokalni reg2 = Volej CtiUkazatel(arg_regs + (i * 8))
                    Volej EmitujIR(23, i, reg2, 0, 0, 0) 
                    i = i + 1
                }
                
                Lokalni vysledek_reg = Volej NovyTempRegistr()
                Volej EmitujIR(24, vysledek_reg, uzel->name, 0, uzel->stmt_count, 0) 
                
                Volej free(arg_regs)
                Vrat vysledek_reg
            }
            Volej free(arg_regs)
        }
    }
    Vrat 0
}
Metoda PrelozIRDoASM(out, vysledek_reg) {
    Volej fputs("    ; --- START ZRYCHLENEHO IR BLOKU ---\n", out)
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * Velikost(IR_Instrukce))
        Pokud (inst->opcode == 0) { i = i + 1; Pokracuj } 
        
        Lokalni dest_int : LiveInterval = pamet_intervalu + ((inst->dest - 1) * Velikost(LiveInterval))
        Lokalni d_str = "r12"
        Pokud (dest_int->fyzicky_reg == 13) { d_str = "r13" }
        Pokud (dest_int->fyzicky_reg == 14) { d_str = "r14" }
        Pokud (dest_int->fyzicky_reg == 15) { d_str = "r15" }
        
        Pokud (inst->opcode == IR_OP_LOAD_CONST) {
            Volej fprintf(out, "    mov %s, %d\n", d_str, inst->src1)
        }
        Pokud (inst->opcode == IR_OP_LOAD_VAR) {
            Pokud (inst->src1 < 0) {
                Lokalni kladny = 0 - inst->src1
                Volej fprintf(out, "    mov %s, qword [rbp + %d]\n", d_str, kladny)
            } Jinak {
                Volej fprintf(out, "    mov %s, qword [rbp - %d]\n", d_str, inst->src1)
            }
        }
        
        // Vsechny matematicke a logicke instrukce
        Pokud (inst->opcode >= IR_OP_ADD && inst->opcode <= IR_OP_BIT_SHR) {
            Lokalni s1_int : LiveInterval = pamet_intervalu + ((inst->src1 - 1) * Velikost(LiveInterval))
            Lokalni s1_str = "r12"
            Pokud (s1_int->fyzicky_reg == 13) { s1_str = "r13" }
            Pokud (s1_int->fyzicky_reg == 14) { s1_str = "r14" }
            Pokud (s1_int->fyzicky_reg == 15) { s1_str = "r15" }
            
            // Trik pro konstanty: pokud je to konstanta, dame ji do volneho r11
            Lokalni s2_str = "r11"
            Pokud (inst->src2_typ == 1) {
                Volej fprintf(out, "    mov r11, %d\n", inst->src2)
            } Jinak {
                Lokalni s2_int : LiveInterval = pamet_intervalu + ((inst->src2 - 1) * Velikost(LiveInterval))
                Pokud (s2_int->fyzicky_reg == 12) { s2_str = "r12" }
                Pokud (s2_int->fyzicky_reg == 13) { s2_str = "r13" }
                Pokud (s2_int->fyzicky_reg == 14) { s2_str = "r14" }
                Pokud (s2_int->fyzicky_reg == 15) { s2_str = "r15" }
            }
            
            Pokud (inst->opcode == IR_OP_ADD) { Volej fprintf(out, "    lea %s, [%s + %s]\n", d_str, s1_str, s2_str) }
            Pokud (inst->opcode == IR_OP_SUB) { Volej fprintf(out, "    mov %s, %s\n    sub %s, %s\n", d_str, s1_str, d_str, s2_str) }
            Pokud (inst->opcode == IR_OP_MUL) { Volej fprintf(out, "    mov %s, %s\n    imul %s, %s\n", d_str, s1_str, d_str, s2_str) }
            Pokud (inst->opcode == IR_OP_DIV) { 
                Volej fprintf(out, "    mov rax, %s\n    cqo\n    idiv %s\n    mov %s, rax\n", s1_str, s2_str, d_str) 
            }
            
            // Nove: Instrukce pro porovnavani (prekladaji se na CMP a SETcc)
            Pokud (inst->opcode >= IR_OP_CMP_EQ && inst->opcode <= IR_OP_CMP_GE) {
                Volej fprintf(out, "    cmp %s, %s\n", s1_str, s2_str)
                Pokud (inst->opcode == IR_OP_CMP_EQ) { Volej fputs("    sete al\n", out) }
                Pokud (inst->opcode == IR_OP_CMP_NEQ) { Volej fputs("    setne al\n", out) }
                Pokud (inst->opcode == IR_OP_CMP_LT) { Volej fputs("    setl al\n", out) }
                Pokud (inst->opcode == IR_OP_CMP_GT) { Volej fputs("    setg al\n", out) }
                Pokud (inst->opcode == IR_OP_CMP_LE) { Volej fputs("    setle al\n", out) }
                Pokud (inst->opcode == IR_OP_CMP_GE) { Volej fputs("    setge al\n", out) }
                Volej fprintf(out, "    movzx %s, al\n", d_str)
            }
            
            // Nove: Bitove operatory a Posuny
            Pokud (inst->opcode == IR_OP_BIT_AND) { Volej fprintf(out, "    mov %s, %s\n    and %s, %s\n", d_str, s1_str, d_str, s2_str) }
            Pokud (inst->opcode == IR_OP_BIT_OR) { Volej fprintf(out, "    mov %s, %s\n    or %s, %s\n", d_str, s1_str, d_str, s2_str) }
            Pokud (inst->opcode == IR_OP_BIT_XOR) { Volej fprintf(out, "    mov %s, %s\n    xor %s, %s\n", d_str, s1_str, d_str, s2_str) }
            Pokud (inst->opcode == IR_OP_BIT_SHL) { Volej fprintf(out, "    mov %s, %s\n    mov rcx, %s\n    shl %s, cl\n", d_str, s1_str, s2_str, d_str) }
            Pokud (inst->opcode == IR_OP_BIT_SHR) { Volej fprintf(out, "    mov %s, %s\n    mov rcx, %s\n    sar %s, cl\n", d_str, s1_str, s2_str, d_str) }
        }
        // ===============================================
        // NOVE: Predani argumentu pres registry (FastCall)
        // ===============================================
        Pokud (inst->opcode == 23) {
            Lokalni src_int : LiveInterval = pamet_intervalu + ((inst->src1 - 1) * Velikost(LiveInterval))
            Lokalni s_str = "r12"
            Pokud (src_int->fyzicky_reg == 13) { s_str = "r13" }
            Pokud (src_int->fyzicky_reg == 14) { s_str = "r14" }
            Pokud (src_int->fyzicky_reg == 15) { s_str = "r15" }
            
            Pokud (cilova_platforma == CIL_WINDOWS) {
                Pokud (inst->dest == 0) { Volej fprintf(out, "    mov rcx, %s\n", s_str) }
                Pokud (inst->dest == 1) { Volej fprintf(out, "    mov rdx, %s\n", s_str) }
                Pokud (inst->dest == 2) { Volej fprintf(out, "    mov r8, %s\n", s_str) }
                Pokud (inst->dest == 3) { Volej fprintf(out, "    mov r9, %s\n", s_str) }
            } Jinak {
                Pokud (inst->dest == 0) { Volej fprintf(out, "    mov rdi, %s\n", s_str) }
                Pokud (inst->dest == 1) { Volej fprintf(out, "    mov rsi, %s\n", s_str) }
                Pokud (inst->dest == 2) { Volej fprintf(out, "    mov rdx, %s\n", s_str) }
                Pokud (inst->dest == 3) { Volej fprintf(out, "    mov rcx, %s\n", s_str) }
            }
        }
        
        // ===============================================
        // NOVE: Samotne volani funkce bez RAM 
        // ===============================================
        Pokud (inst->opcode == 24) {
            Lokalni nazev_f = inst->src1
            Pokud (cilova_platforma == CIL_APPLE && Volej JeExterniJmeno(nazev_f) == 1) {
                nazev_f = Volej NazevSymbolu(nazev_f)
            }
            Volej fputs("    mov eax, 0\n", out)
            Volej fputs("    sub rsp, 32\n", out)
            Volej fprintf(out, "    call %s\n", nazev_f)
            Volej fputs("    add rsp, 32\n", out)
            Volej fprintf(out, "    mov %s, rax\n", d_str) // Vysledek leti rovnou do naseho registru!
        }
        i = i + 1
    }
    
    Lokalni vys_int : LiveInterval = pamet_intervalu + ((vysledek_reg - 1) * Velikost(LiveInterval))
    Lokalni v_str = "r12"
    Pokud (vys_int->fyzicky_reg == 13) { v_str = "r13" }
    Pokud (vys_int->fyzicky_reg == 14) { v_str = "r14" }
    Pokud (vys_int->fyzicky_reg == 15) { v_str = "r15" }
    Volej fprintf(out, "    mov rax, %s\n", v_str)
    Volej fputs("    ; --- KONEC ZRYCHLENEHO IR BLOKU ---\n", out)
    Vrat 0
}
Metoda ProvedLinearScan() {
    Volej printf("Middle-End: Spoustim Linear Scan Register Allocation...\n")
    
    // Mame 4 volne fyzicke registry pro volne vyuziti (napric architekturami byva r12 az r15 obvykle callee-saved)
    Lokalni fyz_r12_volny_od = 0
    Lokalni fyz_r13_volny_od = 0
    Lokalni fyz_r14_volny_od = 0
    Lokalni fyz_r15_volny_od = 0
    
    Lokalni i = 0
    Dokud (i < pocet_intervalu) {
        Lokalni interval : LiveInterval = pamet_intervalu + (i * Velikost(LiveInterval))
        Lokalni start = interval->start_instr
        Lokalni end = interval->end_instr
        
        // Uvolnime registry, jejichz zivot jiz skoncil
        Pokud (fyz_r12_volny_od <= start && fyz_r12_volny_od > 0) { fyz_r12_volny_od = 0 }
        Pokud (fyz_r13_volny_od <= start && fyz_r13_volny_od > 0) { fyz_r13_volny_od = 0 }
        Pokud (fyz_r14_volny_od <= start && fyz_r14_volny_od > 0) { fyz_r14_volny_od = 0 }
        Pokud (fyz_r15_volny_od <= start && fyz_r15_volny_od > 0) { fyz_r15_volny_od = 0 }
        
        // Prideleni volneho registru
        Pokud (fyz_r12_volny_od == 0) { interval->fyzicky_reg = 12; fyz_r12_volny_od = end }
        Jinak Pokud (fyz_r13_volny_od == 0) { interval->fyzicky_reg = 13; fyz_r13_volny_od = end }
        Jinak Pokud (fyz_r14_volny_od == 0) { interval->fyzicky_reg = 14; fyz_r14_volny_od = end }
        Jinak Pokud (fyz_r15_volny_od == 0) { interval->fyzicky_reg = 15; fyz_r15_volny_od = end }
        Jinak {
            // Vsechny HW registry plne! Tento virtualni registr zustane v RAM ("Spill to Stack")
            interval->fyzicky_reg = 0 - 1
        }
        i = i + 1
    }
    Volej printf("Middle-End: Alokace dokoncena pro %d docasnych registru.\n", pocet_intervalu)
    Vrat 0
}
Metoda OptimalizujMrtvyKod() {
    Lokalni smazano = 0
    Lokalni i = pocet_ir - 1
    Dokud (i >= 0) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * Velikost(IR_Instrukce))
        
        // Pokud instrukce pocita neco do 'dest', ale ten registr nema v tabulce
        // intervalu svuj end_instr POTE co byl vytvoren, nikdo ho nečte!
        Pokud (inst->opcode == IR_OP_ADD || inst->opcode == IR_OP_SUB || inst->opcode == IR_OP_MUL || inst->opcode == IR_OP_DIV) {
            Lokalni interval : LiveInterval = pamet_intervalu + ((inst->dest - 1) * Velikost(LiveInterval))
            Pokud (interval->end_instr == interval->start_instr) {
                // Instrukce prepiseme na NOP (nic nedelej)
                inst->opcode = 0
                smazano = smazano + 1
            }
        }
        i = i - 1
    }
    Pokud (smazano > 0) {
        Volej printf("Middle-End: Vymazano %d mrtvych instrukci (DCE).\n", smazano)
    }
    Vrat 0
}
Metoda SpocitejHash(slovo) {
    Lokalni hash = 5381
    Lokalni c = Volej CtiByt(slovo)
    Lokalni i = 0
    Dokud (c != 0) {
        hash = ((hash * 33) + c)
        hash = hash & 2147483647 // Ochrana proti proteceni do zaporu
        i = i + 1
        c = Volej CtiByt(slovo + i)
    }
    Vrat hash % 4096
}

Metoda ZaregistrujDoHashe(sym_index) {
    Lokalni sym : Symbol = pamet_symbolu + (sym_index * Velikost(Symbol))
    Lokalni h = Volej SpocitejHash(sym->name)
    Lokalni adresa_bucketu = hash_tabulka + (h * 8)
    
    Lokalni prvni_plus_jedna = Volej CtiUkazatel(adresa_bucketu)
    sym->hash_next = prvni_plus_jedna
    Volej ZapisUkazatel(adresa_bucketu, sym_index + 1)
    Vrat 0
}

Metoda ZiskejTypKlicovehoSlova(slovo) {
    Lokalni delka = 0
    Dokud (Volej CtiByt(slovo + delka) != 0) { delka = delka + 1 }
    
    Pokud (delka == 3) {
        Pokud (Volej strcmp(slovo, "Asm") == 0) { Vrat TOKEN_ASM }
    } Jinak Pokud (delka == 4) {
        Pokud (Volej strcmp(slovo, "Vrat") == 0) { Vrat TOKEN_VRAT }
    } Jinak Pokud (delka == 5) {
        Pokud (Volej strcmp(slovo, "Pokud") == 0) { Vrat TOKEN_POKUD }
        Pokud (Volej strcmp(slovo, "Dokud") == 0) { Vrat TOKEN_DOKUD }
        Pokud (Volej strcmp(slovo, "Volej") == 0) { Vrat TOKEN_VOLEJ }
        Pokud (Volej strcmp(slovo, "Vypis") == 0) { Vrat TOKEN_VYPIS }
        Pokud (Volej strcmp(slovo, "Jinak") == 0) { Vrat TOKEN_JINAK }
        Pokud (Volej strcmp(slovo, "Cesta") == 0) { Vrat TOKEN_CESTA }
        Pokud (Volej strcmp(slovo, "Zahrn") == 0) { Vrat 999 }
    } Jinak Pokud (delka == 6) {
        Pokud (Volej strcmp(slovo, "Opakuj") == 0) { Vrat TOKEN_OPAKUJ }
        Pokud (Volej strcmp(slovo, "Metoda") == 0) { Vrat TOKEN_METODA }
        Pokud (Volej strcmp(slovo, "Alokuj") == 0) { Vrat TOKEN_ALOKUJ }
        Pokud (Volej strcmp(slovo, "Uvolni") == 0) { Vrat TOKEN_UVOLNI }
        Pokud (Volej strcmp(slovo, "Ukonci") == 0) { Vrat TOKEN_UKONCI }
    } Jinak Pokud (delka == 7) {
        Pokud (Volej strcmp(slovo, "Lokalni") == 0) { Vrat TOKEN_LOKALNI }
        Pokud (Volej strcmp(slovo, "Externi") == 0) { Vrat TOKEN_EXTERNI }
        Pokud (Volej strcmp(slovo, "Skupina") == 0) { Vrat TOKEN_SKUPINA }
    } Jinak Pokud (delka == 8) {
        Pokud (Volej strcmp(slovo, "Globalni") == 0) { Vrat TOKEN_GLOBALNI }
        Pokud (Volej strcmp(slovo, "Velikost") == 0) { Vrat TOKEN_VELIKOST }
        Pokud (Volej strcmp(slovo, "Pokracuj") == 0) { Vrat TOKEN_POKRACUJ }
    } Jinak Pokud (delka == 9) {
        Pokud (Volej strcmp(slovo, "Konstanta") == 0) { Vrat TOKEN_KONSTANTA }
        Pokud (Volej strcmp(slovo, "Struktura") == 0) { Vrat TOKEN_STRUKTURA }
    } Jinak Pokud (delka == 10) {
        Pokud (Volej strcmp(slovo, "Rozcestnik") == 0) { Vrat TOKEN_ROZCESTNIK }
        Pokud (Volej strcmp(slovo, "CtiZAdresu") == 0) { Vrat TOKEN_CTI_ADRESU }
    } Jinak Pokud (delka == 12) {
        Pokud (Volej strcmp(slovo, "Hlavni_cesta") == 0) { Vrat TOKEN_HLAVNI_CESTA }
    }
    Vrat TOKEN_IDENTIFIER
}
Metoda ZapisByte(adresa, hodnota) {
    Asm "mov rax, [rbp+16]"
    Asm "mov rbx, [rbp+24]"
    Asm "mov [rax], bl"
    Vrat 0
}


Metoda CtiByt(adresa) {
    Lokalni hodnota = 0
    Asm "mov rax, [rbp+16]"
    Asm "movzx rax, byte [rax]"
    Asm "mov [rbp-8], rax"
    Vrat hodnota
}
Metoda PridejClenaStruktury(s_name, m_name, off) {
    Pokud (pocet_struktur_clenu >= 499) {
        Volej printf("Kriticka chyba: prekrocen maximalni pocet clenu struktur (500)!\n")
        Volej exit(1)
    }
    Lokalni base = pamet_struktur_clenove + (pocet_struktur_clenu * 1032)
    Volej strncpy(base + 0, s_name, 63)
    Volej ZapisByte(base + 63, 0)
    Volej strncpy(base + 512, m_name, 63)
    Volej ZapisByte(base + 575, 0)
    Volej ZapisUkazatel(base + 1024, off)
    pocet_struktur_clenu = pocet_struktur_clenu + 1
    Vrat 0
}

Metoda ZaregistrujStrukturu(s_name, size) {
    Pokud (pocet_struktur_def >= 99) {
        Volej printf("Kriticka chyba: prekrocen maximalni pocet definic struktur (100)!\n")
        Volej exit(1)
    }
    Lokalni base = pamet_struktur_def + (pocet_struktur_def * 520)
    Volej strncpy(base + 0, s_name, 63)
    Volej ZapisByte(base + 63, 0)
    Volej ZapisUkazatel(base + 512, size)
    pocet_struktur_def = pocet_struktur_def + 1
    Vrat 0
}

Metoda ZiskejOffset(typ, vlastnost) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_clenu) {
        Lokalni base = pamet_struktur_clenove + (i * 1032)
        Pokud (Volej strcmp(base + 0, typ) == 0) {
            Pokud (Volej strcmp(base + 512, vlastnost) == 0) {
                Vrat Volej CtiUkazatel(base + 1024)
            }
        }
        i = i + 1
    }
    // Zásadní oprava: Pokud offset nenajdeme, nesmíme vrátit 0 (což je platný offset pro typ!)
    Volej printf("Kriticka chyba: Clen '%s' ve strukture '%s' neexistuje!\n", vlastnost, typ)
    Volej exit(1)
    Vrat 0
}

Metoda ZiskejVelikostStruktury(typ) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_def) {
        Lokalni base = pamet_struktur_def + (i * 520)
        Pokud (Volej strcmp(base + 0, typ) == 0) {
            Vrat Volej CtiUkazatel(base + 512)
        }
        i = i + 1
    }
    Vrat 8
}

Metoda CtiUkazatel(adresa) {
    Lokalni hodnota = 0
    Asm "mov rax, [rbp+16]"
    Asm "mov rax, [rax]"
    Asm "mov [rbp-8], rax"
    Vrat hodnota
}

Metoda ZapisUkazatel(adresa, hodnota) {
    Asm "mov rax, [rbp+16]"
    Asm "mov rbx, [rbp+24]"
    Asm "mov [rax], rbx"
    Vrat 0
}

// ==========================================
// VYLEPSENI: registr Externi jmen (pro Apple name-mangling pri "Volej")
// ==========================================
Metoda PridejExterniJmeno(nazev) {
    Pokud (pocet_externu >= 199) {
        Volej printf("Kriticka chyba: prilis mnoho Externi deklaraci (max 200)!\n")
        Volej exit(1)
    }
    Lokalni base = pamet_externu + (pocet_externu * 256)
    Volej strncpy(base, nazev, 255)
    pocet_externu = pocet_externu + 1
    Vrat 0
}

Metoda JeExterniJmeno(nazev) {
    // printf a exit generator vzdy prida sam, i kdyz je uzivatel nedeklaroval
    Pokud (Volej strcmp(nazev, "printf") == 0) { Vrat 1 }
    Pokud (Volej strcmp(nazev, "exit") == 0) { Vrat 1 }
    Lokalni i = 0
    Dokud (i < pocet_externu) {
        Lokalni base = pamet_externu + (i * 256)
        Pokud (Volej strcmp(base, nazev) == 0) { Vrat 1 }
        i = i + 1
    }
    Vrat 0
}

// Na Apple (Mach-O) potrebuji C symboly s podtrzitkem na zacatku (_printf, _main, ...)
Metoda NazevSymbolu(nazev) {
    Pokud (cilova_platforma == CIL_APPLE) {
        Lokalni vysledek = Volej malloc(300)
        Volej sprintf(vysledek, "_%s", nazev)
        Vrat vysledek
    }
    Vrat nazev
}

// ==========================================
// VYLEPSENI: vyhodnoceni konstantniho vyrazu (pro "Globalni x = <vyraz>")
// Smi pouzivat jen cisla, jmenovane Konstanty a +,-,*,/,% na jiz slozenych konstantach
// (OptimalizujUzel uz vetsinu ciste-konstantnich podstromu slozi behem parsovani).
// ==========================================
Metoda VyhodnotKonstantu(uzel : AST_Node) {
    Pokud (uzel == 0) {
        Volej printf("Kriticka chyba: prazdny inicializacni vyraz globalni promenne!\n")
        Volej exit(1)
    }
    Pokud (uzel->op == TOKEN_NUMBER) { Vrat Volej atoi(uzel->name) }
    Pokud (uzel->op == TOKEN_IDENTIFIER) {
        Lokalni sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym != 0 && sym->is_const == 1) { Vrat sym->const_val }
        Volej printf("Kriticka chyba: '%s' neni znama konstanta pro inicializaci Globalni promenne!\n", uzel->name)
        Volej exit(1)
    }
    Pokud (uzel->op == TOKEN_MINUS && uzel->left != 0 && uzel->right == 0) {
        Vrat 0 - (Volej VyhodnotKonstantu(uzel->left))
    }
    Volej printf("Kriticka chyba: inicializace Globalni promenne musi byt konstantni vyraz (radek %d)!\n", uzel->line)
    Volej exit(1)
    Vrat 0
}

Metoda PridejLokalniSymbol(nazev, velikost_v_bajtech) {
    Lokalni existuje : Symbol = Volej NajdiSymbol(nazev)
    Pokud (existuje != 0) {
        Pokud (existuje->is_global == 0 && existuje->scope_depth == aktualni_hloubka_bloku) {
            Volej printf("Chyba: Lokalni promenna '%s' jiz byla v tomto bloku deklarovana!\n", nazev)
            Volej exit(1)
        }
    }

    Volej ZkontrolujKapacituSymbolu()
    Lokalni novy_symbol : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
    Volej strncpy(novy_symbol->name, nazev, 255)
    novy_symbol->is_global = 0
    novy_symbol->is_const = 0
    current_local_offset = current_local_offset + velikost_v_bajtech
    novy_symbol->offset = current_local_offset
    
    novy_symbol->scope_depth = aktualni_hloubka_bloku
    novy_symbol->is_active = 1
    
    pocet_symbolu = pocet_symbolu + 1
    Volej ZaregistrujDoHashe(pocet_symbolu - 1)
    Vrat 0
}

Metoda PridejGlobalniSymbol(nazev, hodnota) {
    Lokalni existuje = Volej NajdiSymbol(nazev)
    Pokud (existuje != 0) {
        Vrat 0
    }

    Volej ZkontrolujKapacituSymbolu()
    Lokalni novy_symbol : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
    Volej strncpy(novy_symbol->name, nazev, 255)
    novy_symbol->is_global = 1
    novy_symbol->is_const = 0
    novy_symbol->const_val = hodnota
    pocet_symbolu = pocet_symbolu + 1
    Volej ZaregistrujDoHashe(pocet_symbolu - 1)
    Vrat 0
}

Metoda PridejKonstantu(nazev, hodnota) {
    Volej ZkontrolujKapacituSymbolu()
    Lokalni novy_symbol : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
    Volej strncpy(novy_symbol->name, nazev, 255)
    novy_symbol->is_global = 1
    novy_symbol->is_const = 1
    novy_symbol->const_val = hodnota
    pocet_symbolu = pocet_symbolu + 1
    Volej ZaregistrujDoHashe(pocet_symbolu - 1)
    Vrat 0
}


Metoda NajdiSymbol(nazev) {
    Lokalni h = Volej SpocitejHash(nazev)
    Lokalni adresa_bucketu = hash_tabulka + (h * 8)
    Lokalni aktualni_plus_jedna = Volej CtiUkazatel(adresa_bucketu)
    
    Dokud (aktualni_plus_jedna != 0) {
        Lokalni index = aktualni_plus_jedna - 1
        Lokalni sym : Symbol = pamet_symbolu + (index * Velikost(Symbol))
        
        Pokud (Volej strcmp(sym->name, nazev) == 0) {
            Pokud (codegen_scoped == 1) {
                Pokud (sym->is_global == 1 || (index >= codegen_sym_start && index < codegen_sym_end)) {
                    Vrat sym
                }
            } Jinak {
                Pokud (sym->is_global == 1 || (index >= parse_sym_start && sym->is_active == 1)) {
                    Vrat sym
                }
            }
        }
        aktualni_plus_jedna = sym->hash_next
    }
    Vrat 0
}

// ==========================================
// LEXER (Zpracovani zdrojoveho kodu)
// ==========================================
Metoda LexerCore(nazev_souboru, is_main) {
    Volej printf("Lexer: Oteviram %s...\n", nazev_souboru)
    Lokalni soubor = Volej fopen(nazev_souboru, "r")
    Pokud (soubor == 0) { Volej printf("Chyba: Soubor nenalezen!\n"); Volej exit(1) }

    Volej fseek(soubor, 0, 2)
    Lokalni velikost = Volej ftell(soubor)
    Volej rewind(soubor)

    Lokalni zdroj_buffer = Volej calloc(1, velikost + 2)
    Volej fread(zdroj_buffer, 1, velikost, soubor)
    Volej fclose(soubor)

    Lokalni radek = 1
    Lokalni pos = 0
    Lokalni znak = Volej CtiByt(zdroj_buffer + pos)
    Lokalni i = 0

    Dokud (znak != 0) {
        Pokud (pocet_tokenu >= (kapacita_tokenu - 10)) {
            kapacita_tokenu = kapacita_tokenu * 2
            pamet_tokenu = Volej realloc(pamet_tokenu, kapacita_tokenu * Velikost(Token))
        }

        Pokud (znak == 32 || znak == 9 || znak == 13) { pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); Pokracuj }
        Pokud (znak == 10) { radek = radek + 1; pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); Pokracuj }

        Pokud (znak == 47) {
            pos = pos + 1
            znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 47) {
                Dokud (znak != 10 && znak != 0) { pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
                Pokracuj
            } Jinak {
                Lokalni div_token : Token = pamet_tokenu + (pocet_tokenu * Velikost(Token))
                div_token->line = radek
                div_token->type = TOKEN_DIV
                Volej strncpy(div_token->value, "/", 2)
                pocet_tokenu = pocet_tokenu + 1
                Pokracuj
            }
        }

        Lokalni aktualni_token : Token = pamet_tokenu + (pocet_tokenu * Velikost(Token))
        aktualni_token->line = radek

       // --- CTENI CISEL (CELA I DESETINNA) ---
        Pokud (znak >= 48 && znak <= 57) {
            aktualni_token->type = TOKEN_NUMBER
            i = 0
            Lokalni ma_tecku = 0
            
            // Cteme cislice nebo tecku (znak 46)
            Dokud ((znak >= 48 && znak <= 57) || znak == 46) {
                Pokud (znak == 46) {
                    Pokud (ma_tecku == 1) {
                        Volej printf("Lexikalni chyba na radku %d: Cislo ma vice nez jednu tecku!\n", radek)
                        Volej exit(1)
                    }
                    ma_tecku = 1
                    aktualni_token->type = TOKEN_FLOAT // Jakmile najdeme tecku, menime typ tokenu
                }
                Pokud (i < 254) { aktualni_token->value[i] = znak; i = i + 1 }
                pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            }
            aktualni_token->value[i] = 0; pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }

        Pokud (znak == 34) {
            aktualni_token->type = TOKEN_STRING; aktualni_token->str_id = globalni_str_id; globalni_str_id = globalni_str_id + 1
            i = 0; pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Dokud (znak != 34 && znak != 0) {
                Pokud (znak == 92) {
                    pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                    Pokud (i < 254) {
                        Pokud (znak == 110) { aktualni_token->value[i] = 10 }
                        Jinak Pokud (znak == 116) { aktualni_token->value[i] = 9 }
                        Jinak Pokud (znak == 34) { aktualni_token->value[i] = 34 }
                        Jinak Pokud (znak == 92) { aktualni_token->value[i] = 92 }
                        Jinak Pokud (znak == 48) { aktualni_token->value[i] = 0 }
                        Jinak { aktualni_token->value[i] = znak }
                        i = i + 1
                    }
                    pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                } Jinak {
                    Pokud (i < 254) { aktualni_token->value[i] = znak; i = i + 1 }
                    pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                }
            }
            aktualni_token->value[i] = 0; pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            
            Pokud (cekam_na_zahrn == 1) {
                cekam_na_zahrn = 0
                Lokalni temp_nazev = Volej malloc(256)
                Volej strncpy(temp_nazev, aktualni_token->value, 255)
                Volej LexerCore(temp_nazev, 0)
                Volej free(temp_nazev)
                Pokracuj
            }
            
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }

        Pokud (znak == 61) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_EQEQ; Volej strncpy(aktualni_token->value, "==", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_EQ; Volej strncpy(aktualni_token->value, "=", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 33) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_NEQ; Volej strncpy(aktualni_token->value, "!=", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_NOT; Volej strncpy(aktualni_token->value, "!", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 60) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_LESSEQ; Volej strncpy(aktualni_token->value, "<=", 3); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak Pokud (znak == 60) { aktualni_token->type = TOKEN_SHL; Volej strncpy(aktualni_token->value, "<<", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_LESS; Volej strncpy(aktualni_token->value, "<", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 62) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_GREATEREQ; Volej strncpy(aktualni_token->value, ">=", 3); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak Pokud (znak == 62) { aktualni_token->type = TOKEN_SHR; Volej strncpy(aktualni_token->value, ">>", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_GREATER; Volej strncpy(aktualni_token->value, ">", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 38) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 38) { aktualni_token->type = TOKEN_AND; Volej strncpy(aktualni_token->value, "&&", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_AMPER; Volej strncpy(aktualni_token->value, "&", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 124) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 124) { aktualni_token->type = TOKEN_OR; Volej strncpy(aktualni_token->value, "||", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_PIPE; Volej strncpy(aktualni_token->value, "|", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 94) { aktualni_token->type = TOKEN_CARET; Volej strncpy(aktualni_token->value, "^", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 37) { aktualni_token->type = TOKEN_MOD; Volej strncpy(aktualni_token->value, "%", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }

        Pokud (znak == 43) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_PLUSEQ; Volej strncpy(aktualni_token->value, "+=", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_PLUS }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 45) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_MINUSEQ; Volej strncpy(aktualni_token->value, "-=", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak Pokud (znak == 62) { aktualni_token->type = TOKEN_ARROW; Volej strncpy(aktualni_token->value, "->", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_MINUS }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }

        Pokud (znak == 58) { aktualni_token->type = TOKEN_COLON; Volej strncpy(aktualni_token->value, ":", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 123) { aktualni_token->type = TOKEN_LBRACE; Volej strncpy(aktualni_token->value, "{", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 125) { aktualni_token->type = TOKEN_RBRACE; Volej strncpy(aktualni_token->value, "}", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 40) { aktualni_token->type = TOKEN_LPAREN; Volej strncpy(aktualni_token->value, "(", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 41) { aktualni_token->type = TOKEN_RPAREN; Volej strncpy(aktualni_token->value, ")", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 91) { aktualni_token->type = TOKEN_LBRACKET; Volej strncpy(aktualni_token->value, "[", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 93) { aktualni_token->type = TOKEN_RBRACKET; Volej strncpy(aktualni_token->value, "]", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 44) { aktualni_token->type = TOKEN_COMMA; Volej strncpy(aktualni_token->value, ",", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 42) { aktualni_token->type = TOKEN_MUL; pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }

        Pokud ((znak >= 65 && znak <= 90) || (znak >= 97 && znak <= 122) || znak == 95) {
            i = 0
            Dokud ((znak >= 65 && znak <= 90) || (znak >= 97 && znak <= 122) || znak == 95 || (znak >= 48 && znak <= 57)) {
                Pokud (i < 254) { aktualni_token->value[i] = znak; i = i + 1 }
                pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            }
            aktualni_token->value[i] = 0
            
            Lokalni typ_klic = Volej ZiskejTypKlicovehoSlova(aktualni_token->value)
            Pokud (typ_klic == 999) {
                cekam_na_zahrn = 1
                Pokracuj
            } Jinak {
                aktualni_token->type = typ_klic
            }
            
            pocet_tokenu = pocet_tokenu + 1
            Pokracuj
        }
        pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
    }
    
    Volej free(zdroj_buffer)
    
    Pokud (is_main == 1) {
        Pokud (pocet_tokenu >= kapacita_tokenu) {
            kapacita_tokenu = kapacita_tokenu + 10
            pamet_tokenu = Volej realloc(pamet_tokenu, kapacita_tokenu * Velikost(Token))
        }
        Lokalni eof_token : Token = pamet_tokenu + (pocet_tokenu * Velikost(Token))
        eof_token->type = TOKEN_EOF
        Volej printf("Lexer dokoncil cteni. Celkovy pocet tokenu: %d\n", pocet_tokenu)
    }
    Vrat 0
}

Metoda Lexer(nazev_souboru) {
    cekam_na_zahrn = 0
    Volej LexerCore(nazev_souboru, 1)
    Vrat 0
}

// ==========================================
// PARSER (Sestaveni AST stromu a Precedence)
// ==========================================
Metoda VytvorUzel(typ_uzlu, radek) {
    Lokalni uzel : AST_Node = Volej calloc(1, Velikost(AST_Node))
    uzel->type = typ_uzlu
    uzel->line = radek
    Vrat uzel
}

Metoda ZiskejToken(index) {
    // Vylepseni: ochrana proti cteni mimo alokovany buffer tokenu.
    // pamet_tokenu[pocet_tokenu] je vzdy platny EOF sentinel (viz LexerCore),
    // takze mimo rozsah bezpecne vratime prave jeho.
    Lokalni bezpecny_index = index
    Pokud (bezpecny_index < 0) { bezpecny_index = 0 }
    Pokud (bezpecny_index > pocet_tokenu) { bezpecny_index = pocet_tokenu }
    Lokalni t : Token = pamet_tokenu + (bezpecny_index * Velikost(Token))
    Vrat t
}

Metoda OptimalizujUzel(binarni_uzel : AST_Node) {
    Pokud (binarni_uzel->left != 0 && binarni_uzel->right != 0) {
        Lokalni l_uzel : AST_Node = binarni_uzel->left
        Lokalni r_uzel : AST_Node = binarni_uzel->right
        
        // --- BOOLEOVSKE IDENTITY S PROMENNYMI (x == x) ---
        Pokud (l_uzel->op == 35 && r_uzel->op == 35) { // 35 = TOKEN_IDENTIFIER
            Pokud (Volej strcmp(l_uzel->name, r_uzel->name) == 0) {
                Pokud (binarni_uzel->op == 43 || binarni_uzel->op == 61 || binarni_uzel->op == 62) { // EQEQ, LESSEQ, GREATEREQ
                    binarni_uzel->op = 34; Volej strncpy(binarni_uzel->name, "1", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel
                }
                Pokud (binarni_uzel->op == 64 || binarni_uzel->op == 45 || binarni_uzel->op == 46) { // NEQ, LESS, GREATER
                    binarni_uzel->op = 34; Volej strncpy(binarni_uzel->name, "0", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel
                }
            }
        }
        
        // --- ZCELA KONSTANTNI VYRAZ (Slozeni 2 cisel) ---
        Pokud (l_uzel->op == 34 && r_uzel->op == 34) { // 34 = TOKEN_NUMBER
            Lokalni l_val = Volej atoi(l_uzel->name)
            Lokalni r_val = Volej atoi(r_uzel->name)
            Lokalni vys = 0
            Lokalni lze_opt = 1
            
            Pokud (binarni_uzel->op == 67) { vys = l_val + r_val } // PLUS
            Jinak Pokud (binarni_uzel->op == 44) { vys = l_val - r_val } // MINUS
            Jinak Pokud (binarni_uzel->op == 49) { vys = l_val * r_val } // MUL
            Jinak Pokud (binarni_uzel->op == 50) { Pokud (r_val != 0) { vys = l_val / r_val } Jinak { lze_opt = 0 } }
            Jinak Pokud (binarni_uzel->op == 43) { Pokud (l_val == r_val) { vys = 1 } Jinak { vys = 0 } }
            Jinak Pokud (binarni_uzel->op == 64) { Pokud (l_val != r_val) { vys = 1 } Jinak { vys = 0 } }
            Jinak Pokud (binarni_uzel->op == 47) { Pokud (l_val != 0 && r_val != 0) { vys = 1 } Jinak { vys = 0 } } // AND
            Jinak Pokud (binarni_uzel->op == 48) { Pokud (l_val != 0 || r_val != 0) { vys = 1 } Jinak { vys = 0 } } // OR
            Jinak { lze_opt = 0 }
            
            Pokud (lze_opt == 1) {
                binarni_uzel->op = 34
                Volej sprintf(binarni_uzel->name, "%d", vys)
                binarni_uzel->left = 0
                binarni_uzel->right = 0
            }
            Vrat binarni_uzel
        }
        
        // --- ALGEBRAICKE ZJEDNODUSENI (prava strana je cislo) ---
        Pokud (r_uzel->op == 34) { 
            Lokalni r_cislo = Volej atoi(r_uzel->name)
            
            // Nasobeni, scitani
            Pokud (binarni_uzel->op == 49 && r_cislo == 0) { binarni_uzel->op = 34; Volej strncpy(binarni_uzel->name, "0", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
            Jinak Pokud (binarni_uzel->op == 49 && r_cislo == 1) { Vrat l_uzel }
            Jinak Pokud (binarni_uzel->op == 67 && r_cislo == 0) { Vrat l_uzel }
            Jinak Pokud (binarni_uzel->op == 44 && r_cislo == 0) { Vrat l_uzel }
            Jinak Pokud (binarni_uzel->op == 50 && r_cislo == 1) { Vrat l_uzel }
            
            // Logika (AND, OR)
            Jinak Pokud (binarni_uzel->op == 47 && r_cislo == 1) { Vrat l_uzel } // x && 1 = x
            Jinak Pokud (binarni_uzel->op == 47 && r_cislo == 0) { binarni_uzel->op = 34; Volej strncpy(binarni_uzel->name, "0", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
            Jinak Pokud (binarni_uzel->op == 48 && r_cislo == 0) { Vrat l_uzel } // x || 0 = x
            Jinak Pokud (binarni_uzel->op == 48 && r_cislo == 1) { binarni_uzel->op = 34; Volej strncpy(binarni_uzel->name, "1", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
            
            // Strength Reduction (Bitove posuny)
            Pokud (binarni_uzel->op == 49) {
                Pokud (r_cislo == 2) { binarni_uzel->op = 84; Volej strncpy(r_uzel->name, "1", 2); Vrat binarni_uzel }
                Pokud (r_cislo == 4) { binarni_uzel->op = 84; Volej strncpy(r_uzel->name, "2", 2); Vrat binarni_uzel }
                Pokud (r_cislo == 8) { binarni_uzel->op = 84; Volej strncpy(r_uzel->name, "3", 2); Vrat binarni_uzel }
            }
            Pokud (binarni_uzel->op == 50) {
                Pokud (r_cislo == 2) { binarni_uzel->op = 85; Volej strncpy(r_uzel->name, "1", 2); Vrat binarni_uzel }
                Pokud (r_cislo == 4) { binarni_uzel->op = 85; Volej strncpy(r_uzel->name, "2", 2); Vrat binarni_uzel }
                Pokud (r_cislo == 8) { binarni_uzel->op = 85; Volej strncpy(r_uzel->name, "3", 2); Vrat binarni_uzel }
            }
        }
        
        // --- ALGEBRAICKE ZJEDNODUSENI (leva strana je cislo) ---
        Pokud (l_uzel->op == 34) { 
            Lokalni l_cislo = Volej atoi(l_uzel->name)
            Pokud (binarni_uzel->op == 47 && l_cislo == 1) { Vrat r_uzel }
            Pokud (binarni_uzel->op == 47 && l_cislo == 0) { binarni_uzel->op = 34; Volej strncpy(binarni_uzel->name, "0", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
            Pokud (binarni_uzel->op == 48 && l_cislo == 0) { Vrat r_uzel }
            Pokud (binarni_uzel->op == 48 && l_cislo == 1) { binarni_uzel->op = 34; Volej strncpy(binarni_uzel->name, "1", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
        }
    }
    Vrat binarni_uzel
}
Metoda ParseFaktor() {
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Lokalni uzel : AST_Node = 0

    Pokud (token->type == TOKEN_LPAREN) {
        aktualni_token_idx = aktualni_token_idx + 1
        uzel = Volej ParseVyraz()
        Lokalni rp_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (rp_token->type == TOKEN_RPAREN) { aktualni_token_idx = aktualni_token_idx + 1 }
    } Jinak Pokud (token->type == TOKEN_MINUS) {
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_MINUS
        aktualni_token_idx = aktualni_token_idx + 1
        uzel->left = Volej ParseFaktor()
    } Jinak Pokud (token->type == TOKEN_NOT) {
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_NOT
        aktualni_token_idx = aktualni_token_idx + 1
        uzel->left = Volej ParseFaktor()
    } Jinak Pokud (token->type == TOKEN_STRING) {
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_STRING
        uzel->int_val = token->str_id
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == TOKEN_NUMBER) {
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_NUMBER
        Volej strncpy(uzel->name, token->value, 255)
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == 98) { // --- NOVE: Zpracovani TOKEN_FLOAT (98) ---
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = 98 
        Volej strncpy(uzel->name, token->value, 255) // Ulozime si tvar "3.14"
        uzel->int_val = globalni_float_id            // Ulozime si ID (flt0, flt1...)
        globalni_float_id = globalni_float_id + 1
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == TOKEN_VELIKOST) {
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_NUMBER
        Lokalni typ_str : Token = Volej ZiskejToken(aktualni_token_idx + 2)
        Lokalni vel = Volej ZiskejVelikostStruktury(typ_str->value)
        Volej sprintf(uzel->name, "%d", vel)
        aktualni_token_idx = aktualni_token_idx + 4
    } Jinak Pokud (token->type == TOKEN_CTI_ADRESU) {
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_CTI_ADRESU
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParseVyraz()
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == TOKEN_ALOKUJ) {
        uzel = Volej VytvorUzel(AST_ALLOC, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        uzel->left = Volej ParseFaktor()
    } Jinak Pokud (token->type == TOKEN_VOLEJ) {
        uzel = Volej VytvorUzel(AST_CALL, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni nazev_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Volej strncpy(uzel->name, nazev_token->value, 255)
        aktualni_token_idx = aktualni_token_idx + 2

        uzel->stmts = Volej calloc(100, 8)
        uzel->stmt_count = 0
        Lokalni arg_token_e : Token = Volej ZiskejToken(aktualni_token_idx)
        Dokud (arg_token_e->type != TOKEN_RPAREN && arg_token_e->type != TOKEN_EOF) {
            Lokalni arg_vyraz_e = Volej ParseVyraz()
            Pokud (uzel->stmt_count < 95) {
                Lokalni addr_e = uzel->stmts + (uzel->stmt_count * 8)
                Volej ZapisUkazatel(addr_e, arg_vyraz_e)
                uzel->stmt_count = uzel->stmt_count + 1
            } Jinak {
                Volej printf("Kriticka chyba: prekrocen maximalni pocet argumentu volani (95) na radku %d!\n", token->line)
                Volej exit(1)
            }

            arg_token_e = Volej ZiskejToken(aktualni_token_idx)
            Pokud (arg_token_e->type == TOKEN_COMMA) { aktualni_token_idx = aktualni_token_idx + 1 }
            arg_token_e = Volej ZiskejToken(aktualni_token_idx)
        }
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == TOKEN_IDENTIFIER) {
        Lokalni po_ident : Token = Volej ZiskejToken(aktualni_token_idx + 1)
        Pokud (po_ident->type == TOKEN_ARROW) {
            Lokalni vlastnost : Token = Volej ZiskejToken(aktualni_token_idx + 2)
            Lokalni ctvrty_token : Token = Volej ZiskejToken(aktualni_token_idx + 3)
            
            Pokud (ctvrty_token->type == TOKEN_LBRACKET) {
                uzel = Volej VytvorUzel(AST_ARRAY_READ, token->line)
                Volej strncpy(uzel->name, token->value, 255)
                Volej strncpy(uzel->sub_name, vlastnost->value, 63)
                Lokalni sym_arr : Symbol = Volej NajdiSymbol(token->value)
                Pokud (sym_arr != 0) { uzel->int_val = Volej ZiskejOffset(sym_arr->type_name, vlastnost->value) }
                
                aktualni_token_idx = aktualni_token_idx + 4
                uzel->left = Volej ParseVyraz()
                
                Lokalni po_idx : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (po_idx->type == TOKEN_RBRACKET) { aktualni_token_idx = aktualni_token_idx + 1 }
            } Jinak {
                uzel = Volej VytvorUzel(AST_PTR_MEMBER_READ, token->line)
                Volej strncpy(uzel->name, token->value, 255)
                Volej strncpy(uzel->sub_name, vlastnost->value, 63)
                Lokalni sym : Symbol = Volej NajdiSymbol(token->value)
                Pokud (sym != 0) { uzel->int_val = Volej ZiskejOffset(sym->type_name, vlastnost->value) }
                aktualni_token_idx = aktualni_token_idx + 3
            }
        } Jinak Pokud (po_ident->type == TOKEN_LBRACKET) {
            uzel = Volej VytvorUzel(AST_LOCAL_ARRAY_READ, token->line)
            Volej strncpy(uzel->name, token->value, 255)
            aktualni_token_idx = aktualni_token_idx + 2
            uzel->left = Volej ParseVyraz()
            
            Lokalni po_idx2 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (po_idx2->type == TOKEN_RBRACKET) { aktualni_token_idx = aktualni_token_idx + 1 }
        } Jinak {
            // --- OPTIMALIZACE: Constant Propagation (Sireni konstant) ---
            Lokalni sym_id_opt : Symbol = Volej NajdiSymbol(token->value)
            Pokud (sym_id_opt != 0 && sym_id_opt->is_const == 1) {
                uzel = Volej VytvorUzel(AST_EXPR, token->line)
                uzel->op = TOKEN_NUMBER
                Volej sprintf(uzel->name, "%d", sym_id_opt->const_val)
                aktualni_token_idx = aktualni_token_idx + 1
            } Jinak {
                uzel = Volej VytvorUzel(AST_EXPR, token->line)
                uzel->op = TOKEN_IDENTIFIER
                Volej strncpy(uzel->name, token->value, 255)
                aktualni_token_idx = aktualni_token_idx + 1
            }
        }
    } Jinak { Volej printf("Chyba: Ocekavan vyraz!\n"); Volej exit(1) }

    Vrat uzel
}
Metoda ParseNasobeni() {
    Lokalni uzel = Volej ParseFaktor()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_MUL || t->type == TOKEN_DIV || t->type == TOKEN_MOD) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseFaktor()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseScitani() {
    Lokalni uzel = Volej ParseNasobeni()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_PLUS || t->type == TOKEN_MINUS) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseNasobeni()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParsePosun() {
    Lokalni uzel = Volej ParseScitani()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_SHL || t->type == TOKEN_SHR) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseScitani()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParsePorovnani() {
    Lokalni uzel = Volej ParsePosun()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_LESS || t->type == TOKEN_LESSEQ || t->type == TOKEN_GREATER || t->type == TOKEN_GREATEREQ) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParsePosun()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseRovnost() {
    Lokalni uzel = Volej ParsePorovnani()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_EQEQ || t->type == TOKEN_NEQ) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParsePorovnani()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseBitAND() {
    Lokalni uzel = Volej ParseRovnost()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_AMPER) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseRovnost()
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseBitXOR() {
    Lokalni uzel = Volej ParseBitAND()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_CARET) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseBitAND()
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseBitOR() {
    Lokalni uzel = Volej ParseBitXOR()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_PIPE) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseBitXOR()
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseVyraz() {
    Lokalni uzel = Volej ParseBitOR()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_AND || t->type == TOKEN_OR) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseBitOR()
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}
Metoda ZiskejTypUzlu(u : AST_Node) {
    Pokud (u == 0) { Vrat "" }
    Pokud (u->op == 33 || u->op == 95) { Vrat "String" }
    Pokud (u->op == 98) { Vrat "Float" }
    
    // Pro matematicke operatory odvodime typ z leve/prave strany
    Pokud (u->op == 34 || u->op == 67 || u->op == 44 || u->op == 49 || u->op == 50 || u->op == 80) { 
        Lokalni lt = Volej ZiskejTypUzlu(u->left)
        Lokalni rt = Volej ZiskejTypUzlu(u->right)
        Pokud (Volej strcmp(lt, "Float") == 0 || Volej strcmp(rt, "Float") == 0) { Vrat "Float" }
        Pokud (Volej strcmp(lt, "String") == 0 || Volej strcmp(rt, "String") == 0) { Vrat "String" }
        Vrat "Cislo"
    }
    Pokud (u->op == 35) { // IDENTIFIER
        Lokalni sym : Symbol = Volej NajdiSymbol(u->name)
        Pokud (sym != 0) { Vrat sym->type_name }
    }
    Pokud (u->type == 20) { // AST_CALL
        Lokalni fsym : Symbol = Volej NajdiSymbol(u->name)
        Pokud (fsym != 0 && fsym->is_function == 1) {
            Lokalni fnode : AST_Node = fsym->func_node
            Vrat fnode->type_name
        }
    }
    Vrat ""
}

Metoda ZkontrolujAST(uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    Pokud (uzel->type == 100) { Vrat 0 }

    Pokud (uzel->type == AST_METHOD) {
        kontrola_aktualni_typ_metody = uzel->type_name
    }

    // 1. Zanorovani do dalsich uzlu
    Pokud (uzel->type == AST_PROGRAM || uzel->type == AST_BLOCK || uzel->type == AST_METHOD) {
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Lokalni adresa_v_poli = uzel->stmts + (i * 8)
            Lokalni pod_uzel : AST_Node = Volej CtiUkazatel(adresa_v_poli)
            Volej ZkontrolujAST(pod_uzel)
            i = i + 1
        }
    }
    Pokud (uzel->type == AST_IF || uzel->type == AST_WHILE) {
        Lokalni pravy_blok : AST_Node = uzel->right
        Volej ZkontrolujAST(pravy_blok)
        Pokud (uzel->alt != 0) {
            Lokalni alt_blok : AST_Node = uzel->alt
            Volej ZkontrolujAST(alt_blok)
        }
    }
    Pokud (uzel->type == AST_FOR) {
        Pokud (uzel->stmts != 0) {
            Lokalni telo : AST_Node = Volej CtiUkazatel(uzel->stmts)
            Volej ZkontrolujAST(telo)
        }
        Pokud (uzel->alt != 0) {
            Lokalni alt_blok2 : AST_Node = uzel->alt
            Volej ZkontrolujAST(alt_blok2)
        }
    }

    // --- PŘETĚŽOVÁNÍ OPERÁTORŮ PRO STRINGY ---
    Pokud (uzel->type == 5) { // AST_EXPR
        Volej ZkontrolujAST(uzel->left)
        Volej ZkontrolujAST(uzel->right)
        
        // Pokud jde o scitani, nebo porovnani (TOKEN_PLUS=67, TOKEN_EQEQ=43, TOKEN_NEQ=64)
        Pokud (uzel->op == 67 || uzel->op == 43 || uzel->op == 64) {
            Lokalni l_typ = Volej ZiskejTypUzlu(uzel->left)
            Lokalni r_typ = Volej ZiskejTypUzlu(uzel->right)
            
            Pokud (Volej strcmp(l_typ, "String") == 0 && Volej strcmp(r_typ, "String") == 0) {
                // Přeměníme operátor, aby generátor assembleru věděl, co má dělat
                Pokud (uzel->op == 67) { uzel->op = 95 }   // 95 = STRING_PLUS
                Pokud (uzel->op == 43) { uzel->op = 96 }   // 96 = STRING_EQEQ
                Pokud (uzel->op == 64) { uzel->op = 97 }   // 97 = STRING_NEQ
            }
        }
    }

    // --- KONTROLA VOLANI FUNKCI ---
    Pokud (uzel->type == AST_CALL) {
        Lokalni a = 0
        Dokud (a < uzel->stmt_count) {
            Lokalni arg_adresa = uzel->stmts + (a * 8)
            Lokalni arg_uzel : AST_Node = Volej CtiUkazatel(arg_adresa)
            Volej ZkontrolujAST(arg_uzel)
            a = a + 1
        }
        Lokalni met_sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (met_sym != 0 && met_sym->is_function == 1) {
            Lokalni def_uzel : AST_Node = met_sym->func_node
            Pokud (uzel->stmt_count != def_uzel->arg_count) {
                Volej printf("Typova chyba (radek %d): Metoda '%s' ocekava %d argumentu, ale bylo predano %d.\n", uzel->line, uzel->name, def_uzel->arg_count, uzel->stmt_count)
                Volej exit(1)
            }
            Lokalni k = 0
            Dokud (k < def_uzel->arg_count) {
                Lokalni ocekavany_sym : Symbol = pamet_symbolu + ((def_uzel->sym_start + k) * Velikost(Symbol))
                Lokalni dodany_adresa = uzel->stmts + (k * 8)
                Lokalni dodany_uzel : AST_Node = Volej CtiUkazatel(dodany_adresa)
                
                Pokud (Volej strcmp(ocekavany_sym->type_name, "") != 0) {
                    Lokalni dodany_typ = Volej ZiskejTypUzlu(dodany_uzel)
                    Pokud (Volej strcmp(dodany_typ, "") != 0) {
                        Pokud (Volej strcmp(ocekavany_sym->type_name, dodany_typ) != 0) {
                            Volej printf("Typova chyba (radek %d): Argument %d pro '%s' ma byt typu '%s', ale byl predan '%s'.\n", uzel->line, k + 1, uzel->name, ocekavany_sym->type_name, dodany_typ)
                            Volej exit(1)
                        }
                    }
                }
                k = k + 1
            }
        }
    }

    // --- KONTROLA NÁVRATŮ Z METOD ---
    Pokud (uzel->type == AST_RETURN) {
        Pokud (kontrola_aktualni_typ_metody != 0 && Volej strcmp(kontrola_aktualni_typ_metody, "") != 0) {
            Lokalni ret_typ = Volej ZiskejTypUzlu(uzel->left)
            Pokud (Volej strcmp(ret_typ, "") != 0) {
                Pokud (Volej strcmp(ret_typ, kontrola_aktualni_typ_metody) != 0) {
                    Volej printf("Typova chyba (radek %d): Metoda ma vracet typ '%s', ale vraci '%s'.\n", uzel->line, kontrola_aktualni_typ_metody, ret_typ)
                    Volej exit(1)
                }
            }
        }
    }

    // --- KONTROLA PŘIŘAZENÍ A ODVOZENÍ TYPU ---
    Pokud (uzel->type == AST_ASSIGN || uzel->type == AST_VAR_DECL) {
        Pokud (uzel->right != 0) {
            Lokalni r_uzel : AST_Node = uzel->right
            Volej ZkontrolujAST(r_uzel)
            
            Lokalni levy_sym : Symbol = Volej NajdiSymbol(uzel->name)
            Pokud (levy_sym != 0) {
                Lokalni odvozeny_typ = Volej ZiskejTypUzlu(r_uzel)
                
                Pokud (Volej strcmp(levy_sym->type_name, "") == 0) {
                    Pokud (Volej strcmp(odvozeny_typ, "") != 0) {
                        Volej strncpy(levy_sym->type_name, odvozeny_typ, 63)
                    }
                } Jinak {
                    Pokud (Volej strcmp(odvozeny_typ, "") != 0) {
                        Pokud (Volej strcmp(levy_sym->type_name, odvozeny_typ) != 0) {
                            Volej printf("Typova chyba (radek %d): Nelze priradit '%s' do promenne '%s' (ocekava '%s').\n", uzel->line, odvozeny_typ, levy_sym->name, levy_sym->type_name)
                            Volej exit(1)
                        }
                    }
                }
            }
        }
    }

    Pokud (uzel->type == AST_METHOD) { kontrola_aktualni_typ_metody = 0 }
    Vrat 0
}
Metoda ParseBlok() {
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Lokalni blok : AST_Node = Volej VytvorUzel(AST_BLOCK, token->line)
    
    Volej ZapisUkazatel(blok + 40, 10)
    blok->stmts = Volej calloc(10, 8)
    blok->stmt_count = 0

    aktualni_hloubka_bloku = aktualni_hloubka_bloku + 1
    aktualni_token_idx = aktualni_token_idx + 1

    token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (token->type != TOKEN_RBRACE && token->type != TOKEN_EOF) {
        Lokalni prikaz = Volej ParsePrikaz()
        Pokud (prikaz != 0) {
            Lokalni aktualni_kapacita = Volej CtiUkazatel(blok + 40)
            Pokud (blok->stmt_count >= aktualni_kapacita) {
                aktualni_kapacita = aktualni_kapacita * 2
                Volej ZapisUkazatel(blok + 40, aktualni_kapacita)
                blok->stmts = Volej realloc(blok->stmts, aktualni_kapacita * 8)
            }
            Lokalni adresa_v_poli = blok->stmts + (blok->stmt_count * 8)
            Volej ZapisUkazatel(adresa_v_poli, prikaz)
            blok->stmt_count = blok->stmt_count + 1
        }
        token = Volej ZiskejToken(aktualni_token_idx)
    }
    
    aktualni_token_idx = aktualni_token_idx + 1
    
    // OPRAVA: Symboly nesmažeme (generátor je bude potřebovat), jen je uspíme
    Lokalni i = pocet_symbolu - 1
    Dokud (i >= parse_sym_start) {
        Lokalni sym : Symbol = pamet_symbolu + (i * Velikost(Symbol))
        Pokud (sym->scope_depth == aktualni_hloubka_bloku) {
            sym->is_active = 0
        }
        i = i - 1
    }
    
    aktualni_hloubka_bloku = aktualni_hloubka_bloku - 1
    Vrat blok
}
Metoda ParsePrikaz() {
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Lokalni uzel : AST_Node = 0
    Lokalni str_token : Token = 0

    Pokud (token->type == 23) { // TOKEN_ASM
        uzel = Volej VytvorUzel(26, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        str_token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (str_token->type == 33) { Volej strncpy(uzel->name, str_token->value, 255) } Jinak { Volej strncpy(uzel->name, "nop", 255) }
        aktualni_token_idx = aktualni_token_idx + 1
        Vrat uzel
    }
    
    Pokud (token->type == 66) { uzel = Volej VytvorUzel(11, token->line); aktualni_token_idx = aktualni_token_idx + 1; uzel->left = Volej ParseVyraz(); Vrat uzel }
    Pokud (token->type == 54) { uzel = Volej VytvorUzel(22, token->line); aktualni_token_idx = aktualni_token_idx + 1; Vrat uzel }
    Pokud (token->type == 56) { uzel = Volej VytvorUzel(23, token->line); aktualni_token_idx = aktualni_token_idx + 1; Vrat uzel }
    Pokud (token->type == 92) { uzel = Volej VytvorUzel(31, token->line); aktualni_token_idx = aktualni_token_idx + 1; uzel->left = Volej ParseVyraz(); Vrat uzel }

    Pokud (token->type == 15) { // TOKEN_LOKALNI
        uzel = Volej VytvorUzel(3, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni nazev_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Volej strncpy(uzel->name, nazev_token->value, 255)
        aktualni_token_idx = aktualni_token_idx + 1

        Lokalni velikost_bajtu = 8
        Lokalni token_zavor : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (token_zavor->type == 38) { // LBRACKET
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni cislo_tok : Token = Volej ZiskejToken(aktualni_token_idx)
            velikost_bajtu = Volej atoi(cislo_tok->value) * 8
            aktualni_token_idx = aktualni_token_idx + 2
        }

        Lokalni dvojtecka : Token = Volej ZiskejToken(aktualni_token_idx)
        Lokalni typ_promenne = ""
        Pokud (dvojtecka->type == 57) { // COLON (OPRAVENO Z 58 NA 57)
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni typ_token : Token = Volej ZiskejToken(aktualni_token_idx)
            typ_promenne = typ_token->value
            aktualni_token_idx = aktualni_token_idx + 1
        }

        Lokalni eq_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (eq_token->type == 42) { // EQ
            aktualni_token_idx = aktualni_token_idx + 1
            uzel->right = Volej ParseVyraz()
        } Jinak {
            uzel->right = 0
        }

        Volej PridejLokalniSymbol(uzel->name, velikost_bajtu)
        
        Lokalni sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym != 0) {
            Pokud (Volej strcmp(typ_promenne, "") != 0) { 
                Volej strncpy(sym->type_name, typ_promenne, 63) 
            } Jinak Pokud (uzel->right != 0) {
                // --- OPRAVA: Okamzita typova inference pri parsovani! ---
                Lokalni odvozeny = Volej ZiskejTypUzlu(uzel->right)
                Pokud (Volej strcmp(odvozeny, "") != 0) {
                    Volej strncpy(sym->type_name, odvozeny, 63)
                }
            }
        }
        Vrat uzel
    }
    
    Pokud (token->type == 19) { uzel = Volej VytvorUzel(25, token->line); aktualni_token_idx = aktualni_token_idx + 1; uzel->left = Volej ParseVyraz(); Vrat uzel }

    Pokud (token->type == 35) { // IDENTIFIER
        Lokalni dalsi_token : Token = Volej ZiskejToken(aktualni_token_idx + 1)
        Pokud (dalsi_token->type == 42 || dalsi_token->type == 69 || dalsi_token->type == 70) {
            uzel = Volej VytvorUzel(4, token->line)
            uzel->op = dalsi_token->type
            Volej strncpy(uzel->name, token->value, 255)
            aktualni_token_idx = aktualni_token_idx + 2
            uzel->right = Volej ParseVyraz()
            
            // --- OPRAVA: Typova inference i pri prirazovani, pokud jeste nema typ ---
            Lokalni sym_as : Symbol = Volej NajdiSymbol(uzel->name)
            Pokud (sym_as != 0 && Volej strcmp(sym_as->type_name, "") == 0) {
                Lokalni odvozeny2 = Volej ZiskejTypUzlu(uzel->right)
                Pokud (Volej strcmp(odvozeny2, "") != 0) {
                    Volej strncpy(sym_as->type_name, odvozeny2, 63)
                }
            }
            Vrat uzel
        } Jinak Pokud (dalsi_token->type == 63) { // ARROW
            Lokalni vlastnost : Token = Volej ZiskejToken(aktualni_token_idx + 2)
            Lokalni treti_token : Token = Volej ZiskejToken(aktualni_token_idx + 3)
            
            Pokud (treti_token->type == 42) { // EQ
                uzel = Volej VytvorUzel(17, token->line)
                Volej strncpy(uzel->name, token->value, 255)
                Lokalni sym2 : Symbol = Volej NajdiSymbol(token->value)
                Pokud (sym2 != 0) { uzel->int_val = Volej ZiskejOffset(sym2->type_name, vlastnost->value) }
                aktualni_token_idx = aktualni_token_idx + 4
                uzel->right = Volej ParseVyraz()
                Vrat uzel
            } Jinak Pokud (treti_token->type == 38) { // LBRACKET
                uzel = Volej VytvorUzel(19, token->line)
                Volej strncpy(uzel->name, token->value, 255)
                Volej strncpy(uzel->sub_name, vlastnost->value, 63)
                Lokalni sym_arr : Symbol = Volej NajdiSymbol(token->value)
                Pokud (sym_arr != 0) { uzel->int_val = Volej ZiskejOffset(sym_arr->type_name, vlastnost->value) }
                aktualni_token_idx = aktualni_token_idx + 4
                uzel->left = Volej ParseVyraz()
                Lokalni po_idx : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (po_idx->type == 39) { aktualni_token_idx = aktualni_token_idx + 1 }
                Lokalni r_eq : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (r_eq->type == 42) { aktualni_token_idx = aktualni_token_idx + 1 }
                uzel->right = Volej ParseVyraz()
                Vrat uzel
            }
        } Jinak Pokud (dalsi_token->type == 38) { // LBRACKET
            uzel = Volej VytvorUzel(33, token->line)
            Volej strncpy(uzel->name, token->value, 255)
            aktualni_token_idx = aktualni_token_idx + 2
            uzel->left = Volej ParseVyraz()
            Lokalni po_idx2 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (po_idx2->type == 39) { aktualni_token_idx = aktualni_token_idx + 1 }
            Lokalni r_eq2 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (r_eq2->type == 42) { aktualni_token_idx = aktualni_token_idx + 1 }
            uzel->right = Volej ParseVyraz()
            Vrat uzel
        }
    }

    Pokud (token->type == 21) { // POKUD
        uzel = Volej VytvorUzel(6, token->line)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParseVyraz()
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni pb_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (pb_token->type == 36) { uzel->right = Volej ParseBlok() } Jinak { uzel->right = Volej ParsePrikaz() }
        Lokalni jinak_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (jinak_token->type == 22) { // JINAK
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni eb_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (eb_token->type == 36) { uzel->alt = Volej ParseBlok() } Jinak { uzel->alt = Volej ParsePrikaz() }
        }
        Vrat uzel
    }
    
    Pokud (token->type == 7) { // DOKUD
        uzel = Volej VytvorUzel(7, token->line)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParseVyraz()
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni db_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (db_token->type == 36) { uzel->right = Volej ParseBlok() } Jinak { uzel->right = Volej ParsePrikaz() }
        
        // PŘIDÁNO: Volání modulu pro O(1) optimalizaci cyklů
        Volej OptimalizujSCEV(uzel)
        
        Vrat uzel
    }

    Pokud (token->type == 8) { // OPAKUJ
        uzel = Volej VytvorUzel(8, token->line)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParsePrikaz()
        Lokalni carka1 : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (carka1->type == 51) { aktualni_token_idx = aktualni_token_idx + 1 }
        uzel->right = Volej ParseVyraz()
        Lokalni carka2 : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (carka2->type == 51) { aktualni_token_idx = aktualni_token_idx + 1 }
        uzel->alt = Volej ParsePrikaz()
        Lokalni rp_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (rp_token->type == 41) { aktualni_token_idx = aktualni_token_idx + 1 }
        Lokalni blok_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (blok_token->type == 36) {
            Lokalni telo1 = Volej ParseBlok()
            uzel->stmts = Volej calloc(1, 8)
            Volej ZapisUkazatel(uzel->stmts, telo1)
        } Jinak {
            Lokalni telo2 = Volej ParsePrikaz()
            uzel->stmts = Volej calloc(1, 8)
            Volej ZapisUkazatel(uzel->stmts, telo2)
        }
        
        // --- ZDE PŘIDEJ TENTO ŘÁDEK ---
        Volej OptimalizujRozbaleniOpakuj(uzel)
        // ------------------------------

        Vrat uzel
    }

    Pokud (token->type == 71) { // ROZCESTNIK
        uzel = Volej VytvorUzel(28, token->line)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParseVyraz()
        Lokalni rp : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (rp->type == 41) { aktualni_token_idx = aktualni_token_idx + 1 }
        Lokalni lb : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (lb->type == 36) { aktualni_token_idx = aktualni_token_idx + 1 }
        uzel->stmts = Volej calloc(500, 8)
        uzel->stmt_count = 0
        Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
        Dokud (t->type != 37 && t->type != 55) { // RBRACE / EOF
            Pokud (t->type == 72) { // CESTA
                Lokalni c_uzel : AST_Node = Volej VytvorUzel(29, t->line)
                aktualni_token_idx = aktualni_token_idx + 1
                c_uzel->left = Volej ParseVyraz()
                Lokalni col : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (col->type == 57) { aktualni_token_idx = aktualni_token_idx + 1 } // OPRAVENO Z 58 NA 57
                Lokalni akce_token : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (akce_token->type == 36) { c_uzel->right = Volej ParseBlok() } Jinak { c_uzel->right = Volej ParsePrikaz() }
                Pokud (uzel->stmt_count < 495) {
                    Lokalni adr = uzel->stmts + (uzel->stmt_count * 8)
                    Volej ZapisUkazatel(adr, c_uzel)
                    uzel->stmt_count = uzel->stmt_count + 1
                } Jinak { Volej printf("Kriticka chyba\n"); Volej exit(1) }
            } Jinak Pokud (t->type == 73) { // HLAVNI_CESTA
                aktualni_token_idx = aktualni_token_idx + 1
                Lokalni col2 : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (col2->type == 57) { aktualni_token_idx = aktualni_token_idx + 1 } // OPRAVENO Z 58 NA 57
                Lokalni akce_token2 : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (akce_token2->type == 36) { uzel->alt = Volej ParseBlok() } Jinak { uzel->alt = Volej ParsePrikaz() }
            } Jinak { aktualni_token_idx = aktualni_token_idx + 1 }
            t = Volej ZiskejToken(aktualni_token_idx)
        }
        aktualni_token_idx = aktualni_token_idx + 1
        Vrat uzel
    }

    Pokud (token->type == 5) { // VOLEJ
        uzel = Volej VytvorUzel(20, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni nazev_token_volej : Token = Volej ZiskejToken(aktualni_token_idx)
        Volej strncpy(uzel->name, nazev_token_volej->value, 255)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->stmts = Volej calloc(100, 8)
        uzel->stmt_count = 0
        Lokalni arg_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Dokud (arg_token->type != 41 && arg_token->type != 55) {
            Lokalni arg_vyraz = Volej ParseVyraz()
            Pokud (uzel->stmt_count < 95) {
                Lokalni addr_arg = uzel->stmts + (uzel->stmt_count * 8)
                Volej ZapisUkazatel(addr_arg, arg_vyraz)
                uzel->stmt_count = uzel->stmt_count + 1
            } Jinak { Volej printf("Kriticka chyba\n"); Volej exit(1) }
            arg_token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (arg_token->type == 51) { aktualni_token_idx = aktualni_token_idx + 1 }
            arg_token = Volej ZiskejToken(aktualni_token_idx)
        }
        aktualni_token_idx = aktualni_token_idx + 1
        Vrat uzel
    }
    
    aktualni_token_idx = aktualni_token_idx + 1
    Vrat Volej VytvorUzel(100, token->line)
}
Metoda ParseMetoda() {
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Pokud (token->type == TOKEN_METODA) {
        Lokalni uzel : AST_Node = Volej VytvorUzel(AST_METHOD, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        
        Lokalni nazev_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Volej printf("Parsuji metodu: %s\n", nazev_token->value)
        Volej strncpy(uzel->name, nazev_token->value, 255)
        aktualni_token_idx = aktualni_token_idx + 2
        
        Volej ZkontrolujKapacituSymbolu()
        Lokalni met_sym : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
        Volej strncpy(met_sym->name, nazev_token->value, 255)
        met_sym->is_global = 1
        met_sym->is_function = 1
        met_sym->is_active = 1
        met_sym->func_node = uzel
        pocet_symbolu = pocet_symbolu + 1
        Volej ZaregistrujDoHashe(pocet_symbolu - 1)
        
        current_local_offset = 0
        Lokalni arg_idx = 0
        uzel->sym_start = pocet_symbolu
        parse_sym_start = pocet_symbolu
        Lokalni arg_token : Token = Volej ZiskejToken(aktualni_token_idx)
        
        Dokud (arg_token->type != TOKEN_RPAREN && arg_token->type != TOKEN_EOF) {
            Pokud (arg_token->type == TOKEN_IDENTIFIER) {
                Volej ZkontrolujKapacituSymbolu()
                Lokalni novy_param : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
                Volej strncpy(novy_param->name, arg_token->value, 255)
                novy_param->is_global = 0
                novy_param->is_const = 0
                novy_param->offset = 0 - ((arg_idx + 2) * 8)
                novy_param->scope_depth = 0
                novy_param->is_active = 1
                
                pocet_symbolu = pocet_symbolu + 1
                Volej ZaregistrujDoHashe(pocet_symbolu - 1)
                
                arg_idx = arg_idx + 1
                aktualni_token_idx = aktualni_token_idx + 1
                Lokalni dvojtecka_token : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (dvojtecka_token->type == TOKEN_COLON) {
                    aktualni_token_idx = aktualni_token_idx + 1
                    Lokalni typ_token : Token = Volej ZiskejToken(aktualni_token_idx)
                    Pokud (typ_token->type == TOKEN_IDENTIFIER) {
                        Volej strncpy(novy_param->type_name, typ_token->value, 63)
                        aktualni_token_idx = aktualni_token_idx + 1
                    }
                }
            }
            Lokalni carka_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (carka_token->type == TOKEN_COMMA) { aktualni_token_idx = aktualni_token_idx + 1 }
            arg_token = Volej ZiskejToken(aktualni_token_idx)
        }
        aktualni_token_idx = aktualni_token_idx + 1
        
        Lokalni navr_dvojtecka : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (navr_dvojtecka->type == TOKEN_COLON) {
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni navr_typ_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (navr_typ_token->type == TOKEN_IDENTIFIER) {
                Volej strncpy(uzel->type_name, navr_typ_token->value, 63)
                aktualni_token_idx = aktualni_token_idx + 1
            }
        }
        
        uzel->arg_count = arg_idx
        uzel->right = Volej ParseBlok()
        uzel->int_val = current_local_offset
        uzel->sym_end = pocet_symbolu
        Vrat uzel
    }
    Vrat 0
}

Metoda Parser() {
    Volej printf("Parser: Sestavuji AST...\n")
    Lokalni koren : AST_Node = Volej VytvorUzel(AST_PROGRAM, 1)
    koren->stmts = Volej calloc(5000, 8)
    koren->stmt_count = 0
    aktualni_token_idx = 0
    
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (token->type != TOKEN_EOF && aktualni_token_idx < pocet_tokenu) {
        Volej printf("  top-level radek %d typ %d\n", token->line, token->type)

        Pokud (token->type == TOKEN_EXTERNI) {
            Lokalni ext_uzel : AST_Node = Volej VytvorUzel(AST_EXTERN_DECL, token->line)
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni ext_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            Volej strncpy(ext_uzel->name, ext_nazev->value, 255)
            Volej PridejExterniJmeno(ext_nazev->value)
            aktualni_token_idx = aktualni_token_idx + 1
            
            Pokud (koren->stmt_count < 4995) {
                Lokalni adresa_v_poli = koren->stmts + (koren->stmt_count * 8)
                Volej ZapisUkazatel(adresa_v_poli, ext_uzel)
                koren->stmt_count = koren->stmt_count + 1
            } Jinak {
                Volej printf("Kriticka chyba: prekrocen maximalni pocet prikazu na nejvyssi urovni (5000)!\n")
                Volej exit(1)
            }
        } Jinak Pokud (token->type == TOKEN_GLOBALNI) {
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni glob_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            aktualni_token_idx = aktualni_token_idx + 1
            
            Lokalni eq_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Lokalni init_hodnota = 0
            Pokud (eq_token->type == TOKEN_EQ) {
                aktualni_token_idx = aktualni_token_idx + 1
                Lokalni init_vyraz : AST_Node = Volej ParseVyraz()
                init_hodnota = Volej VyhodnotKonstantu(init_vyraz)
            }
            Volej PridejGlobalniSymbol(glob_nazev->value, init_hodnota)
        } Jinak Pokud (token->type == TOKEN_KONSTANTA) {
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni konst_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            aktualni_token_idx = aktualni_token_idx + 2
            Lokalni konst_hodnota : Token = Volej ZiskejToken(aktualni_token_idx)
            Lokalni konst_cislo = Volej atoi(konst_hodnota->value)
            Volej PridejKonstantu(konst_nazev->value, konst_cislo)
            aktualni_token_idx = aktualni_token_idx + 1
        } Jinak Pokud (token->type == TOKEN_STRUKTURA) {
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni struktura_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            aktualni_token_idx = aktualni_token_idx + 2
            Lokalni akt_offset = 0
            
            Lokalni s_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Dokud (s_token->type != TOKEN_RBRACE && s_token->type != TOKEN_EOF) {
                Lokalni arr_size = 1
                Lokalni dalsi_s : Token = Volej ZiskejToken(aktualni_token_idx + 1)
                Pokud (dalsi_s->type == TOKEN_LBRACKET) {
                    Lokalni cislo_tok : Token = Volej ZiskejToken(aktualni_token_idx + 2)
                    arr_size = Volej atoi(cislo_tok->value)
                    aktualni_token_idx = aktualni_token_idx + 3
                }
                
                Volej PridejClenaStruktury(struktura_nazev->value, s_token->value, akt_offset)
                akt_offset = akt_offset + (arr_size * 8)
                
                aktualni_token_idx = aktualni_token_idx + 1
                s_token = Volej ZiskejToken(aktualni_token_idx)
            }
            Volej ZaregistrujStrukturu(struktura_nazev->value, akt_offset)
            aktualni_token_idx = aktualni_token_idx + 1
        } Jinak Pokud (token->type == TOKEN_SKUPINA) {
            aktualni_token_idx = aktualni_token_idx + 1
            
            Lokalni skupina_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (skupina_nazev->type == TOKEN_IDENTIFIER) {
                aktualni_token_idx = aktualni_token_idx + 1
            }
            
            Lokalni lb_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (lb_token->type == TOKEN_LBRACE) {
                aktualni_token_idx = aktualni_token_idx + 1
            }
            
            Lokalni hodnota_skupiny = 0
            Lokalni v_token : Token = Volej ZiskejToken(aktualni_token_idx)
            
            Dokud (v_token->type != TOKEN_RBRACE && v_token->type != TOKEN_EOF) {
                Pokud (v_token->type == TOKEN_IDENTIFIER) {
                    Lokalni jmeno_konstanty = v_token->value
                    aktualni_token_idx = aktualni_token_idx + 1
                    
                    Lokalni dalsi_tok : Token = Volej ZiskejToken(aktualni_token_idx)
                    Pokud (dalsi_tok->type == TOKEN_EQ) {
                        aktualni_token_idx = aktualni_token_idx + 1
                        // OPRAVA: Přejmenování proměnné na cislo_tok2
                        Lokalni cislo_tok2 : Token = Volej ZiskejToken(aktualni_token_idx)
                        Pokud (cislo_tok2->type == TOKEN_NUMBER) {
                            hodnota_skupiny = Volej atoi(cislo_tok2->value)
                            aktualni_token_idx = aktualni_token_idx + 1
                        }
                    }
                    
                    Volej PridejKonstantu(jmeno_konstanty, hodnota_skupiny)
                    hodnota_skupiny = hodnota_skupiny + 1
                    
                } Jinak {
                    aktualni_token_idx = aktualni_token_idx + 1
                }
                v_token = Volej ZiskejToken(aktualni_token_idx)
            }
            aktualni_token_idx = aktualni_token_idx + 1
        } Jinak {
            Lokalni metoda = Volej ParseMetoda()
            Pokud (metoda != 0) {
                Pokud (koren->stmt_count < 4995) {
                    Lokalni adresa_metody = koren->stmts + (koren->stmt_count * 8)
                    Volej ZapisUkazatel(adresa_metody, metoda)
                    koren->stmt_count = koren->stmt_count + 1
                } Jinak {
                    Volej printf("Kriticka chyba: prekrocen maximalni pocet prikazu na nejvyssi urovni (5000)!\n")
                    Volej exit(1)
                }
            } Jinak {
                aktualni_token_idx = aktualni_token_idx + 1
            }
        }
        token = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat koren
}

// ==========================================
// GENERATOR ASM (Logika překladu)
// ==========================================
Metoda GenerujVyraz(out, uzel : AST_Node) {
    Pokud (uzel == 0) Vrat 0
    Pokud (uzel->type == 100) Vrat 0

    pocet_ir = 0
    pocet_intervalu = 0
    citac_temp_reg = 1
    
    Lokalni ir_vysledek = Volej GenerujIR_Vyraz(uzel)
    Pokud (ir_vysledek != 0) {
        Lokalni vys_int : LiveInterval = pamet_intervalu + ((ir_vysledek - 1) * Velikost(LiveInterval))
        vys_int->end_instr = pocet_ir

        Volej ProvedLinearScan()
        Volej OptimalizujMrtvyKod()
        Volej PrelozIRDoASM(out, ir_vysledek)
        Vrat 0 
    }

    // Nacteni desetinneho cisla
    Pokud (uzel->op == 98) { Volej fprintf(out, "    mov rax, qword [rel flt%d]\n", uzel->int_val); Vrat 0 }

    Pokud (uzel->op == TOKEN_STRING) { Volej fprintf(out, "    lea rax, [rel str%d]\n", uzel->int_val); Vrat 0 }
    Pokud (uzel->op == TOKEN_NUMBER) { Volej fprintf(out, "    mov rax, %s\n", uzel->name); Vrat 0 }
    
    Pokud (uzel->op == TOKEN_CTI_ADRESU) {
        Volej GenerujVyraz(out, uzel->left)
        Volej fputs("    mov rax, [rax]\n", out)
        Vrat 0
    }

    Pokud (uzel->type == AST_ALLOC) {
        Volej GenerujVyraz(out, uzel->left)
        Pokud (cilova_platforma == CIL_WINDOWS) { Volej fputs("    mov rcx, rax\n", out) }
        Jinak { Volej fputs("    mov rdi, rax\n", out) }
        Volej fputs("    sub rsp, 32\n", out)
        Pokud (cilova_platforma == CIL_APPLE) { Volej fputs("    call _malloc\n", out) }
        Jinak { Volej fputs("    call malloc\n", out) }
        Volej fputs("    add rsp, 32\n", out)
        Vrat 0
    }

    Pokud (uzel->type == AST_CALL) {
        Lokalni navic = uzel->stmt_count - 4
        Lokalni padding = 0
        Pokud (navic > 0) {
            Lokalni lychy = navic - ((navic / 2) * 2)
            Pokud (lychy != 0) { padding = 8; Volej fputs("    sub rsp, 8\n", out) }
        }

        Lokalni arg_idx = uzel->stmt_count - 1
        Dokud (arg_idx >= 0) {
            Lokalni addr_call = uzel->stmts + (arg_idx * 8)
            Lokalni arg_node : AST_Node = Volej CtiUkazatel(addr_call)
            Pokud (arg_node != 0 && arg_node->type != 100) { Volej GenerujVyraz(out, arg_node) }
            Volej fputs("    push rax\n", out)
            arg_idx = arg_idx - 1
        }
        
        Pokud (cilova_platforma == CIL_WINDOWS) {
            Pokud (uzel->stmt_count > 0) { Volej fputs("    pop rcx\n    movq xmm0, rcx\n", out) }
            Pokud (uzel->stmt_count > 1) { Volej fputs("    pop rdx\n    movq xmm1, rdx\n", out) }
            Pokud (uzel->stmt_count > 2) { Volej fputs("    pop r8\n    movq xmm2, r8\n", out) }
            Pokud (uzel->stmt_count > 3) { Volej fputs("    pop r9\n    movq xmm3, r9\n", out) }
        } Jinak {
            Pokud (uzel->stmt_count > 0) { Volej fputs("    pop rdi\n    movq xmm0, rdi\n", out) }
            Pokud (uzel->stmt_count > 1) { Volej fputs("    pop rsi\n    movq xmm0, rsi\n", out) }
            Pokud (uzel->stmt_count > 2) { Volej fputs("    pop rdx\n    movq xmm1, rdx\n", out) }
            Pokud (uzel->stmt_count > 3) { Volej fputs("    pop rcx\n    movq xmm2, rcx\n", out) }
        }
        
        Lokalni nazev_volani = uzel->name
        Pokud (cilova_platforma == CIL_APPLE && Volej JeExterniJmeno(uzel->name) == 1) { nazev_volani = Volej NazevSymbolu(uzel->name) }
        
        Volej fputs("    mov eax, 4\n", out)
        Volej fputs("    sub rsp, 32\n", out)
        Volej fprintf(out, "    call %s\n", nazev_volani)
        Volej fputs("    add rsp, 32\n", out)

        Lokalni k_smazani = padding
        Pokud (navic > 0) { k_smazani = k_smazani + (navic * 8) }
        Pokud (k_smazani > 0) { Volej fprintf(out, "    add rsp, %d\n", k_smazani) }
        Vrat 0
    }

    Pokud (uzel->type == AST_ARRAY_READ) { Lokalni sym_arr_rd : Symbol = Volej NajdiSymbol(uzel->name); Pokud (sym_arr_rd != 0) { Volej GenerujVyraz(out, uzel->left); Volej fputs("    push rax\n", out); Pokud (sym_arr_rd->is_global) { Volej fprintf(out, "    mov rax, qword [rel gvar_%s]\n", sym_arr_rd->name) } Jinak { Pokud (sym_arr_rd->offset < 0) { Lokalni k_arr = 0 - sym_arr_rd->offset; Volej fprintf(out, "    mov rax, qword [rbp + %d]\n", k_arr) } Jinak { Volej fprintf(out, "    mov rax, qword [rbp - %d]\n", sym_arr_rd->offset) } }; Pokud (uzel->int_val != 0) { Volej fprintf(out, "    add rax, %d\n", uzel->int_val) }; Volej fputs("    pop rbx\n", out); Lokalni je_byte_pole = 0; Pokud (Volej strcmp(uzel->sub_name, "value") == 0) { je_byte_pole = 1 }; Pokud (Volej strcmp(uzel->sub_name, "name") == 0) { je_byte_pole = 1 }; Pokud (Volej strcmp(uzel->sub_name, "sub_name") == 0) { je_byte_pole = 1 }; Pokud (Volej strcmp(uzel->sub_name, "init_str") == 0) { je_byte_pole = 1 }; Pokud (Volej strcmp(uzel->sub_name, "type_name") == 0) { je_byte_pole = 1 }; Pokud (Volej strcmp(uzel->sub_name, "struct_name") == 0) { je_byte_pole = 1 }; Pokud (Volej strcmp(uzel->sub_name, "member_name") == 0) { je_byte_pole = 1 }; Pokud (je_byte_pole == 1) { Volej fputs("    add rax, rbx\n    movzx rax, byte [rax]\n", out) } Jinak { Volej fputs("    imul rbx, 8\n    add rax, rbx\n    mov rax, qword [rax]\n", out) } }; Vrat 0 }
    Pokud (uzel->type == AST_LOCAL_ARRAY_READ) { Lokalni sym_loc : Symbol = Volej NajdiSymbol(uzel->name); Pokud (sym_loc != 0) { Volej GenerujVyraz(out, uzel->left); Volej fputs("    imul rax, 8\n    push rbx\n", out); Pokud (sym_loc->is_global) { Volej fprintf(out, "    mov rbx, qword [rel gvar_%s]\n", sym_loc->name) } Jinak { Pokud (sym_loc->offset < 0) { Lokalni k_loc = 0 - sym_loc->offset; Volej fprintf(out, "    mov rbx, qword [rbp + %d]\n", k_loc) } Jinak { Volej fprintf(out, "    mov rbx, qword [rbp - %d]\n", sym_loc->offset) } }; Volej fputs("    add rax, rbx\n    mov rax, qword [rax]\n    pop rbx\n", out) }; Vrat 0 }
    Pokud (uzel->type == AST_PTR_MEMBER_READ) { Lokalni sym_ptr : Symbol = Volej NajdiSymbol(uzel->name); Pokud (sym_ptr != 0) { Pokud (sym_ptr->is_global) { Volej fprintf(out, "    mov rax, qword [rel gvar_%s]\n", sym_ptr->name) } Jinak { Pokud (sym_ptr->offset < 0) { Lokalni k = 0 - sym_ptr->offset; Volej fprintf(out, "    mov rax, qword [rbp + %d]\n", k) } Jinak { Volej fprintf(out, "    mov rax, qword [rbp - %d]\n", sym_ptr->offset) } }; Lokalni je_pole = 0; Pokud (Volej strcmp(uzel->sub_name, "value") == 0) je_pole = 1; Pokud (Volej strcmp(uzel->sub_name, "name") == 0) je_pole = 1; Pokud (Volej strcmp(uzel->sub_name, "sub_name") == 0) je_pole = 1; Pokud (Volej strcmp(uzel->sub_name, "init_str") == 0) je_pole = 1; Pokud (Volej strcmp(uzel->sub_name, "type_name") == 0) je_pole = 1; Pokud (Volej strcmp(uzel->sub_name, "struct_name") == 0) je_pole = 1; Pokud (Volej strcmp(uzel->sub_name, "member_name") == 0) je_pole = 1; Pokud (je_pole) { Pokud (uzel->int_val != 0) { Volej fprintf(out, "    add rax, %d\n", uzel->int_val) } } Jinak { Pokud (uzel->int_val == 0) { Volej fputs("    mov rax, [rax]\n", out) } Jinak { Volej fprintf(out, "    mov rax, [rax + %d]\n", uzel->int_val) } } }; Vrat 0 }
    Pokud (uzel->op == TOKEN_IDENTIFIER) { Lokalni sym_id : Symbol = Volej NajdiSymbol(uzel->name); Pokud (sym_id != 0) { Pokud (sym_id->is_const) { Volej fprintf(out, "    mov rax, %d\n", sym_id->const_val) } Jinak Pokud (sym_id->is_global) { Volej fprintf(out, "    mov rax, qword [rel gvar_%s]\n", sym_id->name) } Jinak { Pokud (sym_id->offset < 0) { Lokalni kladny = 0 - sym_id->offset; Volej fprintf(out, "    mov rax, qword [rbp + %d]\n", kladny) } Jinak { Volej fprintf(out, "    mov rax, qword [rbp - %d]\n", sym_id->offset) } } } Jinak { Volej printf("Chyba: Nedeklarovana promenna '%s'\n", uzel->name); Volej exit(1) }; Vrat 0 }
    Pokud (uzel->op == TOKEN_MINUS && uzel->left != 0 && uzel->right == 0) { Volej GenerujVyraz(out, uzel->left); Volej fputs("    neg rax\n", out); Vrat 0 }
    Pokud (uzel->op == TOKEN_NOT && uzel->left != 0) { Volej GenerujVyraz(out, uzel->left); Volej fputs("    cmp rax, 0\n    sete al\n    movzx rax, al\n", out); Vrat 0 }

    Pokud (uzel->op == TOKEN_AND) { Lokalni lbl_and = citac_navesti; citac_navesti = citac_navesti + 1; Volej GenerujVyraz(out, uzel->left); Volej fputs("    cmp rax, 0\n", out); Volej fprintf(out, "    je .L_false_%d\n", lbl_and); Volej GenerujVyraz(out, uzel->right); Volej fputs("    cmp rax, 0\n", out); Volej fprintf(out, "    je .L_false_%d\n", lbl_and); Volej fputs("    mov rax, 1\n", out); Volej fprintf(out, "    jmp .L_end_%d\n", lbl_and); Volej fprintf(out, ".L_false_%d:\n", lbl_and); Volej fputs("    mov rax, 0\n", out); Volej fprintf(out, ".L_end_%d:\n", lbl_and); Vrat 0 }
    Pokud (uzel->op == TOKEN_OR) { Lokalni lbl_or = citac_navesti; citac_navesti = citac_navesti + 1; Volej GenerujVyraz(out, uzel->left); Volej fputs("    cmp rax, 0\n", out); Volej fprintf(out, "    jne .L_true_%d\n", lbl_or); Volej GenerujVyraz(out, uzel->right); Volej fputs("    cmp rax, 0\n", out); Volej fprintf(out, "    jne .L_true_%d\n", lbl_or); Volej fputs("    mov rax, 0\n", out); Volej fprintf(out, "    jmp .L_end_%d\n", lbl_or); Volej fprintf(out, ".L_true_%d:\n", lbl_or); Volej fputs("    mov rax, 1\n", out); Volej fprintf(out, ".L_end_%d:\n", lbl_or); Vrat 0 }

    // Matematika 
    Pokud (uzel->op == TOKEN_PLUS || uzel->op == TOKEN_MINUS || uzel->op == TOKEN_MUL || uzel->op == TOKEN_DIV || uzel->op == TOKEN_MOD || uzel->op == TOKEN_EQEQ || uzel->op == TOKEN_NEQ || uzel->op == TOKEN_LESS || uzel->op == TOKEN_GREATER || uzel->op == TOKEN_LESSEQ || uzel->op == TOKEN_GREATEREQ || uzel->op == TOKEN_AMPER || uzel->op == TOKEN_PIPE || uzel->op == TOKEN_CARET || uzel->op == TOKEN_SHL || uzel->op == TOKEN_SHR) {
        
        Lokalni je_float = 0
        Lokalni lt = Volej ZiskejTypUzlu(uzel->left)
        Lokalni rt = Volej ZiskejTypUzlu(uzel->right)
        Pokud (Volej strcmp(lt, "Float") == 0 || Volej strcmp(rt, "Float") == 0) { je_float = 1 }

        Lokalni prava_strana_je_cislo = 0
        Lokalni pravy_uzel_fast : AST_Node = uzel->right
        Pokud (pravy_uzel_fast != 0) { Pokud (pravy_uzel_fast->op == TOKEN_NUMBER && je_float == 0) { prava_strana_je_cislo = 1 } }

        Pokud (prava_strana_je_cislo == 1) {
            Volej GenerujVyraz(out, uzel->left)
            Lokalni cis = pravy_uzel_fast->name
            Pokud (uzel->op == TOKEN_PLUS) Volej fprintf(out, "    add rax, %s\n", cis)
            Pokud (uzel->op == TOKEN_MINUS) Volej fprintf(out, "    sub rax, %s\n", cis)
            Pokud (uzel->op == TOKEN_MUL) { Volej fprintf(out, "    mov rbx, %s\n    imul rax, rbx\n", cis) }
            Pokud (uzel->op == TOKEN_DIV) { Volej fprintf(out, "    mov rbx, %s\n    cqo\n    idiv rbx\n", cis) }
            Pokud (uzel->op == TOKEN_MOD) { Volej fprintf(out, "    mov rbx, %s\n    cqo\n    idiv rbx\n    mov rax, rdx\n", cis) }
            Pokud (uzel->op == TOKEN_EQEQ) { Volej fprintf(out, "    cmp rax, %s\n    sete al\n    movzx rax, al\n", cis) }
            Pokud (uzel->op == TOKEN_NEQ) { Volej fprintf(out, "    cmp rax, %s\n    setne al\n    movzx rax, al\n", cis) }
            Pokud (uzel->op == TOKEN_LESS) { Volej fprintf(out, "    cmp rax, %s\n    setl al\n    movzx rax, al\n", cis) }
            Pokud (uzel->op == TOKEN_GREATER) { Volej fprintf(out, "    cmp rax, %s\n    setg al\n    movzx rax, al\n", cis) }
            Pokud (uzel->op == TOKEN_LESSEQ) { Volej fprintf(out, "    cmp rax, %s\n    setle al\n    movzx rax, al\n", cis) }
            Pokud (uzel->op == TOKEN_GREATEREQ) { Volej fprintf(out, "    cmp rax, %s\n    setge al\n    movzx rax, al\n", cis) }
            Pokud (uzel->op == TOKEN_AMPER) { Volej fprintf(out, "    and rax, %s\n", cis) }
            Pokud (uzel->op == TOKEN_PIPE) { Volej fprintf(out, "    or rax, %s\n", cis) }
            Pokud (uzel->op == TOKEN_CARET) { Volej fprintf(out, "    xor rax, %s\n", cis) }
            Pokud (uzel->op == TOKEN_SHL) { Volej fprintf(out, "    mov rcx, %s\n    shl rax, cl\n", cis) }
            Pokud (uzel->op == TOKEN_SHR) { Volej fprintf(out, "    mov rcx, %s\n    sar rax, cl\n", cis) }
        } Jinak {
            Volej GenerujVyraz(out, uzel->left)
            Volej fputs("    push rax\n", out)
            
            Volej GenerujVyraz(out, uzel->right)
            Volej fputs("    mov rbx, rax\n", out)
            Volej fputs("    pop rax\n", out)
            
            Pokud (je_float == 1) {
                // --- OPRAVA: movq se vykona pouze pro operace, ktere vraci opet Float ---
                Volej fputs("    movq xmm0, rax\n    movq xmm1, rbx\n", out)
                Pokud (uzel->op == TOKEN_PLUS) { Volej fputs("    addsd xmm0, xmm1\n    movq rax, xmm0\n", out) }
                Jinak Pokud (uzel->op == TOKEN_MINUS) { Volej fputs("    subsd xmm0, xmm1\n    movq rax, xmm0\n", out) }
                Jinak Pokud (uzel->op == TOKEN_MUL) { Volej fputs("    mulsd xmm0, xmm1\n    movq rax, xmm0\n", out) }
                Jinak Pokud (uzel->op == TOKEN_DIV) { Volej fputs("    divsd xmm0, xmm1\n    movq rax, xmm0\n", out) }
                Jinak Pokud (uzel->op == TOKEN_EQEQ) { Volej fputs("    ucomisd xmm0, xmm1\n    sete al\n    movzx rax, al\n", out) }
                Jinak Pokud (uzel->op == TOKEN_NEQ) { Volej fputs("    ucomisd xmm0, xmm1\n    setne al\n    movzx rax, al\n", out) }
                Jinak Pokud (uzel->op == TOKEN_LESS) { Volej fputs("    ucomisd xmm0, xmm1\n    setb al\n    movzx rax, al\n", out) }
                Jinak Pokud (uzel->op == TOKEN_GREATER) { Volej fputs("    ucomisd xmm0, xmm1\n    seta al\n    movzx rax, al\n", out) }
                Jinak Pokud (uzel->op == TOKEN_LESSEQ) { Volej fputs("    ucomisd xmm0, xmm1\n    setbe al\n    movzx rax, al\n", out) }
                Jinak Pokud (uzel->op == TOKEN_GREATEREQ) { Volej fputs("    ucomisd xmm0, xmm1\n    setae al\n    movzx rax, al\n", out) }
            } Jinak {
                Pokud (uzel->op == TOKEN_PLUS) Volej fputs("    add rax, rbx\n", out)
                Pokud (uzel->op == TOKEN_MINUS) Volej fputs("    sub rax, rbx\n", out)
                Pokud (uzel->op == TOKEN_MUL) Volej fputs("    imul rax, rbx\n", out)
                Pokud (uzel->op == TOKEN_DIV) Volej fputs("    cqo\n    idiv rbx\n", out)
                Pokud (uzel->op == TOKEN_MOD) Volej fputs("    cqo\n    idiv rbx\n    mov rax, rdx\n", out)
                Pokud (uzel->op == TOKEN_EQEQ) { Volej fputs("    cmp rax, rbx\n    sete al\n    movzx rax, al\n", out) }
                Pokud (uzel->op == TOKEN_NEQ) { Volej fputs("    cmp rax, rbx\n    setne al\n    movzx rax, al\n", out) }
                Pokud (uzel->op == TOKEN_LESS) { Volej fputs("    cmp rax, rbx\n    setl al\n    movzx rax, al\n", out) }
                Pokud (uzel->op == TOKEN_GREATER) { Volej fputs("    cmp rax, rbx\n    setg al\n    movzx rax, al\n", out) }
                Pokud (uzel->op == TOKEN_LESSEQ) { Volej fputs("    cmp rax, rbx\n    setle al\n    movzx rax, al\n", out) }
                Pokud (uzel->op == TOKEN_GREATEREQ) { Volej fputs("    cmp rax, rbx\n    setge al\n    movzx rax, al\n", out) }
                Pokud (uzel->op == TOKEN_AMPER) { Volej fputs("    and rax, rbx\n", out) }
                Pokud (uzel->op == TOKEN_PIPE) { Volej fputs("    or rax, rbx\n", out) }
                Pokud (uzel->op == TOKEN_CARET) { Volej fputs("    xor rax, rbx\n", out) }
                Pokud (uzel->op == TOKEN_SHL) { Volej fputs("    mov rcx, rbx\n    shl rax, cl\n", out) }
                Pokud (uzel->op == TOKEN_SHR) { Volej fputs("    mov rcx, rbx\n    sar rax, cl\n", out) }
            }
        }
    }

    Pokud (uzel->op == 95 || uzel->op == 96 || uzel->op == 97) {
        Volej GenerujVyraz(out, uzel->right)
        Volej fputs("    push rax\n", out)
        Volej fputs("    sub rsp, 8\n", out)
        Volej GenerujVyraz(out, uzel->left)
        Volej fputs("    add rsp, 8\n", out)
        Volej fputs("    pop rbx\n", out)
        
        Pokud (uzel->op == 95) {
            Volej fputs("    push rbx\n", out)
            Volej fputs("    push rax\n", out)
            
            Pokud (cilova_platforma == CIL_WINDOWS) { Volej fputs("    mov rcx, 1024\n", out) }
            Jinak { Volej fputs("    mov rdi, 1024\n", out) }
            Volej fputs("    sub rsp, 32\n", out)
            Pokud (cilova_platforma == CIL_APPLE) { Volej fputs("    call _malloc\n", out) }
            Jinak { Volej fputs("    call malloc\n", out) }
            Volej fputs("    add rsp, 32\n", out)
            
            Volej fputs("    push rax\n", out)
            Volej fputs("    mov r8, [rsp+8]\n", out)
            Volej fputs("    mov r9, [rsp+16]\n", out)
            
            Pokud (cilova_platforma == CIL_WINDOWS) {
                Volej fputs("    mov rcx, rax\n", out)
                Volej fputs("    lea rdx, [rel fmt_str_concat]\n", out)
            } Jinak {
                Volej fputs("    mov rdi, rax\n", out)
                Volej fputs("    lea rsi, [rel fmt_str_concat]\n", out)
                Volej fputs("    mov rdx, r8\n", out)
                Volej fputs("    mov rcx, r9\n", out)
                Volej fputs("    mov eax, 0\n", out)
            }
            Volej fputs("    sub rsp, 32\n", out)
            Pokud (cilova_platforma == CIL_APPLE) { Volej fputs("    call _sprintf\n", out) }
            Jinak { Volej fputs("    call sprintf\n", out) }
            Volej fputs("    add rsp, 32\n", out)
            
            Volej fputs("    pop rax\n", out)
            Volej fputs("    add rsp, 16\n", out)
            
        } Jinak Pokud (uzel->op == 96 || uzel->op == 97) {
            Pokud (cilova_platforma == CIL_WINDOWS) {
                Volej fputs("    mov rcx, rax\n", out)
                Volej fputs("    mov rdx, rbx\n", out)
            } Jinak {
                Volej fputs("    mov rdi, rax\n", out)
                Volej fputs("    mov rsi, rbx\n", out)
            }
            Volej fputs("    sub rsp, 32\n", out)
            Pokud (cilova_platforma == CIL_APPLE) { Volej fputs("    call _strcmp\n", out) }
            Jinak { Volej fputs("    call strcmp\n", out) }
            Volej fputs("    add rsp, 32\n", out)
            
            Pokud (uzel->op == 96) {
                Volej fputs("    cmp rax, 0\n    sete al\n    movzx rax, al\n", out)
            } Jinak {
                Volej fputs("    cmp rax, 0\n    setne al\n    movzx rax, al\n", out)
            }
        }
    }
    Vrat 0
}
Metoda GenerujAST(out, uzel : AST_Node) {
    Pokud (uzel == 0) Vrat 0
    Pokud (uzel->type == 100) Vrat 0

    Pokud (uzel->type == AST_PROGRAM) {
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Lokalni adresa_v_poli_prog = uzel->stmts + (i * 8)
            Lokalni pod_uzel_prog = Volej CtiUkazatel(adresa_v_poli_prog)
            Volej GenerujAST(out, pod_uzel_prog)
            i = i + 1
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_ASM_NODE) { Volej fprintf(out, "    %s\n", uzel->name); Vrat 0 }

    Pokud (uzel->type == AST_METHOD) {
        Pokud (Volej strcmp(uzel->name, "") == 0) {
            Volej fputs("anonymni_funkce:\n", out)
        } Jinak {
            Volej fprintf(out, "%s:\n", uzel->name)
        }
        
        Volej fputs("    push rbp\n    mov rbp, rsp\n", out)
        Pokud (cilova_platforma == CIL_WINDOWS) {
            Volej fputs("    mov [rbp+16], rcx\n    mov [rbp+24], rdx\n    mov [rbp+32], r8\n    mov [rbp+40], r9\n", out)
        } Jinak {
            Volej fputs("    mov [rbp+16], rdi\n    mov [rbp+24], rsi\n    mov [rbp+32], rdx\n    mov [rbp+40], rcx\n", out)
        }
        
        Lokalni zarovnani = uzel->int_val + 15
        Lokalni zbytek = zarovnani
        Dokud (zbytek > 15) { zbytek = zbytek - 16 }
        zarovnani = zarovnani - zbytek
        Volej fprintf(out, "    sub rsp, %d\n", zarovnani)
        
        Volej fputs("    push r12\n    push r13\n    push r14\n    push r15\n", out)
        
        codegen_sym_start = uzel->sym_start
        codegen_sym_end = uzel->sym_end
        codegen_scoped = 1
        Volej GenerujAST(out, uzel->right)
        codegen_scoped = 0
        
        Volej fputs("    pop r15\n    pop r14\n    pop r13\n    pop r12\n", out)
        
        Volej fputs("    mov rsp, rbp\n    pop rbp\n    ret\n\n", out)
        Vrat 0
    }
    
    Pokud (uzel->type == AST_ARRAY_ASSIGN) {
        Lokalni sym_arr_as : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_arr_as != 0) {
            Volej GenerujVyraz(out, uzel->right)
            Volej fputs("    push rax\n", out)
            
            Volej GenerujVyraz(out, uzel->left)
            Volej fputs("    push rax\n", out)
            
            Pokud (sym_arr_as->is_global) { Volej fprintf(out, "    mov rbx, qword [rel gvar_%s]\n", sym_arr_as->name) }
            Jinak { Volej fprintf(out, "    mov rbx, qword [rbp - %d]\n", sym_arr_as->offset) }
            
            Pokud (uzel->int_val != 0) { Volej fprintf(out, "    add rbx, %d\n", uzel->int_val) }
            
            Volej fputs("    pop rcx\n", out)
            
            Lokalni je_byte_pole_as = 0
            Pokud (Volej strcmp(uzel->sub_name, "value") == 0) { je_byte_pole_as = 1 }
            Pokud (Volej strcmp(uzel->sub_name, "name") == 0) { je_byte_pole_as = 1 }
            Pokud (Volej strcmp(uzel->sub_name, "sub_name") == 0) { je_byte_pole_as = 1 }
            Pokud (Volej strcmp(uzel->sub_name, "init_str") == 0) { je_byte_pole_as = 1 }
            Pokud (Volej strcmp(uzel->sub_name, "type_name") == 0) { je_byte_pole_as = 1 }
            Pokud (Volej strcmp(uzel->sub_name, "struct_name") == 0) { je_byte_pole_as = 1 }
            Pokud (Volej strcmp(uzel->sub_name, "member_name") == 0) { je_byte_pole_as = 1 }
            
            Pokud (je_byte_pole_as == 1) {
                Volej fputs("    add rbx, rcx\n", out)
                Volej fputs("    pop rax\n", out)
                Volej fputs("    mov byte [rbx], al\n", out)
            } Jinak {
                Volej fputs("    imul rcx, 8\n", out)
                Volej fputs("    add rbx, rcx\n", out)
                Volej fputs("    pop rax\n", out)
                Volej fputs("    mov qword [rbx], rax\n", out)
            }
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_LOCAL_ARRAY_ASSIGN) {
        Lokalni sym_loc_as : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_loc_as != 0) {
            Volej GenerujVyraz(out, uzel->right)
            Volej fputs("    push rax\n", out)
            
            Volej GenerujVyraz(out, uzel->left)
            Volej fputs("    imul rax, 8\n", out)
            Pokud (sym_loc_as->is_global) {
                Volej fprintf(out, "    mov rbx, qword [rel gvar_%s]\n", sym_loc_as->name)
            } Jinak {
                Pokud (sym_loc_as->offset < 0) {
                    Lokalni k_loc2 = 0 - sym_loc_as->offset
                    Volej fprintf(out, "    mov rbx, qword [rbp + %d]\n", k_loc2)
                } Jinak {
                    Volej fprintf(out, "    mov rbx, qword [rbp - %d]\n", sym_loc_as->offset)
                }
            }
            Volej fputs("    add rbx, rax\n    pop rax\n    mov qword [rbx], rax\n", out)
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_PTR_MEMBER_ASSIGN) {
        Lokalni sym_zapis_as : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_zapis_as != 0) {
            Volej GenerujVyraz(out, uzel->right)
            Volej fputs("    push rax\n", out)
            
            Pokud (sym_zapis_as->is_global) { Volej fprintf(out, "    mov rbx, qword [rel gvar_%s]\n", sym_zapis_as->name) }
            Jinak { Volej fprintf(out, "    mov rbx, qword [rbp - %d]\n", sym_zapis_as->offset) }
            
            Volej fputs("    pop rax\n", out)
            Pokud (uzel->int_val == 0) { Volej fputs("    mov [rbx], rax\n", out) }
            Jinak { Volej fprintf(out, "    mov [rbx + %d], rax\n", uzel->int_val) }
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_ASSIGN || uzel->type == AST_VAR_DECL) {
        Pokud (uzel->right != 0) {
            Volej GenerujVyraz(out, uzel->right)
        } Jinak {
            Volej fputs("    mov rax, 0\n", out)
        }
        Lokalni sym_as : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_as != 0) {
            Pokud (uzel->op == TOKEN_PLUSEQ || uzel->op == TOKEN_MINUSEQ) {
                Volej fputs("    push rax\n", out)
                Pokud (sym_as->is_global) { Volej fprintf(out, "    mov rax, qword [rel gvar_%s]\n", sym_as->name) }
                Jinak {
                    Pokud (sym_as->offset < 0) { Lokalni k1 = 0 - sym_as->offset; Volej fprintf(out, "    mov rax, qword [rbp + %d]\n", k1) }
                    Jinak { Volej fprintf(out, "    mov rax, qword [rbp - %d]\n", sym_as->offset) }
                }
                Volej fputs("    pop rbx\n", out)
                Pokud (uzel->op == TOKEN_PLUSEQ) { Volej fputs("    add rax, rbx\n", out) }
                Pokud (uzel->op == TOKEN_MINUSEQ) { Volej fputs("    sub rax, rbx\n", out) }
            }

            Pokud (sym_as->is_global) { Volej fprintf(out, "    mov qword [rel gvar_%s], rax\n", sym_as->name) }
            Jinak {
                Pokud (sym_as->offset < 0) { Lokalni k2 = 0 - sym_as->offset; Volej fprintf(out, "    mov qword [rbp + %d], rax\n", k2) }
                Jinak { Volej fprintf(out, "    mov qword [rbp - %d], rax\n", sym_as->offset) }
            }
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_RETURN) {
        Pokud (uzel->left != 0) Volej GenerujVyraz(out, uzel->left)
        Volej fputs("    pop r15\n    pop r14\n    pop r13\n    pop r12\n", out)
        Volej fputs("    mov rsp, rbp\n    pop rbp\n    ret\n", out)
        Vrat 0
    }

Pokud (uzel->type == AST_PRINT) {
        Volej GenerujVyraz(out, uzel->left)
        Lokalni typ_p = Volej ZiskejTypUzlu(uzel->left)
        
        Pokud (Volej strcmp(typ_p, "Float") == 0) {
            Pokud (cilova_platforma == CIL_WINDOWS) {
                Volej fputs("    movq xmm1, rax\n    mov rdx, rax\n    lea rcx, [rel fmt_flt]\n", out)
            } Jinak {
                Volej fputs("    movq xmm0, rax\n    lea rdi, [rel fmt_flt]\n    mov eax, 1\n", out)
            }
        } Jinak Pokud (Volej strcmp(typ_p, "String") == 0) {
            Pokud (cilova_platforma == CIL_WINDOWS) {
                Volej fputs("    mov rdx, rax\n    lea rcx, [rel fmt_str]\n", out)
            } Jinak {
                Volej fputs("    mov rsi, rax\n    lea rdi, [rel fmt_str]\n    mov eax, 0\n", out)
            }
        } Jinak {
            Pokud (cilova_platforma == CIL_WINDOWS) {
                Volej fputs("    mov rdx, rax\n    lea rcx, [rel fmt_int]\n", out)
            } Jinak {
                Volej fputs("    mov rsi, rax\n    lea rdi, [rel fmt_int]\n    mov eax, 0\n", out)
            }
        }
        Volej fputs("    sub rsp, 32\n    call printf\n    add rsp, 32\n", out)
        Vrat 0
    }

    Pokud (uzel->type == AST_FREE) {
        Volej GenerujVyraz(out, uzel->left)
        Pokud (cilova_platforma == CIL_WINDOWS) {
            Volej fputs("    mov rcx, rax\n", out)
        } Jinak {
            Volej fputs("    mov rdi, rax\n", out)
        }
        Volej fputs("    sub rsp, 32\n", out)
        Pokud (cilova_platforma == CIL_APPLE) {
            Volej fputs("    call _free\n", out)
        } Jinak {
            Volej fputs("    call free\n", out)
        }
        Volej fputs("    add rsp, 32\n", out)
        Vrat 0
    }

    Pokud (uzel->type == AST_BLOCK) {
        Lokalni j = 0
        Dokud (j < uzel->stmt_count) {
            Lokalni adresa_v_poli_blk = uzel->stmts + (j * 8)
            Lokalni pod_uzel_blk : AST_Node = Volej CtiUkazatel(adresa_v_poli_blk)
            Pokud (pod_uzel_blk != 0) {
                Pokud (pod_uzel_blk->type != 10 && pod_uzel_blk->type != 100) {
                    Volej GenerujAST(out, pod_uzel_blk)
                }
            }
            j = j + 1
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_IF) {
        Lokalni levy_uzel_if : AST_Node = uzel->left
        Pokud (levy_uzel_if != 0) {
            Pokud (levy_uzel_if->op == TOKEN_NUMBER) {
                Lokalni hodnota_podminky = Volej atoi(levy_uzel_if->name)
                Pokud (hodnota_podminky == 0) {
                    Pokud (uzel->alt != 0) { Volej GenerujAST(out, uzel->alt) }
                    Vrat 0
                } Jinak {
                    Volej GenerujAST(out, uzel->right)
                    Vrat 0
                }
            }
        }
        
        Lokalni lbl_if = citac_navesti; citac_navesti = citac_navesti + 1
        Volej GenerujVyraz(out, uzel->left)
        Volej fputs("    cmp rax, 0\n", out)
        Pokud (uzel->alt != 0) {
            Volej fprintf(out, "    je .L_else_%d\n", lbl_if)
            Volej GenerujAST(out, uzel->right)
            Volej fprintf(out, "    jmp .L_end_%d\n", lbl_if)
            Volej fprintf(out, ".L_else_%d:\n", lbl_if)
            Volej GenerujAST(out, uzel->alt)
            Volej fprintf(out, ".L_end_%d:\n", lbl_if)
        } Jinak {
            Volej fprintf(out, "    je .L_end_%d\n", lbl_if)
            Volej GenerujAST(out, uzel->right)
            Volej fprintf(out, ".L_end_%d:\n", lbl_if)
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_SWITCH) {
        Lokalni lbl_sw = citac_navesti; citac_navesti = citac_navesti + 1
        
        Pokud (uzel->stmt_count == 0) {
            Volej GenerujVyraz(out, uzel->left)
            Pokud (uzel->alt != 0) { Volej GenerujAST(out, uzel->alt) }
            Vrat 0
        }
        
        Lokalni min_val = 99999999
        Lokalni max_val = 0 - 99999999
        Lokalni s_idx = 0
        Dokud (s_idx < uzel->stmt_count) {
            Lokalni addr_sw = uzel->stmts + (s_idx * 8)
            Lokalni c_uzel_sw : AST_Node = Volej CtiUkazatel(addr_sw)
            Lokalni sw_left : AST_Node = c_uzel_sw->left
            Lokalni hodnota = Volej VyhodnotKonstantu(sw_left)
            Pokud (hodnota < min_val) { min_val = hodnota }
            Pokud (hodnota > max_val) { max_val = hodnota }
            s_idx = s_idx + 1
        }
        
        Lokalni rozsah = max_val - min_val
        Pokud (rozsah < 0 || rozsah > 10000) {
            Volej printf("Chyba na radku %d: Rozsah Rozcestniku (%d) je prilis velky pro tabulku skoku (max 10000)!\n", uzel->line, rozsah)
            Volej exit(1)
        }
        
        Volej GenerujVyraz(out, uzel->left)
        Volej fprintf(out, "    sub rax, %d\n", min_val)
        Volej fputs("    cmp rax, 0\n", out)
        Pokud (uzel->alt != 0) { Volej fprintf(out, "    jl .L_sw_def_%d\n", lbl_sw) }
        Jinak { Volej fprintf(out, "    jl .L_sw_end_%d\n", lbl_sw) }
        
        Volej fprintf(out, "    cmp rax, %d\n", rozsah)
        Pokud (uzel->alt != 0) { Volej fprintf(out, "    jg .L_sw_def_%d\n", lbl_sw) }
        Jinak { Volej fprintf(out, "    jg .L_sw_end_%d\n", lbl_sw) }
        
        Volej fprintf(out, "    jmp .L_sw_code_%d\n", lbl_sw)
        Volej fprintf(out, ".L_sw_table_%d:\n", lbl_sw)
        
        Lokalni curr = min_val
        Dokud (curr <= max_val) {
            Lokalni nalezena_cesta = 0 - 1
            Lokalni hledam = 0
            Dokud (hledam < uzel->stmt_count) {
                Lokalni addr_h = uzel->stmts + (hledam * 8)
                Lokalni u_h : AST_Node = Volej CtiUkazatel(addr_h)
                Lokalni u_h_left : AST_Node = u_h->left
                Lokalni val_h = Volej VyhodnotKonstantu(u_h_left)
                Pokud (val_h == curr) { nalezena_cesta = hledam; hledam = uzel->stmt_count }
                hledam = hledam + 1
            }
            
            Pokud (nalezena_cesta != (0 - 1)) {
                Volej fprintf(out, "    dd .L_sw_case_%d_%d - .L_sw_table_%d\n", lbl_sw, nalezena_cesta, lbl_sw)
            } Jinak {
                Pokud (uzel->alt != 0) {
                    Volej fprintf(out, "    dd .L_sw_def_%d - .L_sw_table_%d\n", lbl_sw, lbl_sw)
                } Jinak {
                    Volej fprintf(out, "    dd .L_sw_end_%d - .L_sw_table_%d\n", lbl_sw, lbl_sw)
                }
            }
            curr = curr + 1
        }
        
        Volej fprintf(out, ".L_sw_code_%d:\n", lbl_sw)
        Volej fprintf(out, "    lea rdx, [rel .L_sw_table_%d]\n", lbl_sw)
        Volej fputs("    movsxd rcx, dword [rdx + rax*4]\n", out)
        Volej fputs("    add rcx, rdx\n", out)
        Volej fputs("    jmp rcx\n", out)
        
        s_idx = 0
        Dokud (s_idx < uzel->stmt_count) {
            Lokalni addr2_sw = uzel->stmts + (s_idx * 8)
            Lokalni c_uzel2_sw : AST_Node = Volej CtiUkazatel(addr2_sw)
            
            Volej fprintf(out, ".L_sw_case_%d_%d:\n", lbl_sw, s_idx)
            Volej GenerujAST(out, c_uzel2_sw->right)
            Volej fprintf(out, "    jmp .L_sw_end_%d\n", lbl_sw)
            s_idx = s_idx + 1
        }

        Pokud (uzel->alt != 0) {
            Volej fprintf(out, ".L_sw_def_%d:\n", lbl_sw)
            Volej GenerujAST(out, uzel->alt)
        }

        Volej fprintf(out, ".L_sw_end_%d:\n", lbl_sw)
        Vrat 0
    }

    Pokud (uzel->type == AST_WHILE) {
        Lokalni levy_uzel_w : AST_Node = uzel->left
        Pokud (levy_uzel_w != 0) {
            Pokud (levy_uzel_w->op == TOKEN_NUMBER) {
                Lokalni hodnota_cyklu = Volej atoi(levy_uzel_w->name)
                Pokud (hodnota_cyklu == 0) {
                    Vrat 0
                }
            }
        }
        
        Pokud (loop_stack_depth >= 199) {
            Volej printf("Kriticka chyba: prilis hluboko vnorene cykly (max 200)!\n")
            Volej exit(1)
        }
        Lokalni lbl_w = citac_navesti; citac_navesti = citac_navesti + 1
        Lokalni stack_addr_w = loop_label_stack + (loop_stack_depth * 8)
        Volej ZapisUkazatel(stack_addr_w, lbl_w)
        Lokalni cont_addr_w = loop_continue_stack + (loop_stack_depth * 8)
        Volej ZapisUkazatel(cont_addr_w, lbl_w)
        loop_stack_depth = loop_stack_depth + 1

        Volej fprintf(out, ".L_start_%d:\n", lbl_w)
        Volej fprintf(out, ".L_continue_%d:\n", lbl_w)
        Volej GenerujVyraz(out, uzel->left)
        Volej fputs("    cmp rax, 0\n", out)
        Volej fprintf(out, "    je .L_end_%d\n", lbl_w)
        Volej GenerujAST(out, uzel->right)
        Volej fprintf(out, "    jmp .L_start_%d\n", lbl_w)
        Volej fprintf(out, ".L_end_%d:\n", lbl_w)

        loop_stack_depth = loop_stack_depth - 1
        Vrat 0
    }

    Pokud (uzel->type == AST_FOR) {
        Pokud (loop_stack_depth >= 199) {
            Volej printf("Kriticka chyba: prilis hluboko vnorene cykly (max 200)!\n")
            Volej exit(1)
        }
        Lokalni lbl_f = citac_navesti; citac_navesti = citac_navesti + 1
        Lokalni stack_addr_f = loop_label_stack + (loop_stack_depth * 8)
        Volej ZapisUkazatel(stack_addr_f, lbl_f)
        Lokalni cont_addr_f = loop_continue_stack + (loop_stack_depth * 8)
        Volej ZapisUkazatel(cont_addr_f, lbl_f)
        loop_stack_depth = loop_stack_depth + 1

        Volej GenerujAST(out, uzel->left)

        Volej fprintf(out, ".L_start_%d:\n", lbl_f)
        Volej GenerujVyraz(out, uzel->right)
        Volej fputs("    cmp rax, 0\n", out)
        Volej fprintf(out, "    je .L_end_%d\n", lbl_f)

        Lokalni telo_uzel = Volej CtiUkazatel(uzel->stmts)
        Volej GenerujAST(out, telo_uzel)

        Volej fprintf(out, ".L_continue_%d:\n", lbl_f)
        Volej GenerujAST(out, uzel->alt)

        Volej fprintf(out, "    jmp .L_start_%d\n", lbl_f)
        Volej fprintf(out, ".L_end_%d:\n", lbl_f)

        loop_stack_depth = loop_stack_depth - 1
        Vrat 0
    }

    Pokud (uzel->type == AST_CONTINUE) {
        Pokud (loop_stack_depth > 0) {
            Lokalni idx_c = loop_stack_depth - 1
            Lokalni addr_c = loop_continue_stack + (idx_c * 8)
            Lokalni lbl_c = Volej CtiUkazatel(addr_c)
            Volej fprintf(out, "    jmp .L_continue_%d\n", lbl_c)
        } Jinak {
            Volej printf("Chyba: Pokracuj mimo cyklus (radek %d)\n", uzel->line)
            Volej exit(1)
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_BREAK) {
        Pokud (loop_stack_depth > 0) {
            Lokalni idx_b = loop_stack_depth - 1
            Lokalni addr_b = loop_label_stack + (idx_b * 8)
            Lokalni lbl_b = Volej CtiUkazatel(addr_b)
            Volej fprintf(out, "    jmp .L_end_%d\n", lbl_b)
        } Jinak {
            Volej printf("Chyba: Ukonci mimo cyklus (radek %d)\n", uzel->line)
            Volej exit(1)
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_CALL) {
        Lokalni navic_ast = uzel->stmt_count - 4
        Lokalni padding_ast = 0
        Pokud (navic_ast > 0) {
            Lokalni lychy_ast = navic_ast - ((navic_ast / 2) * 2)
            Pokud (lychy_ast != 0) { padding_ast = 8; Volej fputs("    sub rsp, 8\n", out) }
        }

        Lokalni arg_idx_ast = uzel->stmt_count - 1
        Dokud (arg_idx_ast >= 0) {
            Lokalni addr_call_ast = uzel->stmts + (arg_idx_ast * 8)
            Lokalni arg_node_ast : AST_Node = Volej CtiUkazatel(addr_call_ast)
            Pokud (arg_node_ast != 0 && arg_node_ast->type != 100) {
                Volej GenerujVyraz(out, arg_node_ast)
            }
            Volej fputs("    push rax\n", out)
            arg_idx_ast = arg_idx_ast - 1
        }
        
        Pokud (cilova_platforma == CIL_WINDOWS) {
            Pokud (uzel->stmt_count > 0) { Volej fputs("    pop rcx\n    movq xmm0, rcx\n", out) }
            Pokud (uzel->stmt_count > 1) { Volej fputs("    pop rdx\n    movq xmm1, rdx\n", out) }
            Pokud (uzel->stmt_count > 2) { Volej fputs("    pop r8\n    movq xmm2, r8\n", out) }
            Pokud (uzel->stmt_count > 3) { Volej fputs("    pop r9\n    movq xmm3, r9\n", out) }
        } Jinak {
            Pokud (uzel->stmt_count > 0) { Volej fputs("    pop rdi\n    movq xmm0, rdi\n", out) }
            Pokud (uzel->stmt_count > 1) { Volej fputs("    pop rsi\n    movq xmm0, rsi\n", out) }
            Pokud (uzel->stmt_count > 2) { Volej fputs("    pop rdx\n    movq xmm1, rdx\n", out) }
            Pokud (uzel->stmt_count > 3) { Volej fputs("    pop rcx\n    movq xmm2, rcx\n", out) }
        }
        
        Lokalni nazev_volani_ast = uzel->name
        Pokud (cilova_platforma == CIL_APPLE && Volej JeExterniJmeno(uzel->name) == 1) {
            nazev_volani_ast = Volej NazevSymbolu(uzel->name)
        }
        
        Volej fputs("    mov eax, 4\n", out)
        Volej fputs("    sub rsp, 32\n", out)
        Volej fprintf(out, "    call %s\n", nazev_volani_ast)
        Volej fputs("    add rsp, 32\n", out)

        Lokalni k_smazani_ast = padding_ast
        Pokud (navic_ast > 0) { k_smazani_ast = k_smazani_ast + (navic_ast * 8) }
        Pokud (k_smazani_ast > 0) {
            Volej fprintf(out, "    add rsp, %d\n", k_smazani_ast)
        }
        Vrat 0
    }
    Vrat 0
}
Metoda GeneratorASM(ast_koren : AST_Node, vystupni_soubor) {
    Volej printf("Generator: Zapisuji do %s...\n", vystupni_soubor)
    Lokalni out = Volej fopen(vystupni_soubor, "w")

Volej fputs("section .data\n    fmt_int db 37, 100, 10, 0\n    fmt_flt db 37, 102, 10, 0\n    fmt_str db 37, 115, 10, 0\n    fmt_str_concat db 37, 115, 37, 115, 0\n", out)    
    Lokalni i = 0
    Lokalni flt_id = 0
    Dokud (i < pocet_tokenu) {
        Lokalni t : Token = pamet_tokenu + (i * Velikost(Token))
        Pokud (t->type == TOKEN_STRING) {
            Volej fprintf(out, "    str%d db ", t->str_id)
            Lokalni sj = 0
            Lokalni pokracovat = 1
            Dokud (pokracovat == 1) {
                Lokalni raw = Volej CtiByt(t->value + sj)
                Pokud (raw == 0) { pokracovat = 0 } Jinak { Volej fprintf(out, "%d, ", raw); sj = sj + 1 }
            }
            Volej fputs("0\n", out)
        }
        Pokud (t->type == 98) {
            Volej fprintf(out, "    flt%d dq %s\n", flt_id, t->value)
            flt_id = flt_id + 1
        }
        i = i + 1
    }

    Lokalni s = 0
    Dokud (s < pocet_symbolu) {
        Lokalni sym : Symbol = pamet_symbolu + (s * Velikost(Symbol))
        Pokud (sym->is_global && sym->is_const == 0) {
            Volej fprintf(out, "    gvar_%s dq %d\n", sym->name, sym->const_val)
        }
        s = s + 1
    }

    Lokalni hlavni_label = "main"
    Pokud (cilova_platforma == CIL_APPLE) { hlavni_label = "_main" }

    Volej fprintf(out, "\nsection .text\n    global %s\n", hlavni_label)
    Pokud (cilova_platforma == CIL_APPLE) {
        Volej fputs("    extern _printf\n    extern _exit\n", out)
    } Jinak {
        Volej fputs("    extern printf\n    extern exit\n", out)
    }
    
    Lokalni k = 0
    Dokud (k < ast_koren->stmt_count) {
        Lokalni adresa_v_poli = ast_koren->stmts + (k * 8)
        Lokalni pod_uzel : AST_Node = Volej CtiUkazatel(adresa_v_poli)
        Pokud (pod_uzel->type == AST_EXTERN_DECL) {
            Pokud (cilova_platforma == CIL_APPLE) { Volej fprintf(out, "    extern _%s\n", pod_uzel->name) } 
            Jinak { Volej fprintf(out, "    extern %s\n", pod_uzel->name) }
        }
        k = k + 1
    }

    Volej fprintf(out, "\n%s:\n", hlavni_label)
    Pokud (cilova_platforma == CIL_WINDOWS) {
        Volej fputs("    mov [rel gvar_sys_argc], rcx\n    mov [rel gvar_sys_argv], rdx\n", out)
    } Jinak {
        Volej fputs("    mov [rel gvar_sys_argc], rdi\n    mov [rel gvar_sys_argv], rsi\n", out)
    }
    Volej fputs("    sub rsp, 40\n    call Hlavni\n", out)
    Pokud (cilova_platforma == CIL_WINDOWS) {
        Volej fputs("    mov rcx, rax\n    call exit\n\n", out)
    } Jinak Pokud (cilova_platforma == CIL_APPLE) {
        Volej fputs("    mov rdi, rax\n    call _exit\n\n", out)
    } Jinak {
        Volej fputs("    mov rdi, rax\n    call exit\n\n", out)
    }
    
    Volej GenerujAST(out, ast_koren)
    Volej fclose(out)
    Vrat 0
}
Metoda Hlavni() {
    Volej setvbuf(0, 0, 4, 0)
    pamet_struktur_clenove = Volej calloc(500, 1032)
    pocet_struktur_clenu = 0
    pamet_struktur_def = Volej calloc(100, 520)
    pocet_struktur_def = 0

    // Nove dynamicke kapacity a Hash
    pamet_symbolu = Volej calloc(kapacita_symbolu, Velikost(Symbol))
    hash_tabulka = Volej calloc(4096, 8)
    pamet_ir = Volej calloc(kapacita_ir, Velikost(IR_Instrukce))
    pamet_intervalu = Volej calloc(kapacita_intervalu, Velikost(LiveInterval))
    loop_label_stack = Volej calloc(200, 8)
    loop_continue_stack = Volej calloc(200, 8)
    loop_stack_depth = 0
    pamet_externu = Volej calloc(200, 256)
    pocet_externu = 0
    
    Volej PridejGlobalniSymbol("sys_argc", 0)
    Volej PridejGlobalniSymbol("sys_argv", 0)

    Pokud (sys_argc < 2) {
        Volej printf("Pouziti: kompilator.exe <soubor.txt> [vystupni_jmeno] [--cil=apple|linux|windows]\n")
        Volej exit(1)
    }

    Lokalni nazev_zdrojaku = CtiZAdresu(sys_argv + 8)
    Lokalni nazev_vystupu = "program"
    Pokud (sys_argc >= 3) {
        nazev_vystupu = CtiZAdresu(sys_argv + 16)
    }

    cilova_platforma = CIL_APPLE
    Pokud (sys_argc >= 4) {
        Lokalni cil_arg = CtiZAdresu(sys_argv + 24)
        Pokud (Volej strcmp(cil_arg, "--cil=apple") == 0) { cilova_platforma = CIL_APPLE }
        Jinak Pokud (Volej strcmp(cil_arg, "--cil=linux") == 0) { cilova_platforma = CIL_LINUX }
        Jinak Pokud (Volej strcmp(cil_arg, "--cil=windows") == 0) { cilova_platforma = CIL_WINDOWS }
        Jinak {
            Volej printf("Neznamy cil '%s'. Pouzij --cil=apple, --cil=linux nebo --cil=windows.\n", cil_arg)
            Volej exit(1)
        }
    }

     Pokud (cilova_platforma == CIL_APPLE) { Volej printf("Cilova platforma: Apple (macOS, x86-64)\n") }
    Jinak Pokud (cilova_platforma == CIL_LINUX) { Volej printf("Cilova platforma: Linux (x86-64)\n") }
    Jinak { Volej printf("Cilova platforma: Windows (x86-64)\n") }
    Volej fflush(0)

    Volej printf("--- START KOMPILACE ---\n")
    Volej fflush(0)

    // Nova dynamicka kapacita pro tokeny
    pamet_tokenu = Volej calloc(kapacita_tokenu, Velikost(Token))
    
    Volej Lexer(nazev_zdrojaku)
    Lokalni ast = Volej Parser()
    
    Volej printf("Typova kontrola...\n")
    Volej ZkontrolujAST(ast)
 Volej printf("Spoustim Middle-End optimalizace stromu (Inlining, DCE, LICM, CSE)...\n")
    Volej OptimalizujBezpecnyInlining(ast)
    Volej OptimalizujDCE(ast)
    Volej OptimalizujLICM(ast)
    Volej OptimalizujCSE(ast)
    Lokalni asm_soub = Volej malloc(256)
    Lokalni obj_soub = Volej malloc(256)
    Lokalni exe_soub = Volej malloc(256)
    Lokalni cmd_nasm = Volej malloc(512)
    Lokalni cmd_gcc = Volej malloc(512)

    Volej sprintf(asm_soub, "%s.asm", nazev_vystupu)

    Pokud (cilova_platforma == CIL_WINDOWS) {
        Volej sprintf(obj_soub, "%s.obj", nazev_vystupu)
        Volej sprintf(exe_soub, "%s.exe", nazev_vystupu)
    } Jinak {
        Volej sprintf(obj_soub, "%s.o", nazev_vystupu)
        Volej sprintf(exe_soub, "%s", nazev_vystupu)
    }

    Volej GeneratorASM(ast, asm_soub)

   Pokud (cilova_platforma == CIL_APPLE) {
        Volej sprintf(cmd_nasm, "nasm -f macho64 \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_gcc, "clang -s \"%s\" -o \"%s\"", obj_soub, exe_soub)
    } Jinak Pokud (cilova_platforma == CIL_LINUX) {
        Volej sprintf(cmd_nasm, "nasm -f elf64 \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_gcc, "gcc -s -no-pie \"%s\" -o \"%s\"", obj_soub, exe_soub)
    } Jinak {
        Volej sprintf(cmd_nasm, "nasm -f win64 \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_gcc, "gcc -s \"%s\" -o \"%s\"", obj_soub, exe_soub)
    }

    Volej system(cmd_nasm)
    Volej system(cmd_gcc)
    Volej printf("--- DOKONCENO ---\n")
    Vrat 0
}
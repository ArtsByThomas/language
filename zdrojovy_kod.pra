Struktura BasicBlock {
    id
    start_instr    // První IR instrukce v tomto bloku
    end_instr      // Poslední IR instrukce v bloku
    pred_count     // Počet předchůdců (kdo na mě skáče)
    preds          // Ukazatel na pole předchůdců
    succ_count     // Počet následovníků (kam skáču já)
    succs          // Ukazatel na pole následovníků
    live_in        // Které proměnné žijí na vstupu do bloku
    live_out       // Které proměnné žijí na výstupu z bloku
}
Struktura IR_Instrukce {
    opcode
    dest       // ID ciloveho registru nebo temp promenne
    src1       // Prvni argument
    src2       // Druhy argument
    src1_typ   // 0 = Temp/Reg, 1 = Konstanta, 2 = Offset lokalni promenne
    src2_typ   // Zpusob adresovani pro druhy argument
}

// Liveness Analysis (pro alokaci registru)
Struktura LiveInterval {
    var_id         // ID promenne/temp
    start_instr    // Index prvni IR instrukce, kde promenna ozije
    end_instr      // Index posledni IR instrukce, kde se promenna pouzije
    fyzicky_reg    // Napevno prideleni registr: -1 (RAM), nebo 12 (r12), 13 (r13)...
}


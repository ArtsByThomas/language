// --- MEZISTUPEN PREKLADU (IR - Three-Address Code) ---
Struktura IR_Instrukce {
    opcode
    dest       // ID ciloveho registru nebo temp promenne
    src1       // Prvni argument
    src2       // Druhy argument
    src1_typ   // 0 = Temp/Reg, 1 = Konstanta, 2 = Offset lokalni promenne
    src2_typ   // Zpusob adresovani pro druhy argument
}

// Liveness Analysis (pro alokaci registru)
Struktura LiveInterval {
    var_id         // ID promenne/temp
    start_instr    // Index prvni IR instrukce, kde promenna ozije
    end_instr      // Index posledni IR instrukce, kde se promenna pouzije
    fyzicky_reg    // Napevno prideleni registr: -1 (RAM), nebo 12 (r12), 13 (r13)...
}

Globalni pamet_defer = 0
Globalni pocet_defer = 0
Globalni pamet_ir = 0
Globalni pocet_ir = 0
Globalni kapacita_ir = 10000

Globalni pamet_intervalu = 0
Globalni pocet_intervalu = 0
Globalni kapacita_intervalu = 5000

// Generátor virtuálních registrů (t1, t2, t3...)
Globalni citac_temp_reg = 1
// 3. Definice Struktur
Struktura Symbol {
    name[256]
    is_global
    is_const
    const_val
    init_str[64]
    offset
    dim1
    dim2
    type_name[64]
    scope_depth
    is_active
    is_function
    func_node
    hash_next     // dalsi symbol se stejnym hashem
    vreg          // virtualni registr promenne (x86 backend), 0 = promenna zije v pameti
    priznaky      // metody: 1 = zjisteno, 2 = obsahuje Asm (potrebuje domovskou oblast)
}
Globalni hash_tabulka = 0
Struktura AST_Node {
    type
    left
    right
    stmts
    stmt_count
    stmt_capacity
    name[256]
    sub_name[64]
    int_val
    op
    line
    sym_start
    sym_end
    alt
    arg_count       // <-- NOVÉ: Počet argumentů metody
    type_name[64]   // <-- NOVÉ: Návratový typ metody
}

// Přidejte tuto proměnnou mezi ostatní 'Globalni' definice (např. pod aktualni_hloubka_bloku)
Globalni kontrola_aktualni_typ_metody = 0
Struktura Token {
    type
    value[256]
    str_id
    line
}






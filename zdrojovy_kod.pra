// ==========================================
// BACKEND x86-64:  AST -> IR (tri-adresovy kod) -> CFG -> Liveness -> Linear Scan -> assembler
// ==========================================
//
// Kazda hodnota je "virtualni registr" (vreg) cislovany od 1. Lokalni promenne a parametry
// metod bez Asm jsou TAKE vregy, takze je Linear Scan muze drzet v procesorovych registrech
// po celou dobu jejich zivota (vcetne cyklu - to zajisti analyza zivosti pres CFG).
// Registry pro vregy: rbx, r12, r13, r14, r15 (a na Windows navic rsi, rdi) - vsechny jsou
// "callee-saved", takze hodnoty preziji i volani jinych metod a C funkci.
//
// IR instrukce (pole IR_Instrukce): opcode, dest, src1, src2, src1_typ, src2_typ
//   typ operandu: 0 = vreg, 1 = konstanta, 2 = offset ve ramci, 3 = jmeno symbolu (text)
//
//   1 KONST     d = c                    26 KOPIE    d = s1
//   2 NACTI     d = [rbp - off]          3 ULOZ      [rbp - off] = s2
//   4 + 5 - 6 * 7 / 27 %  18 & 19 | 20 ^ 21 << 22 >>     d = s1 OP s2
//   12..17 porovnani (== != < > <= >=)   d = (s1 OP s2) ? 1 : 0
//   28 NEG d = -s1      29 NOT d = (s1 == 0)
//   30..35 SKOK_KDYZ_NE  skoc na navesti dest, kdyz NEPLATI s1 OP s2 (== != < > <= >=)
//   10 SKOK  11 NAVESTI   9 SKOK pri ZF (za "cmp rax, 0" ze surove casti)
//   23 ARG (dest = cislo argumentu)  24 VOLANI d = jmeno(s1)
//   25 DO_RAX rax = s1   38 Z_RAX d = rax     (most mezi IR a surovym assemblerem)
//   36 NACTI_GLOB  37 ULOZ_GLOB  41 ADRESA_LOKALNI  44 ADRESA_SYMBOLU
//   40 d = [s1 + s2*8]   47 d = s1 + s2*8    49 d = [s1 + c]   50 d = bajt [s1 + s2]
//   43 [s1] = s2         51 bajt [s1] = s2
//   97 EPILOG  98 PROLOG  99 SUROVY TEXT
// ==========================================

Globalni ir_pouzite_reg = 0     // bitova maska pouzitych fyzickych registru
Globalni ir_pocet_push = 0
Globalni ir_metoda_ma_asm = 0
Globalni ir_op_typ = 0          // pomocny vystup metody OperandNeboKonst
Globalni ir_prvni_temp = 0      // vregy >= tomuto cislu jsou docasne hodnoty (mensi = promenne)
Globalni ir_metoda = 0          // AST prave generovane metody
Globalni ir_ma_ramec = 1        // 1 = metoda potrebuje rbp (promenne v pameti, Asm, pole)
Globalni ir_chyby_navesti = 0   // chybove vetve metody: [navesti, radek, zprava] * n
Globalni ir_chyby_pocet = 0
Globalni ir_citac_sond = 0

// ---------- Tabulka chybovych hlasek za behu ----------
Globalni pamet_chyb = 0
Globalni pocet_chyb = 0
Globalni kapacita_chyb = 0
Metoda PridejChybovouZpravu(radek, zprava) {
    Pokud (pocet_chyb >= kapacita_chyb) {
        kapacita_chyb = (kapacita_chyb * 2) + 64
        pamet_chyb = Volej realloc(pamet_chyb, kapacita_chyb * 256)
    }
    Volej sprintf(pamet_chyb + (pocet_chyb * 256), "Chyba za behu (radek %d): %s", radek, zprava)
    pocet_chyb = pocet_chyb + 1
    Vrat pocet_chyb - 1
}

// Zapise text jako posloupnost bajtu (bezpecne pro uvozovky a diakritiku)
Metoda ZapisBajtyTextu(out, text) {
    Lokalni sj = 0
    Lokalni znak = Volej CtiByt(text)
    Dokud (znak != 0) {
        Volej fprintf(out, "%d, ", znak)
        sj = sj + 1
        znak = Volej CtiByt(text + sj)
    }
    Volej fputs("0\n", out)
    Vrat 0
}

// ==========================================
// Zakladni operace s IR
// ==========================================
Metoda Ir(op, dest, s1, t1, s2, t2) {
    Volej ZkontrolujKapacituIR()
    // Pamet overenych ukazatelu plati jen v souvislem useku kodu bez navesti a bez zmeny promenne
    Pokud (ir_nul_pocet > 0) {
        Pokud (op == 11) { ir_nul_pocet = 0 }
        Jinak Pokud (dest > 0 && Volej DefinujeDest(op) == 1) {
            Lokalni ni = 0
            Dokud (ni < ir_nul_pocet) {
                Pokud (CtiZAdresu(ir_nul_overene + (ni * 8)) == dest) { Volej ZapisUkazatel(ir_nul_overene + (ni * 8), 0) }
                ni = ni + 1
            }
        }
    }
    Lokalni inst : IR_Instrukce = pamet_ir + (pocet_ir * Velikost(IR_Instrukce))
    inst->opcode = op
    inst->dest = dest
    inst->src1 = s1
    inst->src1_typ = t1
    inst->src2 = s2
    inst->src2_typ = t2
    // hloubka cyklu pro vahy alokace: i cykly z koncove rekurze (metoda a vlozene kopie)
    Volej ZapisUkazatel(ir_hloubka_cyklu + (pocet_ir * 8), loop_stack_depth + tce_hloubka)
    Volej ZapisUkazatel(ir_cekajici_push + (pocet_ir * 8), surove_push)
    pocet_ir = pocet_ir + 1
    Vrat dest
}

// ==========================================
// Kontroly za behu (vypne je --bez-kontrol)
// ==========================================
Globalni kontroly = 1
Globalni ir_nul_overene = 0
Globalni ir_nul_pocet = 0

// p->x: je-li p nula, srozumitelna chyba misto padu (v jadru se nekontroluje: adresa 0 muze byt platna)
Metoda KontrolaUkazatele(v, radek) {
    Pokud (kontroly == 0 || Volej JeJadro() == 1) { Vrat 0 }
    Pokud (ir_nul_overene == 0) { ir_nul_overene = Volej calloc(16, 8) }
    Lokalni i = 0
    Dokud (i < ir_nul_pocet) {
        Pokud (CtiZAdresu(ir_nul_overene + (i * 8)) == v) { Vrat 0 }
        i = i + 1
    }
    Volej Ir(31, Volej ChybovaVetev(radek, "pristup pres nulovy ukazatel (p->clen, kdyz p = 0)"), v, 0, 0, 1)
    Pokud (ir_nul_pocet < 16) {
        Volej ZapisUkazatel(ir_nul_overene + (ir_nul_pocet * 8), v)
        ir_nul_pocet = ir_nul_pocet + 1
    }
    Vrat 0
}

// Index musi byt 0 <= i < velikost (jedno porovnani bez znamenka)
Metoda KontrolaMeze(idx, idx_t, velikost, radek, jmeno) {
    // Index s dokazanym rozsahem uvnitr pole se nekontroluje (rz_meze_ok nastavi volajici)
    Pokud (rz_meze_ok == 1 && idx_t == 0) { rz_meze_ok = 0; Vrat 0 }
    rz_meze_ok = 0
    Pokud (idx_t == 1) {
        Pokud (idx < 0 || idx >= velikost) {
            Volej printf("Chyba (radek %d): Index %lld je mimo pole '%s' (velikost %lld).\n", radek, idx, jmeno, velikost)
            Volej exit(1)
        }
        Vrat 0
    }
    Pokud (kontroly == 0) { Vrat 0 }
    Volej Ir(54, Volej ChybovaVetev(radek, "index mimo meze pole"), idx, 0, velikost, 1)
    Vrat 0
}

Metoda NovyVreg() {
    Lokalni t = citac_temp_reg
    citac_temp_reg = citac_temp_reg + 1
    Pokud (pocet_intervalu >= (kapacita_intervalu - 10)) {
        kapacita_intervalu = kapacita_intervalu * 2
        pamet_intervalu = Volej realloc(pamet_intervalu, kapacita_intervalu * Velikost(LiveInterval))
    }
    Lokalni interval : LiveInterval = pamet_intervalu + (pocet_intervalu * Velikost(LiveInterval))
    interval->var_id = t
    interval->start_instr = 0
    interval->end_instr = 0
    interval->fyzicky_reg = 0
    pocet_intervalu = pocet_intervalu + 1
    Vrat t
}


Metoda Konst(c) {
    Vrat Volej Ir(1, Volej NovyVreg(), c, 1, 0, 1)
}

Metoda NoveNavesti() {
    Lokalni n = citac_navesti
    citac_navesti = citac_navesti + 1
    Vrat n
}

// Prevedeni textu na trvaly retezec (jmena symbolu v IR musi prezit do prekladu)
Metoda TrvalyText1(fmt, a) {
    Lokalni b = Volej calloc(1, 300)
    Volej sprintf(b, fmt, a)
    Vrat b
}

// Zapisuje instrukce dest?  (ostatni pouzivaji dest jako navesti / cislo argumentu)
Metoda DefinujeDest(op) {
    Pokud (op == 1 || op == 2 || op == 26 || op == 27 || op == 28 || op == 29) { Vrat 1 }
    Pokud (op >= 4 && op <= 7) { Vrat 1 }
    Pokud (op >= 12 && op <= 22) { Vrat 1 }
    Pokud (op == 24 || op == 36 || op == 38 || op == 39 || op == 52 || op == 40 || op == 41 || op == 44 || op == 47 || op == 49 || op == 50) { Vrat 1 }
    Pokud (op >= 60 && op <= 72) { Vrat 1 } // desetinna cisla (bity double v celociselnem vregu)
    Pokud (op >= 80 && op <= 86) { Vrat 1 } // dvojice desetinnych cisel (vektorizace)
    Vrat 0
}

Metoda JePodmSkok(op) {
    Pokud (op == 9 || op == 54) { Vrat 1 }
    Pokud (op >= 30 && op <= 35) { Vrat 1 }
    Vrat 0
}

// ==========================================
// AST -> IR: vyrazy
// ==========================================
Metoda JeFloatUzel(u : AST_Node) {
    Pokud (u == 0) { Vrat 0 }
    Pokud (Volej strcmp(Volej ZiskejTypUzlu(u), "Float") == 0) { Vrat 1 }
    Vrat 0
}

// Hodnota cisla nebo vreg: cisla se vkladaji primo do instrukce (ir_op_typ = 1)
Metoda OperandNeboKonst(uzel : AST_Node) {
    Pokud (uzel != 0) {
        Pokud (uzel->type == AST_EXPR && uzel->op == TOKEN_NUMBER) {
            ir_op_typ = 1
            Vrat Volej NaCislo(uzel->name)
        }
    }
    Lokalni v = Volej GenerujHodnotu(uzel)
    ir_op_typ = 0
    Vrat v
}

// Hodnota promenne (vreg): povysena promenna je primo vreg, ostatni se nactou
Metoda HodnotaPromenne(sym : Symbol) {
    Pokud (sym->is_const) { Vrat Volej Konst(sym->const_val) }
    Pokud (sym->is_function) { Vrat Volej Ir(44, Volej NovyVreg(), sym->name, 3, 0, 1) }
    Pokud (sym->is_global && sym->dim1 > 0) { Vrat Volej Ir(44, Volej NovyVreg(), Volej TrvalyText1("gvar_%s", sym->name), 3, 0, 1) } // globalni pole -> adresa
    Pokud (sym->is_global) { Vrat Volej Ir(36, Volej NovyVreg(), sym->name, 3, 0, 1) }
    Pokud (sym->dim1 > 0) { Vrat Volej Ir(41, Volej NovyVreg(), sym->offset, 2, 0, 1) } // pole -> adresa
    Pokud (sym->vreg > 0) { Vrat sym->vreg }
    Vrat Volej Ir(2, Volej NovyVreg(), sym->offset, 2, 0, 1)
}

// Ulozi hodnotu (vreg, nebo konstantu pri t == 1) do promenne
Metoda UlozDoPromenne(sym : Symbol, hodnota, t) {
    Pokud (sym->is_global) { Volej Ir(37, 0, sym->name, 3, hodnota, t); Vrat 0 }
    Pokud (sym->vreg > 0) { Volej Ir(26, sym->vreg, hodnota, t, 0, 1); Vrat 0 }
    Volej Ir(3, 0, sym->offset, 2, hodnota, t)
    Vrat 0
}

Metoda NajdiPromennouNeboChyba(jmeno, radek) {
    Lokalni sym : Symbol = Volej NajdiSymbol(jmeno)
    Pokud (sym == 0) {
        Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", radek, jmeno)
        Volej exit(1)
    }
    Vrat sym
}

Metoda KodOperatoru(op) {
    Pokud (op == 67) { Vrat 4 }
    Pokud (op == 44) { Vrat 5 }
    Pokud (op == 49) { Vrat 6 }
    Pokud (op == 50) { Vrat 7 }
    Pokud (op == 80) { Vrat 27 }
    Pokud (op == 43) { Vrat 12 }
    Pokud (op == 64) { Vrat 13 }
    Pokud (op == 45) { Vrat 14 }
    Pokud (op == 46) { Vrat 15 }
    Pokud (op == 61) { Vrat 16 }
    Pokud (op == 62) { Vrat 17 }
    Pokud (op == 58) { Vrat 18 }
    Pokud (op == 124) { Vrat 19 }
    Pokud (op == 83) { Vrat 20 }
    Pokud (op == 84) { Vrat 21 }
    Pokud (op == 85) { Vrat 22 }
    Vrat 0
}

// Lze volani prelozit primo v IR? (max. 4 celociselne argumenty, prime volani)
// ==========================================
// VESTAVENE METODY PRO PRACI S HARDWAREM (napr. pri psani OS)
//   CtiBajt(adr)  Cti32(adr)  CtiZAdresu(adr)          - cteni 8 / 32 / 64 bitu
//   ZapisBajt(adr, h)  Zapis32(adr, h)  ZapisNaAdresu(adr, h)  - zapis 8 / 32 / 64 bitu
//   Bariera()                                          - pametova bariera (mfence / dmb sy)
// Prekladaji se primo na jednu instrukci. Optimalizator je nikdy neodstrani, nespoji
// ani neprehodi - funguji tedy i pro registry zarizeni (MMIO).
// ==========================================
Metoda JeVestavena(jmeno) {
    Pokud (Volej strcmp(jmeno, "CtiBajt") == 0) { Vrat 1 }
    Pokud (Volej strcmp(jmeno, "Cti32") == 0) { Vrat 2 }
    Pokud (Volej strcmp(jmeno, "ZapisBajt") == 0) { Vrat 3 }
    Pokud (Volej strcmp(jmeno, "Zapis32") == 0) { Vrat 4 }
    Pokud (Volej strcmp(jmeno, "ZapisNaAdresu") == 0) { Vrat 5 }
    Pokud (Volej strcmp(jmeno, "Bariera") == 0) { Vrat 6 }
    Vrat 0
}

Metoda PocetArgVestavene(kod) {
    Pokud (kod == 1 || kod == 2) { Vrat 1 }
    Pokud (kod == 6) { Vrat 0 }
    Vrat 2
}

// x86: vestavena metoda -> IR
Metoda GenerujVestavenou_x86(uzel : AST_Node, kod) {
    Pokud (kod == 6 && Volej JeARM() == 1) { Volej Ir(58, 0, 0, 1, 0, 1); Vrat Volej Konst(0) }
    Pokud (kod == 6) { Volej EmitujASM("    mfence\n"); Vrat Volej Konst(0) }
    Lokalni adr = Volej GenerujHodnotu(Volej CtiUkazatel(uzel->stmts))
    Pokud (kod == 1) { Vrat Volej Ir(50, Volej NovyVreg(), adr, 0, 0, 1) }
    Pokud (kod == 2) { Vrat Volej Ir(52, Volej NovyVreg(), adr, 0, 0, 1) }
    Lokalni h = Volej OperandNeboKonst(Volej CtiUkazatel(uzel->stmts + 8))
    Lokalni ht = ir_op_typ
    Pokud (kod == 3) { Volej Ir(51, 0, adr, 0, h, ht) }
    Pokud (kod == 4) { Volej Ir(53, 0, adr, 0, h, ht) }
    Pokud (kod == 5) { Volej Ir(43, 0, adr, 0, h, ht) }
    Vrat Volej Konst(0)
}

Metoda JeIRVolani(uzel : AST_Node) {
    Pokud (uzel->stmt_count > Volej PocetRegArg()) { Vrat 0 }
    Lokalni fsym : Symbol = Volej NajdiSymbol(uzel->name)
    Lokalni ok = Volej JeExterniJmeno(uzel->name)
    Pokud (fsym != 0) {
        Pokud (fsym->is_function == 1) { ok = 1 } Jinak { ok = 0 }
    }
    Pokud (ok == 0) { Vrat 0 }
    // Desetinne argumenty: metodam Pramenu jdou jako bity v celociselnem registru,
    // funkcim C do xmm/d registru (op 74)
    Lokalni i = 0
    Lokalni nf = 0
    Lokalni ni = 0
    Dokud (i < uzel->stmt_count) {
        Pokud (Volej JeFloatUzel(Volej CtiUkazatel(uzel->stmts + (i * 8))) == 1) { nf = nf + 1 } Jinak { ni = ni + 1 }
        i = i + 1
    }
    Pokud (nf > 0 && ok == 1 && fsym == 0 && nf > 4 && Volej JeARM() == 0) { Vrat 0 }
    Vrat 1
}

// ==========================================
// Vkladani metod (inlining) v IR, i rekurzivni
//   Volani male metody se nahradi jejim telem: parametry a lokalni promenne dostanou
//   nove vregy, Vrat se zmeni na "vysledek = hodnota; skok na konec".
//   Rekurzivni metoda (Fib) se vlozi sama do sebe nejvys do hloubky 2.
//   Nikdy se nevkladaji metody s Asm, Odloz nebo lokalnimi poli (OS kod zustane, jak je).
// ==========================================
Globalni inl_konec = 0          // navesti konce prave vkladaneho tela (0 = nevkladame)
Globalni inl_vysledek = 0       // vreg s navratovou hodnotou vkladaneho tela
Globalni inl_hloubka = 0
Globalni inl_zasobnik = 0       // metody, ktere se prave vkladaji (kvuli rekurzi)
Globalni inl_rozpocet = 0       // pocet vlozenych uzlu v aktualni metode
Globalni inl_vypnuto = 0        // --bez-vkladani

Globalni tce_hloubka = 0        // kolik cyklu z koncove rekurze obklopuje prave generovany kod
Globalni inl_odlozene = 0       // vetve "Pokud (...) { ... Vrat x }" presunute za telo
Globalni inl_odl_pocet = 0

// Konci prikaz (blok) navratem?
Metoda KonciNavratem(u : AST_Node) {
    Pokud (u == 0) { Vrat 0 }
    Pokud (u->type == AST_RETURN) { Vrat 1 }
    Pokud (u->type == AST_BLOCK && u->stmt_count > 0) {
        Vrat Volej KonciNavratem(Volej CtiUkazatel(u->stmts + ((u->stmt_count - 1) * 8)))
    }
    Vrat 0
}

Metoda PocetUzlu(u : AST_Node) {
    Pokud (u == 0) { Vrat 0 }
    Lokalni n = 1 + Volej PocetUzlu(u->left) + Volej PocetUzlu(u->right) + Volej PocetUzlu(u->alt)
    Pokud (u->stmts != 0) {
        Lokalni i = 0
        Dokud (i < u->stmt_count) {
            n = n + Volej PocetUzlu(Volej CtiUkazatel(u->stmts + (i * 8)))
            i = i + 1
        }
    }
    Vrat n
}

// Obsahuje podstrom volani metody daneho jmena?
Metoda VolaMetodu(u : AST_Node, jmeno) {
    Pokud (u == 0) { Vrat 0 }
    Pokud (u->type == AST_CALL) { Pokud (Volej strcmp(u->name, jmeno) == 0) { Vrat 1 } }
    Pokud (Volej VolaMetodu(u->left, jmeno) == 1) { Vrat 1 }
    Pokud (Volej VolaMetodu(u->right, jmeno) == 1) { Vrat 1 }
    Pokud (Volej VolaMetodu(u->alt, jmeno) == 1) { Vrat 1 }
    Pokud (u->stmts != 0) {
        Lokalni i = 0
        Dokud (i < u->stmt_count) {
            Pokud (Volej VolaMetodu(Volej CtiUkazatel(u->stmts + (i * 8)), jmeno) == 1) { Vrat 1 }
            i = i + 1
        }
    }
    Vrat 0
}

// ---------------------------------------------------------------------------
// Castecne vkladani: zacina-li metoda prikazem "Pokud (podminka) { Vrat vyraz }",
// kde podminka i vyraz ctou jen parametry, vyhodnoti se tahle "rychla cesta" uz na
// miste volani a skutecne volani probehne, jen kdyz podminka neplati.
// Fib(1) a Fib(0) pak nestoji cele volani (prolog, kontrola zasobniku, epilog).
// ---------------------------------------------------------------------------
Metoda JeParametrMetody(f : AST_Node, jmeno) {
    Lokalni i = 0
    Dokud (i < f->arg_count) {
        Lokalni ps : Symbol = pamet_symbolu + ((f->sym_start + i) * Velikost(Symbol))
        Pokud (Volej strcmp(ps->name, jmeno) == 0) {
            Pokud (Volej strcmp(ps->type_name, "Float") == 0) { Vrat 0 }
            Vrat 1
        }
        i = i + 1
    }
    Vrat 0
}

// Jen cela cisla, parametry a operace bez vedlejsich ucinku a bez deleni
Metoda JenParametry(u : AST_Node, f : AST_Node) {
    Pokud (u == 0) { Vrat 1 }
    Pokud (u->type != AST_EXPR) { Vrat 0 }
    Lokalni op = u->op
    Pokud (op == 35) { Vrat Volej JeParametrMetody(f, u->name) }
    Pokud (op == 34) { Vrat 1 }
    Lokalni ok = 0
    Pokud (op == 67 || op == 44 || op == 49 || op == 58 || op == 124 || op == 83) { ok = 1 }
    Pokud (op == 84 || op == 85 || op == 43 || op == 64 || op == 45 || op == 46) { ok = 1 }
    Pokud (op == 61 || op == 62 || op == 47 || op == 48 || op == 81) { ok = 1 }
    Pokud (ok == 0) { Vrat 0 }
    Pokud (Volej JenParametry(u->left, f) == 0) { Vrat 0 }
    Vrat Volej JenParametry(u->right, f)
}

// Vrati metodu, u ktere lze rychlou cestu vlozit na misto volani, jinak 0
Metoda LzeCastecne(uzel : AST_Node) {
    Pokud (inl_vypnuto == 1 || ir_metoda_ma_asm == 1) { Vrat 0 }
    Pokud (Volej JeExterniJmeno(uzel->name) == 1) { Vrat 0 }
    Lokalni fsym : Symbol = Volej NajdiSymbol(uzel->name)
    Pokud (fsym == 0) { Vrat 0 }
    Pokud (fsym->is_function == 0) { Vrat 0 }
    Lokalni f : AST_Node = fsym->func_node
    Pokud (f == 0) { Vrat 0 }
    Pokud (f->arg_count != uzel->stmt_count || f->right == 0) { Vrat 0 }
    Pokud (Volej strcmp(f->name, "Hlavni") == 0 || Volej strcmp(f->name, "main") == 0) { Vrat 0 }
    Pokud (Volej strcmp(f->type_name, "Float") == 0) { Vrat 0 }
    Pokud (Volej MetodaMaAsm(uzel->name) == 1) { Vrat 0 }
    Pokud (Volej JePamatovana(uzel->name) == 1) { Vrat 0 }
    Pokud (Volej ObsahujeTyp(f->right, AST_DEFER) == 1) { Vrat 0 }
    Pokud (Volej JeRekurenceNaCyklus(f) == 1) { Vrat 0 }
    // Rekurzivni volani ne: koncova rekurze s akumulatorem uz vetsinu listu odstranila
    // a test navic na konci vnitrniho cyklu procesor casto spatne odhadne (mereno: Fib o 10 % pomalejsi)
    Pokud (f == ir_metoda) { Vrat 0 }
    Lokalni kz = 0
    Dokud (kz < inl_hloubka) {
        Pokud (Volej CtiUkazatel(inl_zasobnik + (kz * 8)) == f) { Vrat 0 }
        kz = kz + 1
    }
    Lokalni telo : AST_Node = f->right
    Pokud (telo->type != AST_BLOCK || telo->stmt_count < 2) { Vrat 0 }
    Lokalni prvni : AST_Node = Volej CtiUkazatel(telo->stmts)
    Pokud (prvni->type != AST_IF || prvni->alt != 0) { Vrat 0 }
    Lokalni navrat : AST_Node = prvni->right
    Pokud (navrat == 0) { Vrat 0 }
    Pokud (navrat->type == AST_BLOCK) {
        Pokud (navrat->stmt_count != 1) { Vrat 0 }
        navrat = Volej CtiUkazatel(navrat->stmts)
    }
    Pokud (navrat->type != AST_RETURN || navrat->left == 0) { Vrat 0 }
    Pokud (Volej JenParametry(prvni->left, f) == 0) { Vrat 0 }
    Pokud (Volej JenParametry(navrat->left, f) == 0) { Vrat 0 }
    Pokud (Volej PocetUzlu(prvni->left) + Volej PocetUzlu(navrat->left) > 12) { Vrat 0 }
    Lokalni i = 0
    Dokud (i < uzel->stmt_count) {
        Pokud (Volej JeFloatUzel(Volej CtiUkazatel(uzel->stmts + (i * 8))) == 1) { Vrat 0 }
        i = i + 1
    }
    Vrat f
}

// Rychla cesta: pri splnene podmince zapise vysledek do vysl a skoci na konec;
// jinak pokracuje na navesti pomala (za ni nasleduje skutecne volani)
Metoda CastecnaStraz(f : AST_Node, hodnoty, vysl, konec) {
    Lokalni telo : AST_Node = f->right
    Lokalni prvni : AST_Node = Volej CtiUkazatel(telo->stmts)
    Lokalni navrat : AST_Node = prvni->right
    Pokud (navrat->type == AST_BLOCK) { navrat = Volej CtiUkazatel(navrat->stmts) }
    Lokalni n = f->arg_count
    Lokalni stare = Volej calloc(n + 1, 8)
    Lokalni s_start = codegen_sym_start
    Lokalni s_end = codegen_sym_end
    codegen_sym_start = f->sym_start
    codegen_sym_end = f->sym_end
    Lokalni i = 0
    Dokud (i < n) {
        Lokalni ps : Symbol = pamet_symbolu + ((f->sym_start + i) * Velikost(Symbol))
        Volej ZapisUkazatel(stare + (i * 8), ps->vreg)
        ps->vreg = CtiZAdresu(hodnoty + (i * 8))   // podminka parametry jen cte, kopie neni potreba
        i = i + 1
    }
    Lokalni pomala = Volej NoveNavesti()
    Volej GenerujSkok(prvni->left, pomala, 0)
    Lokalni v = Volej OperandNeboKonst(navrat->left)
    Volej Ir(26, vysl, v, ir_op_typ, 0, 1)
    Volej Ir(10, konec, 0, 1, 0, 1)
    Volej Ir(11, pomala, 0, 1, 0, 1)
    i = 0
    Dokud (i < n) {
        Lokalni ps2 : Symbol = pamet_symbolu + ((f->sym_start + i) * Velikost(Symbol))
        ps2->vreg = CtiZAdresu(stare + (i * 8))
        i = i + 1
    }
    codegen_sym_start = s_start
    codegen_sym_end = s_end
    Volej free(stare)
    Pokud (podrobny_vypis == 1) { Volej printf(">> Castecne vkladani: rychla cesta '%s' vlozena do '%s'\n", f->name, Volej JmenoMetodyIR()) }
    Vrat 0
}

// Vrati AST metody, kterou lze na tomto miste vlozit, jinak 0
Metoda LzeVlozitIR(uzel : AST_Node) {
    Pokud (inl_vypnuto == 1 || ir_metoda_ma_asm == 1 || inl_hloubka >= 4) { Vrat 0 }
    Pokud (Volej JeExterniJmeno(uzel->name) == 1) { Vrat 0 }
    Lokalni fsym : Symbol = Volej NajdiSymbol(uzel->name)
    Pokud (fsym == 0) { Vrat 0 }
    Pokud (fsym->is_function == 0) { Vrat 0 }
    Lokalni f : AST_Node = fsym->func_node
    Pokud (f == 0) { Vrat 0 }
    Pokud (f->arg_count != uzel->stmt_count || f->right == 0) { Vrat 0 }
    Pokud (Volej strcmp(f->name, "Hlavni") == 0 || Volej strcmp(f->name, "main") == 0) { Vrat 0 }
    Pokud (Volej strcmp(f->type_name, "Float") == 0) { Vrat 0 }
    Pokud (Volej MetodaMaAsm(uzel->name) == 1) { Vrat 0 }
    Pokud (Volej JePamatovana(uzel->name) == 1) { Vrat 0 }
    Pokud (Volej ObsahujeTyp(f->right, AST_DEFER) == 1) { Vrat 0 }
    Pokud (Volej JeRekurenceNaCyklus(f) == 1) { Vrat 0 }   // spocita se cyklem, vkladat rekurzi nema smysl
    Lokalni si = f->sym_start
    Dokud (si < f->sym_end) {
        Lokalni sym : Symbol = pamet_symbolu + (si * Velikost(Symbol))
        Pokud (sym->is_global == 0 && sym->is_function == 0 && sym->is_const == 0 && sym->dim1 != 0) { Vrat 0 }
        si = si + 1
    }
    // Kolikrat uz tahle metoda "bezi" (generovana metoda + vkladana tela)
    Lokalni rek = 0
    Pokud (f == ir_metoda) { rek = 1 }
    Lokalni k = 0
    Dokud (k < inl_hloubka) {
        Pokud (Volej CtiUkazatel(inl_zasobnik + (k * 8)) == f) { rek = rek + 1 }
        k = k + 1
    }
    Lokalni velikost = Volej PocetUzlu(f->right)
    // Rekurzivni metodu vkladame jen do ni same (jinde by kod jen rostl)
    Pokud (rek == 0 && Volej VolaMetodu(f->right, f->name) == 1) { Vrat 0 }
    Pokud (rek > 0) {
        Pokud (rek >= 4 || velikost > 60) { Vrat 0 }
    } Jinak {
        Pokud (velikost > 40) { Vrat 0 }
    }
    Pokud (inl_rozpocet + velikost > 800) { Vrat 0 }
    Vrat f
}

Metoda VlozMetodu(uzel : AST_Node, f : AST_Node) {
    Lokalni n = uzel->stmt_count
    // 1) Argumenty v rozsahu volajiciho
    Lokalni hodnoty = Volej calloc(n + 1, 8)
    Lokalni typy = Volej calloc(n + 1, 8)
    Lokalni i = 0
    Dokud (i < n) {
        Volej ZapisUkazatel(hodnoty + (i * 8), Volej OperandNeboKonst(Volej CtiUkazatel(uzel->stmts + (i * 8))))
        Volej ZapisUkazatel(typy + (i * 8), ir_op_typ)
        i = i + 1
    }
    // 2) Ulozit stav volajiciho a dat promennym volaneho nove vregy
    Lokalni pocet_sym = f->sym_end - f->sym_start
    Lokalni stare = Volej calloc(pocet_sym + 1, 8)
    Lokalni si = 0
    Dokud (si < pocet_sym) {
        Lokalni sym : Symbol = pamet_symbolu + ((f->sym_start + si) * Velikost(Symbol))
        Volej ZapisUkazatel(stare + (si * 8), sym->vreg)
        Pokud (sym->is_global == 0 && sym->is_const == 0 && sym->is_function == 0) { sym->vreg = Volej NovyVreg() }
        si = si + 1
    }
    Lokalni s_start = codegen_sym_start
    Lokalni s_end = codegen_sym_end
    Lokalni s_konec = inl_konec
    Lokalni s_vysl = inl_vysledek
    Lokalni s_tce = tce_aktivni
    Lokalni s_akum = tce_akumulator
    Lokalni s_tce_m = tce_metoda
    Lokalni s_tce_h0 = tce_hloubka
    Lokalni s_tce_op = tce_op
    Lokalni s_tce_start = tce_start
    Lokalni s_tce_konf = tce_konflikt
    Lokalni s_odl = inl_odlozene
    Lokalni s_odl_pocet = inl_odl_pocet
    inl_odlozene = Volej calloc(64, 16)
    inl_odl_pocet = 0
    codegen_sym_start = f->sym_start
    codegen_sym_end = f->sym_end
    tce_aktivni = 0
    tce_akumulator = 0
    inl_konec = Volej NoveNavesti()
    inl_vysledek = Volej NovyVreg()
    Lokalni vysledek = inl_vysledek
    Volej ZapisUkazatel(inl_zasobnik + (inl_hloubka * 8), f)
    inl_hloubka = inl_hloubka + 1
    inl_rozpocet = inl_rozpocet + Volej PocetUzlu(f->right)
    // 3) Parametry = argumenty
    i = 0
    Dokud (i < n) {
        Lokalni ps : Symbol = pamet_symbolu + ((f->sym_start + i) * Velikost(Symbol))
        Volej Ir(26, ps->vreg, CtiZAdresu(hodnoty + (i * 8)), CtiZAdresu(typy + (i * 8)), 0, 1)
        i = i + 1
    }
    // Koncova rekurze i ve vlozenem tele: Fib vlozeny do Fib je zase cyklus s akumulatorem
    // (takhle se pocet skutecnych volani zmensi mnohem vic nez prostym vlozenim)
    tce_metoda = f
    tce_op = 0
    tce_konflikt = 0
    Pokud (Volej AnalyzujTCE(f->right) == 1 && tce_konflikt == 0) {
        tce_aktivni = 1
        Pokud (tce_op != 0) {
            tce_akumulator = Volej NovyVreg()
            Pokud (tce_op == 49) { Volej Ir(26, tce_akumulator, 1, 1, 0, 1) } Jinak { Volej Ir(26, tce_akumulator, 0, 1, 0, 1) }
        }
        tce_start = Volej NoveNavesti()
        Volej Ir(11, tce_start, 0, 1, 0, 1)
        tce_hloubka = tce_hloubka + 1
    }
    // 4) Telo; konec bez Vrat vraci 0
    // Rychla cesta je souvisla a vysledek se zapisuje az na jejim konci, takze jeho
    // interval zivota je kratky (jinak by zabiral registr pres cele vlozene telo)
    Volej GenerujAST_x86(0, f->right)
    Lokalni konec_v = Volej SAkumulatorem(0, 1)
    Volej Ir(26, vysledek, konec_v, 0, 0, 1)
    Volej Ir(10, inl_konec, 0, 1, 0, 1)
    Lokalni oi = 0
    Dokud (oi < inl_odl_pocet) { // vetve, ktere koncily navratem (mohou pridat dalsi)
        Lokalni zaznam = inl_odlozene + (oi * 16)
        Volej Ir(11, CtiZAdresu(zaznam), 0, 1, 0, 1)
        Volej GenerujAST_x86(0, CtiZAdresu(zaznam + 8))
        Volej Ir(10, inl_konec, 0, 1, 0, 1)
        oi = oi + 1
    }
    Volej Ir(11, inl_konec, 0, 1, 0, 1)
    Volej free(inl_odlozene)
    inl_odlozene = s_odl
    inl_odl_pocet = s_odl_pocet
    // 5) Obnovit stav volajiciho
    inl_hloubka = inl_hloubka - 1
    si = 0
    Dokud (si < pocet_sym) {
        Lokalni sym2 : Symbol = pamet_symbolu + ((f->sym_start + si) * Velikost(Symbol))
        sym2->vreg = CtiZAdresu(stare + (si * 8))
        si = si + 1
    }
    codegen_sym_start = s_start
    codegen_sym_end = s_end
    inl_konec = s_konec
    inl_vysledek = s_vysl
    tce_aktivni = s_tce
    tce_akumulator = s_akum
    tce_hloubka = s_tce_h0
    tce_metoda = s_tce_m
    tce_op = s_tce_op
    tce_start = s_tce_start
    tce_konflikt = s_tce_konf
    Volej free(stare)
    Volej free(hodnoty)
    Volej free(typy)
    Pokud (podrobny_vypis == 1) { Volej printf(">> Vkladani: '%s' vlozena do '%s' (hloubka %d)\n", f->name, Volej JmenoMetodyIR(), inl_hloubka + 1) }
    Vrat vysledek
}

Metoda JmenoMetodyIR() {
    Lokalni m : AST_Node = ir_metoda
    Vrat m->name
}

// ==========================================
// Redukce sily v cyklech (strength reduction)
//   V cyklu, kde se j meni jen prikazem "j = j + K" a i se nemeni vubec, se soucin i * j
//   nepocita pokazde znovu: pred cyklem t = i * j, a hned za kazdym "j = j + K" t = t + i*K.
//   Celociselne preteceni se "pretaci" stejne, takze vysledek je vzdy totozny.
// ==========================================
Globalni sr_uzly = 0        // AST soucinu
Globalni sr_vregy = 0       // vreg, ktery soucin drzi
Globalni sr_zmeny = 0       // AST prikazu "j = j + K"
Globalni sr_kroky = 0       // vreg s hodnotou i*K
Globalni sr_pocet = 0
Globalni sr_posledni = 0    // posledni nalezene prirazeni (PocetPrirazeni)
Globalni sr_vypnuto = 0

Metoda PocetPrirazeni(u : AST_Node, jmeno) {
    Pokud (u == 0) { Vrat 0 }
    Lokalni n = 0
    Pokud (u->type == AST_VAR_DECL || u->type == AST_ASSIGN || u->type == AST_FREE) {
        Pokud (Volej strcmp(u->name, jmeno) == 0) { n = 1; sr_posledni = u }
    }
    n = n + Volej PocetPrirazeni(u->left, jmeno) + Volej PocetPrirazeni(u->right, jmeno) + Volej PocetPrirazeni(u->alt, jmeno)
    Pokud (u->stmts != 0) {
        Lokalni i = 0
        Dokud (i < u->stmt_count) {
            n = n + Volej PocetPrirazeni(Volej CtiUkazatel(u->stmts + (i * 8)), jmeno)
            i = i + 1
        }
    }
    Vrat n
}

Metoda PocetPrirazeniCyklu(telo : AST_Node, podm : AST_Node, krok : AST_Node, jmeno) {
    Lokalni n = Volej PocetPrirazeni(telo, jmeno) + Volej PocetPrirazeni(podm, jmeno)
    Lokalni p = sr_posledni
    Lokalni n2 = Volej PocetPrirazeni(krok, jmeno)
    Pokud (n2 == 0) { sr_posledni = p }
    Vrat n + n2
}

// Celociselna promenna drzena ve vregu?
Metoda JeRedukovatelna(u : AST_Node) {
    Pokud (u == 0) { Vrat 0 }
    Pokud (u->type != AST_EXPR || u->op != TOKEN_IDENTIFIER) { Vrat 0 }
    Lokalni sym : Symbol = Volej NajdiSymbol(u->name)
    Pokud (sym == 0) { Vrat 0 }
    Pokud (sym->is_global == 1 || sym->is_const == 1 || sym->is_function == 1 || sym->dim1 != 0 || sym->vreg == 0) { Vrat 0 }
    Pokud (Volej strcmp(sym->type_name, "Float") == 0) { Vrat 0 }
    Vrat 1
}

// Krok K, kdyz je prikaz tvaru "j = j + K", "j = K + j", "j = j - K", "j += K", "j -= K"; jinak 0
Metoda KrokIndukce(a : AST_Node, jmeno) {
    Pokud (a == 0) { Vrat 0 }
    Pokud (a->type != AST_ASSIGN) { Vrat 0 }
    Lokalni h : AST_Node = a->right
    Pokud (h == 0) { Vrat 0 }
    Pokud (a->op == TOKEN_PLUSEQ || a->op == TOKEN_MINUSEQ) {
        Pokud (h->type != AST_EXPR || h->op != TOKEN_NUMBER) { Vrat 0 }
        Lokalni k0 = Volej NaCislo(h->name)
        Pokud (a->op == TOKEN_MINUSEQ) { k0 = 0 - k0 }
        Vrat k0
    }
    Pokud (h->type != AST_EXPR || (h->op != TOKEN_PLUS && h->op != TOKEN_MINUS)) { Vrat 0 }
    Lokalni l : AST_Node = h->left
    Lokalni r : AST_Node = h->right
    Pokud (l == 0 || r == 0) { Vrat 0 }
    Pokud (l->type == AST_EXPR && l->op == TOKEN_IDENTIFIER && r->type == AST_EXPR && r->op == TOKEN_NUMBER) {
        Pokud (Volej strcmp(l->name, jmeno) == 0) {
            Lokalni k1 = Volej NaCislo(r->name)
            Pokud (h->op == TOKEN_MINUS) { k1 = 0 - k1 }
            Vrat k1
        }
    }
    Pokud (h->op == TOKEN_PLUS && r->type == AST_EXPR && r->op == TOKEN_IDENTIFIER && l->type == AST_EXPR && l->op == TOKEN_NUMBER) {
        Pokud (Volej strcmp(r->name, jmeno) == 0) { Vrat Volej NaCislo(l->name) }
    }
    Vrat 0
}

Metoda JeRedukovanySoucin(u : AST_Node) {
    Lokalni k = sr_pocet - 1
    Dokud (k >= 0) {
        Pokud (CtiZAdresu(sr_uzly + (k * 8)) == u) { Vrat k }
        k = k - 1
    }
    Vrat 0 - 1
}

// Projde podstrom a pro vhodne souciny pripravi redukci (kod pred cyklem)
Metoda NajdiSouciny(u : AST_Node, telo : AST_Node, podm : AST_Node, krok : AST_Node) {
    Pokud (u == 0 || sr_pocet >= 32) { Vrat 0 }
    Pokud (u->type == AST_EXPR && u->op == TOKEN_MUL && Volej JeRedukovanySoucin(u) < 0) {
        Pokud (Volej JeRedukovatelna(u->left) == 1 && Volej JeRedukovatelna(u->right) == 1) {
            Lokalni x : AST_Node = u->left
            Lokalni y : AST_Node = u->right
            Pokud (Volej strcmp(x->name, y->name) != 0) {
                // ktera je indukcni (jedno prirazeni j = j + K) a ktera se nemeni (zadne prirazeni)?
                Lokalni nx = Volej PocetPrirazeniCyklu(telo, podm, krok, x->name)
                Lokalni ax = sr_posledni
                Lokalni ny = Volej PocetPrirazeniCyklu(telo, podm, krok, y->name)
                Lokalni ay = sr_posledni
                Lokalni iv : AST_Node = 0
                Lokalni inv : AST_Node = 0
                Lokalni zmena : AST_Node = 0
                Pokud (nx == 1 && ny == 0) { iv = x; inv = y; zmena = ax }
                Pokud (ny == 1 && nx == 0) { iv = y; inv = x; zmena = ay }
                Pokud (iv != 0) {
                    Lokalni k = Volej KrokIndukce(zmena, iv->name)
                    Pokud (k != 0) {
                        Lokalni s_iv : Symbol = Volej NajdiSymbol(iv->name)
                        Lokalni s_inv : Symbol = Volej NajdiSymbol(inv->name)
                        Lokalni tv = Volej Ir(6, Volej NovyVreg(), s_iv->vreg, 0, s_inv->vreg, 0)
                        Lokalni krok_v = s_inv->vreg
                        Pokud (k != 1) {
                            Pokud (k == 0 - 1) { krok_v = Volej Ir(28, Volej NovyVreg(), s_inv->vreg, 0, 0, 1) }
                            Jinak { krok_v = Volej Ir(6, Volej NovyVreg(), s_inv->vreg, 0, k, 1) }
                        }
                        Volej ZapisUkazatel(sr_uzly + (sr_pocet * 8), u)
                        Volej ZapisUkazatel(sr_vregy + (sr_pocet * 8), tv)
                        Volej ZapisUkazatel(sr_zmeny + (sr_pocet * 8), zmena)
                        Volej ZapisUkazatel(sr_kroky + (sr_pocet * 8), krok_v)
                        sr_pocet = sr_pocet + 1
                        Pokud (podrobny_vypis == 1) { Volej printf(">> Redukce sily: '%s * %s' v cyklu (radek %d) se pocita pricitanim\n", x->name, y->name, u->line) }
                    }
                }
            }
        }
    }
    Volej NajdiSouciny(u->left, telo, podm, krok)
    Volej NajdiSouciny(u->right, telo, podm, krok)
    Volej NajdiSouciny(u->alt, telo, podm, krok)
    Pokud (u->stmts != 0) {
        Lokalni i = 0
        Dokud (i < u->stmt_count) {
            Volej NajdiSouciny(Volej CtiUkazatel(u->stmts + (i * 8)), telo, podm, krok)
            i = i + 1
        }
    }
    Vrat 0
}

// Po prirazeni do indukcni promenne: posunout vsechny jeji souciny
Metoda PosunSouciny(prikaz : AST_Node) {
    Lokalni k = 0
    Dokud (k < sr_pocet) {
        Pokud (CtiZAdresu(sr_zmeny + (k * 8)) == prikaz) {
            Lokalni tv = CtiZAdresu(sr_vregy + (k * 8))
            Volej Ir(4, tv, tv, 0, CtiZAdresu(sr_kroky + (k * 8)), 0)
        }
        k = k + 1
    }
    Vrat 0
}

// Operator desetinnych cisel -> IR instrukce (0 = neumime, napr. %)
//   60 + 61 - 62 * 63 /, 66 == 67 != 68 < 69 > 70 <= 71 >=
Metoda KodFloatOperatoru(op) {
    Pokud (op == 67) { Vrat 60 }
    Pokud (op == 44) { Vrat 61 }
    Pokud (op == 49) { Vrat 62 }
    Pokud (op == 50) { Vrat 63 }
    Pokud (op == 43) { Vrat 66 }
    Pokud (op == 64) { Vrat 67 }
    Pokud (op == 45) { Vrat 68 }
    Pokud (op == 46) { Vrat 69 }
    Pokud (op == 61) { Vrat 70 }
    Pokud (op == 62) { Vrat 71 }
    Vrat 0
}

// ==========================================
// Rozsahy hodnot (range analysis)
//   Uvnitr cyklu "Dokud (j < N)", kde se j meni jen prikazem j = j + K (K > 0) a pred cyklem
//   je j = c >= 0, plati c <= j <= N - 1 + K. Z toho se dopocita rozsah vyrazu (i * j) ^ (i + j)
//   a kdyz je urcite nezaporny, deli se konstantou bez opravy pro zaporna cisla (gcc tu opravu
//   dela vzdy). Index pole s dokazanym rozsahem se nekontroluje.
// ==========================================
Globalni rz_sym = 0
Globalni rz_lo = 0
Globalni rz_hi = 0
Globalni rz_pocet = 0
Globalni rz_predchozi = 0
Globalni rz_l = 0
Globalni rz_h = 0
Globalni rz_meze_ok = 0
Konstanta RZ_MAX = 2305843009213693952   // 2^61: vetsi rozsahy nesledujeme (bez rizika preteceni)

Metoda IndexVPoli(idx : AST_Node, velikost) {
    rz_meze_ok = 0
    Pokud (Volej Rozsah(idx) == 1) { Pokud (rz_l >= 0 && rz_h < velikost) { rz_meze_ok = 1 } }
    Vrat 0
}

// Rozsah vyrazu: 1 = znamy (rz_l..rz_h), 0 = neznamy
Metoda Rozsah(u : AST_Node) {
    Pokud (u == 0 || rz_pocet == 0) { Vrat 0 }
    Pokud (u->type != AST_EXPR) { Vrat 0 }
    Pokud (u->op == TOKEN_NUMBER) { rz_l = Volej NaCislo(u->name); rz_h = rz_l; Vrat 1 }
    Pokud (u->op == TOKEN_IDENTIFIER) {
        Lokalni sym : Symbol = Volej NajdiSymbol(u->name)
        Pokud (sym == 0) { Vrat 0 }
        Pokud (sym->is_const == 1) { rz_l = sym->const_val; rz_h = rz_l; Vrat 1 }
        Lokalni k = rz_pocet - 1
        Dokud (k >= 0) {
            Pokud (CtiZAdresu(rz_sym + (k * 8)) == sym) { rz_l = CtiZAdresu(rz_lo + (k * 8)); rz_h = CtiZAdresu(rz_hi + (k * 8)); Vrat 1 }
            k = k - 1
        }
        Vrat 0
    }
    Pokud (u->left == 0 || u->right == 0) { Vrat 0 }
    Pokud (Volej Rozsah(u->left) == 0) { Vrat 0 }
    Lokalni l1 = rz_l
    Lokalni h1 = rz_h
    Pokud (Volej Rozsah(u->right) == 0) { Vrat 0 }
    Lokalni l2 = rz_l
    Lokalni h2 = rz_h
    Pokud (l1 < 0 - RZ_MAX || h1 > RZ_MAX || l2 < 0 - RZ_MAX || h2 > RZ_MAX) { Vrat 0 }
    Lokalni op = u->op
    Pokud (op == 67) { rz_l = l1 + l2; rz_h = h1 + h2; Vrat 1 }          // +
    Pokud (op == 44) { rz_l = l1 - h2; rz_h = h1 - l2; Vrat 1 }          // -
    Pokud (op == 49) {                                                   // *
        Pokud (l1 < 0 || l2 < 0) { Vrat 0 }
        Pokud (h1 > 0 && h2 > RZ_MAX / h1) { Vrat 0 }
        rz_l = l1 * l2
        rz_h = h1 * h2
        Vrat 1
    }
    Pokud (op == 83 || op == 124) {                                      // ^ |
        Pokud (l1 < 0 || l2 < 0) { Vrat 0 }
        Lokalni m = h1
        Pokud (h2 > m) { m = h2 }
        Lokalni p2 = 1
        Dokud (p2 <= m) { p2 = p2 * 2 }
        rz_l = 0
        rz_h = p2 - 1
        Vrat 1
    }
    Pokud (op == 58) {                                                   // &
        Pokud (l1 >= 0 && l2 >= 0) { rz_l = 0; rz_h = h1; Pokud (h2 < h1) { rz_h = h2 }; Vrat 1 }
        Pokud (l1 >= 0) { rz_l = 0; rz_h = h1; Vrat 1 }
        Pokud (l2 >= 0) { rz_l = 0; rz_h = h2; Vrat 1 }
        Vrat 0
    }
    Pokud (op == 80 && l2 == h2 && l2 > 0 && l1 >= 0) { rz_l = 0; rz_h = l2 - 1; Vrat 1 }   // % c
    Pokud (op == 50 && l2 == h2 && l2 > 0 && l1 >= 0) { rz_l = l1 / l2; rz_h = h1 / l2; Vrat 1 } // / c
    Vrat 0
}

// Indukcni promenna cyklu a jeji rozsah (jen kdyz je to bezpecne dokazatelne)
Metoda PridejRozsahCyklu(podm : AST_Node, telo : AST_Node, krok : AST_Node, vstup : AST_Node) {
    Pokud (podm == 0 || vstup == 0 || rz_pocet >= 30 || ir_metoda_ma_asm == 1) { Vrat 0 }
    Pokud (rz_sym == 0) { rz_sym = Volej calloc(32, 8); rz_lo = Volej calloc(32, 8); rz_hi = Volej calloc(32, 8) }
    Pokud (podm->type != AST_EXPR || (podm->op != 45 && podm->op != 61)) { Vrat 0 } // < nebo <=
    Lokalni v : AST_Node = podm->left
    Pokud (Volej JeRedukovatelna(v) == 0) { Vrat 0 }
    // horni mez: konstanta nebo vyraz se znamym rozsahem, ktery se v cyklu nemeni
    Lokalni pravy : AST_Node = podm->right
    Pokud (Volej Rozsah(pravy) == 0) {
        Pokud (rz_pocet > 0) { Vrat 0 }
        Pokud (pravy->type != AST_EXPR || pravy->op != TOKEN_NUMBER) { Vrat 0 }
        rz_h = Volej NaCislo(pravy->name)
    }
    Lokalni n = rz_h
    Pokud (pravy->type == AST_EXPR && pravy->op == TOKEN_IDENTIFIER) {
        Pokud (Volej PocetPrirazeniCyklu(telo, podm, krok, pravy->name) != 0) { Vrat 0 }
    }
    // jedina zmena v cyklu: v = v + K, K > 0
    Pokud (Volej PocetPrirazeniCyklu(telo, podm, krok, v->name) != 1) { Vrat 0 }
    Lokalni k = Volej KrokIndukce(sr_posledni, v->name)
    Pokud (k <= 0 || k > 1048576) { Vrat 0 }
    // vstup: prikaz tesne pred cyklem nastavi v na hodnotu >= 0
    Pokud (vstup->type != AST_VAR_DECL && vstup->type != AST_ASSIGN) { Vrat 0 }
    Pokud (Volej strcmp(vstup->name, v->name) != 0) { Vrat 0 }
    Pokud (vstup->type == AST_ASSIGN && vstup->op != TOKEN_EQ) { Vrat 0 }
    Pokud (Volej Rozsah(vstup->right) == 0) {
        Lokalni hv : AST_Node = vstup->right
        Pokud (hv == 0) { Vrat 0 }
        Pokud (hv->type != AST_EXPR || hv->op != TOKEN_NUMBER) { Vrat 0 }
        rz_l = Volej NaCislo(hv->name)
    }
    Lokalni lo = rz_l
    Pokud (lo < 0 || n > RZ_MAX || n < 0) { Vrat 0 }
    Lokalni hi = n - 1 + k
    Pokud (podm->op == 61) { hi = n + k }
    Pokud (lo > hi) { hi = lo }
    Volej ZapisUkazatel(rz_sym + (rz_pocet * 8), Volej NajdiSymbol(v->name))
    Volej ZapisUkazatel(rz_lo + (rz_pocet * 8), lo)
    Volej ZapisUkazatel(rz_hi + (rz_pocet * 8), hi)
    rz_pocet = rz_pocet + 1
    Pokud (podrobny_vypis == 1) { Volej printf(">> Rozsah: '%s' je v cyklu (radek %d) mezi %lld a %lld\n", v->name, podm->line, lo, hi) }
    Vrat 1
}

// Hlavni prekladac vyrazu: vrati vreg s vysledkem
Metoda GenerujHodnotu(uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat Volej Konst(0) }
    Lokalni t = uzel->type
    Pokud (sr_pocet > 0 && t == AST_EXPR) {
        Lokalni sr_i = Volej JeRedukovanySoucin(uzel)
        Pokud (sr_i >= 0) { Vrat CtiZAdresu(sr_vregy + (sr_i * 8)) }
    }
    Pokud (t == 5) {
        Lokalni op = uzel->op
        Pokud (op == 34) { Vrat Volej Konst(Volej NaCislo(uzel->name)) }
        Pokud (op == 33) { Vrat Volej Ir(44, Volej NovyVreg(), Volej TrvalyText1("str%d", uzel->int_val), 3, 0, 1) }
        Pokud (op == 35) {
            Lokalni sym : Symbol = Volej NajdiSymbol(uzel->name)
            Pokud (sym == 0) {
                Pokud (Volej JeExterniJmeno(uzel->name) == 1) {
                    Vrat Volej Ir(44, Volej NovyVreg(), Volej NazevC_x86(uzel->name), 3, 0, 1)
                }
                Volej NajdiPromennouNeboChyba(uzel->name, uzel->line)
            }
            Vrat Volej HodnotaPromenne(sym)
        }
        Pokud (op == 53) { // CtiZAdresu(a)
            Lokalni adr = Volej GenerujHodnotu(uzel->left)
            Vrat Volej Ir(49, Volej NovyVreg(), adr, 0, 0, 1)
        }
        Lokalni je_f = 0
        Pokud (Volej JeFloatUzel(uzel->left) == 1 || Volej JeFloatUzel(uzel->right) == 1) { je_f = 1 }
        // --- Desetinna cisla v IR: hodnota je 64 bitu double v obycejnem vregu ---
        Pokud (op == 98) { Vrat Volej Ir(72, Volej NovyVreg(), Volej TrvalyText1("flt%d", uzel->int_val), 3, 0, 1) }
        Pokud (op == 44 && uzel->right == 0 && je_f == 1) { // -x: preklopit znamenkovy bit
            Lokalni znam = 1 << 63
            Vrat Volej Ir(20, Volej NovyVreg(), Volej GenerujHodnotu(uzel->left), 0, znam, 1)
        }
        Pokud (je_f == 1 && uzel->left != 0 && uzel->right != 0) {
            Lokalni fop = Volej KodFloatOperatoru(op)
            Pokud (fop != 0) {
                Lokalni fa = Volej GenerujHodnotu(uzel->left)
                Pokud (Volej JeFloatUzel(uzel->left) == 0) { fa = Volej Ir(64, Volej NovyVreg(), fa, 0, 0, 1) }
                Lokalni fb = Volej GenerujHodnotu(uzel->right)
                Pokud (Volej JeFloatUzel(uzel->right) == 0) { fb = Volej Ir(64, Volej NovyVreg(), fb, 0, 0, 1) }
                Vrat Volej Ir(fop, Volej NovyVreg(), fa, 0, fb, 0)
            }
        }
        Pokud (op == 44 && uzel->right == 0 && je_f == 0) {
            Vrat Volej Ir(28, Volej NovyVreg(), Volej GenerujHodnotu(uzel->left), 0, 0, 1)
        }
        Pokud (op == 81) {
            Vrat Volej Ir(29, Volej NovyVreg(), Volej GenerujHodnotu(uzel->left), 0, 0, 1)
        }
        Pokud (op == 47 || op == 48) { // && || : vysledek 0/1 se zkracenym vyhodnocenim
            Lokalni v = Volej NovyVreg()
            Lokalni n_konec = Volej NoveNavesti()
            Pokud (op == 47) {
                Volej Ir(26, v, 0, 1, 0, 1)
                Volej GenerujSkok(uzel->left, n_konec, 0)
                Volej GenerujSkok(uzel->right, n_konec, 0)
                Volej Ir(26, v, 1, 1, 0, 1)
            } Jinak {
                Volej Ir(26, v, 1, 1, 0, 1)
                Volej GenerujSkok(uzel->left, n_konec, 1)
                Volej GenerujSkok(uzel->right, n_konec, 1)
                Volej Ir(26, v, 0, 1, 0, 1)
            }
            Volej Ir(11, n_konec, 0, 1, 0, 1)
            Vrat v
        }
        // --- Texty v IR: spojeni (95) a porovnani (96 ==, 97 !=) pres funkce knihovny C ---
        Pokud ((op == 95 || op == 96 || op == 97) && uzel->left != 0 && uzel->right != 0) {
            Volej ZakazVJadru(uzel->line, "prace s texty")
            Lokalni ta = Volej GenerujHodnotu(uzel->left)
            Lokalni tb = Volej GenerujHodnotu(uzel->right)
            Pokud (op == 95) {
                // presne tolik pameti, kolik je potreba; kopirovani memcpy (bez opakovaneho hledani konce)
                Volej Ir(23, 0, ta, 0, 0, 1)
                Lokalni la = Volej Ir(24, Volej NovyVreg(), "strlen", 3, 1, 1)
                Volej Ir(23, 0, tb, 0, 0, 1)
                Lokalni lb = Volej Ir(24, Volej NovyVreg(), "strlen", 3, 1, 1)
                Lokalni lb1 = Volej Ir(4, Volej NovyVreg(), lb, 0, 1, 1)
                Lokalni nt = Volej Ir(4, Volej NovyVreg(), la, 0, lb1, 0)
                Volej Ir(23, 0, nt, 0, 0, 1)
                Lokalni pt = Volej Ir(24, Volej NovyVreg(), "malloc", 3, 1, 1)
                Volej Ir(31, Volej ChybovaVetev(uzel->line, "spojeni textu: nedostatek pameti"), pt, 0, 0, 1)
                Volej Ir(23, 0, pt, 0, 0, 1)
                Volej Ir(23, 1, ta, 0, 0, 1)
                Volej Ir(23, 2, la, 0, 0, 1)
                Volej Ir(24, Volej NovyVreg(), "memcpy", 3, 3, 1)
                Lokalni pk = Volej Ir(4, Volej NovyVreg(), pt, 0, la, 0)
                Volej Ir(23, 0, pk, 0, 0, 1)
                Volej Ir(23, 1, tb, 0, 0, 1)
                Volej Ir(23, 2, lb1, 0, 0, 1)
                Volej Ir(24, Volej NovyVreg(), "memcpy", 3, 3, 1)
                Vrat pt
            }
            Volej Ir(23, 0, ta, 0, 0, 1)
            Volej Ir(23, 1, tb, 0, 0, 1)
            Lokalni rc = Volej Ir(24, Volej NovyVreg(), "strcmp", 3, 2, 1)
            Pokud (op == 96) { Vrat Volej Ir(12, Volej NovyVreg(), rc, 0, 0, 1) }
            Vrat Volej Ir(13, Volej NovyVreg(), rc, 0, 0, 1)
        }
        Lokalni kod = Volej KodOperatoru(op)
        Pokud (kod != 0 && uzel->left != 0 && uzel->right != 0 && je_f == 0) {
            Lokalni a = Volej GenerujHodnotu(uzel->left)
            Lokalni b = Volej OperandNeboKonst(uzel->right)
            Lokalni bt = ir_op_typ
            Pokud ((kod == 7 || kod == 27) && bt == 0) {
                // Deleni promennou: pri nule srozumitelna chyba misto padu programu
                // SKOK_KDYZ_NE(!=): skoc na chybu, kdyz NEPLATI b != 0, tedy kdyz b == 0
                Volej Ir(31, Volej ChybovaVetev(uzel->line, "deleni nulou"), b, 0, 0, 1)
            }
            Pokud (bt == 1) {
                // Algebraicke zjednoduseni s konstantou
                Pokud ((kod == 4 || kod == 5 || kod == 21 || kod == 22 || kod == 19 || kod == 20) && b == 0) { Vrat a }
                Pokud ((kod == 6 || kod == 7) && b == 1) { Vrat a }
                // Delenec urcite nezaporny (rozsah z cyklu) -> deleni bez opravy pro zaporna cisla
                Pokud ((kod == 7 || kod == 27) && b >= 2 && Volej JeRychleDeleni(b) == 1) {
                    Pokud (Volej Rozsah(uzel->left) == 1 && rz_l >= 0) { bt = 5 }
                }
            }
            Vrat Volej Ir(kod, Volej NovyVreg(), a, 0, b, bt)
        }
    }
    Pokud (t == 20) {
        Lokalni vest = Volej JeVestavena(uzel->name)
        Pokud (vest > 0) { Vrat Volej GenerujVestavenou_x86(uzel, vest) }
        Pokud (Volej JeIRVolani(uzel) == 1) {
            Lokalni vkl : AST_Node = Volej LzeVlozitIR(uzel)
            Pokud (vkl != 0) { Vrat Volej VlozMetodu(uzel, vkl) }
            Lokalni n = uzel->stmt_count
            Lokalni hodnoty = Volej calloc(n + 1, 8)
            Lokalni i = 0
            Dokud (i < n) {
                Volej ZapisUkazatel(hodnoty + (i * 8), Volej GenerujHodnotu(Volej CtiUkazatel(uzel->stmts + (i * 8))))
                i = i + 1
            }
            Lokalni cv_f : AST_Node = Volej LzeCastecne(uzel)
            Lokalni cv_vysl = 0
            Lokalni cv_konec = 0
            Pokud (cv_f != 0) {
                cv_vysl = Volej NovyVreg()
                cv_konec = Volej NoveNavesti()
                Volej CastecnaStraz(cv_f, hodnoty, cv_vysl, cv_konec)
            }
            // Registry argumentu: metody Pramenu a Windows podle pozice; funkce C na Linuxu/macOS
            // a ARM pocitaji cela a desetinna cisla zvlast (desetinne -> op 74 do xmm/d).
            // V src2 je posun "pozice - index registru" (pro variadicke argumenty na macOS ARM).
            Lokalni je_c_vol = Volej JeCFunkceA(uzel->name)
            Lokalni ni_v = 0
            Lokalni nf_v = 0
            i = 0
            Dokud (i < n) {
                Lokalni arg_f = 0
                Pokud (je_c_vol == 1) { arg_f = Volej JeFloatUzel(Volej CtiUkazatel(uzel->stmts + (i * 8))) }
                Pokud (arg_f == 1) {
                    Pokud (cilova_platforma == 2) { Volej Ir(74, i, Volej CtiUkazatel(hodnoty + (i * 8)), 0, 0, 1) }
                    Jinak { Volej Ir(74, nf_v, Volej CtiUkazatel(hodnoty + (i * 8)), 0, i - nf_v, 1) }
                    nf_v = nf_v + 1
                } Jinak {
                    Pokud (cilova_platforma == 2 || je_c_vol == 0) { Volej Ir(23, i, Volej CtiUkazatel(hodnoty + (i * 8)), 0, 0, 1) }
                    Jinak { Volej Ir(23, ni_v, Volej CtiUkazatel(hodnoty + (i * 8)), 0, i - ni_v, 1) }
                    ni_v = ni_v + 1
                }
                i = i + 1
            }
            Volej free(hodnoty)
            Lokalni vys_vol = Volej Ir(24, Volej NovyVreg(), uzel->name, 3, n, 1)
            Pokud (cv_f != 0) {
                Volej Ir(26, cv_vysl, vys_vol, 0, 0, 1)
                Volej Ir(11, cv_konec, 0, 1, 0, 1)
                Vrat cv_vysl
            }
            Vrat vys_vol
        }
    }
    Pokud (t == 16) { // p->clen
        Lokalni sym16 : Symbol = Volej NajdiPromennouNeboChyba(uzel->name, uzel->line)
        Lokalni zaklad = Volej HodnotaPromenne(sym16)
        Volej KontrolaUkazatele(zaklad, uzel->line)
        Pokud (Volej JeClenPole(sym16->type_name, uzel->sub_name) == 1) {
            Pokud (uzel->int_val == 0) { Vrat zaklad }
            Vrat Volej Ir(4, Volej NovyVreg(), zaklad, 0, uzel->int_val, 1)
        }
        Vrat Volej Ir(49, Volej NovyVreg(), zaklad, 0, uzel->int_val, 1)
    }
    Pokud (t == 27) { // p->clen[i] (bajt)
        Lokalni sym27 : Symbol = Volej NajdiPromennouNeboChyba(uzel->name, uzel->line)
        Pokud (Volej JeClenPole(sym27->type_name, uzel->sub_name) == 0) {
            Volej printf("Chyba (radek %d): '%s->%s' neni pole, nelze ho indexovat.\n", uzel->line, uzel->name, uzel->sub_name)
            Volej exit(1)
        }
        Lokalni idx27 = Volej OperandNeboKonst(uzel->left)
        Lokalni idx27_t = ir_op_typ
        Volej KontrolaMeze(idx27, idx27_t, Volej VelikostClenu(sym27->type_name, uzel->sub_name), uzel->line, uzel->sub_name)
        Lokalni z27 = Volej HodnotaPromenne(sym27)
        Volej KontrolaUkazatele(z27, uzel->line)
        Pokud (uzel->int_val != 0) { z27 = Volej Ir(4, Volej NovyVreg(), z27, 0, uzel->int_val, 1) }
        Vrat Volej Ir(50, Volej NovyVreg(), z27, 0, idx27, idx27_t)
    }
    Pokud (t == 32) { // a[i]
        Lokalni sym32 : Symbol = Volej NajdiPromennouNeboChyba(uzel->name, uzel->line)
        Lokalni idx32 = Volej OperandNeboKonst(uzel->left)
        Lokalni idx32_t = ir_op_typ
        Pokud (sym32->dim1 > 0) { Volej IndexVPoli(uzel->left, sym32->dim1 * sym32->dim2) }
        Pokud (sym32->dim1 > 0) { Volej KontrolaMeze(idx32, idx32_t, sym32->dim1 * sym32->dim2, uzel->line, uzel->name) }
        Pokud (idx32_t == 1) { idx32 = Volej Konst(idx32) }
        Lokalni z32 = Volej HodnotaPromenne(sym32)
        Vrat Volej Ir(40, Volej NovyVreg(), z32, 0, idx32, 0)
    }
    Pokud (t == AST_MEMBER_CHAIN) { // a->b->c
        Lokalni zc = Volej GenerujHodnotu(uzel->left)
        Volej KontrolaUkazatele(zc, uzel->line)
        Pokud (Volej JeClenPole(uzel->name, uzel->sub_name) == 1) {
            Pokud (uzel->int_val == 0) { Vrat zc }
            Vrat Volej Ir(4, Volej NovyVreg(), zc, 0, uzel->int_val, 1)
        }
        Vrat Volej Ir(49, Volej NovyVreg(), zc, 0, uzel->int_val, 1)
    }
    Pokud (t == AST_ALLOC && Volej JeARM() == 1) { // Alokuj na ARM64: calloc(1, n) a kontrola
        Volej ZakazVJadru(uzel->line, "Alokuj")
        Lokalni nv_a = Volej GenerujHodnotu(uzel->left)
        Volej Ir(23, 0, 1, 1, 0, 1)
        Volej Ir(23, 1, nv_a, 0, 0, 1)
        Lokalni av_a = Volej Ir(24, Volej NovyVreg(), "calloc", 3, 0, 1)
        Volej Ir(31, Volej ChybovaVetev(uzel->line, "Alokuj: nedostatek pameti"), av_a, 0, 0, 1)
        Vrat av_a
    }
    // Vse ostatni (desetinna cisla, texty, Alokuj, slozita volani) generuje surova cast do rax
    Volej GenerujVyraz_surovy(uzel)
    Vrat Volej Ir(38, Volej NovyVreg(), 0, 1, 0, 1)
}

// Kod porovnani pro SKOK_KDYZ_NE (30..35) a jeho opak
Metoda KodSkoku(op) {
    Pokud (op == 43) { Vrat 30 }
    Pokud (op == 64) { Vrat 31 }
    Pokud (op == 45) { Vrat 32 }
    Pokud (op == 46) { Vrat 33 }
    Pokud (op == 61) { Vrat 34 }
    Pokud (op == 62) { Vrat 35 }
    Vrat 0
}
Metoda OpacnySkok(kod) {
    Pokud (kod == 30) { Vrat 31 }
    Pokud (kod == 31) { Vrat 30 }
    Pokud (kod == 32) { Vrat 35 }
    Pokud (kod == 35) { Vrat 32 }
    Pokud (kod == 33) { Vrat 34 }
    Vrat 33
}

// Podminka: skoc na navesti, kdyz ma podminka hodnotu kdy (1 = pravda, 0 = nepravda)
Metoda GenerujSkok(podm : AST_Node, navesti, kdy) {
    Pokud (podm == 0) { Vrat 0 }
    Pokud (podm->type == AST_EXPR) {
        Lokalni op = podm->op
        Pokud (op == 34) {
            Lokalni pravda = 0
            Pokud (Volej NaCislo(podm->name) != 0) { pravda = 1 }
            Pokud (pravda == kdy) { Volej Ir(10, navesti, 0, 1, 0, 1) }
            Vrat 0
        }
        Pokud (op == 81) { Vrat Volej GenerujSkok(podm->left, navesti, 1 - kdy) }
        Pokud (op == 47) {
            Pokud (kdy == 0) {
                Volej GenerujSkok(podm->left, navesti, 0)
                Volej GenerujSkok(podm->right, navesti, 0)
            } Jinak {
                Lokalni preskoc = Volej NoveNavesti()
                Volej GenerujSkok(podm->left, preskoc, 0)
                Volej GenerujSkok(podm->right, navesti, 1)
                Volej Ir(11, preskoc, 0, 1, 0, 1)
            }
            Vrat 0
        }
        Pokud (op == 48) {
            Pokud (kdy == 1) {
                Volej GenerujSkok(podm->left, navesti, 1)
                Volej GenerujSkok(podm->right, navesti, 1)
            } Jinak {
                Lokalni preskoc2 = Volej NoveNavesti()
                Volej GenerujSkok(podm->left, preskoc2, 1)
                Volej GenerujSkok(podm->right, navesti, 0)
                Volej Ir(11, preskoc2, 0, 1, 0, 1)
            }
            Vrat 0
        }
        Lokalni ks = Volej KodSkoku(op)
        Pokud (ks != 0 && podm->left != 0 && podm->right != 0) {
            Pokud (Volej JeFloatUzel(podm->left) == 0 && Volej JeFloatUzel(podm->right) == 0) {
                Lokalni a = Volej GenerujHodnotu(podm->left)
                Lokalni b = Volej OperandNeboKonst(podm->right)
                Lokalni bt = ir_op_typ
                Pokud (kdy == 1) { ks = Volej OpacnySkok(ks) }
                Volej Ir(ks, navesti, a, 0, b, bt)
                Vrat 0
            }
        }
    }
    Lokalni v = Volej GenerujHodnotu(podm)
    Pokud (kdy == 1) { Volej Ir(30, navesti, v, 0, 0, 1) } Jinak { Volej Ir(31, navesti, v, 0, 0, 1) }
    Vrat 0
}

// Chybova vetev mimo hlavni cestu kodu; vrati navesti, na ktere se ma skocit
Metoda ChybovaVetev(radek, zprava) {
    Pokud (ir_chyby_navesti == 0) { ir_chyby_navesti = Volej calloc(3 * 4096, 8) }
    Pokud (ir_chyby_pocet >= 4096) { Vrat Volej ChybovaVetev_posledni() }
    Lokalni n = Volej NoveNavesti()
    Lokalni b = ir_chyby_navesti + (ir_chyby_pocet * 24)
    Volej ZapisUkazatel(b, n)
    Volej ZapisUkazatel(b + 8, radek)
    Volej ZapisUkazatel(b + 16, zprava)
    ir_chyby_pocet = ir_chyby_pocet + 1
    Vrat n
}
Metoda ChybovaVetev_posledni() {
    Vrat CtiZAdresu(ir_chyby_navesti + ((ir_chyby_pocet - 1) * 24))
}

// Kolik argumentu jde v registrech (x86: 4, ARM64: 8)
Metoda PocetRegArg() {
    Pokud (Volej JeARM() == 1) { Vrat 8 }
    Vrat 4
}

// Hodnota vyrazu do rax (pro surove casti generatoru)
Metoda GenerujVyraz_x86(out, uzel : AST_Node) {
    Lokalni v = Volej GenerujHodnotu(uzel)
    Volej Ir(25, 0, v, 0, 0, 1)
    Vrat 0
}


// ==========================================
// Surova cast generatoru: desetinna cisla, texty, Alokuj, slozita volani
// (vysledek vzdy v rax; registry rbx a r12-r15 nepouziva)
// ==========================================
Metoda NazevC_x86(nazev) {
    Pokud (cilova_platforma == 0) { Vrat Volej NazevSymbolu(nazev) }
    Vrat nazev
}

// Zavola C funkci, jejiz argumenty uz jsou v registrech; zasobnik se zarovna na 16 B
Metoda EmitujVolaniC(nazev) {
    Volej EmitujASM("    mov r11, rsp\n    sub rsp, 40\n    and rsp, -16\n    mov [rsp + 32], r11\n")
    Volej EmitujASM_1("    call %s\n", Volej NazevC_x86(nazev))
    Volej EmitujASM("    mov rsp, [rsp + 32]\n")
    Vrat 0
}

Metoda RegistrArgumentu(index, sysv_externi) {
    Pokud (cilova_platforma == 2) {
        Pokud (index == 0) { Vrat "rcx" }
        Pokud (index == 1) { Vrat "rdx" }
        Pokud (index == 2) { Vrat "r8" }
        Vrat "r9"
    }
    Pokud (index == 0) { Vrat "rdi" }
    Pokud (index == 1) { Vrat "rsi" }
    Pokud (index == 2) { Vrat "rdx" }
    Pokud (index == 3) { Vrat "rcx" }
    Pokud (index == 4) { Vrat "r8" }
    Vrat "r9"
}

// Je-li rax == 0, vypise chybu behu s cislem radku a ukonci program
Metoda GenerujKontroluNuly(radek, zprava) {
    Lokalni ok = Volej NoveNavesti()
    Volej EmitujASM_1("    test rax, rax\n    jnz .L_ok_%d\n", ok)
    Volej GenerujChybuBehu(radek, zprava)
    Volej EmitujASM_1(".L_ok_%d:\n", ok)
    Vrat 0
}

Metoda GenerujChybuBehu(radek, zprava) {
    Pokud (Volej JeJadro() == 1) { Volej EmitujASM("    cli\n    hlt\n"); Vrat 0 }
    Lokalni id = Volej PridejChybovouZpravu(radek, zprava)
    Lokalni a0 = Volej RegistrArgumentu(0, 1)
    Volej EmitujASM_2("    lea %s, [rel err_msg%d]\n", a0, id)
    Volej EmitujVolaniC("puts")
    Volej EmitujASM_1("    mov %s, 1\n", a0)
    Volej EmitujVolaniC("exit")
    Vrat 0
}

// Volani pres zasobnik: vice nez 4 argumenty, desetinne argumenty, volani pres promennou.
// Konvence Pramenu: prvni 4 argumenty v registrech, dalsi nad 32 B "domovskou" oblasti.
Metoda GenerujVolani_x86(out, uzel : AST_Node) {
    Lokalni n = uzel->stmt_count
    Lokalni sym_vol : Symbol = Volej NajdiSymbol(uzel->name)
    Lokalni pres_promennou = 0
    Pokud (sym_vol != 0) { Pokud (sym_vol->is_function == 0) { pres_promennou = 1 } }
    Lokalni je_externi = Volej JeExterniJmeno(uzel->name)
    Pokud (sym_vol == 0 && je_externi == 0) {
        Volej printf("Chyba (radek %d): Neznama metoda '%s' (chybi Metoda nebo Externi).\n", uzel->line, uzel->name)
        Volej exit(1)
    }
    Lokalni sysv_ext = 0
    Pokud (cilova_platforma != 2 && je_externi == 1 && pres_promennou == 0) { sysv_ext = 1 }
    Lokalni max_reg = 4
    Pokud (sysv_ext == 1) { max_reg = 6 }

    // 1) Argumenty zleva doprava vyhodnotime (poradi vedlejsich ucinku), na zasobnik je
    //    ulozime v opacnem poradi -> nejdriv vyhradime misto a pak plnime
    Lokalni ai = 0
    Dokud (ai < n) {
        Volej GenerujVyraz_x86(out, Volej CtiUkazatel(uzel->stmts + (ai * 8)))
        Volej EmitujASM("    push rax\n")
        surove_push = surove_push + 1
        ai = ai + 1
    }
    // Zasobnik ted obsahuje arg0 nejhloubeji, arg(n-1) navrchu -> otocime poradi
    Lokalni i_ot = 0
    Dokud (i_ot < n / 2) {
        Lokalni j_ot = n - 1 - i_ot
        Volej EmitujASM_2("    mov rax, [rsp + %d]\n    mov r11, [rsp + %d]\n", i_ot * 8, j_ot * 8)
        Volej EmitujASM_2("    mov [rsp + %d], r11\n    mov [rsp + %d], rax\n", i_ot * 8, j_ot * 8)
        i_ot = i_ot + 1
    }
    // 2) Argument i ted lezi na [rsp + 8*i]. Rozdelime je do registru a na zasobnik:
    //    - Windows a metody Pramenu: podle pozice (i-ty argument -> i-ty registr, float i do xmm_i)
    //    - C funkce na Linuxu/macOS (SysV): cela cisla a desetinna se pocitaji zvlast
    //      (6 celociselnych registru, 8 xmm), zbytek jde na zasobnik v puvodnim poradi
    Pokud (pres_promennou == 1) {
        // Cil volani do r10 (rax je zatim volny)
        Volej Ir(25, 0, Volej HodnotaPromenne(sym_vol), 0, 0, 1)
        Volej EmitujASM("    mov r10, rax\n")
    }
    Lokalni na_zas = Volej calloc(n + 1, 8)
    Lokalni k = 0
    Lokalni ng = 0
    Lokalni nx = 0
    Lokalni i2 = 0
    Dokud (i2 < n) {
        Lokalni a_node2 : AST_Node = Volej CtiUkazatel(uzel->stmts + (i2 * 8))
        Lokalni je_f = Volej JeFloatUzel(a_node2)
        Pokud (sysv_ext == 1) {
            Pokud (je_f == 1 && nx < 8) {
                Volej EmitujASM_2("    movq xmm%d, [rsp + %d]\n", nx, i2 * 8)
                nx = nx + 1
            } Jinak Pokud (je_f == 0 && ng < 6) {
                Volej EmitujASM_2("    mov %s, [rsp + %d]\n", Volej RegistrArgumentu(ng, 1), i2 * 8)
                ng = ng + 1
            } Jinak {
                Volej ZapisUkazatel(na_zas + (k * 8), i2)
                k = k + 1
            }
        } Jinak {
            Pokud (i2 < 4) {
                Volej EmitujASM_2("    mov %s, [rsp + %d]\n", Volej RegistrArgumentu(i2, 0), i2 * 8)
                Pokud (je_f == 1) { Volej EmitujASM_2("    movq xmm%d, [rsp + %d]\n", i2, i2 * 8) }
            } Jinak {
                Volej ZapisUkazatel(na_zas + (k * 8), i2)
                k = k + 1
            }
        }
        i2 = i2 + 1
    }
    // 3) Zarovnany zasobnik: [32 B domovska oblast (ne u SysV C funkci)] [argumenty na zasobniku] [stare rsp]
    Lokalni stin = 32
    Pokud (sysv_ext == 1) { stin = 0 }
    Volej EmitujASM("    mov r11, rsp\n")
    Volej EmitujASM_1("    sub rsp, %d\n", stin + (k * 8) + 8)
    Volej EmitujASM("    and rsp, -16\n")
    Volej EmitujASM_1("    mov [rsp + %d], r11\n", stin + (k * 8))
    Lokalni j = 0
    Dokud (j < k) {
        Volej EmitujASM_2("    mov rax, [r11 + %d]\n    mov [rsp + %d], rax\n", CtiZAdresu(na_zas + (j * 8)) * 8, stin + (j * 8))
        j = j + 1
    }
    Volej free(na_zas)
    Pokud (sysv_ext == 1) { Volej EmitujASM_1("    mov eax, %d\n", nx) } // pocet xmm registru (printf...)
    Pokud (pres_promennou == 1) {
        Volej EmitujASM("    call r10\n")
    } Jinak {
        Lokalni nazev_volani = uzel->name
        Pokud (je_externi == 1) { nazev_volani = Volej NazevC_x86(uzel->name) }
        Volej EmitujASM_1("    call %s\n", nazev_volani)
    }
    Volej EmitujASM_1("    mov rsp, [rsp + %d]\n", stin + (k * 8))
    Pokud (n > 0) { Volej EmitujASM_1("    add rsp, %d\n", n * 8) }
    surove_push = surove_push - n
    Pokud (Volej VraciCInt(uzel->name) == 1) { Volej EmitujASM("    movsxd rax, eax\n") }
    Pokud (Volej JeFloatExtern(uzel->name) == 1) { Volej EmitujASM("    movq rax, xmm0\n") }
    Vrat 0
}

// Desetinny operand do xmm registru (cele cislo se prevede)
Metoda DoXmm(reg_gp, xmm, je_float) {
    Pokud (je_float == 1) { Volej EmitujASM_2("    movq %s, %s\n", xmm, reg_gp) }
    Jinak { Volej EmitujASM_2("    cvtsi2sd %s, %s\n", xmm, reg_gp) }
    Vrat 0
}

Metoda GenerujVyraz_surovy(uzel : AST_Node) {
    Pokud (uzel->type == AST_CALL) { Volej GenerujVolani_x86(0, uzel); Vrat 0 }
    Pokud (uzel->type == AST_ALLOC) { // Alokuj n -> vynulovana pamet, pri nedostatku pameti chyba
        Volej ZakazVJadru(uzel->line, "Alokuj")
        Volej GenerujVyraz_x86(0, uzel->left)
        Pokud (cilova_platforma == 2) { Volej EmitujASM("    mov rdx, rax\n    mov rcx, 1\n") }
        Jinak { Volej EmitujASM("    mov rsi, rax\n    mov rdi, 1\n") }
        Volej EmitujVolaniC("calloc")
        Volej GenerujKontroluNuly(uzel->line, "Alokuj: nedostatek pameti")
        Vrat 0
    }
    Pokud (uzel->type != AST_EXPR) {
        Volej printf("Chyba (radek %d): Tento vyraz neumi generator x86 prelozit (typ %d).\n", uzel->line, uzel->type)
        Volej exit(1)
    }
    Lokalni op = uzel->op
    Pokud (op == 98) { Volej EmitujASM_1("    mov rax, qword [rel flt%d]\n", uzel->int_val); Vrat 0 }
    Pokud (op == 44 && uzel->right == 0) { // -x pro desetinne cislo: preklopime znamenkovy bit
        Volej GenerujVyraz_x86(0, uzel->left)
        Volej EmitujASM("    btc rax, 63\n")
        Vrat 0
    }
    Pokud (op == 95 || op == 96 || op == 97) {
        Volej ZakazVJadru(uzel->line, "prace s texty")
        Volej GenerujVyraz_x86(0, uzel->left)
        Volej EmitujASM("    push rax\n")
        surove_push = surove_push + 1
        Volej GenerujVyraz_x86(0, uzel->right)
        Volej EmitujASM("    push rax\n")  // [rsp] = pravy text, [rsp+8] = levy text
        surove_push = surove_push - 1 // dalsi kod uz jen vola C funkce s dynamickym zarovnanim
        Lokalni a0 = Volej RegistrArgumentu(0, 1)
        Lokalni a1 = Volej RegistrArgumentu(1, 1)
        Pokud (op == 95) {
            // Spojeni textu: presne tolik pameti, kolik je potreba
            Volej EmitujASM_1("    mov %s, [rsp + 8]\n", a0)
            Volej EmitujVolaniC("strlen")
            Volej EmitujASM("    push rax\n")
            Volej EmitujASM_1("    mov %s, [rsp + 8]\n", a0)
            Volej EmitujVolaniC("strlen")
            Volej EmitujASM("    add rax, [rsp]\n    add rax, 1\n")
            Volej EmitujASM_1("    mov %s, rax\n", a0)
            Volej EmitujVolaniC("malloc")
            Volej GenerujKontroluNuly(uzel->line, "spojeni textu: nedostatek pameti")
            Volej EmitujASM("    mov [rsp], rax\n")
            Volej EmitujASM_2("    mov %s, rax\n    mov %s, [rsp + 16]\n", a0, a1)
            Volej EmitujVolaniC("strcpy")
            Volej EmitujASM_2("    mov %s, [rsp]\n    mov %s, [rsp + 8]\n", a0, a1)
            Volej EmitujVolaniC("strcat")
            Volej EmitujASM("    pop rax\n    add rsp, 16\n")
        } Jinak {
            Volej EmitujASM("    pop r11\n    pop rax\n")
            Volej EmitujASM_2("    mov %s, rax\n    mov %s, r11\n", a0, a1)
            Volej EmitujVolaniC("strcmp")
            Volej EmitujASM("    cmp eax, 0\n")
            Pokud (op == 96) { Volej EmitujASM("    sete al\n    movzx rax, al\n") }
            Jinak { Volej EmitujASM("    setne al\n    movzx rax, al\n") }
        }
        Vrat 0
    }
    // Desetinna aritmetika a porovnani (cele cislo na druhe strane se prevede)
    Pokud (uzel->left != 0 && uzel->right != 0) {
        Lokalni lf = Volej JeFloatUzel(uzel->left)
        Lokalni rf = Volej JeFloatUzel(uzel->right)
        Volej GenerujVyraz_x86(0, uzel->left)
        Volej EmitujASM("    push rax\n")
        surove_push = surove_push + 1
        Volej GenerujVyraz_x86(0, uzel->right)
        Volej EmitujASM("    mov r11, rax\n    pop rax\n")
        surove_push = surove_push - 1
        Volej DoXmm("rax", "xmm0", lf)
        Volej DoXmm("r11", "xmm1", rf)
        Pokud (op == 67) { Volej EmitujASM("    addsd xmm0, xmm1\n    movq rax, xmm0\n"); Vrat 0 }
        Pokud (op == 44) { Volej EmitujASM("    subsd xmm0, xmm1\n    movq rax, xmm0\n"); Vrat 0 }
        Pokud (op == 49) { Volej EmitujASM("    mulsd xmm0, xmm1\n    movq rax, xmm0\n"); Vrat 0 }
        Pokud (op == 50) { Volej EmitujASM("    divsd xmm0, xmm1\n    movq rax, xmm0\n"); Vrat 0 }
        // a < b a a <= b porovname obracene (b > a), aby NaN dalo vzdy nepravdu
        Pokud (op == 45 || op == 61) { Volej EmitujASM("    ucomisd xmm1, xmm0\n") } Jinak { Volej EmitujASM("    ucomisd xmm0, xmm1\n") }
        Pokud (op == 43) { Volej EmitujASM("    sete al\n    setnp cl\n    and al, cl\n") }
        Jinak Pokud (op == 64) { Volej EmitujASM("    setne al\n    setp cl\n    or al, cl\n") }
        Jinak Pokud (op == 45) { Volej EmitujASM("    seta al\n") }
        Jinak Pokud (op == 46) { Volej EmitujASM("    seta al\n") }
        Jinak Pokud (op == 61) { Volej EmitujASM("    setae al\n") }
        Jinak Pokud (op == 62) { Volej EmitujASM("    setae al\n") }
        Jinak {
            Volej printf("Chyba (radek %d): Operator nelze pouzit s desetinnymi cisly.\n", uzel->line)
            Volej exit(1)
        }
        Volej EmitujASM("    movzx rax, al\n")
        Vrat 0
    }
    Volej printf("Chyba (radek %d): Tento vyraz neumi generator x86 prelozit (op %d).\n", uzel->line, op)
    Volej exit(1)
    Vrat 0
}

// ==========================================
// AST -> IR: prikazy
// ==========================================
Metoda GenerujOdlozene_x86(out) {
    Pokud (pocet_defer == 0) { Vrat 0 }
    Volej EmitujASM("    push rax\n") // navratova hodnota prezije odlozene prikazy
    surove_push = surove_push + 1
    Lokalni dr = pocet_defer - 1
    Dokud (dr >= 0) {
        Volej GenerujAST_x86(out, Volej CtiUkazatel(pamet_defer + (dr * 8)))
        dr = dr - 1
    }
    Volej EmitujASM("    pop rax\n")
    surove_push = surove_push - 1
    Vrat 0
}

Metoda GenerujAST_x86(out, uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    Lokalni t = uzel->type
    Pokud (t == 100) { Vrat 0 }

    Pokud (t == 0) { // PROGRAM
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Volej GenerujAST_x86(out, Volej CtiUkazatel(uzel->stmts + (i * 8)))
            i = i + 1
        }
        Vrat 0
    }
    Pokud (t == 10) { Volej GenerujMetodu_x86(out, uzel); Vrat 0 }
    Pokud (t == 1) {
        Lokalni j = 0
        Lokalni pred_blok = rz_predchozi
        Dokud (j < uzel->stmt_count) {
            rz_predchozi = 0
            Pokud (j > 0) { rz_predchozi = Volej CtiUkazatel(uzel->stmts + ((j - 1) * 8)) }
            Volej GenerujAST_x86(out, Volej CtiUkazatel(uzel->stmts + (j * 8)))
            j = j + 1
        }
        rz_predchozi = pred_blok
        Vrat 0
    }
    Pokud (t == 34) { // Odloz
        Pokud (pocet_defer >= 499) { Volej printf("Kriticka chyba: Prekrocen limit 500 odlozenych prikazu!\n"); Volej exit(1) }
        Volej ZapisUkazatel(pamet_defer + (pocet_defer * 8), uzel->left)
        pocet_defer = pocet_defer + 1
        Vrat 0
    }
    Pokud (t == 26) { // Asm "x86:..." (ARM varianta se preskoci)
        Lokalni asm_text = uzel->name
        Lokalni z0 = Volej CtiByt(asm_text); Lokalni z1 = Volej CtiByt(asm_text + 1)
        Lokalni z2 = Volej CtiByt(asm_text + 2); Lokalni z3 = Volej CtiByt(asm_text + 3)
        Pokud (z0 == 97 && z1 == 114 && z2 == 109 && z3 == 58) { Vrat 0 }
        Pokud (z0 == 120 && z1 == 56 && z2 == 54 && z3 == 58) { asm_text = asm_text + 4 }
        Volej EmitujASM_1("    %s\n", asm_text)
        Vrat 0
    }

    Pokud (t == 3 || t == 4) { // Lokalni / prirazeni
        Lokalni sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym == 0) {
            Volej printf("Chyba (radek %d): Prirazeni do nedeklarovane promenne '%s'.\n", uzel->line, uzel->name)
            Volej exit(1)
        }
        Pokud (t == 3 && sym->dim1 > 0 && Volej JeARM() == 1) { // ARM64: vynulovani pole jako IR instrukce
            Volej Ir(55, sym->offset, sym->dim1 * sym->dim2, 1, 0, 1)
            Vrat 0
        }
        Pokud (t == 3 && sym->dim1 > 0) { // lokalni pole: vynulovat
            Lokalni nul_lbl = Volej NoveNavesti()
            Volej EmitujASM_2("    lea rax, [rbp - %d]\n    mov rcx, %d\n", sym->offset, sym->dim1 * sym->dim2)
            Volej EmitujASM_1(".L_nul_%d:\n    mov qword [rax], 0\n    add rax, 8\n    dec rcx\n", nul_lbl)
            Volej EmitujASM_1("    jnz .L_nul_%d\n", nul_lbl)
            Vrat 0
        }
        Lokalni hodnota_uzel : AST_Node = uzel->right
        Pokud (uzel->op == TOKEN_PLUSEQ || uzel->op == TOKEN_MINUSEQ) { // x += v  ->  x = x + v
            Lokalni jm : AST_Node = Volej VytvorUzel(AST_EXPR, uzel->line)
            jm->op = TOKEN_IDENTIFIER
            Volej strncpy(jm->name, uzel->name, 255)
            Lokalni bin : AST_Node = Volej VytvorUzel(AST_EXPR, uzel->line)
            Pokud (uzel->op == TOKEN_PLUSEQ) { bin->op = TOKEN_PLUS } Jinak { bin->op = TOKEN_MINUS }
            bin->left = jm
            bin->right = uzel->right
            hodnota_uzel = bin
        }
        Pokud (hodnota_uzel == 0) { Volej UlozDoPromenne(sym, 0, 1); Vrat 0 }
        Lokalni h = Volej OperandNeboKonst(hodnota_uzel)
        Volej UlozDoPromenne(sym, h, ir_op_typ)
        Pokud (sr_pocet > 0) { Volej PosunSouciny(uzel) }
        Vrat 0
    }

    Pokud (t == AST_MEMBER_CHAIN_ASSIGN) { // a->b->c = hodnota
        Lokalni hc = Volej OperandNeboKonst(uzel->right)
        Lokalni hc_t = ir_op_typ
        Lokalni zc2 = Volej GenerujHodnotu(uzel->left)
        Volej KontrolaUkazatele(zc2, uzel->line)
        Lokalni ac = zc2
        Pokud (uzel->int_val != 0) { ac = Volej Ir(4, Volej NovyVreg(), zc2, 0, uzel->int_val, 1) }
        Volej Ir(43, 0, ac, 0, hc, hc_t)
        Vrat 0
    }
    Pokud (t == 17) { // p->clen = hodnota
        Lokalni sym17 : Symbol = Volej NajdiPromennouNeboChyba(uzel->name, uzel->line)
        Lokalni h17 = Volej OperandNeboKonst(uzel->right)
        Lokalni h17_t = ir_op_typ
        Lokalni a17 = Volej HodnotaPromenne(sym17)
        Volej KontrolaUkazatele(a17, uzel->line)
        Pokud (uzel->int_val != 0) { a17 = Volej Ir(4, Volej NovyVreg(), a17, 0, uzel->int_val, 1) }
        Volej Ir(43, 0, a17, 0, h17, h17_t)
        Vrat 0
    }
    Pokud (t == 19) { // p->clen[i] = hodnota (bajt)
        Lokalni sym19 : Symbol = Volej NajdiPromennouNeboChyba(uzel->name, uzel->line)
        Pokud (Volej JeClenPole(sym19->type_name, uzel->sub_name) == 0) {
            Volej printf("Chyba (radek %d): '%s->%s' neni pole, nelze ho indexovat.\n", uzel->line, uzel->name, uzel->sub_name)
            Volej exit(1)
        }
        Lokalni h19 = Volej OperandNeboKonst(uzel->right)
        Lokalni h19_t = ir_op_typ
        Lokalni i19 = Volej OperandNeboKonst(uzel->left)
        Lokalni i19_t = ir_op_typ
        Volej KontrolaMeze(i19, i19_t, Volej VelikostClenu(sym19->type_name, uzel->sub_name), uzel->line, uzel->sub_name)
        Lokalni a19 = Volej HodnotaPromenne(sym19)
        Volej KontrolaUkazatele(a19, uzel->line)
        Lokalni posun19 = uzel->int_val
        Pokud (i19_t == 1) { posun19 = posun19 + i19 }
        Pokud (posun19 != 0) { a19 = Volej Ir(4, Volej NovyVreg(), a19, 0, posun19, 1) }
        Pokud (i19_t == 0) { a19 = Volej Ir(4, Volej NovyVreg(), a19, 0, i19, 0) }
        Volej Ir(51, 0, a19, 0, h19, h19_t)
        Vrat 0
    }
    Pokud (t == 33) { // a[i] = hodnota
        Lokalni sym33 : Symbol = Volej NajdiPromennouNeboChyba(uzel->name, uzel->line)
        Lokalni h33 = Volej OperandNeboKonst(uzel->right)
        Lokalni h33_t = ir_op_typ
        Lokalni i33 = Volej OperandNeboKonst(uzel->left)
        Lokalni i33_t = ir_op_typ
        Pokud (sym33->dim1 > 0) { Volej IndexVPoli(uzel->left, sym33->dim1 * sym33->dim2) }
        Pokud (sym33->dim1 > 0) { Volej KontrolaMeze(i33, i33_t, sym33->dim1 * sym33->dim2, uzel->line, uzel->name) }
        Pokud (i33_t == 1) { i33 = Volej Konst(i33) }
        Lokalni z33 = Volej HodnotaPromenne(sym33)
        Lokalni a33 = Volej Ir(47, Volej NovyVreg(), z33, 0, i33, 0)
        Volej Ir(43, 0, a33, 0, h33, h33_t)
        Vrat 0
    }

    Pokud (t == 20) { Volej GenerujHodnotu(uzel); Vrat 0 } // volani jako prikaz

    Pokud (t == 25 && Volej JeARM() == 1) { // Vypis na ARM64: printf pres IR
        Lokalni typ_a = Volej ZiskejTypUzlu(uzel->left)
        Volej ZakazVJadru(uzel->line, "Vypis")
        Lokalni hv_a = Volej GenerujHodnotu(uzel->left)
        Lokalni fmt_a = "fmt_int"
        Pokud (Volej strcmp(typ_a, "String") == 0) { fmt_a = "fmt_str" }
        Pokud (Volej strcmp(typ_a, "Float") == 0) { fmt_a = "fmt_flt" }
        Lokalni fv_a = Volej Ir(44, Volej NovyVreg(), fmt_a, 3, 0, 1)
        Volej Ir(23, 0, fv_a, 0, 0, 1)
        Pokud (Volej strcmp(typ_a, "Float") == 0) { Volej Ir(74, 0, hv_a, 0, 1, 1) } Jinak { Volej Ir(23, 1, hv_a, 0, 0, 1) }
        Volej Ir(24, Volej NovyVreg(), "printf", 3, 2, 1)
        Vrat 0
    }
    Pokud (t == 31 && Volej JeARM() == 1) { // Uvolni na ARM64
        Volej ZakazVJadru(uzel->line, "Uvolni")
        Lokalni pv_a = Volej GenerujHodnotu(uzel->left)
        Volej Ir(23, 0, pv_a, 0, 0, 1)
        Volej Ir(24, Volej NovyVreg(), "free", 3, 0, 1)
        Lokalni uva : AST_Node = uzel->left
        Pokud (uva->op == TOKEN_IDENTIFIER) {
            Lokalni uva_sym : Symbol = Volej NajdiSymbol(uva->name)
            Pokud (uva_sym != 0) {
                Pokud (uva_sym->is_function == 0 && uva_sym->is_const == 0 && uva_sym->dim1 == 0) { Volej UlozDoPromenne(uva_sym, 0, 1) }
            }
        }
        Vrat 0
    }
    Pokud (t == 25) { // Vypis
        Volej ZakazVJadru(uzel->line, "Vypis")
        Volej GenerujVyraz_x86(out, uzel->left)
        Lokalni typ_p = Volej ZiskejTypUzlu(uzel->left)
        Lokalni a0p = Volej RegistrArgumentu(0, 1)
        Lokalni a1p = Volej RegistrArgumentu(1, 1)
        Volej EmitujASM_1("    mov %s, rax\n", a1p)
        Pokud (Volej strcmp(typ_p, "Float") == 0) {
            Pokud (cilova_platforma == 2) { Volej EmitujASM("    movq xmm1, rax\n") } Jinak { Volej EmitujASM("    movq xmm0, rax\n") }
            Volej EmitujASM_1("    lea %s, [rel fmt_flt]\n    mov eax, 1\n", a0p)
        } Jinak Pokud (Volej strcmp(typ_p, "String") == 0) {
            Volej EmitujASM_1("    lea %s, [rel fmt_str]\n    mov eax, 0\n", a0p)
        } Jinak {
            Volej EmitujASM_1("    lea %s, [rel fmt_int]\n    mov eax, 0\n", a0p)
        }
        Volej EmitujVolaniC("printf")
        Vrat 0
    }

    Pokud (t == 31) { // Uvolni
        Volej ZakazVJadru(uzel->line, "Uvolni")
        Volej GenerujVyraz_x86(out, uzel->left)
        Volej EmitujASM_1("    mov %s, rax\n", Volej RegistrArgumentu(0, 1))
        Volej EmitujVolaniC("free")
        Lokalni uv : AST_Node = uzel->left
        Pokud (uv->op == TOKEN_IDENTIFIER) {
            Lokalni uv_sym : Symbol = Volej NajdiSymbol(uv->name)
            Pokud (uv_sym != 0) {
                Pokud (uv_sym->is_function == 0 && uv_sym->is_const == 0 && uv_sym->dim1 == 0) {
                    Volej UlozDoPromenne(uv_sym, 0, 1) // ochrana proti dvojitemu uvolneni
                }
            }
        }
        Vrat 0
    }

    Pokud (t == 11) { // Vrat
        Pokud (inl_konec != 0) { // Vrat ve vkladanem tele: vysledek a skok za telo
            Pokud (tce_aktivni == 1) {
                Pokud (Volej DruhNavratu(uzel->left) != 0) { Volej GenerujKoncoveVolani(uzel->left); Vrat 0 }
            }
            Pokud (uzel->left != 0) {
                Lokalni iv = Volej OperandNeboKonst(uzel->left)
                Lokalni iv_t = ir_op_typ
                Pokud (tce_akumulator != 0) { iv = Volej SAkumulatorem(iv, iv_t); iv_t = 0 }
                Volej Ir(26, inl_vysledek, iv, iv_t, 0, 1)
            } Jinak {
                Volej Ir(26, inl_vysledek, Volej SAkumulatorem(0, 1), 0, 0, 1)
            }
            Volej Ir(10, inl_konec, 0, 1, 0, 1)
            Vrat 0
        }
        Pokud (tce_aktivni == 1) {
            Pokud (Volej DruhNavratu(uzel->left) != 0) { Volej GenerujKoncoveVolani(uzel->left); Vrat 0 }
        }
        Pokud (uzel->left != 0) {
            Lokalni rv = Volej OperandNeboKonst(uzel->left)
            Lokalni rv_t = ir_op_typ
            Pokud (tce_akumulator != 0) { rv = Volej SAkumulatorem(rv, rv_t); rv_t = 0 }
            Volej PamatujVysledek(rv, rv_t)
            Volej Ir(25, 0, rv, rv_t, 0, 1)
        } Jinak Pokud (tce_akumulator != 0) {
            Volej Ir(25, 0, Volej SAkumulatorem(0, 1), 0, 0, 1)
        } Jinak {
            Volej Ir(25, 0, 0, 1, 0, 1)
        }
        Volej GenerujOdlozene_x86(out)
        Volej Ir(10, navesti_navratu, 0, 1, 0, 1)
        Vrat 0
    }

    Pokud (t == 6) { // Pokud
        // Ve vkladanem tele: vetev koncici navratem se presune za telo
        Pokud (inl_konec != 0 && uzel->alt == 0 && inl_odl_pocet < 64 && Volej KonciNavratem(uzel->right) == 1) {
            Lokalni n_vetev = Volej NoveNavesti()
            Volej GenerujSkok(uzel->left, n_vetev, 1)
            Volej ZapisUkazatel(inl_odlozene + (inl_odl_pocet * 16), n_vetev)
            Volej ZapisUkazatel(inl_odlozene + (inl_odl_pocet * 16) + 8, uzel->right)
            inl_odl_pocet = inl_odl_pocet + 1
            Vrat 0
        }
        Lokalni n_else = Volej NoveNavesti()
        Volej GenerujSkok(uzel->left, n_else, 0)
        Volej GenerujAST_x86(out, uzel->right)
        Pokud (uzel->alt != 0) {
            Lokalni n_end = Volej NoveNavesti()
            Volej Ir(10, n_end, 0, 1, 0, 1)
            Volej Ir(11, n_else, 0, 1, 0, 1)
            Volej GenerujAST_x86(out, uzel->alt)
            Volej Ir(11, n_end, 0, 1, 0, 1)
        } Jinak {
            Volej Ir(11, n_else, 0, 1, 0, 1)
        }
        Vrat 0
    }

    Pokud (t == 7 || t == 8) { // Dokud / Opakuj - podminka na konci cyklu (jeden skok na pruchod)
        Lokalni n_telo = Volej NoveNavesti()
        Lokalni n_dal = Volej NoveNavesti()
        Lokalni n_podm = Volej NoveNavesti()
        Lokalni n_konec = Volej NoveNavesti()
        Pokud (t == 8) { Volej GenerujAST_x86(out, uzel->left) }
        Lokalni podm : AST_Node = uzel->left
        Lokalni telo : AST_Node = uzel->right
        Pokud (t == 8) { podm = uzel->right; telo = Volej CtiUkazatel(uzel->stmts) }
        Volej ZapisUkazatel(loop_label_stack + (loop_stack_depth * 8), n_konec)
        Volej ZapisUkazatel(loop_continue_stack + (loop_stack_depth * 8), n_dal)
        Volej VstupDoCyklu(uzel->line)
        loop_stack_depth = loop_stack_depth + 1
        // Redukce sily: souciny indukcni promenne spocitane pred cyklem
        Lokalni sr_stary = sr_pocet
        Lokalni krok_c : AST_Node = 0
        Pokud (t == 8) { krok_c = uzel->alt }
        Pokud (sr_vypnuto == 0 && ir_metoda_ma_asm == 0) {
            Pokud (sr_uzly == 0) {
                sr_uzly = Volej calloc(32, 8)
                sr_vregy = Volej calloc(32, 8)
                sr_zmeny = Volej calloc(32, 8)
                sr_kroky = Volej calloc(32, 8)
            }
            Volej NajdiSouciny(telo, telo, podm, krok_c)
            Volej NajdiSouciny(podm, telo, podm, krok_c)
            Volej NajdiSouciny(krok_c, telo, podm, krok_c)
        }
        // Rozsah indukcni promenne uvnitr cyklu (pro deleni bez znamenkove opravy a kontroly mezi)
        Lokalni rz_stary = rz_pocet
        Lokalni vstup_c : AST_Node = rz_predchozi
        Pokud (t == 8) { vstup_c = uzel->left }
        Volej PridejRozsahCyklu(podm, telo, krok_c, vstup_c)
        Volej Ir(10, n_podm, 0, 1, 0, 1)
        Volej Ir(11, n_telo, 0, 1, 0, 1)
        Volej GenerujAST_x86(out, telo)
        Volej Ir(11, n_dal, 0, 1, 0, 1)
        Pokud (t == 8) { Volej GenerujAST_x86(out, uzel->alt) }
        Volej Ir(11, n_podm, 0, 1, 0, 1)
        Volej GenerujSkok(podm, n_telo, 1)
        Volej Ir(11, n_konec, 0, 1, 0, 1)
        sr_pocet = sr_stary
        rz_pocet = rz_stary
        loop_stack_depth = loop_stack_depth - 1
        Vrat 0
    }

    Pokud (t == 22 || t == 23) { // Ukonci / Pokracuj
        Pokud (loop_stack_depth == 0) {
            Volej printf("Chyba (radek %d): Ukonci/Pokracuj smi byt jen uvnitr cyklu.\n", uzel->line)
            Volej exit(1)
        }
        Lokalni cil = 0
        Pokud (t == 22) { cil = Volej CtiUkazatel(loop_label_stack + ((loop_stack_depth - 1) * 8)) }
        Jinak { cil = Volej CtiUkazatel(loop_continue_stack + ((loop_stack_depth - 1) * 8)) }
        Volej Ir(10, cil, 0, 1, 0, 1)
        Vrat 0
    }

    Pokud (t == 28) { // Rozcestnik
        Lokalni sw_v = Volej GenerujHodnotu(uzel->left)
        Lokalni nav_cest = Volej calloc(uzel->stmt_count + 1, 8)
        Lokalni n_hlavni = Volej NoveNavesti()
        Lokalni n_sw_konec = Volej NoveNavesti()
        Lokalni c = 0
        Dokud (c < uzel->stmt_count) {
            Lokalni cesta : AST_Node = Volej CtiUkazatel(uzel->stmts + (c * 8))
            Lokalni hc : AST_Node = cesta->left
            Lokalni nc = Volej NoveNavesti()
            Volej ZapisUkazatel(nav_cest + (c * 8), nc)
            Volej Ir(31, nc, sw_v, 0, Volej NaCislo(hc->name), 1) // skoc, kdyz plati ==
            c = c + 1
        }
        Volej Ir(10, n_hlavni, 0, 1, 0, 1)
        c = 0
        Dokud (c < uzel->stmt_count) {
            Lokalni cesta2 : AST_Node = Volej CtiUkazatel(uzel->stmts + (c * 8))
            Volej Ir(11, Volej CtiUkazatel(nav_cest + (c * 8)), 0, 1, 0, 1)
            Volej GenerujAST_x86(out, cesta2->right)
            Volej Ir(10, n_sw_konec, 0, 1, 0, 1)
            c = c + 1
        }
        Volej Ir(11, n_hlavni, 0, 1, 0, 1)
        Pokud (uzel->alt != 0) { Volej GenerujAST_x86(out, uzel->alt) }
        Volej Ir(11, n_sw_konec, 0, 1, 0, 1)
        Volej free(nav_cest)
        Vrat 0
    }
    Vrat 0
}

// ==========================================
// Eliminace koncove rekurze (TCE)
//   Vrat Metoda(a, b)             -> parametry = a, b; skok na zacatek metody
//   Vrat X + Metoda(a)  (i  *)    -> akumulator = akumulator + X; parametry = a; skok na zacatek
// Rekurze se tak zmeni v cyklus: zadne volani, zadny rust zasobniku.
// Plati jen pro cela cisla (+ a * jsou modulo 2^64 asociativni) a metody bez Asm a Odloz.
// ==========================================
Globalni tce_aktivni = 0
Globalni tce_metoda = 0
Globalni tce_akumulator = 0     // vreg akumulatoru (0 = bez akumulatoru)
Globalni tce_op = 0             // 67 (+) nebo 49 (*)
Globalni tce_start = 0          // navesti zacatku tela
Globalni tce_konflikt = 0

Metoda JeVolaniSebe(u : AST_Node) {
    Pokud (u == 0 || tce_metoda == 0) { Vrat 0 }
    Lokalni m : AST_Node = tce_metoda
    Pokud (u->type != AST_CALL) { Vrat 0 }
    Pokud (Volej strcmp(u->name, m->name) != 0) { Vrat 0 }
    Pokud (u->stmt_count != m->arg_count) { Vrat 0 }
    Lokalni sym : Symbol = Volej NajdiSymbol(u->name)
    Pokud (sym == 0) { Vrat 0 }
    Pokud (sym->is_function == 0) { Vrat 0 }
    Vrat 1
}

// Druh navratu: 0 = obycejny, 1 = koncove volani, 2 = akumulace (vraci i stranu s volanim)
Globalni tce_strana = 0     // 1 = volani je vpravo, 2 = vlevo
Metoda DruhNavratu(vyraz : AST_Node) {
    tce_strana = 0
    Pokud (vyraz == 0) { Vrat 0 }
    Pokud (Volej JeVolaniSebe(vyraz) == 1) { Vrat 1 }
    Pokud (vyraz->type == AST_EXPR && (vyraz->op == TOKEN_PLUS || vyraz->op == TOKEN_MUL) && vyraz->left != 0 && vyraz->right != 0) {
        Pokud (Volej JeFloatUzel(vyraz) == 1) { Vrat 0 }
        Pokud (Volej strcmp(Volej ZiskejTypUzlu(vyraz), "String") == 0) { Vrat 0 }
        Pokud (Volej JeVolaniSebe(vyraz->right) == 1) { tce_strana = 1; Vrat 2 }
        // Volani vlevo jen kdyz prava strana nema vedlejsi ucinky (jinak by se zmenilo poradi)
        Pokud (Volej JeVolaniSebe(vyraz->left) == 1 && Volej JeCistyVyraz(vyraz->right) == 1) { tce_strana = 2; Vrat 2 }
    }
    Vrat 0
}

// Projde vsechny Vrat v tele: zjisti, zda lze TCE pouzit a s jakym operatorem
Metoda AnalyzujTCE(uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    Lokalni nalezeno = 0
    Pokud (uzel->type == AST_RETURN) {
        Lokalni druh = Volej DruhNavratu(uzel->left)
        Pokud (druh == 1) { nalezeno = 1 }
        Pokud (druh == 2) {
            Lokalni vyr : AST_Node = uzel->left
            Pokud (tce_op != 0 && tce_op != vyr->op) { tce_konflikt = 1 }
            tce_op = vyr->op
            nalezeno = 1
        }
    }
    Pokud (Volej AnalyzujTCE(uzel->left) == 1) { nalezeno = 1 }
    Pokud (Volej AnalyzujTCE(uzel->right) == 1) { nalezeno = 1 }
    Pokud (Volej AnalyzujTCE(uzel->alt) == 1) { nalezeno = 1 }
    Pokud (uzel->stmts != 0) {
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Pokud (Volej AnalyzujTCE(Volej CtiUkazatel(uzel->stmts + (i * 8))) == 1) { nalezeno = 1 }
            i = i + 1
        }
    }
    Vrat nalezeno
}

// Hodnota navratu s akumulatorem: akumulator OP v
Metoda SAkumulatorem(v, t) {
    Pokud (tce_akumulator == 0) {
        Pokud (t == 1) { Vrat Volej Konst(v) }
        Vrat v
    }
    Lokalni kod = 4
    Pokud (tce_op == 49) { kod = 6 }
    Vrat Volej Ir(kod, Volej NovyVreg(), tce_akumulator, 0, v, t)
}

Metoda GenerujKoncoveVolani(vyraz : AST_Node) {
    Lokalni druh = Volej DruhNavratu(vyraz)
    Lokalni volani : AST_Node = vyraz
    Pokud (druh == 2) {
        Lokalni ostatni : AST_Node = vyraz->left
        volani = vyraz->right
        Pokud (tce_strana == 2) { ostatni = vyraz->right; volani = vyraz->left }
        Lokalni e = Volej OperandNeboKonst(ostatni)
        Lokalni kod = 4
        Pokud (tce_op == 49) { kod = 6 }
        Volej Ir(kod, tce_akumulator, tce_akumulator, 0, e, ir_op_typ)
    }
    // Nejdriv vyhodnotime vsechny argumenty, pak je teprve priradime (jako soucasne prirazeni)
    Lokalni m : AST_Node = tce_metoda
    Lokalni n = volani->stmt_count
    Lokalni hodnoty = Volej calloc(n + 1, 8)
    Lokalni typy = Volej calloc(n + 1, 8)
    Lokalni i = 0
    Dokud (i < n) {
        Lokalni hv = Volej OperandNeboKonst(Volej CtiUkazatel(volani->stmts + (i * 8)))
        Lokalni ht = ir_op_typ
        // Hodnota primo v promenne (napr. parametru) se musi zkopirovat, jinak by ji
        // prirazeni jineho parametru prepsalo drive, nez ji pouzijeme (Prohod(b, a))
        // (kopii docasne hodnoty pozdeji odstrani slucovani kopii)
        Pokud (ht == 0) { hv = Volej Ir(26, Volej NovyVreg(), hv, 0, 0, 1) }
        Volej ZapisUkazatel(hodnoty + (i * 8), hv)
        Volej ZapisUkazatel(typy + (i * 8), ht)
        i = i + 1
    }
    i = 0
    Dokud (i < n) {
        Lokalni psym : Symbol = pamet_symbolu + ((m->sym_start + i) * Velikost(Symbol))
        Volej Ir(26, psym->vreg, CtiZAdresu(hodnoty + (i * 8)), CtiZAdresu(typy + (i * 8)), 0, 1)
        i = i + 1
    }
    Volej free(hodnoty)
    Volej free(typy)
    Volej Ir(10, tce_start, 0, 1, 0, 1)
    Vrat 0
}

// ==========================================
// Metoda: prolog, povyseni promennych do registru, telo, epilog, prekladovy retezec
// ==========================================
Metoda GenerujMetodu_x86(out, uzel : AST_Node) {
    pocet_ir = 0
    pocet_defer = 0
    citac_temp_reg = 1
    pocet_intervalu = 0
    codegen_scoped = 1
    codegen_sym_start = uzel->sym_start
    codegen_sym_end = uzel->sym_end
    ramec_lokalnich = uzel->int_val
    navesti_navratu = Volej NoveNavesti()
    ir_metoda_ma_asm = Volej ObsahujeTyp(uzel->right, 26)

    // Povyseni: jednoduche lokalni promenne a parametry se stanou vregy (=> registry).
    // V metodach s Asm zustavaji v pameti, aby k nim assembler mohl pristupovat.
    Lokalni si = uzel->sym_start
    Dokud (si < uzel->sym_end) {
        Lokalni sym : Symbol = pamet_symbolu + (si * Velikost(Symbol))
        sym->vreg = 0
        Pokud (ir_metoda_ma_asm == 0 && sym->is_global == 0 && sym->is_const == 0 && sym->is_function == 0 && sym->dim1 == 0) {
            sym->vreg = Volej NovyVreg()
        }
        si = si + 1
    }

    ir_prvni_temp = citac_temp_reg
    surove_push = 0
    ir_metoda = uzel
    ir_nul_pocet = 0
    inl_rozpocet = 0
    inl_hloubka = 0
    inl_konec = 0
    Pokud (inl_zasobnik == 0) { inl_zasobnik = Volej calloc(8, 8) }
    Pokud (Volej JeARM() == 0) { Volej EmitujASM_1("%s:\n", uzel->name) }
    // Prolog (rbp, ramec, nepovysene parametry, ulozeni registru) se vypise az po alokaci,
    // kdy vime, co metoda opravdu potrebuje
    Volej Ir(98, 0, 0, 1, 0, 1)
    // Povysene parametry: prvni 4 primo z registru, dalsi ze zasobniku
    Lokalni pi = 0
    Dokud (pi < uzel->arg_count) {
        Lokalni psym : Symbol = pamet_symbolu + ((uzel->sym_start + pi) * Velikost(Symbol))
        Pokud (psym->vreg > 0) {
            Pokud (pi < Volej PocetRegArg()) { Volej Ir(39, psym->vreg, pi, 1, 0, 1) } Jinak { Volej Ir(2, psym->vreg, psym->offset, 2, 0, 1) }
        }
        pi = pi + 1
    }

    Volej PamatujZacatek(uzel)
    Lokalni rek_hotovo = Volej RekurenceNaCyklus(uzel)
    // Eliminace koncove rekurze (ne u Pamatuj: kazde volani ma jit pres tabulku)
    tce_aktivni = 0
    tce_akumulator = 0
    tce_op = 0
    tce_konflikt = 0
    tce_metoda = uzel
    tce_hloubka = 0
    Pokud (rek_hotovo == 0 && pam_aktivni == 0 && ir_metoda_ma_asm == 0 && Volej ObsahujeTyp(uzel->right, 34) == 0 && Volej strcmp(uzel->type_name, "Float") != 0) {
        Pokud (Volej AnalyzujTCE(uzel->right) == 1 && tce_konflikt == 0) {
            tce_aktivni = 1
            Pokud (tce_op != 0) {
                tce_akumulator = Volej NovyVreg()
                Pokud (tce_op == 49) { Volej Ir(26, tce_akumulator, 1, 1, 0, 1) } Jinak { Volej Ir(26, tce_akumulator, 0, 1, 0, 1) }
            }
            tce_start = Volej NoveNavesti()
            Volej Ir(11, tce_start, 0, 1, 0, 1)
            tce_hloubka = 1
            Pokud (podrobny_vypis == 1) { Volej printf(">> TCE: koncova rekurze v '%s' prevedena na cyklus\n", uzel->name) }
        }
    }

    Pokud (rek_hotovo == 0) { Volej GenerujAST_x86(out, uzel->right) }

    // Konec metody bez Vrat: odlozene prikazy a navrat 0
    Pokud (tce_akumulator != 0) { Volej Ir(25, 0, Volej SAkumulatorem(0, 1), 0, 0, 1) } Jinak { Volej Ir(25, 0, 0, 1, 0, 1) }
    Volej GenerujOdlozene_x86(out)
    Volej Ir(11, navesti_navratu, 0, 1, 0, 1)
    Volej Ir(97, 0, 0, 1, 0, 1)
    // Chybove vetve (deleni nulou...) az za koncem metody, aby nebrzdily hlavni cestu
    Lokalni ci = 0
    Dokud (ci < ir_chyby_pocet && Volej JeARM() == 0) {
        Lokalni cb = ir_chyby_navesti + (ci * 24)
        Volej Ir(11, CtiZAdresu(cb), 0, 1, 0, 1)
        Volej GenerujChybuBehu(CtiZAdresu(cb + 8), CtiZAdresu(cb + 16))
        ci = ci + 1
    }
    Pokud (Volej JeARM() == 1) {
        // ARM64: jen kdyz cela metoda jde prelozit pres IR; jinak ji prelozi jednoduchy generator
        Pokud (Volej LzeARM(uzel) == 0) {
            Pokud (podrobny_vypis == 1) { Volej printf(">> ARM64: metoda '%s' jednoduchym generatorem\n", uzel->name) }
            Lokalni sj = uzel->sym_start
            Dokud (sj < uzel->sym_end) {
                Lokalni symj : Symbol = pamet_symbolu + (sj * Velikost(Symbol))
                symj->vreg = 0
                sj = sj + 1
            }
            Lokalni kj = 0
            Dokud (kj < pocet_ir) {
                Lokalni ij : IR_Instrukce = pamet_ir + (kj * 48)
                Pokud (ij->opcode == 99) { Volej free(ij->src1) }
                kj = kj + 1
            }
            pocet_ir = 0
            ir_chyby_pocet = 0
            tce_aktivni = 0
            tce_akumulator = 0
            tce_metoda = 0
            Vrat 0
        }
    } Jinak {
        ir_chyby_pocet = 0
    }

    // --- Backend: intervaly -> mrtvy kod -> CFG -> liveness -> Linear Scan -> assembler ---
    Volej OdstranNedosazitelne()
    Volej RotujCykly()
    Volej VytahniKonstanty()
    Volej SpocitejIntervaly()
    Pokud (Volej SlucKopie() > 0) { Volej SpocitejIntervaly() }
    Pokud (Volej OptimalizujMrtvyKod() > 0) { Volej SpocitejIntervaly() }
    Pokud (Volej VektorizujCykly() > 0) { Volej SpocitejIntervaly() }
    Pokud (vypis_ir == 1) { Volej VypisIR(uzel->name) }
    Volej BudujCFG()
    Volej SpocitejLiveness()
    Volej ProvedLinearScan()
    Pokud (Volej JeARM() == 1) { Volej PrelozIRDoARM(out); ir_chyby_pocet = 0 } Jinak { Volej PrelozIRDoASM(out) }
    Volej CistiCFG()
    Volej fputs("\n", out)

    // Uklid: vregy promennych plati jen v teto metode
    si = uzel->sym_start
    Dokud (si < uzel->sym_end) {
        Lokalni sym2 : Symbol = pamet_symbolu + (si * Velikost(Symbol))
        sym2->vreg = 0
        si = si + 1
    }
    pocet_ir = 0
    codegen_scoped = 0
    tce_aktivni = 0
    tce_akumulator = 0
    tce_metoda = 0
    Vrat 1
}

// ==========================================
// Intervaly zivota: od prvniho do posledniho vyskytu vregu v IR
// ==========================================
Globalni ir_pocty_pouziti = 0

Metoda RozsirInterval(v, i) {
    Pokud (v <= 0 || v >= citac_temp_reg) { Vrat 0 }
    Lokalni iv : LiveInterval = pamet_intervalu + ((v - 1) * 32)
    Pokud (iv->fyzicky_reg == 0 || iv->start_instr > i) { iv->start_instr = i }
    Pokud (iv->fyzicky_reg == 0 || iv->end_instr < i) { iv->end_instr = i }
    iv->fyzicky_reg = 1 // docasne: "interval je pouzity"
    Vrat 0
}

Metoda SpocitejIntervaly() {
    Lokalni k = 0
    Dokud (k < pocet_intervalu) {
        Lokalni iv : LiveInterval = pamet_intervalu + (k * 32)
        iv->start_instr = 0
        iv->end_instr = 0
        iv->fyzicky_reg = 0
        k = k + 1
    }
    Pokud (ir_pocty_pouziti != 0) { Volej free(ir_pocty_pouziti) }
    ir_pocty_pouziti = Volej calloc(citac_temp_reg + 1, 8)
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op = inst->opcode
        Pokud (op != 0 && op < 97) {
            Pokud (inst->src1_typ == 0 && inst->src1 > 0) {
                Volej RozsirInterval(inst->src1, i)
                Volej ZapisUkazatel(ir_pocty_pouziti + (inst->src1 * 8), CtiZAdresu(ir_pocty_pouziti + (inst->src1 * 8)) + 1)
            }
            Pokud (inst->src2_typ == 0 && inst->src2 > 0) {
                Volej RozsirInterval(inst->src2, i)
                Volej ZapisUkazatel(ir_pocty_pouziti + (inst->src2 * 8), CtiZAdresu(ir_pocty_pouziti + (inst->src2 * 8)) + 1)
            }
            Pokud (Volej DefinujeDest(op) == 1) { Volej RozsirInterval(inst->dest, i) }
        }
        i = i + 1
    }
    Vrat 0
}

// Odstrani vypocty, jejichz vysledek nikdo nepouzije. Nikdy neodstranuje cteni pameti
// (muze jit o hardwarovy registr) ani volani.
// Vytazeni konstant z cyklu: nacteni desetinneho literalu (72) a adresy symbolu (44)
// se v cyklu nemeni, takze se presune na zacatek metody (za nacteni parametru).
// Jen jednou definovane hodnoty; nic jineho se nepresouva (pamet, volani, Asm zustavaji).
Metoda VytahniKonstanty() {
    Pokud (ir_metoda_ma_asm == 1 || pocet_ir < 4) { Vrat 0 }
    // 1) ktere instrukce jsou v cyklu (mezi navestim a skokem zpet na nej)
    Lokalni max_nav = citac_navesti + 2
    Lokalni pozice = Volej calloc(max_nav + 1, 8)
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni in1 : IR_Instrukce = pamet_ir + (i * 48)
        Pokud (in1->opcode == 11 && in1->dest >= 0 && in1->dest < max_nav) { Volej ZapisUkazatel(pozice + (in1->dest * 8), i + 1) }
        i = i + 1
    }
    Lokalni rozdil = Volej calloc(pocet_ir + 2, 8)
    i = 0
    Dokud (i < pocet_ir) {
        Lokalni in2 : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op2 = in2->opcode
        Pokud ((op2 == 10 || (op2 >= 30 && op2 <= 35)) && in2->dest >= 0 && in2->dest < max_nav) {
            Lokalni p = CtiZAdresu(pozice + (in2->dest * 8)) - 1
            Pokud (p >= 0 && p < i) {
                Volej ZapisUkazatel(rozdil + (p * 8), CtiZAdresu(rozdil + (p * 8)) + 1)
                Volej ZapisUkazatel(rozdil + ((i + 1) * 8), CtiZAdresu(rozdil + ((i + 1) * 8)) - 1)
            }
        }
        i = i + 1
    }
    // 2) misto vlozeni: za prologem a nactenim parametru
    Lokalni cil = 0
    Dokud (cil < pocet_ir) {
        Lokalni in3 : IR_Instrukce = pamet_ir + (cil * 48)
        // (99 na zacatku je navesti metody na x86)
        Pokud (in3->opcode != 98 && in3->opcode != 39 && in3->opcode != 2 && in3->opcode != 0 && !(in3->opcode == 99 && cil == 0)) { Ukonci }
        cil = cil + 1
    }
    Pokud (Volej SpocitejDefiniceIR() == 0) { Vrat 0 }
    // 3) presun: kandidaty zkopirujeme na misto "cil" a puvodni zrusime
    Lokalni kand = Volej calloc(pocet_ir + 1, 8)
    Lokalni nk = 0
    Lokalni hloubka = 0
    i = 0
    Dokud (i < pocet_ir) {
        hloubka = hloubka + CtiZAdresu(rozdil + (i * 8))
        Lokalni in4 : IR_Instrukce = pamet_ir + (i * 48)
        Pokud (hloubka > 0 && i > cil && (in4->opcode == 72 || in4->opcode == 44) && in4->dest > 0 && in4->dest < citac_temp_reg) {
            Pokud (CtiZAdresu(ir_pocty_definic + (in4->dest * 8)) == 1) { Volej ZapisUkazatel(kand + (nk * 8), i); nk = nk + 1 }
        }
        i = i + 1
    }
    Pokud (nk > 0) {
        Volej ZkontrolujKapacituIR_N(nk)
        Volej memmove(pamet_ir + ((cil + nk) * 48), pamet_ir + (cil * 48), (pocet_ir - cil) * 48)
        // pole indexovana cislem instrukce se posunou stejne
        Volej memmove(ir_hloubka_cyklu + ((cil + nk) * 8), ir_hloubka_cyklu + (cil * 8), (pocet_ir - cil) * 8)
        Volej memmove(ir_cekajici_push + ((cil + nk) * 8), ir_cekajici_push + (cil * 8), (pocet_ir - cil) * 8)
        Lokalni z = 0
        Dokud (z < nk) {
            Volej ZapisUkazatel(ir_hloubka_cyklu + ((cil + z) * 8), 0)
            Volej ZapisUkazatel(ir_cekajici_push + ((cil + z) * 8), 0)
            z = z + 1
        }
        pocet_ir = pocet_ir + nk
        Lokalni k = 0
        Dokud (k < nk) {
            Lokalni puv = CtiZAdresu(kand + (k * 8)) + nk
            Volej memmove(pamet_ir + ((cil + k) * 48), pamet_ir + (puv * 48), 48)
            Lokalni zrus : IR_Instrukce = pamet_ir + (puv * 48)
            zrus->opcode = 0
            k = k + 1
        }
    }
    Volej free(kand)
    Volej free(rozdil)
    Volej free(pozice)
    Vrat nk
}

// Vlozi n prazdnych instrukci (opcode 0) na pozici poz; posune i pole po instrukcich
Metoda VlozMistoIR(poz, n) {
    Volej ZkontrolujKapacituIR_N(n)
    Volej memmove(pamet_ir + ((poz + n) * 48), pamet_ir + (poz * 48), (pocet_ir - poz) * 48)
    Volej memmove(ir_hloubka_cyklu + ((poz + n) * 8), ir_hloubka_cyklu + (poz * 8), (pocet_ir - poz) * 8)
    Volej memmove(ir_cekajici_push + ((poz + n) * 8), ir_cekajici_push + (poz * 8), (pocet_ir - poz) * 8)
    Lokalni k = 0
    Dokud (k < n) {
        Lokalni ik : IR_Instrukce = pamet_ir + ((poz + k) * 48)
        ik->opcode = 0
        Volej ZapisUkazatel(ir_hloubka_cyklu + ((poz + k) * 8), CtiZAdresu(ir_hloubka_cyklu + ((poz + n) * 8)))
        Volej ZapisUkazatel(ir_cekajici_push + ((poz + k) * 8), CtiZAdresu(ir_cekajici_push + ((poz + n) * 8)))
        k = k + 1
    }
    pocet_ir = pocet_ir + n
    Vrat 0
}

Metoda ObracenePorovnani(op) {
    Pokud (op == 30) { Vrat 31 }
    Pokud (op == 31) { Vrat 30 }
    Pokud (op == 32) { Vrat 35 }
    Pokud (op == 35) { Vrat 32 }
    Pokud (op == 33) { Vrat 34 }
    Vrat 33
}

// Rotace cyklu: "L: kdyz neplati, skoc ven; telo; skoc na L"
//   ->  "L: kdyz neplati, skoc ven; Lt: telo; kdyz plati, skoc na Lt; skoc ven"
// Kazde kolo pak ma jediny (podmineny) skok misto dvou. Hlavne cykly z koncove rekurze.
Metoda RotujCykly() {
    Pokud (ir_metoda_ma_asm == 1) { Vrat 0 }
    Lokalni pocet = 0
    Lokalni j = 0
    Dokud (j < pocet_ir) {
        Lokalni sk : IR_Instrukce = pamet_ir + (j * 48)
        Pokud (sk->opcode == 10) {
            Lokalni cil = sk->dest
            // najdi navesti cil pred skokem
            Lokalni p = j - 1
            Dokud (p >= 0) {
                Lokalni ip : IR_Instrukce = pamet_ir + (p * 48)
                Pokud (ip->opcode == 11 && ip->dest == cil) { Ukonci }
                p = p - 1
            }
            Pokud (p >= 0) {
                Lokalni q = p + 1
                Dokud (q < j) {
                    Lokalni iq0 : IR_Instrukce = pamet_ir + (q * 48)
                    Pokud (iq0->opcode != 0) { Ukonci }
                    q = q + 1
                }
                Lokalni iq : IR_Instrukce = pamet_ir + (q * 48)
                Pokud (q < j && iq->opcode >= 30 && iq->opcode <= 35) {
                    Lokalni vychod = iq->dest
                    Lokalni op_k = iq->opcode
                    Lokalni a1 = iq->src1
                    Lokalni a1t = iq->src1_typ
                    Lokalni a2 = iq->src2
                    Lokalni a2t = iq->src2_typ
                    Lokalni n_telo = Volej NoveNavesti()
                    // misto za skokem: CMPJ (obracene) + JMP ven
                    Volej VlozMistoIR(j + 1, 1)
                    Lokalni nj : IR_Instrukce = pamet_ir + (j * 48)
                    nj->opcode = Volej ObracenePorovnani(op_k)
                    nj->dest = n_telo
                    nj->src1 = a1
                    nj->src1_typ = a1t
                    nj->src2 = a2
                    nj->src2_typ = a2t
                    Lokalni nv : IR_Instrukce = pamet_ir + ((j + 1) * 48)
                    nv->opcode = 10
                    nv->dest = vychod
                    nv->src1 = 0
                    nv->src1_typ = 1
                    nv->src2 = 0
                    nv->src2_typ = 1
                    // navesti tela hned za puvodni test
                    Volej VlozMistoIR(q + 1, 1)
                    Lokalni nl : IR_Instrukce = pamet_ir + ((q + 1) * 48)
                    nl->opcode = 11
                    nl->dest = n_telo
                    nl->src1 = 0
                    nl->src1_typ = 1
                    nl->src2 = 0
                    nl->src2_typ = 1
                    j = j + 2
                    pocet = pocet + 1
                }
            }
        }
        j = j + 1
    }
    Vrat pocet
}

// Ladici vypis mezikodu: index, kod operace, cil, operandy (# = konstanta, v = vreg)
Metoda VypisIR(jmeno) {
    Volej printf("=== IR metody %s ===\n", jmeno)
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op = inst->opcode
        Pokud (op != 0) {
            Pokud (op == 99 || op == 38) {
                Volej printf("%4d  %3d  (text)\n", i, op)
            } Jinak Pokud (op == 24 || op == 44 || op == 72) {
                Volej printf("%4d  %3d  v%d  %s  %d\n", i, op, inst->dest, inst->src1, inst->src2)
            } Jinak {
                Volej printf("%4d  %3d  v%d  %s%d  %s%d\n", i, op, inst->dest, Volej ZnackaOperandu(inst->src1_typ), inst->src1, Volej ZnackaOperandu(inst->src2_typ), inst->src2)
            }
        }
        i = i + 1
    }
    Vrat 0
}
Metoda ZnackaOperandu(t) {
    Pokud (t == 0) { Vrat "v" }
    Pokud (t == 1) { Vrat "#" }
    Vrat "?"
}

// ---------------------------------------------------------------------------
// Vektorizace desetinnych cyklu (jen x86-64)
// Cyklus "Dokud (i < n) { ...desetinne vypocty...; s = s + t; i = i + 1 }" pocita dve
// kola najednou: kazda operace (addpd/mulpd/divpd...) zpracuje dvojici hodnot v jednom
// registru xmm. Vysledky jednotlivych kol jsou bit po bitu stejne jako bez vektorizace.
// Soucet (redukce) se nepreskupuje: s = s + t[i]; s = s + t[i+1] - stejne poradi jako puvodne,
// proto je i konecny vysledek stejny (gcc tohle bez -ffast-math nedela).
// Zbyle kolo (lichy pocet) dopocita puvodni cyklus, ktery zustava za vektorovym.
// Nove operace IR: 80 rozkopiruj, 81 dve cela -> dve desetinna, 82-85 + - * / dvojic,
// 86 horni polovina.
// ---------------------------------------------------------------------------
Globalni ir_vektor = 0          // vreg -> 1: dvojice desetinnych cisel v jednom xmm
Globalni vek_vypnuto = 0        // --bez-vektorizace
Globalni vek_buf = 0
Globalni vek_n = 0
Globalni vek_pre = 0
Globalni vek_pre_n = 0
Globalni vek_seznam = 0         // vregy dvojic (pro ir_vektor)
Globalni vek_seznam_n = 0
Globalni vek_seznam_kap = 0
Globalni vek_pocet_cyklu = 0
Globalni vek_noveho = 0         // pocet novych vregu dvojic v aktualnim cyklu

Metoda VekZapis(buf, n, op, d, s1, t1, s2, t2) {
    Lokalni b : IR_Instrukce = buf + (n * 48)
    b->opcode = op
    b->dest = d
    b->src1 = s1
    b->src1_typ = t1
    b->src2 = s2
    b->src2_typ = t2
    Vrat 0
}
Metoda VekPridej(op, d, s1, t1, s2, t2) {
    Volej VekZapis(vek_buf, vek_n, op, d, s1, t1, s2, t2)
    vek_n = vek_n + 1
    Vrat 0
}
Metoda VekNovy() {
    Lokalni v = Volej NovyVreg()
    Pokud (vek_seznam_n >= vek_seznam_kap) {
        vek_seznam_kap = (vek_seznam_kap * 2) + 64
        vek_seznam = Volej realloc(vek_seznam, vek_seznam_kap * 8)
    }
    Volej ZapisUkazatel(vek_seznam + (vek_seznam_n * 8), v)
    vek_seznam_n = vek_seznam_n + 1
    vek_noveho = vek_noveho + 1
    Vrat v
}
Metoda JeSkokIR(op) {
    Pokud (op == 10 || op == 54 || (op >= 30 && op <= 35)) { Vrat 1 }
    Vrat 0
}
// Kolik dvojic smi byt zivych najednou: kazda musi dostat vlastni xmm registr
// (Linux/macOS xmm0-13, Windows jen xmm0-5); dva registry zustanou pro skalarni hodnoty
Metoda VekLimit() {
    Pokud (cilova_platforma == 2) { Vrat 4 }
    Vrat 12
}
// Nejvic soucasne zivych dvojic: rozkopirovane hodnoty (ziji cely cyklus) + hodnoty tela
Metoda VekTlak(sez0) {
    Lokalni posledni = Volej calloc(citac_temp_reg + 1, 8)
    Lokalni je = Volej calloc(citac_temp_reg + 1, 8)
    Lokalni k = sez0
    Dokud (k < vek_seznam_n) {
        Volej ZapisUkazatel(je + (CtiZAdresu(vek_seznam + (k * 8)) * 8), 1)
        k = k + 1
    }
    Lokalni e = 0
    Dokud (e < vek_n) {
        Lokalni ie : IR_Instrukce = vek_buf + (e * 48)
        Pokud (ie->src1_typ == 0 && ie->src1 > 0 && ie->src1 < citac_temp_reg) { Volej ZapisUkazatel(posledni + (ie->src1 * 8), e) }
        Pokud (ie->src2_typ == 0 && ie->src2 > 0 && ie->src2 < citac_temp_reg) { Volej ZapisUkazatel(posledni + (ie->src2 * 8), e) }
        e = e + 1
    }
    Lokalni nej = 0
    e = 0
    Dokud (e < vek_n) {
        Lokalni zive = vek_pre_n
        Lokalni f = 0
        Dokud (f <= e) {
            Lokalni iff : IR_Instrukce = vek_buf + (f * 48)
            Lokalni dd = iff->dest
            Pokud (dd > 0 && dd < citac_temp_reg) {
                Pokud (CtiZAdresu(je + (dd * 8)) == 1 && (f == e || CtiZAdresu(posledni + (dd * 8)) >= e)) { zive = zive + 1 }
            }
            f = f + 1
        }
        Pokud (zive > nej) { nej = zive }
        e = e + 1
    }
    Volej free(posledni)
    Volej free(je)
    Vrat nej
}

Metoda VektorizujCykly() {
    Pokud (ir_vektor != 0) { Volej free(ir_vektor) }
    ir_vektor = 0
    vek_seznam_n = 0
    Pokud (vek_vypnuto == 1 || ir_metoda_ma_asm == 1 || Volej JeARM() == 1) { Vrat 0 }
    Lokalni pocet = 0
    Lokalni t = 0
    Dokud (t < pocet_ir) {
        Lokalni it : IR_Instrukce = pamet_ir + (t * 48)
        Pokud (it->opcode == 35 && it->src1_typ == 0) {
            Lokalni nove = Volej VektorizujCyklus(t)
            Pokud (nove > 0) { pocet = pocet + 1; t = t + nove }
        }
        t = t + 1
    }
    Pokud (vek_seznam_n > 0) {
        ir_vektor = Volej calloc(citac_temp_reg + 1, 8)
        Lokalni k = 0
        Dokud (k < vek_seznam_n) {
            Volej ZapisUkazatel(ir_vektor + (CtiZAdresu(vek_seznam + (k * 8)) * 8), 1)
            k = k + 1
        }
    }
    vek_pocet_cyklu = vek_pocet_cyklu + pocet
    Vrat pocet
}

// Operand dvojice: hodnota z tela (uz prevedena) nebo hodnota zvenku (rozkopiruje se pred cyklem)
Metoda VekOperand(v, typ, mapa, bmapa, defs, iv, nv0) {
    Pokud (typ != 0 || v <= 0 || v >= nv0 || v == iv) { Vrat 0 }
    Lokalni m = CtiZAdresu(mapa + (v * 8))
    Pokud (m != 0) { Vrat m }
    Pokud (CtiZAdresu(defs + (v * 8)) != 0) { Vrat 0 }   // pouziti pred definici (hodnota z minuleho kola)
    Lokalni bm = CtiZAdresu(bmapa + (v * 8))
    Pokud (bm != 0) { Vrat bm }
    bm = Volej VekNovy()
    Volej ZapisUkazatel(bmapa + (v * 8), bm)
    Volej VekZapis(vek_pre, vek_pre_n, 80, bm, v, 0, 0, 1)
    vek_pre_n = vek_pre_n + 1
    Vrat bm
}

// t = index testu "35 L_telo, i, n". Vrati pocet vlozenych instrukci (0 = cyklus nezmenen).
Metoda VektorizujCyklus(t) {
    Lokalni it : IR_Instrukce = pamet_ir + (t * 48)
    Lokalni l_telo = it->dest
    Lokalni iv = it->src1
    Lokalni nn = it->src2
    Lokalni nn_t = it->src2_typ
    Lokalni nv0 = citac_temp_reg
    Pokud (iv <= 0 || iv >= nv0) { Vrat 0 }
    // navesti tesne pred testem (pokracovani cyklu, zacatek testu)
    Lokalni k = t - 1
    Dokud (k >= 0) {
        Lokalni ik : IR_Instrukce = pamet_ir + (k * 48)
        Pokud (ik->opcode == 11 || ik->opcode == 0) { k = k - 1 } Jinak { Ukonci }
    }
    Lokalni posl = k
    Pokud (posl <= 0) { Vrat 0 }
    Lokalni inc : IR_Instrukce = pamet_ir + (posl * 48)
    Pokud (inc->opcode != 4 || inc->dest != iv || inc->src1 != iv || inc->src1_typ != 0 || inc->src2 != 1 || inc->src2_typ != 1) { Vrat 0 }
    // navesti tela
    Lokalni b = posl - 1
    Dokud (b >= 0) {
        Lokalni ib : IR_Instrukce = pamet_ir + (b * 48)
        Pokud (ib->opcode == 11 && ib->dest == l_telo) { Ukonci }
        b = b - 1
    }
    Pokud (b <= 0) { Vrat 0 }
    // pred telem: skok na test
    Lokalni j = b - 1
    Dokud (j >= 0) {
        Lokalni ij0 : IR_Instrukce = pamet_ir + (j * 48)
        Pokud (ij0->opcode != 0) { Ukonci }
        j = j - 1
    }
    Pokud (j < 0) { Vrat 0 }
    Lokalni ij : IR_Instrukce = pamet_ir + (j * 48)
    Pokud (ij->opcode != 10) { Vrat 0 }
    Lokalni l_test = ij->dest
    Lokalni ok = 0
    Lokalni q = posl + 1
    Dokud (q < t) {
        Lokalni iq : IR_Instrukce = pamet_ir + (q * 48)
        Pokud (iq->opcode == 11 && iq->dest == l_test) { ok = 1 }
        q = q + 1
    }
    Pokud (ok == 0) { Vrat 0 }
    // zadne jine skoky do cyklu (Pokracuj, Ukonci apod. -> nevektorizujeme)
    q = 0
    Dokud (q < pocet_ir) {
        Lokalni iz : IR_Instrukce = pamet_ir + (q * 48)
        Pokud (q != j && q != t && Volej JeSkokIR(iz->opcode) == 1) {
            Pokud (iz->dest == l_telo) { Vrat 0 }
            Lokalni r = posl + 1
            Dokud (r < t) {
                Lokalni ir_ : IR_Instrukce = pamet_ir + (r * 48)
                Pokud (ir_->opcode == 11 && ir_->dest == iz->dest) { Vrat 0 }
                r = r + 1
            }
        }
        Pokud (q > b && q < posl && iz->opcode != 0) {
            Lokalni opz = iz->opcode
            Pokud (!(opz == 26 || opz == 64 || (opz >= 60 && opz <= 63))) { Vrat 0 }
        }
        q = q + 1
    }
    // definice a pouziti v tele
    Lokalni defs = Volej calloc(nv0 + 1, 8)
    Lokalni uses = Volej calloc(nv0 + 1, 8)
    Lokalni mapa = Volej calloc(nv0 + 1, 8)
    Lokalni bmapa = Volej calloc(nv0 + 1, 8)
    Lokalni redukce = Volej calloc(nv0 + 1, 8)
    Lokalni dobre = 1
    q = b + 1
    Dokud (q < posl && dobre == 1) {
        Lokalni iu : IR_Instrukce = pamet_ir + (q * 48)
        Pokud (iu->opcode != 0) {
            Pokud (iu->dest <= 0 || iu->dest >= nv0 || iu->dest == iv) { dobre = 0 } Jinak {
                Volej ZapisUkazatel(defs + (iu->dest * 8), CtiZAdresu(defs + (iu->dest * 8)) + 1)
                Pokud (CtiZAdresu(defs + (iu->dest * 8)) > 1) { dobre = 0 }
            }
            Pokud (iu->src1_typ == 0 && iu->src1 > 0 && iu->src1 < nv0) { Volej ZapisUkazatel(uses + (iu->src1 * 8), CtiZAdresu(uses + (iu->src1 * 8)) + 1) }
            Pokud (iu->src2_typ == 0 && iu->src2 > 0 && iu->src2 < nv0) { Volej ZapisUkazatel(uses + (iu->src2 * 8), CtiZAdresu(uses + (iu->src2 * 8)) + 1) }
        }
        q = q + 1
    }
    Pokud (nn_t == 0) {
        Pokud (nn == iv || nn <= 0 || nn >= nv0) { dobre = 0 } Jinak { Pokud (CtiZAdresu(defs + (nn * 8)) != 0) { dobre = 0 } }
    }
    // preklad tela
    Lokalni kap = ((posl - b) * 4) + 32
    vek_buf = Volej calloc(kap, 48)
    vek_n = 0
    vek_pre = Volej calloc(kap, 48)
    vek_pre_n = 0
    vek_noveho = 0
    Lokalni sez0 = vek_seznam_n
    Lokalni tc = Volej NovyVreg()   // i + 1 (spocitane v testu vektoroveho cyklu)
    Lokalni l_vt = Volej NoveNavesti()
    Lokalni l_vb = Volej NoveNavesti()
    Lokalni redukci = 0
    q = b + 1
    Dokud (q < posl && dobre == 1) {
        Lokalni ip : IR_Instrukce = pamet_ir + (q * 48)
        Lokalni op = ip->opcode
        Lokalni d = ip->dest
        Pokud (op == 64) {
            Pokud (ip->src1_typ != 0) { dobre = 0 } Jinak {
                Lokalni p64 = Volej VekNovy()
                Pokud (ip->src1 == iv) { Volej VekPridej(81, p64, iv, 0, tc, 0) }
                Jinak Pokud (ip->src1 > 0 && ip->src1 < nv0 && CtiZAdresu(defs + (ip->src1 * 8)) == 0) { Volej VekPridej(81, p64, ip->src1, 0, ip->src1, 0) }
                Jinak { dobre = 0 }
                Volej ZapisUkazatel(mapa + (d * 8), p64)
            }
        } Jinak Pokud (op == 26) {
            Lokalni m26 = 0
            Pokud (ip->src1_typ == 0 && ip->src1 > 0 && ip->src1 < nv0) { m26 = CtiZAdresu(mapa + (ip->src1 * 8)) }
            Pokud (m26 == 0) { dobre = 0 } Jinak { Volej ZapisUkazatel(mapa + (d * 8), m26) }
        } Jinak Pokud (op >= 60 && op <= 63) {
            Lokalni a = ip->src1
            Lokalni bb = ip->src2
            Lokalni red = 0
            Lokalni x = 0
            Pokud (ip->src1_typ == 0 && ip->src2_typ == 0) {
                Pokud (a == d && bb != d) { red = 1; x = bb }
                Jinak Pokud ((op == 60 || op == 62) && bb == d && a != d) { red = 1; x = a }
            }
            Pokud (red == 1) {
                // redukce: d se v tele jinde necte; dve skalarni operace ve stejnem poradi
                Lokalni px = 0
                Pokud (x > 0 && x < nv0) { px = CtiZAdresu(mapa + (x * 8)) }
                Pokud (px == 0 || CtiZAdresu(uses + (d * 8)) != 1) { dobre = 0 } Jinak {
                    Volej ZapisUkazatel(redukce + (d * 8), 1)
                    Volej VekPridej(op, d, d, 0, px, 0)
                    Lokalni hi = Volej VekNovy()
                    Volej VekPridej(86, hi, px, 0, 0, 1)
                    Volej VekPridej(op, d, d, 0, hi, 0)
                    redukci = redukci + 1
                }
            } Jinak {
                Lokalni pa = Volej VekOperand(a, ip->src1_typ, mapa, bmapa, defs, iv, nv0)
                Lokalni pb = Volej VekOperand(bb, ip->src2_typ, mapa, bmapa, defs, iv, nv0)
                Pokud (pa == 0 || pb == 0) { dobre = 0 } Jinak {
                    Lokalni pd = Volej VekNovy()
                    Volej VekPridej(82 + (op - 60), pd, pa, 0, pb, 0)
                    Volej ZapisUkazatel(mapa + (d * 8), pd)
                }
            }
        }
        q = q + 1
    }
    Pokud (redukci == 0) { dobre = 0 }
    Pokud (dobre == 1) { Pokud (Volej VekTlak(sez0) > Volej VekLimit()) { dobre = 0 } }
    // hodnoty z tela (krome redukci) se za cyklem nesmi cist: vektorovy cyklus je nezapisuje
    Pokud (dobre == 1) {
        q = 0
        Dokud (q < pocet_ir && dobre == 1) {
            Pokud (q < b || q > t) {
                Lokalni io : IR_Instrukce = pamet_ir + (q * 48)
                Pokud (io->opcode != 0 && io->opcode < 97) {
                    Pokud (io->src1_typ == 0 && io->src1 > 0 && io->src1 < nv0) {
                        Pokud (CtiZAdresu(defs + (io->src1 * 8)) != 0 && CtiZAdresu(redukce + (io->src1 * 8)) == 0) { dobre = 0 }
                    }
                    Pokud (io->src2_typ == 0 && io->src2 > 0 && io->src2 < nv0) {
                        Pokud (CtiZAdresu(defs + (io->src2 * 8)) != 0 && CtiZAdresu(redukce + (io->src2 * 8)) == 0) { dobre = 0 }
                    }
                }
            }
            q = q + 1
        }
    }
    Lokalni vlozeno = 0
    Pokud (dobre == 1) {
        // pred skok na test: rozkopirovani; skok na test vektoru; telo; i += 2; test; (puvodni skok)
        Lokalni celkem = vek_pre_n + 2 + vek_n + 5
        Lokalni hl_tela = CtiZAdresu(ir_hloubka_cyklu + ((b + 1) * 8))
        Volej VlozMistoIR(j, celkem)
        Lokalni w = j
        Lokalni e = 0
        Dokud (e < vek_pre_n) {
            Volej memmove(pamet_ir + (w * 48), vek_pre + (e * 48), 48)
            w = w + 1
            e = e + 1
        }
        Volej VekZapis(pamet_ir, w, 10, l_vt, 0, 1, 0, 1)
        w = w + 1
        Lokalni w_tela = w
        Volej VekZapis(pamet_ir, w, 11, l_vb, 0, 1, 0, 1)
        w = w + 1
        e = 0
        Dokud (e < vek_n) {
            Volej memmove(pamet_ir + (w * 48), vek_buf + (e * 48), 48)
            w = w + 1
            e = e + 1
        }
        Volej VekZapis(pamet_ir, w, 4, iv, iv, 0, 2, 1)
        w = w + 1
        Volej VekZapis(pamet_ir, w, 11, l_vt, 0, 1, 0, 1)
        w = w + 1
        Volej VekZapis(pamet_ir, w, 32, l_test, iv, 0, nn, nn_t)
        w = w + 1
        Volej VekZapis(pamet_ir, w, 4, tc, iv, 0, 1, 1)
        w = w + 1
        Volej VekZapis(pamet_ir, w, 35, l_vb, tc, 0, nn, nn_t)
        w = w + 1
        Lokalni h = w_tela
        Dokud (h < w) {
            Volej ZapisUkazatel(ir_hloubka_cyklu + (h * 8), hl_tela)
            h = h + 1
        }
        vlozeno = celkem
        Pokud (podrobny_vypis == 1) { Volej printf(">> Vektorizace: cyklus v '%s' pocita dve kola najednou (%d redukci)\n", Volej JmenoMetodyIR(), redukci) }
    } Jinak {
        vek_seznam_n = sez0   // nove vregy nepouzity
    }
    Volej free(vek_buf)
    Volej free(vek_pre)
    Volej free(defs)
    Volej free(uses)
    Volej free(mapa)
    Volej free(bmapa)
    Volej free(redukce)
    Vrat vlozeno
}

// Pocty definic vregu (pro presuny pred alokaci)
Metoda SpocitejDefiniceIR() {
    Volej SpocitejDefinice()
    Vrat 1
}

// Nedosazitelny kod: instrukce za bezpodminecnym skokem az do dalsiho navesti
// (napr. "vysledek = 0" za posledním Vrat). Surovy text (99) muze obsahovat navesti -> konec.
Metoda OdstranNedosazitelne() {
    Lokalni pocet = 0
    Lokalni mrtvy = 0
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op = inst->opcode
        Pokud (op == 11 || op == 99 || op == 97 || op == 98) { mrtvy = 0 }
        Jinak Pokud (mrtvy == 1 && op != 0) { inst->opcode = 0; pocet = pocet + 1 }
        Jinak Pokud (op == 10) { mrtvy = 1 }
        i = i + 1
    }
    Vrat pocet
}

Metoda OptimalizujMrtvyKod() {
    Lokalni celkem = 0
    Lokalni zmena = 1
    Dokud (zmena == 1) {
        zmena = 0
        Lokalni i = pocet_ir - 1
        Dokud (i >= 0) {
            Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
            Lokalni op = inst->opcode
            Lokalni smi = 0
            Pokud (op == 1 || op == 2 || op == 26 || op == 28 || op == 29 || op == 41 || op == 44 || op == 47) { smi = 1 }
            Pokud ((op >= 4 && op <= 6) || (op >= 12 && op <= 22)) { smi = 1 }
            Pokud (smi == 1 && inst->dest > 0) {
                Pokud (CtiZAdresu(ir_pocty_pouziti + (inst->dest * 8)) == 0) {
                    // Zapis do povysene promenne, kterou uz nikdo necte, je take mrtvy
                    Pokud (inst->src1_typ == 0 && inst->src1 > 0) {
                        Volej ZapisUkazatel(ir_pocty_pouziti + (inst->src1 * 8), CtiZAdresu(ir_pocty_pouziti + (inst->src1 * 8)) - 1)
                    }
                    Pokud (inst->src2_typ == 0 && inst->src2 > 0) {
                        Volej ZapisUkazatel(ir_pocty_pouziti + (inst->src2 * 8), CtiZAdresu(ir_pocty_pouziti + (inst->src2 * 8)) - 1)
                    }
                    inst->opcode = 0
                    celkem = celkem + 1
                    zmena = 1
                }
            }
            i = i - 1
        }
    }
    Vrat celkem
}

// ==========================================
// CFG: zakladni bloky a jejich nasledovnici (hrany = cisla bloku)
// Blok (48 B): +0 prvni instrukce, +8 posledni, +16 skok, +24 plynuly prechod, +32 mnoziny
// ==========================================
Globalni slov_v_mnozine = 1

Metoda VytvorZakladniBlok(start_id) {
    Lokalni b_adr = pamet_bloku + (pocet_bloku * 48)
    Volej ZapisUkazatel(b_adr + 0, start_id)
    Volej ZapisUkazatel(b_adr + 8, start_id)
    Volej ZapisUkazatel(b_adr + 16, 0 - 1)
    Volej ZapisUkazatel(b_adr + 24, 0 - 1)
    // 4 bitove mnoziny vregu: USE, DEF, IN, OUT (po 64bitovych slovech)
    Volej ZapisUkazatel(b_adr + 32, Volej calloc(4 * slov_v_mnozine, 8))
    pocet_bloku = pocet_bloku + 1
    Vrat pocet_bloku - 1
}

Metoda BudujCFG() {
    pocet_bloku = 0
    Pokud (pocet_ir == 0) { Vrat 0 }
    slov_v_mnozine = (citac_temp_reg / 64) + 1
    Pokud (pamet_bloku != 0) { Volej free(pamet_bloku) }
    pamet_bloku = Volej calloc(pocet_ir + 2, 48)

    // 1) Cislo navesti -> index instrukce
    Lokalni max_nav = citac_navesti + 1
    Lokalni nav_instr = Volej calloc(max_nav + 1, 8)
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst0 : IR_Instrukce = pamet_ir + (i * 48)
        Pokud (inst0->opcode == 11) {
            Pokud (inst0->dest >= 0 && inst0->dest < max_nav) { Volej ZapisUkazatel(nav_instr + (inst0->dest * 8), i + 1) }
        }
        i = i + 1
    }
    // 2) Zacatky bloku
    Lokalni blok_instr = Volej calloc(pocet_ir + 2, 8)
    i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst1 : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni zacatek = 0
        Pokud (i == 0 || inst1->opcode == 11) { zacatek = 1 }
        Pokud (i > 0) {
            Lokalni pred : IR_Instrukce = pamet_ir + ((i - 1) * 48)
            Pokud (pred->opcode == 10 || Volej JePodmSkok(pred->opcode) == 1) { zacatek = 1 }
        }
        Pokud (zacatek == 1) { Volej ZapisUkazatel(blok_instr + (i * 8), Volej VytvorZakladniBlok(i) + 1) }
        i = i + 1
    }
    // 3) Konce bloku a nasledovnici
    Lokalni b = 0
    Dokud (b < pocet_bloku) {
        Lokalni b_adr = pamet_bloku + (b * 48)
        Lokalni konec = pocet_ir - 1
        Pokud (b + 1 < pocet_bloku) { konec = CtiZAdresu(pamet_bloku + ((b + 1) * 48)) - 1 }
        Volej ZapisUkazatel(b_adr + 8, konec)
        Lokalni posl : IR_Instrukce = pamet_ir + (konec * 48)
        Lokalni op2 = posl->opcode
        Pokud (op2 == 10 || Volej JePodmSkok(op2) == 1) {
            Lokalni cil = posl->dest
            Pokud (cil >= 0 && cil < max_nav) {
                Lokalni cil_i = CtiZAdresu(nav_instr + (cil * 8))
                Pokud (cil_i > 0) { Volej ZapisUkazatel(b_adr + 16, CtiZAdresu(blok_instr + ((cil_i - 1) * 8)) - 1) }
            }
        }
        Pokud (op2 != 10 && op2 != 97 && konec + 1 < pocet_ir) { Volej ZapisUkazatel(b_adr + 24, b + 1) }
        b = b + 1
    }
    Volej free(nav_instr)
    Volej free(blok_instr)
    Vrat 0
}

Metoda CistiCFG() {
    Lokalni b = 0
    Dokud (b < pocet_bloku) {
        Volej free(CtiZAdresu(pamet_bloku + (b * 48) + 32))
        b = b + 1
    }
    pocet_bloku = 0
    Vrat 0
}

Metoda BitNastav(mnozina, v) {
    Lokalni adr = mnozina + ((v >> 6) * 8)
    Volej ZapisUkazatel(adr, CtiZAdresu(adr) | (1 << (v & 63)))
    Vrat 0
}

Metoda BitJe(mnozina, v) {
    Vrat (CtiZAdresu(mnozina + ((v >> 6) * 8)) >> (v & 63)) & 1
}

// ==========================================
// Liveness: ktere vregy jsou zive na vstupu/vystupu bloku. Zive vregy prodlouzime
// pres cele bloky - tak promenna v cyklu drzi svuj registr po cely cyklus.
// ==========================================
Metoda SpocitejLiveness() {
    Pokud (pocet_bloku == 0) { Vrat 0 }
    Lokalni nw = slov_v_mnozine
    // USE a DEF kazdeho bloku
    Lokalni b = 0
    Dokud (b < pocet_bloku) {
        Lokalni b_adr = pamet_bloku + (b * 48)
        Lokalni use = CtiZAdresu(b_adr + 32)
        Lokalni def = use + (nw * 8)
        Lokalni j = CtiZAdresu(b_adr + 0)
        Lokalni e_i = CtiZAdresu(b_adr + 8)
        Dokud (j <= e_i) {
            Lokalni inst : IR_Instrukce = pamet_ir + (j * 48)
            Lokalni op = inst->opcode
            Pokud (op != 0 && op < 97) {
                Pokud (inst->src1_typ == 0 && inst->src1 > 0 && inst->src1 < citac_temp_reg) {
                    Pokud (Volej BitJe(def, inst->src1) == 0) { Volej BitNastav(use, inst->src1) }
                }
                Pokud (inst->src2_typ == 0 && inst->src2 > 0 && inst->src2 < citac_temp_reg) {
                    Pokud (Volej BitJe(def, inst->src2) == 0) { Volej BitNastav(use, inst->src2) }
                }
                Pokud (Volej DefinujeDest(op) == 1 && inst->dest > 0 && inst->dest < citac_temp_reg) { Volej BitNastav(def, inst->dest) }
            }
            j = j + 1
        }
        b = b + 1
    }
    // Iterace: OUT = IN(nasledovniku), IN = USE | (OUT & ~DEF), dokud se neco meni
    Lokalni zmena = 1
    Lokalni iter = 0
    Dokud (zmena == 1) {
        zmena = 0
        iter = iter + 1
        b = pocet_bloku - 1
        Dokud (b >= 0) {
            Lokalni b2 = pamet_bloku + (b * 48)
            Lokalni sady = CtiZAdresu(b2 + 32)
            Lokalni s1 = CtiZAdresu(b2 + 16)
            Lokalni s2 = CtiZAdresu(b2 + 24)
            Lokalni in1 = 0
            Lokalni in2 = 0
            Pokud (s1 >= 0) { in1 = CtiZAdresu(pamet_bloku + (s1 * 48) + 32) + (nw * 16) }
            Pokud (s2 >= 0) { in2 = CtiZAdresu(pamet_bloku + (s2 * 48) + 32) + (nw * 16) }
            Lokalni w = 0
            Dokud (w < nw) {
                Lokalni o = 0
                Pokud (in1 != 0) { o = CtiZAdresu(in1 + (w * 8)) }
                Pokud (in2 != 0) { o = o | CtiZAdresu(in2 + (w * 8)) }
                Volej ZapisUkazatel(sady + (nw * 24) + (w * 8), o)
                Lokalni novy_in = CtiZAdresu(sady + (w * 8)) | (o & (CtiZAdresu(sady + (nw * 8) + (w * 8)) ^ (0 - 1)))
                Pokud (novy_in != CtiZAdresu(sady + (nw * 16) + (w * 8))) {
                    Volej ZapisUkazatel(sady + (nw * 16) + (w * 8), novy_in)
                    zmena = 1
                }
                w = w + 1
            }
            b = b - 1
        }
    }
    // Prodlouzeni intervalu: vreg zivy na vstupu nebo vystupu bloku zabira cely blok
    b = 0
    Dokud (b < pocet_bloku) {
        Lokalni b3 = pamet_bloku + (b * 48)
        Lokalni sady3 = CtiZAdresu(b3 + 32)
        Lokalni st = CtiZAdresu(b3 + 0)
        Lokalni en = CtiZAdresu(b3 + 8)
        Lokalni w3 = 0
        Dokud (w3 < nw) {
            Lokalni zive = CtiZAdresu(sady3 + (nw * 16) + (w3 * 8)) | CtiZAdresu(sady3 + (nw * 24) + (w3 * 8))
            Pokud (zive != 0) {
                Lokalni bit = 0
                Dokud (bit < 64) {
                    Pokud (((zive >> bit) & 1) == 1) {
                        Lokalni v = (w3 * 64) + bit
                        Pokud (v > 0 && v < citac_temp_reg) {
                            Volej RozsirInterval(v, st)
                            Volej RozsirInterval(v, en)
                        }
                    }
                    bit = bit + 1
                }
            }
            w3 = w3 + 1
        }
        b = b + 1
    }
    Pokud (podrobny_vypis == 1) { Volej printf("Backend: Liveness ustalena po %d pruchodech, %d bloku.\n", iter, pocet_bloku) }
    Vrat 0
}

// ==========================================
// Useky zivota (lifetime holes)
//   Interval [prvni, posledni pouziti] je hruby obal. Presneji: vreg je zivy jen v nekolika
//   usecich (napr. ve vetvi presunute za hlavni cestu nezije mezi). Registr pak muze sdilet
//   vic vregu, jejichz useky se neprekryvaji, i kdyz se jejich obaly prekryvaji.
//   Pocita se z liveness: blok po bloku odzadu (zivy na vystupu -> usek do konce bloku,
//   definice usek ukonci, pouziti ho otevre).
// ==========================================
Globalni us_od = 0          // seradene useky: zacatek (vcetne)
Globalni us_do = 0          // konec (vcetne)
Globalni us_zac = 0         // pro vreg v: index prvniho useku
Globalni us_poc = 0         // pro vreg v: pocet useku (0 = pouzij obal intervalu)
Globalni tr_v = 0           // docasne trojice (vreg, od, do)
Globalni tr_od = 0
Globalni tr_do = 0
Globalni tr_n = 0
Globalni tr_kap = 0

Metoda PridejUsek(v, od, do_) {
    Pokud (v <= 0 || v >= citac_temp_reg) { Vrat 0 }
    Pokud (tr_n >= tr_kap) {
        tr_kap = tr_kap * 2
        tr_v = Volej realloc(tr_v, tr_kap * 8)
        tr_od = Volej realloc(tr_od, tr_kap * 8)
        tr_do = Volej realloc(tr_do, tr_kap * 8)
    }
    Volej ZapisUkazatel(tr_v + (tr_n * 8), v)
    Volej ZapisUkazatel(tr_od + (tr_n * 8), od)
    Volej ZapisUkazatel(tr_do + (tr_n * 8), do_)
    tr_n = tr_n + 1
    Vrat 0
}

Metoda OtevriUsek(otevreno, zasob, zn, v, j) {
    Pokud (v <= 0 || v >= citac_temp_reg) { Vrat zn }
    Pokud (CtiZAdresu(otevreno + (v * 8)) == 0) {
        Volej ZapisUkazatel(otevreno + (v * 8), j + 1)
        Volej ZapisUkazatel(zasob + (zn * 8), v)
        Vrat zn + 1
    }
    Vrat zn
}

Metoda SpocitejUseky() {
    tr_kap = 1024
    tr_n = 0
    tr_v = Volej malloc(tr_kap * 8)
    tr_od = Volej malloc(tr_kap * 8)
    tr_do = Volej malloc(tr_kap * 8)
    Lokalni nw = slov_v_mnozine
    Lokalni otevreno = Volej calloc(citac_temp_reg + 1, 8)   // konec otevreneho useku + 1 (0 = zavreny)
    Lokalni zasob = Volej calloc(citac_temp_reg + (2 * pocet_ir) + 2, 8)
    Lokalni b = 0
    Dokud (b < pocet_bloku) {
        Lokalni b_adr = pamet_bloku + (b * 48)
        Lokalni st = CtiZAdresu(b_adr + 0)
        Lokalni en = CtiZAdresu(b_adr + 8)
        Lokalni sady = CtiZAdresu(b_adr + 32)
        Lokalni zn = 0
        // zive na vystupu bloku
        Lokalni w = 0
        Dokud (w < nw) {
            Lokalni o = CtiZAdresu(sady + (nw * 24) + (w * 8))
            Pokud (o != 0) {
                Lokalni bit = 0
                Dokud (bit < 64) {
                    Pokud (((o >> bit) & 1) == 1) { zn = Volej OtevriUsek(otevreno, zasob, zn, (w * 64) + bit, en) }
                    bit = bit + 1
                }
            }
            w = w + 1
        }
        Lokalni j = en
        Dokud (j >= st) {
            Lokalni inst : IR_Instrukce = pamet_ir + (j * 48)
            Lokalni op = inst->opcode
            Pokud (op != 0 && op < 97) {
                Lokalni d = inst->dest
                Pokud (Volej DefinujeDest(op) == 1 && d > 0 && d < citac_temp_reg) {
                    Lokalni ot = CtiZAdresu(otevreno + (d * 8))
                    Pokud (ot > 0) {
                        Volej PridejUsek(d, j, ot - 1)
                        Volej ZapisUkazatel(otevreno + (d * 8), 0)
                    } Jinak {
                        Volej PridejUsek(d, j, j) // mrtva definice: registr zabira aspon v teto instrukci
                    }
                }
                Pokud (inst->src1_typ == 0) { zn = Volej OtevriUsek(otevreno, zasob, zn, inst->src1, j) }
                Pokud (inst->src2_typ == 0) { zn = Volej OtevriUsek(otevreno, zasob, zn, inst->src2, j) }
            }
            j = j - 1
        }
        // co zustalo otevrene, zije od zacatku bloku
        Lokalni k = 0
        Dokud (k < zn) {
            Lokalni v = CtiZAdresu(zasob + (k * 8))
            Lokalni ot2 = CtiZAdresu(otevreno + (v * 8))
            Pokud (ot2 > 0) {
                Volej PridejUsek(v, st, ot2 - 1)
                Volej ZapisUkazatel(otevreno + (v * 8), 0)
            }
            k = k + 1
        }
        b = b + 1
    }
    Volej free(otevreno)
    Volej free(zasob)
    // Razeni podle vregu (counting sort), pak podle zacatku, a slouceni navazujicich useku
    us_poc = Volej calloc(citac_temp_reg + 1, 8)
    us_zac = Volej calloc(citac_temp_reg + 2, 8)
    us_od = Volej malloc((tr_n + 1) * 8)
    us_do = Volej malloc((tr_n + 1) * 8)
    Lokalni t = 0
    Dokud (t < tr_n) {
        Lokalni vt = CtiZAdresu(tr_v + (t * 8))
        Volej ZapisUkazatel(us_zac + ((vt + 1) * 8), CtiZAdresu(us_zac + ((vt + 1) * 8)) + 1)
        t = t + 1
    }
    Lokalni v2 = 1
    Dokud (v2 <= citac_temp_reg) {
        Volej ZapisUkazatel(us_zac + (v2 * 8), CtiZAdresu(us_zac + (v2 * 8)) + CtiZAdresu(us_zac + ((v2 - 1) * 8)))
        v2 = v2 + 1
    }
    t = 0
    Dokud (t < tr_n) {
        Lokalni vt2 = CtiZAdresu(tr_v + (t * 8))
        Lokalni poz = CtiZAdresu(us_zac + (vt2 * 8)) + CtiZAdresu(us_poc + (vt2 * 8))
        Volej ZapisUkazatel(us_od + (poz * 8), CtiZAdresu(tr_od + (t * 8)))
        Volej ZapisUkazatel(us_do + (poz * 8), CtiZAdresu(tr_do + (t * 8)))
        Volej ZapisUkazatel(us_poc + (vt2 * 8), CtiZAdresu(us_poc + (vt2 * 8)) + 1)
        t = t + 1
    }
    v2 = 1
    Dokud (v2 < citac_temp_reg) {
        Lokalni z = CtiZAdresu(us_zac + (v2 * 8))
        Lokalni n = CtiZAdresu(us_poc + (v2 * 8))
        // razeni vkladanim (useku jednoho vregu je malo)
        Lokalni a = 1
        Dokud (a < n) {
            Lokalni ko = CtiZAdresu(us_od + ((z + a) * 8))
            Lokalni kd = CtiZAdresu(us_do + ((z + a) * 8))
            Lokalni c = a - 1
            Dokud (c >= 0 && CtiZAdresu(us_od + ((z + c) * 8)) > ko) {
                Volej ZapisUkazatel(us_od + ((z + c + 1) * 8), CtiZAdresu(us_od + ((z + c) * 8)))
                Volej ZapisUkazatel(us_do + ((z + c + 1) * 8), CtiZAdresu(us_do + ((z + c) * 8)))
                c = c - 1
            }
            Volej ZapisUkazatel(us_od + ((z + c + 1) * 8), ko)
            Volej ZapisUkazatel(us_do + ((z + c + 1) * 8), kd)
            a = a + 1
        }
        // slouceni prekryvajicich se a navazujicich useku
        Pokud (n > 1) {
            Lokalni m = 0
            a = 1
            Dokud (a < n) {
                Lokalni ao = CtiZAdresu(us_od + ((z + a) * 8))
                Lokalni ad = CtiZAdresu(us_do + ((z + a) * 8))
                Pokud (ao <= CtiZAdresu(us_do + ((z + m) * 8)) + 1) {
                    Pokud (ad > CtiZAdresu(us_do + ((z + m) * 8))) { Volej ZapisUkazatel(us_do + ((z + m) * 8), ad) }
                } Jinak {
                    m = m + 1
                    Volej ZapisUkazatel(us_od + ((z + m) * 8), ao)
                    Volej ZapisUkazatel(us_do + ((z + m) * 8), ad)
                }
                a = a + 1
            }
            Volej ZapisUkazatel(us_poc + (v2 * 8), m + 1)
        }
        v2 = v2 + 1
    }
    Volej free(tr_v)
    Volej free(tr_od)
    Volej free(tr_do)
    Vrat 0
}

Metoda UvolniUseky() {
    Volej free(us_od)
    Volej free(us_do)
    Volej free(us_zac)
    Volej free(us_poc)
    Vrat 0
}

// ==========================================
// Slouceni kopii (coalescing): "t = a + b; x = t"  ->  "x = a + b"
// ==========================================
Metoda SlucKopie() {
    Lokalni pocet = 0
    Lokalni i = 1
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Pokud (inst->opcode == 26 && inst->src1_typ == 0) {
            Lokalni s = inst->src1
            Lokalni d = inst->dest
            Pokud (s >= ir_prvni_temp && s != d && CtiZAdresu(ir_pocty_pouziti + (s * 8)) == 1) {
                Lokalni j = i - 1
                Lokalni pj : IR_Instrukce = pamet_ir + (j * 48)
                Dokud (j > 0 && pj->opcode == 0) { j = j - 1; pj = pamet_ir + (j * 48) }
                Pokud (pj->dest == s && pj->opcode != 39 && Volej DefinujeDest(pj->opcode) == 1) {
                    // x nesmi byt druhym operandem (instrukce "mov x, a; op x, b" by b prepsala)
                    Pokud (!(pj->src2_typ == 0 && pj->src2 == d)) {
                        pj->dest = d
                        inst->opcode = 0
                        pocet = pocet + 1
                    }
                }
            }
        }
        i = i + 1
    }
    Vrat pocet
}

// ==========================================
// Linear Scan: vregy -> fyzicke registry (nebo zasobnik, kdyz dojdou)
//   - nejdriv se zkousi "scratch" registry (rcx, rdx, rsi, rdi, r8, r9), ktere neni treba
//     ukladat; smi je dostat jen interval, ve kterem je zadna instrukce neprepisuje
//   - pak registry, ktere musi volana metoda zachovat (rbx, r12-r15; Windows i rsi, rdi)
//   - kdyz registry dojdou, odlozi se do pameti interval s nejmensi vahou
//     (vaha = pocet pouziti, kazda uroven cyklu x8)
// ==========================================
Globalni ra_pool = 0          // kody registru v poradi preference
Globalni ra_pocet = 0
Globalni ra_seznamy = 0       // pro kazdy kod registru: pole indexu instrukci, ktere ho prepisuji
Globalni ra_delky = 0
Globalni ra_vahy = 0

// ==========================================
// Pamatuj: cista metoda s jednim celociselnym parametrem si pamatuje vysledky
//   Pamatuj Metoda Fib(n) { ... }  ->  pro 0 <= n < 1024 se kazdy vysledek pocita jen jednou.
//   Kompilator overi, ze je metoda opravdu cista (nic necte ani nemeni mimo sebe), jinak chyba.
// ==========================================
Globalni pam_dalsi = 0
Konstanta PAM_VELIKOST = 1024

Metoda JePamatovana(jmeno) {
    Lokalni sym : Symbol = Volej NajdiSymbol(jmeno)
    Pokud (sym == 0) { Vrat 0 }
    Pokud (sym->is_function == 0) { Vrat 0 }
    Pokud (Volej strcmp(sym->init_str, "Pamatuj") == 0) { Vrat 1 }
    Vrat 0
}

// Je podstrom cisty? (jen lokalni promenne, konstanty, aritmetika, rizeni a volani sebe sama)
Metoda JeCistyStrom(u : AST_Node, jmeno) {
    Pokud (u == 0) { Vrat 1 }
    Lokalni t = u->type
    Pokud (t == AST_CALL) { Pokud (Volej strcmp(u->name, jmeno) != 0) { Vrat 0 } }
    Pokud (t == 16 || t == 17 || t == 19 || t == 27 || t == 25 || t == 26 || t == 30 || t == 31 || t == 34) { Vrat 0 }
    Pokud (t == AST_MEMBER_CHAIN || t == AST_MEMBER_CHAIN_ASSIGN) { Vrat 0 }
    Pokud (t == AST_EXPR && u->op == TOKEN_IDENTIFIER) {
        Lokalni sym : Symbol = Volej NajdiSymbol(u->name)
        Pokud (sym == 0) { Vrat 0 }
        Pokud (sym->is_global == 1 && sym->is_const == 0) { Vrat 0 }   // globalni promenna se muze menit
        Pokud (Volej strcmp(sym->type_name, "Float") == 0) { Vrat 0 }
    }
    Pokud (t == AST_EXPR && u->op == 98) { Vrat 0 }  // desetinne cislo
    Pokud (t == AST_ASSIGN) {
        Lokalni sa : Symbol = Volej NajdiSymbol(u->name)
        Pokud (sa == 0) { Vrat 0 }
        Pokud (sa->is_global == 1) { Vrat 0 }
    }
    Pokud (Volej JeCistyStrom(u->left, jmeno) == 0 || Volej JeCistyStrom(u->right, jmeno) == 0 || Volej JeCistyStrom(u->alt, jmeno) == 0) { Vrat 0 }
    Pokud (u->stmts != 0) {
        Lokalni i = 0
        Dokud (i < u->stmt_count) {
            Pokud (Volej JeCistyStrom(Volej CtiUkazatel(u->stmts + (i * 8)), jmeno) == 0) { Vrat 0 }
            i = i + 1
        }
    }
    Vrat 1
}

Globalni pam_aktivni = 0
Globalni pam_n0 = 0       // vreg s puvodnim argumentem
Globalni pam_jmeno = 0

// Na zacatku metody: kdyz uz je vysledek znamy, rovnou ho vratit
// ---------------------------------------------------------------------------
// Rekurence -> cyklus: cista metoda tvaru
//     Metoda F(n) { Pokud (n < K) { Vrat E(n) }  Vrat F(n - 1) OP F(n - 2) }
// (OP je + - * & | ^, E cte jen n) se spocita cyklem: a = F(K-2), b = F(K-1) a pak
// opakovane b, a = b OP a, b. Vysledek je bit po bitu stejny (cela cisla se pretaci stejne),
// jen misto exponencialne mnoha volani staci n kol. gcc ani clang tohle nedelaji.
// Vypnout: --bez-rekurence.
// ---------------------------------------------------------------------------
Globalni rek_vypnuto = 0

// Je u volani teto metody s argumentem "n - k"? Vrati k, jinak 0
Metoda RekVolani(u : AST_Node, f : AST_Node, jmeno_n) {
    Pokud (u == 0) { Vrat 0 }
    Pokud (u->type != AST_CALL || u->stmt_count != 1) { Vrat 0 }
    Pokud (Volej strcmp(u->name, f->name) != 0) { Vrat 0 }
    Lokalni a : AST_Node = Volej CtiUkazatel(u->stmts)
    Pokud (a == 0) { Vrat 0 }
    Pokud (a->type != AST_EXPR || a->op != 44) { Vrat 0 }
    Lokalni l : AST_Node = a->left
    Lokalni r : AST_Node = a->right
    Pokud (l == 0 || r == 0) { Vrat 0 }
    Pokud (l->type != AST_EXPR || l->op != 35 || r->type != AST_EXPR || r->op != 34) { Vrat 0 }
    Pokud (Volej strcmp(l->name, jmeno_n) != 0) { Vrat 0 }
    Lokalni k = Volej NaCislo(r->name)
    Pokud (k == 1 || k == 2) { Vrat k }
    Vrat 0
}
Metoda RekIrOp(op) {
    Pokud (op == 67) { Vrat 4 }
    Pokud (op == 44) { Vrat 5 }
    Pokud (op == 49) { Vrat 6 }
    Pokud (op == 58) { Vrat 18 }
    Pokud (op == 124) { Vrat 19 }
    Pokud (op == 83) { Vrat 20 }
    Vrat 0
}
// Vrati 1, kdyz telo metody nahradil cyklem
// Jen test (bez generovani): pouziva vkladani, aby metodu prevadenou na cyklus nevkladalo jako rekurzi
Metoda JeRekurenceNaCyklus(f : AST_Node) {
    Pokud (rek_vypnuto == 1 || inl_vypnuto == 1) { Vrat 0 }
    Pokud (Volej JePamatovana(f->name) == 1 || Volej MetodaMaAsm(f->name) == 1) { Vrat 0 }
    rek_jen_test = 1
    Lokalni r = Volej RekurenceNaCyklus(f)
    rek_jen_test = 0
    Vrat r
}
Globalni rek_jen_test = 0
Metoda RekurenceNaCyklus(uzel : AST_Node) {
    Pokud (rek_vypnuto == 1 || inl_vypnuto == 1) { Vrat 0 }
    Pokud (rek_jen_test == 0 && (pam_aktivni == 1 || ir_metoda_ma_asm == 1)) { Vrat 0 }
    Pokud (uzel->arg_count != 1 || Volej strcmp(uzel->type_name, "Float") == 0) { Vrat 0 }
    Lokalni ps : Symbol = pamet_symbolu + (uzel->sym_start * Velikost(Symbol))
    Pokud (Volej strcmp(ps->type_name, "Float") == 0) { Vrat 0 }
    Pokud (rek_jen_test == 0 && ps->vreg <= 0) { Vrat 0 }
    Lokalni telo : AST_Node = uzel->right
    Pokud (telo == 0) { Vrat 0 }
    Pokud (telo->type != AST_BLOCK || telo->stmt_count != 2) { Vrat 0 }
    Lokalni prvni : AST_Node = Volej CtiUkazatel(telo->stmts)
    Lokalni druhy : AST_Node = Volej CtiUkazatel(telo->stmts + 8)
    Pokud (prvni->type != AST_IF || prvni->alt != 0 || druhy->type != AST_RETURN) { Vrat 0 }
    // straz "n < K" nebo "n <= K"
    Lokalni pod : AST_Node = prvni->left
    Pokud (pod == 0) { Vrat 0 }
    Pokud (pod->type != AST_EXPR || (pod->op != 45 && pod->op != 61)) { Vrat 0 }
    Lokalni pl : AST_Node = pod->left
    Lokalni pr : AST_Node = pod->right
    Pokud (pl == 0 || pr == 0) { Vrat 0 }
    Pokud (pl->type != AST_EXPR || pl->op != 35 || pr->type != AST_EXPR || pr->op != 34) { Vrat 0 }
    Pokud (Volej strcmp(pl->name, ps->name) != 0) { Vrat 0 }
    Lokalni kk = Volej NaCislo(pr->name)
    Pokud (kk > 1000000 || kk < 0 - 1000000) { Vrat 0 }
    Pokud (pod->op == 61) { kk = kk + 1 }
    // zakladni pripad: cisty vyraz jen z n
    Lokalni navrat : AST_Node = prvni->right
    Pokud (navrat == 0) { Vrat 0 }
    Pokud (navrat->type == AST_BLOCK) {
        Pokud (navrat->stmt_count != 1) { Vrat 0 }
        navrat = Volej CtiUkazatel(navrat->stmts)
    }
    Pokud (navrat->type != AST_RETURN || navrat->left == 0) { Vrat 0 }
    Pokud (Volej JenParametry(navrat->left, uzel) == 0) { Vrat 0 }
    // krok: F(n - 1) OP F(n - 2) (v libovolnem poradi)
    Lokalni ex : AST_Node = druhy->left
    Pokud (ex == 0) { Vrat 0 }
    Pokud (ex->type != AST_EXPR) { Vrat 0 }
    Lokalni irop = Volej RekIrOp(ex->op)
    Pokud (irop == 0) { Vrat 0 }
    Lokalni kl = Volej RekVolani(ex->left, uzel, ps->name)
    Lokalni kr = Volej RekVolani(ex->right, uzel, ps->name)
    Pokud (kl == 0 || kr == 0 || kl == kr) { Vrat 0 }
    Pokud (rek_jen_test == 1) { Vrat 1 }

    Lokalni n = ps->vreg
    Lokalni l_rek = Volej NoveNavesti()
    Volej GenerujSkok(prvni->left, l_rek, 0)
    Lokalni v0 = Volej OperandNeboKonst(navrat->left)
    Volej Ir(25, 0, v0, ir_op_typ, 0, 1)
    Volej Ir(10, navesti_navratu, 0, 1, 0, 1)
    Volej Ir(11, l_rek, 0, 1, 0, 1)
    // a = F(K-2), b = F(K-1): zakladni vyraz pro konstanty
    Lokalni a = Volej NovyVreg()
    Lokalni b = Volej NovyVreg()
    ps->vreg = Volej Ir(26, Volej NovyVreg(), kk - 2, 1, 0, 1)
    Lokalni va = Volej OperandNeboKonst(navrat->left)
    Volej Ir(26, a, va, ir_op_typ, 0, 1)
    ps->vreg = Volej Ir(26, Volej NovyVreg(), kk - 1, 1, 0, 1)
    Lokalni vb = Volej OperandNeboKonst(navrat->left)
    Volej Ir(26, b, vb, ir_op_typ, 0, 1)
    ps->vreg = n
    Lokalni i = Volej Ir(26, Volej NovyVreg(), kk, 1, 0, 1)
    Lokalni l_cyk = Volej NoveNavesti()
    Lokalni l_kon = Volej NoveNavesti()
    tce_hloubka = 1
    Volej Ir(11, l_cyk, 0, 1, 0, 1)
    Lokalni c = Volej NovyVreg()
    // b = F(i-1), a = F(i-2); F(i) = levy OP pravy
    Pokud (kl == 1) { Volej Ir(irop, c, b, 0, a, 0) } Jinak { Volej Ir(irop, c, a, 0, b, 0) }
    Volej Ir(26, a, b, 0, 0, 1)
    Volej Ir(26, b, c, 0, 0, 1)
    Volej Ir(31, l_kon, i, 0, n, 0)         // i == n -> hotovo (bez preteceni i pro n = max)
    Volej Ir(4, i, i, 0, 1, 1)
    Volej Ir(10, l_cyk, 0, 1, 0, 1)
    Volej Ir(11, l_kon, 0, 1, 0, 1)
    tce_hloubka = 0
    Volej Ir(25, 0, b, 0, 0, 1)
    Volej Ir(10, navesti_navratu, 0, 1, 0, 1)
    Pokud (podrobny_vypis == 1) { Volej printf(">> Rekurence: '%s' pocita cyklem (F(n) = F(n-%d) op F(n-%d))\n", uzel->name, kl, kr) }
    Vrat 1
}

Metoda PamatujZacatek(uzel : AST_Node) {
    pam_aktivni = 0
    Pokud (Volej JePamatovana(uzel->name) == 0) { Vrat 0 }
    Pokud (uzel->arg_count != 1 || ir_metoda_ma_asm == 1 || Volej strcmp(uzel->type_name, "Float") == 0 || Volej JeCistyStrom(uzel->right, uzel->name) == 0) {
        Volej printf("Chyba (radek %d): 'Pamatuj' jde jen u ciste metody s jednim celociselnym parametrem (bez globalnich promennych, pameti, vypisu a volani jinych metod).\n", uzel->line)
        Volej exit(1)
    }
    Lokalni ps : Symbol = pamet_symbolu + (uzel->sym_start * Velikost(Symbol))
    pam_n0 = Volej Ir(26, Volej NovyVreg(), ps->vreg, 0, 0, 1)
    pam_jmeno = uzel->name
    Lokalni n_pocitej = Volej NoveNavesti()
    Volej Ir(54, n_pocitej, pam_n0, 0, PAM_VELIKOST, 1)            // mimo tabulku (i zaporne) -> pocitat
    Lokalni aok = Volej Ir(44, Volej NovyVreg(), Volej TrvalyText1("pamok_%s", uzel->name), 3, 0, 1)
    Lokalni ok = Volej Ir(40, Volej NovyVreg(), aok, 0, pam_n0, 0)
    Volej Ir(31, n_pocitej, ok, 0, 0, 1)                            // jeste nespocitano
    Lokalni ah = Volej Ir(44, Volej NovyVreg(), Volej TrvalyText1("pam_%s", uzel->name), 3, 0, 1)
    Lokalni h = Volej Ir(40, Volej NovyVreg(), ah, 0, pam_n0, 0)
    Volej Ir(25, 0, h, 0, 0, 1)
    Volej Ir(10, navesti_navratu, 0, 1, 0, 1)
    Volej Ir(11, n_pocitej, 0, 1, 0, 1)
    pam_aktivni = 1
    Pokud (podrobny_vypis == 1) { Volej printf(">> Pamatuj: '%s' si pamatuje vysledky pro 0..%d\n", uzel->name, PAM_VELIKOST - 1) }
    Vrat 0
}

// Pri Vrat: ulozit vysledek do tabulky
Metoda PamatujVysledek(v, vt) {
    Pokud (pam_aktivni == 0) { Vrat 0 }
    Lokalni n_preskoc = Volej NoveNavesti()
    Volej Ir(54, n_preskoc, pam_n0, 0, PAM_VELIKOST, 1)
    Lokalni ah = Volej Ir(44, Volej NovyVreg(), Volej TrvalyText1("pam_%s", pam_jmeno), 3, 0, 1)
    Lokalni a1 = Volej Ir(47, Volej NovyVreg(), ah, 0, pam_n0, 0)
    Volej Ir(43, 0, a1, 0, v, vt)
    Lokalni aok = Volej Ir(44, Volej NovyVreg(), Volej TrvalyText1("pamok_%s", pam_jmeno), 3, 0, 1)
    Lokalni a2 = Volej Ir(47, Volej NovyVreg(), aok, 0, pam_n0, 0)
    Volej Ir(43, 0, a2, 0, 1, 1)
    Volej Ir(11, n_preskoc, 0, 1, 0, 1)
    Vrat 0
}

// ==========================================
// Zarovnani zasobniku jen tam, kde je potreba
//   Funkce C vyzaduji pri volani zasobnik zarovnany na 16 B. Metody Pramenu, ktere C nevolaji
//   (ani nic, co volaji), ho nepotrebuji -> u volani mezi nimi odpadne "sub rsp, 8 / add rsp, 8".
//   Pocita se jednou pro cely program (pevny bod pres graf volani).
// ==========================================
Globalni zar_pole = 0     // pro index symbolu: 1 = potrebuje zarovnani

Metoda PrimoVolaC(u : AST_Node) {
    Pokud (u == 0) { Vrat 0 }
    Lokalni t = u->type
    Pokud (t == 25 || t == 30 || t == 31 || t == 26 || t == 34) { Vrat 1 }   // Vypis Alokuj Uvolni Asm Odloz
    Pokud (t == AST_EXPR && (u->op == 95 || u->op == 96 || u->op == 97)) { Vrat 1 }   // texty
    Pokud (t == AST_CALL) {
        Pokud (Volej JeVestavena(u->name) == 0) {
            Lokalni fs : Symbol = Volej NajdiSymbol(u->name)
            Pokud (fs == 0) { Vrat 1 }
            Pokud (fs->is_function == 0) { Vrat 1 }   // volani pres promennou
            Pokud (Volej JeExterniJmeno(u->name) == 1) { Vrat 1 }
            Pokud (u->stmt_count > 4) { Vrat 1 }
        }
    }
    Pokud (Volej PrimoVolaC(u->left) == 1 || Volej PrimoVolaC(u->right) == 1 || Volej PrimoVolaC(u->alt) == 1) { Vrat 1 }
    Pokud (u->stmts != 0) {
        Lokalni i = 0
        Dokud (i < u->stmt_count) {
            Pokud (Volej PrimoVolaC(Volej CtiUkazatel(u->stmts + (i * 8))) == 1) { Vrat 1 }
            i = i + 1
        }
    }
    Vrat 0
}

Metoda VolaOznacenou(u : AST_Node) {
    Pokud (u == 0) { Vrat 0 }
    Pokud (u->type == AST_CALL) {
        Lokalni fs : Symbol = Volej NajdiSymbol(u->name)
        Pokud (fs != 0) {
            Pokud (fs->is_function == 1) {
                Lokalni ix = (fs - pamet_symbolu) / Velikost(Symbol)
                Pokud (CtiZAdresu(zar_pole + (ix * 8)) == 1) { Vrat 1 }
            }
        }
    }
    Pokud (Volej VolaOznacenou(u->left) == 1 || Volej VolaOznacenou(u->right) == 1 || Volej VolaOznacenou(u->alt) == 1) { Vrat 1 }
    Pokud (u->stmts != 0) {
        Lokalni i = 0
        Dokud (i < u->stmt_count) {
            Pokud (Volej VolaOznacenou(Volej CtiUkazatel(u->stmts + (i * 8))) == 1) { Vrat 1 }
            i = i + 1
        }
    }
    Vrat 0
}

Metoda PotrebujeZarovnani(jmeno) {
    Pokud (Volej JeJadro() == 1) { Vrat 1 }
    Lokalni sym : Symbol = Volej NajdiSymbol(jmeno)
    Pokud (sym == 0) { Vrat 1 }
    Pokud (sym->is_function == 0 || sym->func_node == 0) { Vrat 1 }
    Pokud (zar_pole == 0) {
        // jmena uvnitr tel hledame globalne (rozsah prave generovane metody vypneme)
        Lokalni s_scoped = codegen_scoped
        codegen_scoped = 0
        zar_pole = Volej calloc(pocet_symbolu + 1, 8)
        Lokalni k = 0
        Dokud (k < pocet_symbolu) {
            Lokalni sk : Symbol = pamet_symbolu + (k * Velikost(Symbol))
            Pokud (sk->is_function == 1 && sk->func_node != 0) {
                Lokalni fk : AST_Node = sk->func_node
                Pokud (Volej PrimoVolaC(fk->right) == 1) { Volej ZapisUkazatel(zar_pole + (k * 8), 1) }
            }
            k = k + 1
        }
        Lokalni zmena = 1
        Dokud (zmena == 1) {
            zmena = 0
            k = 0
            Dokud (k < pocet_symbolu) {
                Lokalni sk2 : Symbol = pamet_symbolu + (k * Velikost(Symbol))
                Pokud (sk2->is_function == 1 && sk2->func_node != 0 && CtiZAdresu(zar_pole + (k * 8)) == 0) {
                    Lokalni fk2 : AST_Node = sk2->func_node
                    Pokud (Volej VolaOznacenou(fk2->right) == 1) { Volej ZapisUkazatel(zar_pole + (k * 8), 1); zmena = 1 }
                }
                k = k + 1
            }
        }
        codegen_scoped = s_scoped
    }
    Lokalni ix = (sym - pamet_symbolu) / Velikost(Symbol)
    Vrat CtiZAdresu(zar_pole + (ix * 8))
}

// Obsahuje metoda Asm? (vysledek se pamatuje v symbolu)
Metoda MetodaMaAsm(jmeno) {
    Lokalni sym : Symbol = Volej NajdiSymbol(jmeno)
    Pokud (sym == 0) { Vrat 1 }
    Pokud (sym->is_function == 0) { Vrat 1 }
    Pokud ((sym->priznaky & 1) == 0) {
        Lokalni f : AST_Node = sym->func_node
        sym->priznaky = 1
        Pokud (Volej ObsahujeTyp(f->right, AST_ASM_NODE) == 1) { sym->priznaky = 3 }
        // Parametr, ktery nebude ve vregu (pole), se uklada do domovske oblasti
        Lokalni pa = 0
        Dokud (pa < f->arg_count) {
            Lokalni psa : Symbol = pamet_symbolu + ((f->sym_start + pa) * Velikost(Symbol))
            Pokud (psa->dim1 != 0) { sym->priznaky = 3 }
            pa = pa + 1
        }
    }
    Pokud ((sym->priznaky & 2) == 2) { Vrat 1 }
    Vrat 0
}

Metoda JeCalleeSaved(kod) {
    Pokud (kod >= 32) { Vrat 0 } // xmm: bereme je jako prepisovane volanim (nic se neuklada)
    Pokud (Volej JeARM() == 1) {
        Pokud (kod >= 19 && kod <= 28) { Vrat 1 }
        Vrat 0
    }
    Pokud (kod == 3 || kod == 5 || kod >= 12) { Vrat 1 }
    Pokud (cilova_platforma == 2 && (kod == 6 || kod == 7)) { Vrat 1 }
    Vrat 0
}

Metoda KodArgRegistru(i) {
    Pokud (cilova_platforma == 2) {
        Pokud (i == 0) { Vrat 1 }
        Pokud (i == 1) { Vrat 2 }
        Pokud (i == 2) { Vrat 8 }
        Vrat 9
    }
    Pokud (i == 0) { Vrat 7 }
    Pokud (i == 1) { Vrat 6 }
    Pokud (i == 2) { Vrat 2 }
    Vrat 1
}

Metoda JmenoRegistru(kod) {
    Pokud (kod >= 32) { Vrat Volej JmenoXmm(kod - 32) }
    Pokud (kod == 1) { Vrat "rcx" }
    Pokud (kod == 2) { Vrat "rdx" }
    Pokud (kod == 3) { Vrat "rbx" }
    Pokud (kod == 5) { Vrat "rbp" }
    Pokud (kod == 6) { Vrat "rsi" }
    Pokud (kod == 7) { Vrat "rdi" }
    Pokud (kod == 8) { Vrat "r8" }
    Pokud (kod == 9) { Vrat "r9" }
    Pokud (kod == 12) { Vrat "r12" }
    Pokud (kod == 13) { Vrat "r13" }
    Pokud (kod == 14) { Vrat "r14" }
    Vrat "r15"
}

Metoda PripravPool() {
    ra_pool = Volej calloc(32, 8)
    Lokalni n = 0
    Pokud (Volej JeARM() == 1) {
        // ARM64: nejdriv registry, ktere volany nemusi zachovat (x9-x15), pak x19-x28
        Lokalni ka = 9
        Dokud (ka <= 15) { Volej ZapisUkazatel(ra_pool + (n * 8), ka); n = n + 1; ka = ka + 1 }
        ka = 19
        Dokud (ka <= 28) { Volej ZapisUkazatel(ra_pool + (n * 8), ka); n = n + 1; ka = ka + 1 }
        // d18-d31 pro desetinna cisla (kody 32-45; volani je prepisuje)
        ka = 0
        Dokud (ka < 14) { Volej ZapisUkazatel(ra_pool + (n * 8), 32 + ka); n = n + 1; ka = ka + 1 }
        ra_pocet = n
        Vrat 0
    }
    Pokud (cilova_platforma == 2) {
        Volej ZapisUkazatel(ra_pool + 0, 8); Volej ZapisUkazatel(ra_pool + 8, 9)
        Volej ZapisUkazatel(ra_pool + 16, 1); Volej ZapisUkazatel(ra_pool + 24, 2)
        Volej ZapisUkazatel(ra_pool + 32, 3); Volej ZapisUkazatel(ra_pool + 40, 6); Volej ZapisUkazatel(ra_pool + 48, 7)
        n = 7
    } Jinak {
        Volej ZapisUkazatel(ra_pool + 0, 8); Volej ZapisUkazatel(ra_pool + 8, 9)
        Volej ZapisUkazatel(ra_pool + 16, 6); Volej ZapisUkazatel(ra_pool + 24, 7)
        Volej ZapisUkazatel(ra_pool + 32, 1); Volej ZapisUkazatel(ra_pool + 40, 2)
        Volej ZapisUkazatel(ra_pool + 48, 3)
        n = 7
    }
    Volej ZapisUkazatel(ra_pool + (n * 8), 12); Volej ZapisUkazatel(ra_pool + ((n + 1) * 8), 13)
    Volej ZapisUkazatel(ra_pool + ((n + 2) * 8), 14); Volej ZapisUkazatel(ra_pool + ((n + 3) * 8), 15)
    ra_pocet = n + 4
    // Registry xmm pro desetinna cisla (Windows: jen xmm0-xmm5, ostatni musi volany zachovat)
    Lokalni nx = 14
    Pokud (cilova_platforma == 2) { nx = 6 }
    Lokalni kx = 0
    Dokud (kx < nx) { Volej ZapisUkazatel(ra_pool + (ra_pocet * 8), 32 + kx); ra_pocet = ra_pocet + 1; kx = kx + 1 }
    // Metoda bez ramce muze rbp pouzit jako dalsi registr
    Pokud (ra_s_rbp == 1) { Volej ZapisUkazatel(ra_pool + (ra_pocet * 8), 5); ra_pocet = ra_pocet + 1 }
    Vrat 0
}

// Potrebuje metoda ramec (rbp) i bez odkladani do pameti?
Globalni ra_s_rbp = 0
Metoda PotrebujeRamec() {
    Pokud (ir_metoda_ma_asm == 1) { Vrat 1 }
    Lokalni m : AST_Node = ir_metoda
    Lokalni si = m->sym_start
    Dokud (si < m->sym_end) {
        Lokalni sym : Symbol = pamet_symbolu + (si * Velikost(Symbol))
        Pokud (sym->is_global == 0 && sym->is_const == 0 && sym->is_function == 0 && sym->vreg == 0) { Vrat 1 }
        si = si + 1
    }
    Lokalni k = 0
    Dokud (k < pocet_ir) {
        Lokalni ik : IR_Instrukce = pamet_ir + (k * 48)
        Pokud (ik->opcode == 2 || ik->opcode == 3 || ik->opcode == 41 || ik->opcode == 55) { Vrat 1 }
        // surovy text, ktery adresuje pres rbp
        Pokud (ik->opcode == 99) { Pokud (Volej strstr(ik->src1, "rbp") != 0) { Vrat 1 } }
        k = k + 1
    }
    Vrat 0
}

// Alokace: metoda bez ramce zkusi i rbp; kdyby pak cokoli odkladala do pameti, alokuje znovu s ramcem
// Ktere vregy smi do xmm: vsechny definice i pouziti jsou desetinne operace, kopie,
// argumenty nebo navrat (kopie mezi tridami resi movq). Musi mit aspon jednu opravdovou
// desetinnou operaci, aby se do xmm nedostala obycejna cisla.
Globalni ir_float_trida = 0
Metoda SpocitejFloatTridu() {
    Pokud (ir_float_trida != 0) { Volej free(ir_float_trida) }
    ir_float_trida = 0
    ir_float_trida = Volej calloc(citac_temp_reg + 1, 8)
    Lokalni zakaz = Volej calloc(citac_temp_reg + 1, 8)
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op = inst->opcode
        Pokud (op != 0 && op < 97) {
            Lokalni fl_op = 0
            Pokud ((op >= 60 && op <= 63) || (op >= 66 && op <= 71) || op == 74) { fl_op = 1 }
            Pokud (op >= 80 && op <= 86 && op != 81) { fl_op = 1 }
            Lokalni d = inst->dest
            Pokud (Volej DefinujeDest(op) == 1 && d > 0 && d < citac_temp_reg) {
                Pokud ((op >= 60 && op <= 64) || op == 72 || (op >= 80 && op <= 86)) { Volej ZapisUkazatel(ir_float_trida + (d * 8), 1) }
                Jinak Pokud (op != 26) { Volej ZapisUkazatel(zakaz + (d * 8), 1) }
            }
            Pokud (inst->src1_typ == 0 && inst->src1 > 0 && inst->src1 < citac_temp_reg) {
                Pokud (fl_op == 1) { Volej ZapisUkazatel(ir_float_trida + (inst->src1 * 8), 1) }
                Jinak Pokud (op != 26 && op != 23 && op != 25) { Volej ZapisUkazatel(zakaz + (inst->src1 * 8), 1) }
            }
            Pokud (inst->src2_typ == 0 && inst->src2 > 0 && inst->src2 < citac_temp_reg) {
                Pokud (fl_op == 1) { Volej ZapisUkazatel(ir_float_trida + (inst->src2 * 8), 1) }
                Jinak { Volej ZapisUkazatel(zakaz + (inst->src2 * 8), 1) }
            }
        }
        i = i + 1
    }
    Lokalni v = 0
    Dokud (v < citac_temp_reg) {
        Pokud (CtiZAdresu(zakaz + (v * 8)) == 1) { Volej ZapisUkazatel(ir_float_trida + (v * 8), 0) }
        v = v + 1
    }
    Volej free(zakaz)
    Vrat 0
}

Metoda ProvedLinearScan() {
    Volej SpocitejFloatTridu()
    Volej SpocitejUseky()
    Lokalni potreba = Volej PotrebujeRamec()
    Lokalni puvodni = Volej calloc(pocet_intervalu + 1, 8)
    Lokalni k = 0
    Dokud (k < pocet_intervalu) {
        Lokalni iv : LiveInterval = pamet_intervalu + (k * 32)
        Volej ZapisUkazatel(puvodni + (k * 8), iv->fyzicky_reg)
        k = k + 1
    }
    ra_s_rbp = 0
    Pokud (potreba == 0 && Volej JeARM() == 0) { ra_s_rbp = 1 }
    Volej AlokujRegistry(potreba)
    Pokud (ra_s_rbp == 1 && ir_ma_ramec == 1) {
        k = 0
        Dokud (k < pocet_intervalu) {
            Lokalni iv2 : LiveInterval = pamet_intervalu + (k * 32)
            iv2->fyzicky_reg = CtiZAdresu(puvodni + (k * 8))
            k = k + 1
        }
        ra_s_rbp = 0
        Volej AlokujRegistry(1)
    }
    ra_s_rbp = 0
    Volej free(puvodni)
    Volej UvolniUseky()
    Vrat 0
}

// Ktere scratch registry instrukce prepisuje (bitova maska podle kodu registru)
Metoda MaskaPrepisu(inst : IR_Instrukce) {
    Lokalni op = inst->opcode
    Pokud (Volej JeARM() == 1) {
        // ARM64: volani prepisuje x0-x17; z registru v poolu jsou to x9-x15
        Pokud (op == 24 || op == 97 || op == 98) { Vrat (127 << 9) | (16383 << 32) } // + d18-d31
        Vrat 0
    }
    Lokalni vse = (1 << 1) | (1 << 2) | (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9)
    vse = vse | (16383 << 32) // xmm0-xmm13: volani i surovy kod je smi prepsat
    Pokud (op == 24 || op == 99 || op == 97 || op == 98) { Vrat vse }
    Pokud (op == 7 || op == 27) { Vrat (1 << 2) }
    Pokud ((op == 21 || op == 22) && inst->src2_typ != 1) { Vrat (1 << 1) }
    Pokud (op == 23) { Vrat (1 << Volej KodArgRegistru(inst->dest)) }
    Pokud (op == 74 && cilova_platforma == 2) { Vrat (1 << Volej KodArgRegistru(inst->dest)) | (1 << (32 + inst->dest)) } // Windows: i do celociselneho registru
    Pokud (op == 74) { Vrat (1 << (32 + inst->dest)) }
    Pokud (op == 39) {
        Vrat (1 << Volej KodArgRegistru(0)) | (1 << Volej KodArgRegistru(1)) | (1 << Volej KodArgRegistru(2)) | (1 << Volej KodArgRegistru(3))
    }
    Vrat 0
}

Metoda PripravPrepisy() {
    ra_seznamy = Volej calloc(48, 8)
    ra_delky = Volej calloc(48, 8)
    Lokalni k = 1
    Dokud (k < 48) { Volej ZapisUkazatel(ra_seznamy + (k * 8), Volej calloc(pocet_ir + 1, 8)); k = k + 1 }
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Pokud (inst->opcode != 0) {
            Lokalni m = Volej MaskaPrepisu(inst)
            Pokud (m != 0) {
                k = 1
                Dokud (k < 48) {
                    Pokud (((m >> k) & 1) == 1) {
                        Lokalni n = CtiZAdresu(ra_delky + (k * 8))
                        Volej ZapisUkazatel(CtiZAdresu(ra_seznamy + (k * 8)) + (n * 8), i)
                        Volej ZapisUkazatel(ra_delky + (k * 8), n + 1)
                    }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    Vrat 0
}

// Prepisuje nejaka instrukce v useku [od, do] dany scratch registr? (binarni hledani)
Metoda RegistrKoliduje(kod, od, do_) {
    Pokud (Volej JeCalleeSaved(kod) == 1) { Vrat 0 }
    Lokalni pole = CtiZAdresu(ra_seznamy + (kod * 8))
    Lokalni n = CtiZAdresu(ra_delky + (kod * 8))
    Lokalni lo = 0
    Lokalni hi = n
    Dokud (lo < hi) {
        Lokalni mid = (lo + hi) / 2
        Pokud (CtiZAdresu(pole + (mid * 8)) < od) { lo = mid + 1 } Jinak { hi = mid }
    }
    Pokud (lo < n) { Pokud (CtiZAdresu(pole + (lo * 8)) <= do_) { Vrat 1 } }
    Vrat 0
}

Metoda SpocitejVahy() {
    ra_vahy = Volej calloc(citac_temp_reg + 1, 8)
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op = inst->opcode
        Pokud (op != 0 && op < 97) {
            Lokalni h = CtiZAdresu(ir_hloubka_cyklu + (i * 8))
            Pokud (h > 6) { h = 6 }
            Lokalni w = 1 << (h * 3)
            Pokud (inst->src1_typ == 0 && inst->src1 > 0) { Volej ZapisUkazatel(ra_vahy + (inst->src1 * 8), CtiZAdresu(ra_vahy + (inst->src1 * 8)) + w) }
            Pokud (inst->src2_typ == 0 && inst->src2 > 0) { Volej ZapisUkazatel(ra_vahy + (inst->src2 * 8), CtiZAdresu(ra_vahy + (inst->src2 * 8)) + w) }
            Pokud (Volej DefinujeDest(op) == 1 && inst->dest > 0) { Volej ZapisUkazatel(ra_vahy + (inst->dest * 8), CtiZAdresu(ra_vahy + (inst->dest * 8)) + w) }
        }
        i = i + 1
    }
    Vrat 0
}

// --- Useky obsazene v kazdem registru (serazene; v jednom registru se nikdy neprekryvaji) ---
Globalni rr_od = 0        // pro index v poolu: pole zacatku
Globalni rr_do = 0        // pole koncu
Globalni rr_vl = 0        // pole vlastniku (index intervalu)
Globalni rr_n = 0
Globalni rr_kap = 0
Globalni ra_cur_od = 0    // useky prave alokovaneho intervalu
Globalni ra_cur_do = 0
Globalni ra_cur_n = 0
Globalni ra_cur_kap = 0
Globalni ra_od_kol = 0    // od ktere instrukce kontrolovat prepisy scratch registru
Globalni ra_cur_vreg = 0  // vreg prave prirazovaneho intervalu
Globalni ra_obeti = 0     // intervaly, ktere by se pro uvolneni registru musely odlozit
Globalni ra_obeti_n = 0

Metoda PripravRegistroveUseky() {
    rr_od = Volej calloc(32, 8)
    rr_do = Volej calloc(32, 8)
    rr_vl = Volej calloc(32, 8)
    rr_n = Volej calloc(32, 8)
    rr_kap = Volej calloc(32, 8)
    Lokalni r = 0
    Dokud (r < 32) {
        Volej ZapisUkazatel(rr_od + (r * 8), Volej malloc(64 * 8))
        Volej ZapisUkazatel(rr_do + (r * 8), Volej malloc(64 * 8))
        Volej ZapisUkazatel(rr_vl + (r * 8), Volej malloc(64 * 8))
        Volej ZapisUkazatel(rr_kap + (r * 8), 64)
        r = r + 1
    }
    ra_cur_kap = 64
    ra_cur_od = Volej malloc(64 * 8)
    ra_cur_do = Volej malloc(64 * 8)
    ra_obeti = Volej malloc((pocet_intervalu + 1) * 8)
    Vrat 0
}

Metoda UvolniRegistroveUseky() {
    Lokalni r = 0
    Dokud (r < 32) {
        Volej free(CtiZAdresu(rr_od + (r * 8)))
        Volej free(CtiZAdresu(rr_do + (r * 8)))
        Volej free(CtiZAdresu(rr_vl + (r * 8)))
        r = r + 1
    }
    Volej free(rr_od)
    Volej free(rr_do)
    Volej free(rr_vl)
    Volej free(rr_n)
    Volej free(rr_kap)
    Volej free(ra_cur_od)
    Volej free(ra_cur_do)
    Volej free(ra_obeti)
    Vrat 0
}

// Useky intervalu idx do ra_cur_* (bez spocitanych useku = cely obal)
Metoda NactiUsekyIntervalu(idx) {
    Lokalni iv : LiveInterval = pamet_intervalu + (idx * 32)
    Lokalni v = idx + 1
    Lokalni n = CtiZAdresu(us_poc + (v * 8))
    Pokud (n == 0) {
        Volej ZapisUkazatel(ra_cur_od, iv->start_instr)
        Volej ZapisUkazatel(ra_cur_do, iv->end_instr)
        ra_cur_n = 1
        Vrat 0
    }
    Pokud (n > ra_cur_kap) {
        ra_cur_kap = n * 2
        ra_cur_od = Volej realloc(ra_cur_od, ra_cur_kap * 8)
        ra_cur_do = Volej realloc(ra_cur_do, ra_cur_kap * 8)
    }
    Lokalni z = CtiZAdresu(us_zac + (v * 8))
    Lokalni k = 0
    Dokud (k < n) {
        Volej ZapisUkazatel(ra_cur_od + (k * 8), CtiZAdresu(us_od + ((z + k) * 8)))
        Volej ZapisUkazatel(ra_cur_do + (k * 8), CtiZAdresu(us_do + ((z + k) * 8)))
        k = k + 1
    }
    ra_cur_n = n
    Vrat 0
}

// Prvni usek registru r, ktery konci v a nebo pozdeji (binarni hledani)
Metoda PrvniUsekOd(r, a) {
    Lokalni pole = CtiZAdresu(rr_do + (r * 8))
    Lokalni lo = 0
    Lokalni hi = CtiZAdresu(rr_n + (r * 8))
    Dokud (lo < hi) {
        Lokalni mid = (lo + hi) / 2
        Pokud (CtiZAdresu(pole + (mid * 8)) < a) { lo = mid + 1 } Jinak { hi = mid }
    }
    Vrat lo
}

// Neprepisuje scratch registr nic v usecich aktualniho intervalu?
Metoda ScratchVolnyProUseky(kod) {
    Lokalni k = 0
    Dokud (k < ra_cur_n) {
        Lokalni a = CtiZAdresu(ra_cur_od + (k * 8))
        // Usek zacina vysledkem volani/deleni (i za dirou v zivotnosti): ten se zapise az po prepsani
        Lokalni ia : IR_Instrukce = pamet_ir + (a * 48)
        Pokud (ia->dest == ra_cur_vreg && (ia->opcode == 24 || ia->opcode == 7 || ia->opcode == 27)) { a = a + 1 }
        Pokud (a < ra_od_kol) { a = ra_od_kol }
        Lokalni b = CtiZAdresu(ra_cur_do + (k * 8))
        Pokud (a <= b) { Pokud (Volej RegistrKoliduje(kod, a, b) == 1) { Vrat 0 } }
        k = k + 1
    }
    Vrat 1
}

Metoda RegistrVolnyProUseky(r) {
    Pokud (Volej ScratchVolnyProUseky(CtiZAdresu(ra_pool + (r * 8))) == 0) { Vrat 0 }
    Lokalni n = CtiZAdresu(rr_n + (r * 8))
    Lokalni od_pole = CtiZAdresu(rr_od + (r * 8))
    Lokalni k = 0
    Dokud (k < ra_cur_n) {
        Lokalni p = Volej PrvniUsekOd(r, CtiZAdresu(ra_cur_od + (k * 8)))
        Pokud (p < n) { Pokud (CtiZAdresu(od_pole + (p * 8)) <= CtiZAdresu(ra_cur_do + (k * 8))) { Vrat 0 } }
        k = k + 1
    }
    Vrat 1
}

// Soucet vah intervalu, ktere v registru r prekazeji (ulozi je do ra_obeti);
// -1, kdyz je mezi nimi aspon jeden tezsi nez novy interval
Metoda VahaKonfliktu(r, vaha_cur) {
    ra_obeti_n = 0
    Lokalni soucet = 0
    Lokalni n = CtiZAdresu(rr_n + (r * 8))
    Lokalni od_pole = CtiZAdresu(rr_od + (r * 8))
    Lokalni vl_pole = CtiZAdresu(rr_vl + (r * 8))
    Lokalni k = 0
    Dokud (k < ra_cur_n) {
        Lokalni b = CtiZAdresu(ra_cur_do + (k * 8))
        Lokalni p = Volej PrvniUsekOd(r, CtiZAdresu(ra_cur_od + (k * 8)))
        Dokud (p < n && CtiZAdresu(od_pole + (p * 8)) <= b) {
            Lokalni o = CtiZAdresu(vl_pole + (p * 8))
            Lokalni zname = 0
            Lokalni x = 0
            Dokud (x < ra_obeti_n) {
                Pokud (CtiZAdresu(ra_obeti + (x * 8)) == o) { zname = 1 }
                x = x + 1
            }
            Pokud (zname == 0) {
                Lokalni w = CtiZAdresu(ra_vahy + ((o + 1) * 8))
                Pokud (w >= vaha_cur) { Vrat 0 - 1 }
                Volej ZapisUkazatel(ra_obeti + (ra_obeti_n * 8), o)
                ra_obeti_n = ra_obeti_n + 1
                soucet = soucet + w
            }
            p = p + 1
        }
        k = k + 1
    }
    Vrat soucet
}

Metoda OdeberVlastnika(r, vlastnik) {
    Lokalni n = CtiZAdresu(rr_n + (r * 8))
    Lokalni od_pole = CtiZAdresu(rr_od + (r * 8))
    Lokalni do_pole = CtiZAdresu(rr_do + (r * 8))
    Lokalni vl_pole = CtiZAdresu(rr_vl + (r * 8))
    Lokalni m = 0
    Lokalni k = 0
    Dokud (k < n) {
        Pokud (CtiZAdresu(vl_pole + (k * 8)) != vlastnik) {
            Volej ZapisUkazatel(od_pole + (m * 8), CtiZAdresu(od_pole + (k * 8)))
            Volej ZapisUkazatel(do_pole + (m * 8), CtiZAdresu(do_pole + (k * 8)))
            Volej ZapisUkazatel(vl_pole + (m * 8), CtiZAdresu(vl_pole + (k * 8)))
            m = m + 1
        }
        k = k + 1
    }
    Volej ZapisUkazatel(rr_n + (r * 8), m)
    Vrat 0
}

Metoda VlozUseky(r, vlastnik) {
    Lokalni k = 0
    Dokud (k < ra_cur_n) {
        Lokalni n = CtiZAdresu(rr_n + (r * 8))
        Pokud (n >= CtiZAdresu(rr_kap + (r * 8))) {
            Lokalni kap = n * 2
            Volej ZapisUkazatel(rr_kap + (r * 8), kap)
            Volej ZapisUkazatel(rr_od + (r * 8), Volej realloc(CtiZAdresu(rr_od + (r * 8)), kap * 8))
            Volej ZapisUkazatel(rr_do + (r * 8), Volej realloc(CtiZAdresu(rr_do + (r * 8)), kap * 8))
            Volej ZapisUkazatel(rr_vl + (r * 8), Volej realloc(CtiZAdresu(rr_vl + (r * 8)), kap * 8))
        }
        Lokalni a = CtiZAdresu(ra_cur_od + (k * 8))
        Lokalni p = Volej PrvniUsekOd(r, a)
        Lokalni od_pole = CtiZAdresu(rr_od + (r * 8))
        Lokalni do_pole = CtiZAdresu(rr_do + (r * 8))
        Lokalni vl_pole = CtiZAdresu(rr_vl + (r * 8))
        Pokud (p < n) {
            Volej memmove(od_pole + ((p + 1) * 8), od_pole + (p * 8), (n - p) * 8)
            Volej memmove(do_pole + ((p + 1) * 8), do_pole + (p * 8), (n - p) * 8)
            Volej memmove(vl_pole + ((p + 1) * 8), vl_pole + (p * 8), (n - p) * 8)
        }
        Volej ZapisUkazatel(od_pole + (p * 8), a)
        Volej ZapisUkazatel(do_pole + (p * 8), CtiZAdresu(ra_cur_do + (k * 8)))
        Volej ZapisUkazatel(vl_pole + (p * 8), vlastnik)
        Volej ZapisUkazatel(rr_n + (r * 8), n + 1)
        k = k + 1
    }
    Vrat 0
}

Metoda AlokujRegistry(potreba_ramce) {
    Volej PripravPool()
    Volej PripravPrepisy()
    Volej SpocitejVahy()
    Pokud (ir_vektor != 0) {
        Lokalni vv = 1
        Dokud (vv < citac_temp_reg) {
            Pokud (CtiZAdresu(ir_vektor + (vv * 8)) == 1) { Volej ZapisUkazatel(ra_vahy + (vv * 8), 1 << 50) }
            vv = vv + 1
        }
    }
    Volej PripravRegistroveUseky()
    Lokalni r = 0
    ir_pouzite_reg = 0
    Lokalni spill_offset = ramec_lokalnich + 8
    Pokud (potreba_ramce == 0) { spill_offset = 8 } // vsechny promenne jsou v registrech

    // Razeni intervalu podle zacatku (counting sort)
    Lokalni pocty = Volej calloc(pocet_ir + 2, 8)
    Lokalni k = 0
    Dokud (k < pocet_intervalu) {
        Lokalni iv : LiveInterval = pamet_intervalu + (k * 32)
        Pokud (iv->fyzicky_reg == 1) {
            Volej ZapisUkazatel(pocty + ((iv->start_instr + 1) * 8), CtiZAdresu(pocty + ((iv->start_instr + 1) * 8)) + 1)
        }
        k = k + 1
    }
    k = 1
    Dokud (k <= pocet_ir + 1) {
        Volej ZapisUkazatel(pocty + (k * 8), CtiZAdresu(pocty + (k * 8)) + CtiZAdresu(pocty + ((k - 1) * 8)))
        k = k + 1
    }
    Lokalni poradi = Volej calloc(pocet_intervalu + 1, 8)
    Lokalni pocet_razenych = 0
    k = 0
    Dokud (k < pocet_intervalu) {
        Lokalni iv2 : LiveInterval = pamet_intervalu + (k * 32)
        Pokud (iv2->fyzicky_reg == 1) {
            Lokalni pozice = CtiZAdresu(pocty + (iv2->start_instr * 8))
            Volej ZapisUkazatel(pocty + (iv2->start_instr * 8), pozice + 1)
            Volej ZapisUkazatel(poradi + (pozice * 8), k)
            pocet_razenych = pocet_razenych + 1
        }
        k = k + 1
    }

    Lokalni q = 0
    Dokud (q < pocet_razenych) {
        Lokalni idx = CtiZAdresu(poradi + (q * 8))
        Lokalni cur : LiveInterval = pamet_intervalu + (idx * 32)
        Lokalni vaha_cur = CtiZAdresu(ra_vahy + ((idx + 1) * 8))
        Volej NactiUsekyIntervalu(idx)
        // Vysledek volani/deleni se zapisuje az PO prepsani scratch registru -> ta instrukce nevadi
        ra_od_kol = cur->start_instr
        ra_cur_vreg = idx + 1
        Lokalni i_start : IR_Instrukce = pamet_ir + (cur->start_instr * 48)
        Pokud (i_start->dest == idx + 1 && (i_start->opcode == 24 || i_start->opcode == 7 || i_start->opcode == 27)) { ra_od_kol = cur->start_instr + 1 }
        // 1) volny registr: zadny jeho usek se neprekryva a nic ho v nasich usecich neprepisuje
        Lokalni vybrany = 0 - 1
        // Desetinne hodnoty nejdriv do xmm, pak do obycejnych registru; ostatni nikdy do xmm
        Lokalni je_fl = 0
        Pokud (ir_float_trida != 0) { je_fl = CtiZAdresu(ir_float_trida + ((idx + 1) * 8)) }
        // Dvojice desetinnych cisel (vektorizace) smi jen do xmm
        Lokalni je_vek = 0
        Pokud (ir_vektor != 0) { je_vek = CtiZAdresu(ir_vektor + ((idx + 1) * 8)) }
        Pokud (je_vek == 1) { je_fl = 1 }
        r = 0
        Dokud (r < ra_pocet && vybrany < 0 && je_fl == 1) {
            Pokud (CtiZAdresu(ra_pool + (r * 8)) >= 32) { Pokud (Volej RegistrVolnyProUseky(r) == 1) { vybrany = r } }
            r = r + 1
        }
        r = 0
        Dokud (r < ra_pocet && vybrany < 0 && je_vek == 0) {
            Pokud (CtiZAdresu(ra_pool + (r * 8)) < 32) { Pokud (Volej RegistrVolnyProUseky(r) == 1) { vybrany = r } }
            r = r + 1
        }
        Pokud (vybrany < 0) {
            // 2) vezmeme registr, jehoz prekazejici intervaly maji dohromady mensi vahu nez novy
            Lokalni nej = 0 - 1
            Lokalni nej_vaha = 0
            r = 0
            Dokud (r < ra_pocet) {
                Lokalni kod_r = CtiZAdresu(ra_pool + (r * 8))
                Lokalni smi = 0
                Pokud (je_vek == 1) { Pokud (kod_r >= 32) { smi = 1 } } Jinak { Pokud (je_fl == 1 || kod_r < 32) { smi = 1 } }
                Pokud (smi == 1 && Volej ScratchVolnyProUseky(kod_r) == 1) {
                    Lokalni w = Volej VahaKonfliktu(r, vaha_cur)
                    Pokud (w >= 0 && (nej < 0 || w < nej_vaha)) { nej = r; nej_vaha = w }
                }
                r = r + 1
            }
            Pokud (nej >= 0 && nej_vaha < vaha_cur) {
                // obeti (ulozene ve VahaKonfliktu) jdou do pameti
                Volej VahaKonfliktu(nej, vaha_cur)
                Lokalni oi = 0
                Dokud (oi < ra_obeti_n) {
                    Lokalni ob_idx = CtiZAdresu(ra_obeti + (oi * 8))
                    Lokalni obet : LiveInterval = pamet_intervalu + (ob_idx * 32)
                    obet->fyzicky_reg = 0 - spill_offset
                    spill_offset = spill_offset + 8
                    Volej OdeberVlastnika(nej, ob_idx)
                    oi = oi + 1
                }
                vybrany = nej
            }
        }
        Pokud (vybrany >= 0) {
            cur->fyzicky_reg = CtiZAdresu(ra_pool + (vybrany * 8))
            Volej VlozUseky(vybrany, idx)
        } Jinak Pokud (je_vek == 1) {
            Volej printf("Vnitrni chyba prekladace: dvojice desetinnych cisel nedostala registr xmm (prelozte s --bez-vektorizace)\n")
            Volej exit(1)
        } Jinak {
            cur->fyzicky_reg = 0 - spill_offset
            spill_offset = spill_offset + 8
        }
        q = q + 1
    }
    Volej UvolniRegistroveUseky()
    // Ktere callee-saved registry musi prolog ulozit
    k = 0
    Dokud (k < pocet_intervalu) {
        Lokalni iv3 : LiveInterval = pamet_intervalu + (k * 32)
        Pokud (iv3->fyzicky_reg > 1) {
            Pokud (Volej JeCalleeSaved(iv3->fyzicky_reg) == 1) { ir_pouzite_reg = ir_pouzite_reg | (1 << iv3->fyzicky_reg) }
        }
        k = k + 1
    }
    // Metoda s Asm: ulozime vsechny (Asm je muze menit)
    Pokud (ir_metoda_ma_asm == 1) {
        r = 0
        Dokud (r < ra_pocet) {
            Lokalni kod_a = CtiZAdresu(ra_pool + (r * 8))
            Pokud (Volej JeCalleeSaved(kod_a) == 1) { ir_pouzite_reg = ir_pouzite_reg | (1 << kod_a) }
            r = r + 1
        }
    }
    ir_pocet_push = 0
    r = 0
    Dokud (r < 32) {
        Pokud (((ir_pouzite_reg >> r) & 1) == 1) { ir_pocet_push = ir_pocet_push + 1 }
        r = r + 1
    }
    ramec_celkem = spill_offset - 8
    ramec_celkem = ((ramec_celkem + 15) / 16) * 16
    // Potrebuje metoda rbp? (promenne nebo odlozene hodnoty v pameti, parametry na zasobniku, Asm)
    ir_ma_ramec = potreba_ramce
    Pokud (ramec_celkem > 0) { ir_ma_ramec = 1 }
    Volej free(pocty)
    Volej free(poradi)
    r = 1
    Dokud (r < 48) { Volej free(CtiZAdresu(ra_seznamy + (r * 8))); r = r + 1 }
    Volej free(ra_seznamy)
    Volej free(ra_delky)
    Volej free(ra_vahy)
    Volej free(ra_pool)
    Vrat 0
}

// ==========================================
// Preklad IR -> assembler x86-64
// ==========================================
Globalni ir_out = 0
// Napoveda: hodnota, kterou hned cte jen ARG / navrat, se spocita rovnou do ciloveho registru
Globalni ir_napoveda_v = 0 - 1
Globalni ir_napoveda_reg = 0
Globalni ir_napoveda_do = 0 - 1     // index instrukce, po jejimz prekladu napoveda konci
Globalni ir_pocty_definic = 0

Metoda SpocitejDefinice() {
    Pokud (ir_pocty_definic != 0) { Volej free(ir_pocty_definic) }
    ir_pocty_definic = Volej calloc(citac_temp_reg + 1, 8)
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Pokud (inst->opcode != 0 && inst->dest > 0 && inst->dest < citac_temp_reg && Volej DefinujeDest(inst->opcode) == 1) {
            Volej ZapisUkazatel(ir_pocty_definic + (inst->dest * 8), CtiZAdresu(ir_pocty_definic + (inst->dest * 8)) + 1)
        }
        i = i + 1
    }
    Vrat 0
}

Metoda LzeNapovedet(op) {
    Pokud (op == 1 || op == 26 || op == 4 || op == 5 || op == 6 || op == 18 || op == 19 || op == 20) { Vrat 1 }
    Pokud (op == 28 || op == 36 || op == 40 || op == 44 || op == 49 || op == 24) { Vrat 1 }
    Vrat 0
}

// Najde napovedu pro instrukci i (nastavi ir_napoveda_*)
Metoda NajdiNapovedu(i) {
    Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
    Lokalni d = inst->dest
    Pokud (Volej LzeNapovedet(inst->opcode) == 0 || d <= 0 || d >= citac_temp_reg) { Vrat 0 }
    Pokud (CtiZAdresu(ir_pocty_pouziti + (d * 8)) != 1 || CtiZAdresu(ir_pocty_definic + (d * 8)) != 1) { Vrat 0 }
    Lokalni j = i + 1
    Lokalni pj : IR_Instrukce = 0
    Dokud (j < pocet_ir) {
        pj = pamet_ir + (j * 48)
        Pokud (pj->opcode != 0) { Ukonci }
        j = j + 1
    }
    Pokud (j >= pocet_ir) { Vrat 0 }
    Lokalni reg = "rax"
    Pokud (pj->opcode == 25 && pj->src1_typ == 0 && pj->src1 == d) {
        reg = "rax"     // navratova hodnota
    } Jinak Pokud (inst->opcode == 24 && (pj->opcode == 4 || pj->opcode == 18 || pj->opcode == 19 || pj->opcode == 20) && pj->src2_typ == 0 && pj->src2 == d && !(pj->src1_typ == 0 && pj->src1 == d)) {
        reg = "rax"     // vysledek volani rovnou jako druhy operand (add r14, rax)
    } Jinak Pokud (pj->opcode == 23) {
        // Rada ARG: cil musi byt mezi nimi a zadny drivejsi ARG nesmi cist z ciloveho registru
        Lokalni k = j
        Lokalni nalezeno = 0 - 1
        Dokud (k < pocet_ir && nalezeno < 0) {
            Lokalni pk : IR_Instrukce = pamet_ir + (k * 48)
            Pokud (pk->opcode == 0) { k = k + 1; Pokracuj }
            Pokud (pk->opcode != 23) { Ukonci }
            Pokud (pk->src1_typ == 0 && pk->src1 == d) { nalezeno = k } Jinak { k = k + 1 }
        }
        Pokud (nalezeno < 0) { Vrat 0 }
        Lokalni cil : IR_Instrukce = pamet_ir + (nalezeno * 48)
        reg = Volej RegistrArgumentu(cil->dest, 0)
        k = j
        Dokud (k < nalezeno) {
            Lokalni pk2 : IR_Instrukce = pamet_ir + (k * 48)
            Pokud (pk2->opcode == 23 && pk2->src1_typ == 0) {
                Pokud (Volej strcmp(Volej Umisteni(pk2->src1), reg) == 0) { Vrat 0 }
            }
            k = k + 1
        }
        j = nalezeno
    } Jinak {
        Vrat 0
    }
    // Druhy operand nesmi lezet v cilovem registru (prvni by ho prepsal)
    Pokud (inst->src2_typ == 0 && inst->src2 > 0) {
        Pokud (Volej strcmp(Volej Umisteni(inst->src2), reg) == 0) { Vrat 0 }
    }
    ir_napoveda_v = d
    ir_napoveda_reg = reg
    ir_napoveda_do = j
    Vrat 0
}

// Umisteni vregu: nazev registru, nebo "qword [rbp - N]" kdyz je na zasobniku
Metoda Umisteni(v) {
    Pokud (v == ir_napoveda_v) { Vrat ir_napoveda_reg }
    Lokalni iv : LiveInterval = pamet_intervalu + ((v - 1) * 32)
    Pokud (iv->fyzicky_reg > 0) { Vrat Volej JmenoRegistru(iv->fyzicky_reg) }
    Vrat Volej TrvalyText1("qword [rbp - %d]", 0 - iv->fyzicky_reg)
}
Metoda VRegistru(v) {
    Pokud (v == ir_napoveda_v) { Vrat 1 }
    Lokalni iv : LiveInterval = pamet_intervalu + ((v - 1) * 32)
    Pokud (iv->fyzicky_reg > 0) { Vrat 1 }
    Vrat 0
}
Metoda JeImm32(c) {
    Pokud (c >= (0 - 2147483647) && c <= 2147483647) { Vrat 1 }
    Vrat 0
}
Metoda Vystup(text) { Volej fputs(text, ir_out); Vrat 0 }
Metoda Vystup1(f, a) { Volej fprintf(ir_out, f, a); Vrat 0 }
Metoda Vystup2(f, a, b) { Volej fprintf(ir_out, f, a, b); Vrat 0 }
Metoda Vystup3(f, a, b, c) { Volej fprintf(ir_out, f, a, b, c); Vrat 0 }

// Nacte operand (vreg nebo konstantu) do daneho registru
Metoda JmenoXmm(k) {
    Pokud (a_xmm_jmena == 0) {
        a_xmm_jmena = Volej calloc(16, 8)
        Lokalni j = 0
        Dokud (j < 16) { Volej ZapisUkazatel(a_xmm_jmena + (j * 8), Volej TrvalyText1("xmm%d", j)); j = j + 1 }
    }
    Vrat CtiZAdresu(a_xmm_jmena + (k * 8))
}
Globalni a_xmm_jmena = 0
Metoda JeXmm(jmeno) {
    Pokud (CtiByt(jmeno) == 120 && CtiByt(jmeno + 1) == 109) { Vrat 1 } // "xm"
    Vrat 0
}
// Hodnota operandu v registru xmm (kdyz v nem neni, nacte se do nahradniho pres movq)
// Dvojice desetinnych cisel je vzdy v xmm (alokator to zarucuje)
Metoda VekRegistr(v) {
    Lokalni u = Volej Umisteni(v)
    Pokud (Volej JeXmm(u) == 0) {
        Volej printf("Vnitrni chyba prekladace: dvojice desetinnych cisel mimo xmm (prelozte s --bez-vektorizace)\n")
        Volej exit(1)
    }
    Vrat u
}
Metoda PrelozVektor(op, d, s1, t1, s2, t2) {
    Lokalni dx = Volej VekRegistr(d)
    Pokud (op == 80) { // stejna hodnota do obou polovin
        Lokalni sx = Volej XmmOperandu(s1, t1, "xmm15")
        Pokud (Volej strcmp(sx, dx) != 0) { Volej Vystup2("    movapd %s, %s\n", dx, sx) }
        Volej Vystup2("    unpcklpd %s, %s\n", dx, dx)
        Vrat 0
    }
    Pokud (op == 81) { // dve cela cisla -> dve desetinna (pxor: bez falesne zavislosti)
        Lokalni a = Volej RegistrOperandu(s1, t1, "r10")
        Lokalni b = Volej RegistrOperandu(s2, t2, "r11")
        Volej Vystup3("    pxor %s, %s\n    cvtsi2sd %s, ", dx, dx, dx)
        Volej Vystup1("%s\n", a)
        Volej Vystup1("    pxor xmm15, xmm15\n    cvtsi2sd xmm15, %s\n", b)
        Volej Vystup1("    unpcklpd %s, xmm15\n", dx)
        Vrat 0
    }
    Pokud (op == 86) { // horni polovina
        Lokalni hx = Volej VekRegistr(s1)
        Pokud (Volej strcmp(hx, dx) != 0) { Volej Vystup2("    movapd %s, %s\n", dx, hx) }
        Volej Vystup2("    unpckhpd %s, %s\n", dx, dx)
        Vrat 0
    }
    Lokalni ins = "addpd"
    Pokud (op == 83) { ins = "subpd" }
    Pokud (op == 84) { ins = "mulpd" }
    Pokud (op == 85) { ins = "divpd" }
    Lokalni ax = Volej VekRegistr(s1)
    Lokalni bx = Volej VekRegistr(s2)
    Pokud (Volej strcmp(bx, dx) == 0 && Volej strcmp(ax, dx) != 0) {
        Volej Vystup1("    movapd xmm14, %s\n", ax)
        Volej Vystup2("    %s xmm14, %s\n", ins, bx)
        Volej Vystup1("    movapd %s, xmm14\n", dx)
    } Jinak {
        Pokud (Volej strcmp(ax, dx) != 0) { Volej Vystup2("    movapd %s, %s\n", dx, ax) }
        Volej Vystup3("    %s %s, %s\n", ins, dx, bx)
    }
    Vrat 0
}

Metoda XmmOperandu(s, t, nahradni) {
    Pokud (t == 1) {
        Pokud (s == 0) { Volej Vystup2("    pxor %s, %s\n", nahradni, nahradni); Vrat nahradni }
        Volej Vystup1("    mov r11, %lld\n", s)
        Volej Vystup1("    movq %s, r11\n", nahradni)
        Vrat nahradni
    }
    Lokalni u = Volej Umisteni(s)
    Pokud (Volej JeXmm(u) == 1) { Vrat u }
    Volej Vystup2("    movq %s, %s\n", nahradni, u)
    Vrat nahradni
}

Metoda NactiDo(reg, s, t) {
    Pokud (t == 1) {
        Pokud (s == 0) { Volej Vystup2("    xor %s, %s\n", reg, reg); Vrat 0 }
        Volej Vystup2("    mov %s, %lld\n", reg, s)
        Vrat 0
    }
    Lokalni u = Volej Umisteni(s)
    Pokud (Volej JeXmm(u) == 1 || Volej JeXmm(reg) == 1) { Volej Vystup2("    movq %s, %s\n", reg, u); Vrat 0 }
    Pokud (Volej strcmp(u, reg) != 0) { Volej Vystup2("    mov %s, %s\n", reg, u) }
    Vrat 0
}

// Registr s hodnotou operandu: je-li vreg v registru, pouzije primo ten, jinak nacte do nahradniho
Metoda RegistrOperandu(s, t, nahradni) {
    Pokud (t == 0) { Pokud (Volej VRegistru(s) == 1) { Vrat Volej Umisteni(s) } }
    Volej NactiDo(nahradni, s, t)
    Vrat nahradni
}

// Druhy operand instrukce: registr, pamet nebo 32bitova konstanta
Metoda DruhyOperand(s, t) {
    Pokud (t == 1) {
        Pokud (Volej JeImm32(s) == 1) { Vrat Volej TrvalyText1("%lld", s) }
        Volej Vystup1("    mov r11, %lld\n", s)
        Vrat "r11"
    }
    Vrat Volej Umisteni(s)
}

// Ulozi pracovni registr do cile (vreg)
Metoda UlozCil(d, reg) {
    Lokalni u = Volej Umisteni(d)
    Pokud (Volej JeXmm(u) == 1 && Volej strcmp(u, reg) != 0) { Volej Vystup2("    movq %s, %s\n", u, reg); Vrat 0 }
    Pokud (Volej strcmp(u, reg) != 0) { Volej Vystup2("    mov %s, %s\n", u, reg) }
    Vrat 0
}

// Pracovni registr pro vysledek: primo cilovy registr, nebo r10 kdyz je cil na zasobniku
Metoda PracovniRegistr(d) {
    Pokud (Volej VRegistru(d) == 1) { Vrat Volej Umisteni(d) }
    Vrat "r10"
}

Metoda LogDvou(c) {
    Pokud (c < 2) { Vrat 0 - 1 }
    Lokalni k = 0
    Lokalni x = c
    Dokud ((x & 1) == 0) { x = x >> 1; k = k + 1 }
    Pokud (x != 1) { Vrat 0 - 1 }
    Vrat k
}

// Deleni / zbytek konstantou bez pomale instrukce idiv.
// Delenec je v r11, vysledek ulozi do vregu d.
// Delenec je v registru x (r11 nebo registr promenne, nikdy rax/rdx); x se nemeni
Globalni deleni_nezaporne = 0   // delenec urcite >= 0 (rozsah z cyklu)
Metoda DeleniKonstantou(c, zbytek, d, x) {
    Lokalni k = Volej LogDvou(c)
    Pokud (k > 0 && deleni_nezaporne == 1) {
        // nezaporny delenec a mocnina dvou: jen posun, zbytek jen maska
        Lokalni w2 = Volej PracovniRegistr(d)
        Pokud (Volej strcmp(w2, x) != 0) { Volej Vystup2("    mov %s, %s\n", w2, x) }
        Pokud (zbytek == 1) { Volej Vystup2("    and %s, %lld\n", w2, c - 1) } Jinak { Volej Vystup2("    shr %s, %d\n", w2, k) }
        Volej UlozCil(d, w2)
        Vrat 0
    }
    Pokud (k > 0) {
        // mocnina dvou: zaokrouhleni k nule (u zapornych cisel pricteme c-1)
        Volej Vystup3("    mov rdx, %s\n    sar rdx, 63\n    shr rdx, %d\n", x, 64 - k, 0)
        Volej Vystup1("    add rdx, %s\n", x)
        Volej Vystup1("    sar rdx, %d\n", k)
    } Jinak {
        Lokalni m = Volej MagickeCislo(c)
        Volej Vystup2("    mov rax, %lld\n    imul %s\n", m, x)
        Pokud (m < 0) { Volej Vystup1("    add rdx, %s\n", x) }
        Pokud (magie_posun > 0) { Volej Vystup1("    sar rdx, %d\n", magie_posun) }
        // oprava pro zaporny delenec (u nezaporneho zbytecna)
        Pokud (deleni_nezaporne == 0) { Volej Vystup1("    mov rax, %s\n    shr rax, 63\n    add rdx, rax\n", x) }
    }
    // podil je v rdx
    Pokud (zbytek == 0) { Volej UlozCil(d, "rdx"); Vrat 0 }
    Pokud (Volej JeImm32(c) == 1) { Volej Vystup1("    imul rdx, rdx, %lld\n", c) } Jinak { Volej Vystup1("    mov rax, %lld\n    imul rdx, rax\n", c) }
    // zbytek = x - podil*c, rovnou do ciloveho registru (kdyz to neni rdx ani x)
    Lokalni w = Volej PracovniRegistr(d)
    Pokud (Volej strcmp(w, "rdx") != 0 && Volej strcmp(w, x) != 0) {
        Volej Vystup2("    mov %s, %s\n", w, x)
        Volej Vystup1("    sub %s, rdx\n", w)
        Volej UlozCil(d, w)
        Vrat 0
    }
    Pokud (Volej strcmp(x, "r11") != 0) { Volej Vystup1("    mov r11, %s\n", x) }
    Volej Vystup("    sub r11, rdx\n")
    Volej UlozCil(d, "r11")
    Vrat 0
}

Metoda JeRychleDeleni(c) {
    Pokud (c < 2) { Vrat 0 }
    Pokud (Volej LogDvou(c) > 0) { Vrat 1 }
    Pokud (Volej MagickeCislo(c) != 0) { Vrat 1 }
    Vrat 0
}

// Instrukce skoku pri NEPLATNOSTI porovnani (30..35)
Metoda SkokPriNeplatnosti(op) {
    Pokud (op == 30) { Vrat "jne" }
    Pokud (op == 31) { Vrat "je" }
    Pokud (op == 32) { Vrat "jge" }
    Pokud (op == 33) { Vrat "jle" }
    Pokud (op == 34) { Vrat "jg" }
    Vrat "jl"
}
Metoda SetPorovnani(op) {
    Pokud (op == 12) { Vrat "sete" }
    Pokud (op == 13) { Vrat "setne" }
    Pokud (op == 14) { Vrat "setl" }
    Pokud (op == 15) { Vrat "setg" }
    Pokud (op == 16) { Vrat "setle" }
    Vrat "setge"
}

// cmp s1, s2 (prvni operand musi byt registr nebo pamet; nejvys jeden pametovy)
Metoda VypisCmp(s1, t1, s2, t2) {
    Lokalni a = "r10"
    Pokud (t1 == 0) { a = Volej Umisteni(s1) } Jinak { Volej NactiDo("r10", s1, t1) }
    Lokalni b = Volej DruhyOperand(s2, t2)
    Pokud (t1 == 0 && Volej VRegistru(s1) == 0 && t2 == 0) {
        Pokud (Volej VRegistru(s2) == 0) { Volej NactiDo("r10", s1, t1); a = "r10" }
    }
    Volej Vystup2("    cmp %s, %s\n", a, b)
    Vrat 0
}

// Dalsi skutecna instrukce je navesti n? (pak je skok na nej zbytecny)
Metoda DalsiJeNavesti(i, n) {
    Lokalni j = i + 1
    Dokud (j < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (j * 48)
        Pokud (inst->opcode == 0) { j = j + 1; Pokracuj }
        Pokud (inst->opcode == 11) {
            Pokud (inst->dest == n) { Vrat 1 }
            j = j + 1
            Pokracuj
        }
        Vrat 0
    }
    Vrat 0
}

Globalni ir_vola = 0
Globalni zarovnani_vypnuto = 0   // --bez-zarovnani

// Zarovnani zacatku cyklu na 16 bajtu (jako gcc .p2align 4): jen navesti, na ktere se skace zpet
// a pred kterym je nepodmineny skok, takze vypln (nop) se nikdy neprovadi
Metoda ZarovnatNavesti(i, d) {
    Pokud (zarovnani_vypnuto == 1 || cilova_platforma == 3 || cilova_platforma == 5) { Vrat 0 }
    // predchozi instrukce: nepodmineny skok, ktery se opravdu vypise
    Lokalni k = i - 1
    Dokud (k >= 0) {
        Lokalni ik : IR_Instrukce = pamet_ir + (k * 48)
        Pokud (ik->opcode != 0) { Ukonci }
        k = k - 1
    }
    Pokud (k < 0) { Vrat 0 }
    Lokalni ip : IR_Instrukce = pamet_ir + (k * 48)
    Pokud (ip->opcode != 10) { Vrat 0 }
    Pokud (Volej DalsiJeNavesti(k, ip->dest) == 1) { Vrat 0 }
    // skace se na nej zpet?
    Lokalni j = i + 1
    Dokud (j < pocet_ir) {
        Lokalni ij : IR_Instrukce = pamet_ir + (j * 48)
        Lokalni o = ij->opcode
        Pokud ((o == 10 || (o >= 30 && o <= 35) || o == 9) && ij->dest == d) { Vrat 1 }
        j = j + 1
    }
    Vrat 0
}
Globalni x_xmm14 = 0 - 1       // vreg, jehoz hodnota je prave v xmm14
Globalni ir_pocet_xmm = 0      // desetinne argumenty pred volanim (SysV: al = jejich pocet)

// ---------------------------------------------------------------------------
// Rychly vstup (shrink-wrapping): zacina-li metoda "Pokud (a OP b) { Vrat e }", kde a, b jsou
// parametry nebo cela cisla a e je parametr, cislo nebo parametr +/- cislo, vyhodnoti se tenhle
// test hned na vstupu, jeste pred prologem, jen nad registry argumentu. Kdyz plati, metoda
// skonci "ret" bez ramce, ukladani registru a kontroly zasobniku (Fib(1) stoji 5 instrukci).
// Test se v tele dela tak jako tak, jen se presune drive: zadny skok navic.
// ---------------------------------------------------------------------------
Globalni rv_citac = 0

// Index parametru (0..3), nebo -1
Metoda RvParametr(u : AST_Node) {
    Pokud (u == 0) { Vrat 0 - 1 }
    Pokud (u->type != AST_EXPR || u->op != 35) { Vrat 0 - 1 }
    Lokalni f : AST_Node = ir_metoda
    Lokalni i = 0
    Dokud (i < f->arg_count && i < 4) {
        Lokalni ps : Symbol = pamet_symbolu + ((f->sym_start + i) * Velikost(Symbol))
        Pokud (Volej strcmp(ps->name, u->name) == 0) {
            Pokud (Volej strcmp(ps->type_name, "Float") == 0) { Vrat 0 - 1 }
            Vrat i
        }
        i = i + 1
    }
    Vrat 0 - 1
}
Metoda RvJeCislo(u : AST_Node) {
    Pokud (u == 0) { Vrat 0 }
    Pokud (u->type != AST_EXPR || u->op != 34) { Vrat 0 }
    Lokalni c = Volej NaCislo(u->name)
    Pokud (c > 2147483647 || c < 0 - 2147483647) { Vrat 0 }
    Vrat 1
}
// Vrati prikaz Pokud, ktery lze vyhodnotit na vstupu, jinak 0
Metoda RychlyVstup() {
    Lokalni f : AST_Node = ir_metoda
    Pokud (f == 0 || f->right == 0 || ir_metoda_ma_asm == 1 || inl_vypnuto == 1) { Vrat 0 }
    Pokud (Volej strcmp(f->name, "Hlavni") == 0 || Volej strcmp(f->name, "main") == 0) { Vrat 0 }
    Pokud (Volej strcmp(f->type_name, "Float") == 0) { Vrat 0 }
    Pokud (Volej JePamatovana(f->name) == 1) { Vrat 0 }
    Pokud (Volej ObsahujeTyp(f->right, AST_DEFER) == 1) { Vrat 0 }
    Lokalni telo : AST_Node = f->right
    Pokud (telo->type != AST_BLOCK || telo->stmt_count < 2) { Vrat 0 }
    Lokalni prvni : AST_Node = Volej CtiUkazatel(telo->stmts)
    Pokud (prvni->type != AST_IF || prvni->alt != 0) { Vrat 0 }
    Lokalni pod : AST_Node = prvni->left
    Pokud (pod == 0) { Vrat 0 }
    Pokud (pod->type != AST_EXPR) { Vrat 0 }
    Lokalni op = pod->op
    Pokud (!(op == 43 || op == 64 || op == 45 || op == 46 || op == 61 || op == 62)) { Vrat 0 }
    Lokalni pa = Volej RvParametr(pod->left)
    Lokalni pb = Volej RvParametr(pod->right)
    Pokud (pa < 0 && pb < 0) { Vrat 0 }
    Pokud (pa < 0 && Volej RvJeCislo(pod->left) == 0) { Vrat 0 }
    Pokud (pb < 0 && Volej RvJeCislo(pod->right) == 0) { Vrat 0 }
    Lokalni navrat : AST_Node = prvni->right
    Pokud (navrat == 0) { Vrat 0 }
    Pokud (navrat->type == AST_BLOCK) {
        Pokud (navrat->stmt_count != 1) { Vrat 0 }
        navrat = Volej CtiUkazatel(navrat->stmts)
    }
    Pokud (navrat->type != AST_RETURN || navrat->left == 0) { Vrat 0 }
    Lokalni e : AST_Node = navrat->left
    Pokud (Volej RvParametr(e) >= 0 || Volej RvJeCislo(e) == 1) { Vrat prvni }
    Pokud (e->type != AST_EXPR || (e->op != 67 && e->op != 44)) { Vrat 0 }
    Pokud (Volej RvParametr(e->left) >= 0 && Volej RvJeCislo(e->right) == 1) { Vrat prvni }
    Vrat 0
}
// Podminka pro skok na plny vstup, kdyz "a OP b" NEPLATI (a je vzdy registr)
Metoda RvSkokX86(op) {
    Pokud (op == 43) { Vrat "jne" }
    Pokud (op == 64) { Vrat "je" }
    Pokud (op == 45) { Vrat "jge" }
    Pokud (op == 46) { Vrat "jle" }
    Pokud (op == 61) { Vrat "jg" }
    Vrat "jl"
}
Metoda RvSkokARM(op) {
    Pokud (op == 43) { Vrat "ne" }
    Pokud (op == 64) { Vrat "eq" }
    Pokud (op == 45) { Vrat "ge" }
    Pokud (op == 46) { Vrat "le" }
    Pokud (op == 61) { Vrat "gt" }
    Vrat "lt"
}
Metoda RvCislo(u : AST_Node) { Vrat Volej NaCislo(u->name) }
// "c OP p" je totez co "p OP' c"
Metoda RvOtoc(op) {
    Pokud (op == 45) { Vrat 46 }
    Pokud (op == 46) { Vrat 45 }
    Pokud (op == 61) { Vrat 62 }
    Pokud (op == 62) { Vrat 61 }
    Vrat op
}
Metoda EmitujRychlyVstupX86(prvni : AST_Node) {
    Lokalni pod : AST_Node = prvni->left
    Lokalni op = pod->op
    Lokalni pa = Volej RvParametr(pod->left)
    Lokalni pb = Volej RvParametr(pod->right)
    rv_citac = rv_citac + 1
    Pokud (pa >= 0 && pb >= 0) {
        Volej Vystup2("    cmp %s, %s\n", Volej RegistrArgumentu(pa, 0), Volej RegistrArgumentu(pb, 0))
    } Jinak Pokud (pa >= 0) {
        Volej Vystup2("    cmp %s, %lld\n", Volej RegistrArgumentu(pa, 0), Volej RvCislo(pod->right))
    } Jinak {
        op = Volej RvOtoc(op)
        Volej Vystup2("    cmp %s, %lld\n", Volej RegistrArgumentu(pb, 0), Volej RvCislo(pod->left))
    }
    Volej Vystup2("    %s .L_plny_vstup_%d\n", Volej RvSkokX86(op), rv_citac)
    Lokalni navrat : AST_Node = prvni->right
    Pokud (navrat->type == AST_BLOCK) { navrat = Volej CtiUkazatel(navrat->stmts) }
    Lokalni e : AST_Node = navrat->left
    Lokalni pe = Volej RvParametr(e)
    Pokud (pe >= 0) { Volej Vystup1("    mov rax, %s\n", Volej RegistrArgumentu(pe, 0)) }
    Jinak Pokud (Volej RvJeCislo(e) == 1) { Volej Vystup1("    mov rax, %lld\n", Volej NaCislo(e->name)) }
    Jinak {
        Lokalni k = Volej RvCislo(e->right)
        Pokud (e->op == 44) { k = 0 - k }
        Volej Vystup2("    lea rax, [%s + %lld]\n", Volej RegistrArgumentu(Volej RvParametr(e->left), 0), k)
    }
    Volej Vystup1("    ret\n.L_plny_vstup_%d:\n", rv_citac)
    Pokud (podrobny_vypis == 1) { Volej printf(">> Rychly vstup: '%s' vraci zakladni pripad pred prologem\n", Volej JmenoMetodyIR()) }
    Vrat 0
}
Metoda EmitujRychlyVstupARM(prvni : AST_Node) {
    Lokalni pod : AST_Node = prvni->left
    Lokalni op = pod->op
    Lokalni pa = Volej RvParametr(pod->left)
    Lokalni pb = Volej RvParametr(pod->right)
    rv_citac = rv_citac + 1
    Pokud (pa >= 0 && pb >= 0) {
        Volej Vystup2("    cmp x%d, x%d\n", pa, pb)
    } Jinak {
        Lokalni c = 0
        Pokud (pa >= 0) { c = Volej RvCislo(pod->right) } Jinak {
            op = Volej RvOtoc(op)
            pa = pb
            c = Volej RvCislo(pod->left)
        }
        Pokud (c >= 0 && c < 4096) { Volej Vystup2("    cmp x%d, #%lld\n", pa, c) }
        Jinak { Volej CisloA(16, c); Volej Vystup1("    cmp x%d, x16\n", pa) }
    }
    Volej Vystup2("    b.%s .L_plny_vstup_%d\n", Volej RvSkokARM(op), rv_citac)
    Lokalni navrat : AST_Node = prvni->right
    Pokud (navrat->type == AST_BLOCK) { navrat = Volej CtiUkazatel(navrat->stmts) }
    Lokalni e : AST_Node = navrat->left
    Lokalni pe = Volej RvParametr(e)
    Pokud (pe >= 0) { Pokud (pe != 0) { Volej Vystup1("    mov x0, x%d\n", pe) } }
    Jinak Pokud (Volej RvJeCislo(e) == 1) { Volej CisloA(0, Volej NaCislo(e->name)) }
    Jinak {
        Lokalni k = Volej RvCislo(e->right)
        Pokud (e->op == 44) { k = 0 - k }
        Lokalni pr = Volej RvParametr(e->left)
        Pokud (k >= 0 && k < 4096) { Volej Vystup2("    add x0, x%d, #%lld\n", pr, k) }
        Jinak Pokud (k < 0 && k > 0 - 4096) { Volej Vystup2("    sub x0, x%d, #%lld\n", pr, 0 - k) }
        Jinak { Volej CisloA(16, k); Volej Vystup1("    add x0, x%d, x16\n", pr) }
    }
    Volej Vystup1("    ret\n.L_plny_vstup_%d:\n", rv_citac)
    Vrat 0
}

Metoda PrelozIRDoASM(out) {
    ir_out = out
    Volej SpocitejDefinice()
    ir_vola = 0
    Lokalni iv0 = 0
    Dokud (iv0 < pocet_ir && ir_vola == 0) {
        Lokalni ii0 : IR_Instrukce = pamet_ir + (iv0 * 48)
        Pokud (ii0->opcode == 24) { ir_vola = 1 }
        Pokud (ii0->opcode == 99) { Pokud (Volej strstr(ii0->src1, "call") != 0) { ir_vola = 1 } }
        iv0 = iv0 + 1
    }
    ir_napoveda_v = 0 - 1
    ir_napoveda_do = 0 - 1
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Pokud (ir_napoveda_do >= 0 && i > ir_napoveda_do) { ir_napoveda_v = 0 - 1; ir_napoveda_do = 0 - 1 }
        Pokud (ir_napoveda_do < 0) { Volej NajdiNapovedu(i) }
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op = inst->opcode
        Lokalni d = inst->dest
        Lokalni s1 = inst->src1
        Lokalni t1 = inst->src1_typ
        Lokalni s2 = inst->src2
        Lokalni t2 = inst->src2_typ

        Pokud (op == 0) { i = i + 1; Pokracuj }
        // Obsah xmm14 plati jen mezi desetinnymi operacemi jdoucimi po sobe
        Pokud (op != 60 && op != 61 && op != 62 && op != 63 && op != 64) { x_xmm14 = 0 - 1 }
        Pokud (op == 99) { Volej fputs(s1, out); Volej free(s1); i = i + 1; Pokracuj }
        Pokud (op == 98) { // prolog: ramec a ulozeni pouzitych callee-saved registru
            Pokud (ir_ma_ramec == 1 || ir_pouzite_reg != 0 || ir_vola == 1) {
                Lokalni rv : AST_Node = Volej RychlyVstup()
                Pokud (rv != 0) { Volej EmitujRychlyVstupX86(rv) }
            }
            Pokud (ir_ma_ramec == 1) {
                Volej Vystup("    push rbp\n    mov rbp, rsp\n")
                // Nepovysene parametry z registru do domovske oblasti nad navratovou adresou
                Lokalni m98 : AST_Node = ir_metoda
                Lokalni pi98 = 0
                Dokud (pi98 < m98->arg_count && pi98 < 4) {
                    Lokalni ps98 : Symbol = pamet_symbolu + ((m98->sym_start + pi98) * Velikost(Symbol))
                    Pokud (ps98->vreg == 0) { Volej Vystup2("    mov [rbp + %d], %s\n", 16 + (pi98 * 8), Volej RegistrArgumentu(pi98, 0)) }
                    pi98 = pi98 + 1
                }
            }
            Pokud (cilova_platforma == 2 && ramec_celkem > 4096) {
                // Windows vyzaduje "osahat" kazdou stranku zasobniku (stack probe)
                ir_citac_sond = ir_citac_sond + 1
                Volej Vystup2("    mov r11, %d\n.L_sonda_%d:\n", ramec_celkem / 4096, ir_citac_sond)
                Volej Vystup1("    sub rsp, 4096\n    test [rsp], rsp\n    dec r11\n    jnz .L_sonda_%d\n", ir_citac_sond)
                Pokud ((ramec_celkem % 4096) > 0) { Volej Vystup1("    sub rsp, %d\n", ramec_celkem % 4096) }
            } Jinak Pokud (ramec_celkem > 0) { Volej Vystup1("    sub rsp, %d\n", ramec_celkem) }
            Lokalni r = 0
            Dokud (r < 16) {
                Pokud (((ir_pouzite_reg >> r) & 1) == 1) { Volej Vystup1("    push %s\n", Volej JmenoRegistru(r)) }
                r = r + 1
            }
            // Kontrola hloubky rekurze jen v metodach, ktere neco volaji (list metody nic nepridava)
            Pokud (kontroly == 1 && cilova_platforma != 3 && ir_vola == 1) {
                Volej Vystup("    cmp rsp, [rel pramen_mez_zasobniku]\n    jb pramen_preteceni_zasobniku\n")
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 97) { // epilog
            Pokud (ir_ma_ramec == 0) {
                // Bez ramce: rsp uz ukazuje na ulozene registry
                Lokalni r3 = 15
                Dokud (r3 >= 0) {
                    Pokud (((ir_pouzite_reg >> r3) & 1) == 1) { Volej Vystup1("    pop %s\n", Volej JmenoRegistru(r3)) }
                    r3 = r3 - 1
                }
                Volej Vystup("    ret\n")
                i = i + 1
                Pokracuj
            }
            Pokud (ir_pocet_push > 0) {
                Volej Vystup1("    lea rsp, [rbp - %d]\n", ramec_celkem + (ir_pocet_push * 8))
                Lokalni r2 = 15
                Dokud (r2 >= 0) {
                    Pokud (((ir_pouzite_reg >> r2) & 1) == 1) { Volej Vystup1("    pop %s\n", Volej JmenoRegistru(r2)) }
                    r2 = r2 - 1
                }
            }
            Volej Vystup("    leave\n    ret\n")
            i = i + 1
            Pokracuj
        }
        Pokud (op == 39) { Volej UlozCil(d, Volej RegistrArgumentu(s1, 0)); i = i + 1; Pokracuj }
        Pokud (op == 11) {
            Pokud (Volej ZarovnatNavesti(i, d) == 1) { Volej Vystup("    align 16\n") }
            Volej Vystup1(".L_label_%d:\n", d)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 10) {
            Pokud (Volej DalsiJeNavesti(i, d) == 0) { Volej Vystup1("    jmp .L_label_%d\n", d) }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 9) { Volej Vystup1("    je .L_label_%d\n", d); i = i + 1; Pokracuj }
        Pokud (op == 54) { // kontrola mezi: skok na chybu, kdyz s1 >= s2 bez znamenka (zaporne = obrovske)
            Volej VypisCmp(s1, t1, s2, t2)
            Volej Vystup1("    jae .L_label_%d\n", d)
            i = i + 1
            Pokracuj
        }
        Pokud (op >= 30 && op <= 35) {
            Pokud (t2 == 1 && s2 == 0 && (op == 30 || op == 31) && t1 == 0 && Volej VRegistru(s1) == 1) {
                Lokalni u0 = Volej Umisteni(s1)
                Volej Vystup2("    test %s, %s\n", u0, u0)
            } Jinak {
                Volej VypisCmp(s1, t1, s2, t2)
            }
            Volej Vystup2("    %s .L_label_%d\n", Volej SkokPriNeplatnosti(op), d)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 25) { Volej NactiDo("rax", s1, t1); i = i + 1; Pokracuj }
        Pokud (op == 38) { Volej UlozCil(d, "rax"); i = i + 1; Pokracuj }
        Pokud (op == 23) { Volej NactiDo(Volej RegistrArgumentu(d, 0), s1, t1); i = i + 1; Pokracuj }
        Pokud (op >= 80 && op <= 86) { Volej PrelozVektor(op, d, s1, t1, s2, t2); i = i + 1; Pokracuj }
        Pokud (op >= 60 && op <= 63 && Volej JeXmm(Volej Umisteni(d)) == 1) { // vysledek v xmm: primo
            Lokalni dx = Volej Umisteni(d)
            Lokalni ins_x = "addsd"
            Pokud (op == 61) { ins_x = "subsd" }
            Pokud (op == 62) { ins_x = "mulsd" }
            Pokud (op == 63) { ins_x = "divsd" }
            Lokalni bx = Volej XmmOperandu(s2, t2, "xmm15")
            Pokud (Volej strcmp(bx, dx) == 0 && !(t1 == 0 && Volej strcmp(Volej Umisteni(s1), dx) == 0)) {
                // d == b: pres xmm14, aby se b neprepsalo drive, nez se pouzije
                Lokalni ax = Volej XmmOperandu(s1, t1, "xmm14")
                Pokud (Volej strcmp(ax, "xmm14") != 0) { Volej Vystup1("    movapd xmm14, %s\n", ax) }
                Volej Vystup2("    %s xmm14, %s\n", ins_x, bx)
                Volej Vystup1("    movapd %s, xmm14\n", dx)
            } Jinak {
                Lokalni ax2 = Volej XmmOperandu(s1, t1, dx)
                Pokud (Volej strcmp(ax2, dx) != 0) { Volej Vystup2("    movapd %s, %s\n", dx, ax2) }
                Volej Vystup3("    %s %s, %s\n", ins_x, dx, bx)
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 64 && Volej JeXmm(Volej Umisteni(d)) == 1) {
            Lokalni dx64 = Volej Umisteni(d)
            Lokalni a64x = Volej RegistrOperandu(s1, t1, "r10")
            Volej Vystup3("    pxor %s, %s\n    cvtsi2sd %s, ", dx64, dx64, dx64)
            Volej Vystup1("%s\n", a64x)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 72 && Volej JeXmm(Volej Umisteni(d)) == 1) {
            Volej Vystup2("    movsd %s, qword [rel %s]\n", Volej Umisteni(d), s1)
            i = i + 1
            Pokracuj
        }
        Pokud (op >= 66 && op <= 71) { // porovnani (operandy mohou byt v xmm); NaN: plati jen !=
            Lokalni a66x = Volej XmmOperandu(s1, t1, "xmm14")
            Lokalni b66x = Volej XmmOperandu(s2, t2, "xmm15")
            Pokud (op == 68 || op == 70) { Volej Vystup2("    ucomisd %s, %s\n", b66x, a66x) } Jinak { Volej Vystup2("    ucomisd %s, %s\n", a66x, b66x) }
            Pokud (op == 66) { Volej Vystup("    sete al\n    setnp r11b\n    and al, r11b\n") }
            Pokud (op == 67) { Volej Vystup("    setne al\n    setp r11b\n    or al, r11b\n") }
            Pokud (op == 68 || op == 69) { Volej Vystup("    seta al\n") }
            Pokud (op == 70 || op == 71) { Volej Vystup("    setae al\n") }
            Lokalni w66x = Volej PracovniRegistr(d)
            Volej Vystup1("    movzx %s, al\n", w66x)
            Volej UlozCil(d, w66x)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 74) { // desetinny argument funkce C -> xmm (Windows: i do celociselneho registru)
            Lokalni ax74 = Volej XmmOperandu(s1, t1, Volej JmenoXmm(d))
            Pokud (Volej strcmp(ax74, Volej JmenoXmm(d)) != 0) { Volej Vystup2("    movapd %s, %s\n", Volej JmenoXmm(d), ax74) }
            Pokud (cilova_platforma == 2) { Volej Vystup2("    movq %s, %s\n", Volej RegistrArgumentu(d, 0), Volej JmenoXmm(d)) }
            Pokud (d + 1 > ir_pocet_xmm) { ir_pocet_xmm = d + 1 }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 26 && t1 == 0 && (Volej JeXmm(Volej Umisteni(d)) == 1 || Volej JeXmm(Volej Umisteni(s1)) == 1)) {
            Lokalni ud = Volej Umisteni(d)
            Lokalni us = Volej Umisteni(s1)
            Pokud (Volej strcmp(ud, us) != 0) {
                Pokud (Volej JeXmm(ud) == 1 && Volej JeXmm(us) == 1) { Volej Vystup2("    movapd %s, %s\n", ud, us) }
                Jinak { Volej Vystup2("    movq %s, %s\n", ud, us) }
            }
            i = i + 1
            Pokracuj
        }
        Pokud ((op == 1 || op == 26) && t1 == 1 && Volej JeXmm(Volej Umisteni(d)) == 1) {
            Volej XmmOperandu(s1, 1, Volej Umisteni(d))
            i = i + 1
            Pokracuj
        }
        Pokud (op >= 60 && op <= 63) { // + - * / desetinnych cisel (pres xmm14, xmm15)
            // xmm14 si pamatuje vysledek predchozi operace (x_xmm14) -> bez zbytecneho movq
            Lokalni pa = s1
            Lokalni pa_t = t1
            Lokalni pb = s2
            Lokalni pb_t = t2
            Pokud ((op == 60 || op == 62) && t2 == 0 && s2 == x_xmm14 && !(t1 == 0 && s1 == x_xmm14)) { pa = s2; pa_t = t2; pb = s1; pb_t = t1 }
            Pokud (!(pa_t == 0 && pa == x_xmm14)) {
                Lokalni a60 = Volej RegistrOperandu(pa, pa_t, "r10")
                Volej Vystup1("    movq xmm14, %s\n", a60)
            }
            Lokalni b60 = Volej RegistrOperandu(pb, pb_t, "r11")
            Volej Vystup1("    movq xmm15, %s\n", b60)
            Pokud (op == 60) { Volej Vystup("    addsd xmm14, xmm15\n") }
            Pokud (op == 61) { Volej Vystup("    subsd xmm14, xmm15\n") }
            Pokud (op == 62) { Volej Vystup("    mulsd xmm14, xmm15\n") }
            Pokud (op == 63) { Volej Vystup("    divsd xmm14, xmm15\n") }
            Lokalni w60 = Volej PracovniRegistr(d)
            Volej Vystup1("    movq %s, xmm14\n", w60)
            Volej UlozCil(d, w60)
            x_xmm14 = d
            i = i + 1
            Pokracuj
        }
        Pokud (op == 64) { // cele cislo -> desetinne
            Lokalni a64 = Volej RegistrOperandu(s1, t1, "r10")
            // pxor: cvtsi2sd jinak zavisi na stare hodnote xmm14 a zretezil by celou smycku
            Volej Vystup1("    pxor xmm14, xmm14\n    cvtsi2sd xmm14, %s\n", a64)
            Lokalni w64 = Volej PracovniRegistr(d)
            Volej Vystup1("    movq %s, xmm14\n", w64)
            Volej UlozCil(d, w64)
            x_xmm14 = d
            i = i + 1
            Pokracuj
        }
        Pokud (op == 72) { // nacteni ze symbolu (desetinny literal)
            Lokalni w72 = Volej PracovniRegistr(d)
            Volej Vystup2("    mov %s, qword [rel %s]\n", w72, s1)
            Volej UlozCil(d, w72)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 24) {
            Lokalni nazev_f = s1
            Pokud (Volej JeCFunkceA(nazev_f) == 1) { nazev_f = Volej NazevC_x86(nazev_f) }
            // Zarovnani zasobniku zname predem: prolog ulozil ir_pocet_push registru
            // a surovy kod ma na zasobniku ir_cekajici_push hodnot
            // Domovska oblast 32 B: Windows ABI a metody Pramenu s Asm (ukladaji si tam parametry)
            Lokalni je_ext24 = Volej JeCFunkceA(s1)
            Lokalni zarovnani = 0
            Pokud (cilova_platforma == 2 || (je_ext24 == 0 && Volej MetodaMaAsm(s1) == 1)) { zarovnani = 32 }
            Lokalni parita = ir_pocet_push + CtiZAdresu(ir_cekajici_push + (i * 8))
            Pokud (ir_ma_ramec == 0) { parita = parita + 1 }
            // Metoda Pramenu, ktera (ani nic, co vola) nevola C, zarovnany zasobnik nepotrebuje
            Pokud (je_ext24 == 0 && zarovnani == 0 && Volej PotrebujeZarovnani(s1) == 0) { parita = 0 }
            Pokud ((parita & 1) == 1) { zarovnani = zarovnani + 8 }
            Pokud (zarovnani > 0) { Volej Vystup1("    sub rsp, %d\n", zarovnani) }
            // al = pocet xmm registru u variadickych C funkci (SysV); Pramen ho nepotrebuje
            Pokud (je_ext24 == 1 && cilova_platforma != 2) {
                Pokud (ir_pocet_xmm > 0) { Volej Vystup1("    mov eax, %d\n", ir_pocet_xmm) } Jinak { Volej Vystup("    xor eax, eax\n") }
            }
            ir_pocet_xmm = 0
            Volej Vystup1("    call %s\n", nazev_f)
            Pokud (zarovnani > 0) { Volej Vystup1("    add rsp, %d\n", zarovnani) }
            Pokud (CtiZAdresu(ir_pocty_pouziti + (d * 8)) > 0) { // vysledek nikdo necte -> neukladat
                Pokud (Volej VraciCInt(s1) == 1) { Volej Vystup("    movsxd rax, eax\n") }
                Pokud (Volej JeFloatExtern(s1) == 1) { Volej Vystup("    movq rax, xmm0\n") }
                Volej UlozCil(d, "rax")
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 1 || op == 26) { // KONST, KOPIE
            Pokud (t1 == 0) {
                Pokud (Volej strcmp(Volej Umisteni(d), Volej Umisteni(s1)) == 0) { i = i + 1; Pokracuj }
            }
            Lokalni w = Volej PracovniRegistr(d)
            Pokud (t1 == 1 && Volej VRegistru(d) == 0 && Volej JeImm32(s1) == 1) {
                Volej Vystup2("    mov %s, %lld\n", Volej Umisteni(d), s1)
            } Jinak Pokud (t1 == 0 && (Volej VRegistru(d) == 1 || Volej VRegistru(s1) == 1)) {
                Volej Vystup2("    mov %s, %s\n", Volej Umisteni(d), Volej Umisteni(s1))
            } Jinak {
                Volej NactiDo(w, s1, t1)
                Volej UlozCil(d, w)
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 2) { // nacteni promenne z ramce
            Lokalni w2 = Volej PracovniRegistr(d)
            Pokud (s1 < 0) { Volej Vystup2("    mov %s, qword [rbp + %d]\n", w2, 0 - s1) } Jinak { Volej Vystup2("    mov %s, qword [rbp - %d]\n", w2, s1) }
            Volej UlozCil(d, w2)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 3) { // ulozeni do promenne v ramci
            Lokalni h3 = "r10"
            Pokud (t2 == 1 && Volej JeImm32(s2) == 1) { h3 = Volej TrvalyText1("%lld", s2) } Jinak { h3 = Volej RegistrOperandu(s2, t2, "r10") }
            Pokud (s1 < 0) { Volej Vystup2("    mov qword [rbp + %d], %s\n", 0 - s1, h3) } Jinak { Volej Vystup2("    mov qword [rbp - %d], %s\n", s1, h3) }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 36) { // globalni promenna
            Lokalni w36 = Volej PracovniRegistr(d)
            Volej Vystup2("    mov %s, qword [rel gvar_%s]\n", w36, s1)
            Volej UlozCil(d, w36)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 37) {
            Lokalni h37 = "r10"
            Pokud (t2 == 1 && Volej JeImm32(s2) == 1) { h37 = Volej TrvalyText1("%lld", s2) } Jinak { h37 = Volej RegistrOperandu(s2, t2, "r10") }
            Volej Vystup2("    mov qword [rel gvar_%s], %s\n", s1, h37)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 41) { // adresa lokalniho pole
            Lokalni w41 = Volej PracovniRegistr(d)
            Volej Vystup2("    lea %s, [rbp - %d]\n", w41, s1)
            Volej UlozCil(d, w41)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 44) { // adresa symbolu (text, metoda, C funkce)
            Lokalni w44 = Volej PracovniRegistr(d)
            Pokud (Volej JeExterniJmeno(s1) == 1 && cilova_platforma != 2) {
                Volej Vystup2("    mov %s, [rel %s wrt ..gotpcrel]\n", w44, Volej NazevC_x86(s1))
            } Jinak {
                Volej Vystup2("    lea %s, [rel %s]\n", w44, s1)
            }
            Volej UlozCil(d, w44)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 40 || op == 47) { // [s1 + s2*8] nebo jeho adresa
            Lokalni b40 = Volej RegistrOperandu(s1, t1, "r10")
            Lokalni x40 = Volej RegistrOperandu(s2, t2, "r11")
            // a = &p[i]; [a] = h  ->  mov qword [p + i*8], h (adresa jinde potreba neni)
            Pokud (op == 47 && d > 0 && d < citac_temp_reg) {
                Pokud (CtiZAdresu(ir_pocty_pouziti + (d * 8)) == 1 && CtiZAdresu(ir_pocty_definic + (d * 8)) == 1) {
                    Lokalni j47 = i + 1
                    Lokalni n47 : IR_Instrukce = 0
                    Dokud (j47 < pocet_ir) {
                        n47 = pamet_ir + (j47 * 48)
                        Pokud (n47->opcode != 0) { Ukonci }
                        j47 = j47 + 1
                    }
                    Pokud (j47 < pocet_ir) {
                        Pokud (n47->opcode == 43 && n47->src1_typ == 0 && n47->src1 == d && !(n47->src2_typ == 0 && n47->src2 == d)) {
                            Lokalni h47 = "rax"
                            Pokud (n47->src2_typ == 1 && Volej JeImm32(n47->src2) == 1) { h47 = Volej TrvalyText1("%lld", n47->src2) } Jinak { h47 = Volej RegistrOperandu(n47->src2, n47->src2_typ, "rax") }
                            Volej Vystup3("    mov qword [%s + %s*8], %s\n", b40, x40, h47)
                            i = j47 + 1
                            Pokracuj
                        }
                    }
                }
            }
            Lokalni w40 = Volej PracovniRegistr(d)
            Pokud (op == 40) { Volej Vystup3("    mov %s, qword [%s + %s*8]\n", w40, b40, x40) }
            Jinak { Volej Vystup3("    lea %s, [%s + %s*8]\n", w40, b40, x40) }
            Volej UlozCil(d, w40)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 49) { // [s1 + c]
            Lokalni b49 = Volej RegistrOperandu(s1, t1, "r10")
            Lokalni w49 = Volej PracovniRegistr(d)
            Pokud (s2 == 0) { Volej Vystup2("    mov %s, qword [%s]\n", w49, b49) } Jinak { Volej Vystup3("    mov %s, qword [%s + %lld]\n", w49, b49, s2) }
            Volej UlozCil(d, w49)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 50) { // bajt [s1 + s2]
            Lokalni b50 = Volej RegistrOperandu(s1, t1, "r10")
            Pokud (t2 == 1) { Volej Vystup2("    movzx eax, byte [%s + %lld]\n", b50, s2) }
            Jinak { Volej Vystup2("    movzx eax, byte [%s + %s]\n", b50, Volej RegistrOperandu(s2, t2, "r11")) }
            Volej UlozCil(d, "rax")
            i = i + 1
            Pokracuj
        }
        Pokud (op == 52) { // 32 bitu z [s1] (horni polovina = 0)
            Lokalni b52 = Volej RegistrOperandu(s1, t1, "r10")
            Volej Vystup1("    mov eax, dword [%s]\n", b52)
            Volej UlozCil(d, "rax")
            i = i + 1
            Pokracuj
        }
        Pokud (op == 53) { // 32 bitu do [s1]
            Lokalni a53 = Volej RegistrOperandu(s1, t1, "r10")
            Volej NactiDo("rax", s2, t2)
            Volej Vystup1("    mov dword [%s], eax\n", a53)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 43) { // [s1] = s2
            Lokalni a43 = Volej RegistrOperandu(s1, t1, "r10")
            Lokalni h43 = "r11"
            Pokud (t2 == 1 && Volej JeImm32(s2) == 1) { h43 = Volej TrvalyText1("%lld", s2) } Jinak { h43 = Volej RegistrOperandu(s2, t2, "r11") }
            Volej Vystup2("    mov qword [%s], %s\n", a43, h43)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 51) { // bajt [s1] = s2
            Lokalni a51 = Volej RegistrOperandu(s1, t1, "r10")
            Volej NactiDo("rax", s2, t2)
            Volej Vystup1("    mov byte [%s], al\n", a51)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 28 || op == 29) { // NEG, NOT
            Pokud (op == 28) {
                Lokalni w28 = Volej PracovniRegistr(d)
                Volej NactiDo(w28, s1, t1)
                Volej Vystup1("    neg %s\n", w28)
                Volej UlozCil(d, w28)
            } Jinak {
                Volej VypisCmp(s1, t1, 0, 1)
                Volej Vystup("    sete al\n    movzx eax, al\n")
                Volej UlozCil(d, "rax")
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op >= 12 && op <= 17) { // porovnani -> 0/1
            Volej VypisCmp(s1, t1, s2, t2)
            Volej Vystup1("    %s al\n    movzx eax, al\n", Volej SetPorovnani(op))
            Volej UlozCil(d, "rax")
            i = i + 1
            Pokracuj
        }
        Pokud (op == 7 || op == 27) { // deleni a zbytek
            // typ 5 = konstanta a delenec je urcite nezaporny (rozsah z cyklu)
            deleni_nezaporne = 0
            Pokud (t2 == 5) { deleni_nezaporne = 1; t2 = 1 }
            Pokud (t2 == 1 && Volej JeRychleDeleni(s2) == 1) {
                Lokalni zb = 0
                Pokud (op == 27) { zb = 1 }
                Lokalni xd = "r11"
                Pokud (t1 == 0 && Volej VRegistru(s1) == 1) { xd = Volej Umisteni(s1) }
                Pokud (Volej strcmp(xd, "rax") == 0 || Volej strcmp(xd, "rdx") == 0) { xd = "r11" }
                Pokud (Volej strcmp(xd, "r11") == 0) { Volej NactiDo("r11", s1, t1) }
                Volej DeleniKonstantou(s2, zb, d, xd)
            } Jinak {
                Volej NactiDo("rax", s1, t1)
                Lokalni dv = "r11"
                Pokud (t2 == 1) { Volej Vystup1("    mov r11, %lld\n", s2) } Jinak { dv = Volej Umisteni(s2) }
                Volej Vystup1("    cqo\n    idiv %s\n", dv)
                Pokud (op == 7) { Volej UlozCil(d, "rax") } Jinak { Volej UlozCil(d, "rdx") }
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 21 || op == 22) { // posuny
            Lokalni w21 = Volej PracovniRegistr(d)
            Volej NactiDo(w21, s1, t1)
            Lokalni ins = "shl"
            Pokud (op == 22) { ins = "sar" }
            Pokud (t2 == 1) { Volej Vystup3("    %s %s, %lld\n", ins, w21, s2 & 63) }
            Jinak {
                Volej NactiDo("rcx", s2, t2)
                Volej Vystup2("    %s %s, cl\n", ins, w21)
            }
            Volej UlozCil(d, w21)
            i = i + 1
            Pokracuj
        }
        Pokud ((op >= 4 && op <= 6) || (op >= 18 && op <= 20)) { // + - * & | ^
            Lokalni w4 = Volej PracovniRegistr(d)
            Pokud (op == 4 && t1 == 0 && Volej VRegistru(s1) == 1 && t2 == 1 && Volej JeImm32(s2) == 1) {
                Volej Vystup3("    lea %s, [%s + %lld]\n", w4, Volej Umisteni(s1), s2)
            } Jinak Pokud (op == 5 && t1 == 0 && Volej VRegistru(s1) == 1 && t2 == 1 && Volej JeImm32(s2) == 1 && Volej strcmp(w4, Volej Umisteni(s1)) != 0) {
                // d = s1 - c  ->  lea d, [s1 - c] (jedna instrukce misto mov + sub)
                Volej Vystup3("    lea %s, [%s - %lld]\n", w4, Volej Umisteni(s1), s2)
            } Jinak Pokud (op == 4 && t1 == 0 && t2 == 0 && Volej VRegistru(s1) == 1 && Volej VRegistru(s2) == 1) {
                Volej Vystup3("    lea %s, [%s + %s]\n", w4, Volej Umisteni(s1), Volej Umisteni(s2))
            } Jinak Pokud (op == 6 && t2 == 1 && Volej JeImm32(s2) == 1) {
                Volej Vystup3("    imul %s, %s, %lld\n", w4, Volej RegistrOperandu(s1, t1, "r11"), s2)
            } Jinak {
                Volej NactiDo(w4, s1, t1)
                Lokalni b4 = Volej DruhyOperand(s2, t2)
                Lokalni ins4 = "add"
                Pokud (op == 5) { ins4 = "sub" }
                Pokud (op == 6) { ins4 = "imul" }
                Pokud (op == 18) { ins4 = "and" }
                Pokud (op == 19) { ins4 = "or" }
                Pokud (op == 20) { ins4 = "xor" }
                Pokud (op == 6 && Volej VRegistru(d) == 0 && t2 == 0 && Volej VRegistru(s2) == 0) {
                    // imul neumi pamet jako cil i zdroj soucasne -> pres registr
                    Volej NactiDo("r11", s2, t2)
                    b4 = "r11"
                }
                Volej Vystup3("    %s %s, %s\n", ins4, w4, b4)
            }
            Volej UlozCil(d, w4)
            i = i + 1
            Pokracuj
        }
        Volej printf("Interni chyba: neznama IR instrukce %d\n", op)
        Volej exit(1)
    }
    Vrat 0
}

// ==========================================
// Optimalizujici backend ARM64: preklad IR -> assembler GNU as (AArch64)
//   Stejne IR, CFG, liveness, useky zivota a Linear Scan jako x86-64.
//   Registry: x9-x15 (volany je nemusi zachovat), x19-x28 (musi), x16/x17/x8 jako pomocne.
//   Ramec: x29 = ramec, lokalni pole a odlozene hodnoty na [x29 - posun],
//   ulozene registry x19-x28 pod nimi. Listova metoda bez ramce nema prolog vubec.
//   Metodu, ktera obsahuje neco, co tento backend neumi (desetinna cisla, spojovani textu,
//   Asm, slozita volani), prelozi puvodni jednoduchy generator. Obe casti maji stejnou
//   volaci konvenci: x0-x7 argumenty, x0 vysledek, domovskou oblast si vyhradi volany.
// ==========================================
Globalni arm_ir = 1            // 0 = --bez-arm-ir (jen jednoduchy generator)
Globalni a_xn = 0              // jmena registru x0..x31 (x31 = xzr)
Globalni a_wn = 0
Globalni a_ramec = 0           // velikost oblasti pod x29 (lokalni + odlozene + ulozene registry)
Globalni a_ma_ramec = 0
Globalni a_ulozene = 0         // pocet ulozenych callee-saved registru
Globalni a_argumentu = 0       // pocet ARG pred volanim (podle pozice)
Globalni a_druh_arg = 0        // pro pozici: 23 = cele cislo (x), 74 = desetinne (d)
Globalni a_reg_arg = 0         // pro pozici: cislo registru

Metoda PripravJmenaA() {
    Pokud (a_xn != 0) { Vrat 0 }
    a_druh_arg = Volej calloc(32, 8)
    a_reg_arg = Volej calloc(32, 8)
    a_xn = Volej calloc(32, 8)
    a_wn = Volej calloc(32, 8)
    Lokalni k = 0
    Dokud (k < 31) {
        Volej ZapisUkazatel(a_xn + (k * 8), Volej TrvalyText1("x%d", k))
        Volej ZapisUkazatel(a_wn + (k * 8), Volej TrvalyText1("w%d", k))
        k = k + 1
    }
    Volej ZapisUkazatel(a_xn + (31 * 8), "xzr")
    Volej ZapisUkazatel(a_wn + (31 * 8), "wzr")
    Vrat 0
}
Metoda XA(k) { Vrat CtiZAdresu(a_xn + (k * 8)) }
Metoda WA(k) { Vrat CtiZAdresu(a_wn + (k * 8)) }

// Kod fyzickeho registru vregu, nebo -1 (odlozen do pameti)
Metoda RegVregA(v) {
    Lokalni iv : LiveInterval = pamet_intervalu + ((v - 1) * 32)
    Pokud (iv->fyzicky_reg > 1) { Vrat iv->fyzicky_reg }
    Vrat 0 - 1
}
Metoda PosunVregA(v) {
    Lokalni iv : LiveInterval = pamet_intervalu + ((v - 1) * 32)
    Vrat 0 - iv->fyzicky_reg
}

// Konstanta do registru (mov / movz + movk)
Metoda CisloA(k, c) {
    Pokud (c >= 0 && c < 65536) { Volej Vystup2("    mov %s, #%lld\n", Volej XA(k), c); Vrat 0 }
    Pokud (c < 0 && c > 0 - 65536) { Volej Vystup2("    mov %s, #%lld\n", Volej XA(k), c); Vrat 0 }
    Volej Vystup2("    movz %s, #%lld\n", Volej XA(k), c & 65535)
    Lokalni sh = 16
    Dokud (sh < 64) {
        Lokalni kus = (c >> sh) & 65535
        Pokud (kus != 0) { Volej Vystup3("    movk %s, #%lld, lsl #%d\n", Volej XA(k), kus, sh) }
        sh = sh + 16
    }
    Vrat 0
}

// Pristup do ramce [x29 - posun] (posun > 0) nebo [x29 + -posun]
Metoda RamecA(instr, k, posun) {
    Pokud (posun > 0 && posun < 256) { Volej Vystup3("    %s %s, [x29, #-%d]\n", instr, Volej XA(k), posun); Vrat 0 }
    Pokud (posun <= 0 && posun > 0 - 4096) { Volej Vystup3("    %s %s, [x29, #%d]\n", instr, Volej XA(k), 0 - posun); Vrat 0 }
    Volej CisloA(8, posun)
    Volej Vystup1("    sub x8, x29, x8\n", 0)
    Volej Vystup2("    %s %s, [x8]\n", instr, Volej XA(k))
    Vrat 0
}

// Hodnota operandu v registru: vrati kod registru (pripadne nacte do pomocneho)
Metoda OpA(s, t, pomocny) {
    Pokud (t == 1) {
        Volej CisloA(pomocny, s)
        Vrat pomocny
    }
    Lokalni r = Volej RegVregA(s)
    Pokud (r >= 32) { // desetinna hodnota v registru d -> do pomocneho x
        Volej Vystup2("    fmov %s, %s\n", Volej XA(pomocny), Volej DA(r))
        Vrat pomocny
    }
    Pokud (r >= 0) { Vrat r }
    Lokalni ld = "ldr"
    Pokud (Volej PosunVregA(s) < 256) { ld = "ldur" }
    Volej RamecA(ld, pomocny, Volej PosunVregA(s))
    Vrat pomocny
}
// Registry d (desetinna cisla): kod 32+k je d(18+k)
Metoda DA(kod) { Vrat Volej TrvalyText1("d%d", kod - 32 + 18) }
Metoda JeDA(v) {
    Pokud (Volej RegVregA(v) >= 32) { Vrat 1 }
    Vrat 0
}
// Hodnota operandu v registru d (nacte do pomocneho, kdyz v nem neni)
Metoda DOpA(s, t, pomocny) {
    Pokud (t == 0) { Pokud (Volej JeDA(s) == 1) { Vrat Volej DA(Volej RegVregA(s)) } }
    Pokud (t == 1 && s == 0) { Volej Vystup1("    fmov %s, xzr\n", pomocny); Vrat pomocny }
    Lokalni r = Volej OpA(s, t, 16)
    Volej Vystup2("    fmov %s, %s\n", pomocny, Volej XA(r))
    Vrat pomocny
}

Metoda NactiDoA(k, s, t) {
    Pokud (t == 0) { Pokud (Volej JeDA(s) == 1) { Volej Vystup2("    fmov %s, %s\n", Volej XA(k), Volej DA(Volej RegVregA(s))); Vrat 0 } }
    Pokud (t == 1) { Volej CisloA(k, s); Vrat 0 }
    Lokalni r = Volej OpA(s, t, k)
    Pokud (r != k) { Volej Vystup2("    mov %s, %s\n", Volej XA(k), Volej XA(r)) }
    Vrat 0
}
// Registr pro vysledek: primo cil, nebo pomocny (kdyz je cil v pameti)
Metoda CilA(d, pomocny) {
    Lokalni r = Volej RegVregA(d)
    Pokud (r >= 0) { Vrat r }
    Vrat pomocny
}
Metoda UlozA(d, k) {
    Pokud (Volej RegVregA(d) >= 0) { Vrat 0 }
    Lokalni st = "str"
    Pokud (Volej PosunVregA(d) < 256) { st = "stur" }
    Volej RamecA(st, k, Volej PosunVregA(d))
    Vrat 0
}

Metoda AdresaSymboluA(k, jmeno) {
    Pokud (cilova_platforma == 4) {
        Volej Vystup3("    adrp %s, %s@PAGE\n    add %s, ", Volej XA(k), jmeno, Volej XA(k))
        Volej Vystup2("%s, %s@PAGEOFF\n", Volej XA(k), jmeno)
    } Jinak {
        Volej Vystup3("    adrp %s, %s\n    add %s, ", Volej XA(k), jmeno, Volej XA(k))
        Volej Vystup2("%s, :lo12:%s\n", Volej XA(k), jmeno)
    }
    Vrat 0
}

Metoda PodminkaA(op) {
    Pokud (op == 12) { Vrat "eq" }
    Pokud (op == 13) { Vrat "ne" }
    Pokud (op == 14) { Vrat "lt" }
    Pokud (op == 15) { Vrat "gt" }
    Pokud (op == 16) { Vrat "le" }
    Vrat "ge"
}
// Skok pri NEPLATNOSTI porovnani 30..35 (== != < > <= >=)
Metoda SkokNeplatiA(op) {
    Pokud (op == 30) { Vrat "ne" }
    Pokud (op == 31) { Vrat "eq" }
    Pokud (op == 32) { Vrat "ge" }
    Pokud (op == 33) { Vrat "le" }
    Pokud (op == 34) { Vrat "gt" }
    Vrat "lt"
}

Metoda CmpA(s1, t1, s2, t2) {
    Lokalni a = Volej OpA(s1, t1, 16)
    Pokud (t2 == 1 && s2 >= 0 && s2 < 4096) { Volej Vystup2("    cmp %s, #%lld\n", Volej XA(a), s2); Vrat 0 }
    Pokud (t2 == 1 && s2 < 0 && s2 > 0 - 4096) { Volej Vystup2("    cmn %s, #%lld\n", Volej XA(a), 0 - s2); Vrat 0 }
    Lokalni b = Volej OpA(s2, t2, 17)
    Volej Vystup2("    cmp %s, %s\n", Volej XA(a), Volej XA(b))
    Vrat 0
}

// Je jmeno funkce jazyka C (deklarovana Externi, nebo funkce knihovny, kterou vola Vypis/Alokuj)?
Metoda JeCFunkceA(jmeno) {
    Pokud (Volej JeExterniJmeno(jmeno) == 1) { Vrat 1 }
    Lokalni sym : Symbol = Volej NajdiSymbol(jmeno)
    Pokud (sym == 0) { Vrat 1 }
    Pokud (sym->is_function == 0) { Vrat 1 }
    Vrat 0
}

// Umi ARM64 backend celou metodu? (vse v IR, nic surove pro x86)
Metoda LzeARM(m : AST_Node) {
    Pokud (m->arg_count > 8) { Vrat 0 }
    // Asm pro ARM ("arm:...") zna jen jednoduchy generator; x86 cast IR ho preskakuje
    Pokud (ir_metoda_ma_asm == 1) { Vrat 0 }
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op = inst->opcode
        Pokud (op == 99 || op == 38 || op == 9) {
            Pokud (podrobny_vypis == 1 && op == 99) { Volej printf(">> ARM64: IR neumi: %s", inst->src1) }
            Vrat 0
        }
        Pokud (op == 44) { Pokud (Volej JeExterniJmeno(inst->src1) == 1) { Vrat 0 } }
        Pokud (op == 24 && Volej JeJadro() == 1) { Pokud (Volej JeCFunkceA(inst->src1) == 1) { Vrat 0 } }
        i = i + 1
    }
    Vrat 1
}

// Chyba za behu (chybova vetev za koncem metody)
Metoda ChybaBehuA(radek, zprava) {
    Pokud (Volej JeJadro() == 1) { Volej Vystup("    b .\n"); Vrat 0 }
    Lokalni id = Volej PridejChybovouZpravu(radek, zprava)
    Lokalni jm = Volej TrvalyText1("err_msg%d", id)
    Volej AdresaSymboluA(0, jm)
    Volej Vystup1("    bl %s\n", Volej NazevC_ARM("puts"))
    Volej Vystup1("    mov x0, #1\n    bl %s\n", Volej NazevC_ARM("exit"))
    Vrat 0
}

Metoda UlozRegistryA(instr) {
    // ulozene registry lezi na [sp + 8k] (sp = x29 - a_ramec)
    Lokalni k = 0
    Lokalni r = 19
    Lokalni predchozi = 0 - 1
    Dokud (r <= 28) {
        Pokud (((ir_pouzite_reg >> r) & 1) == 1) {
            Pokud (predchozi >= 0) {
                Pokud (Volej strcmp(instr, "str") == 0) { Volej Vystup3("    stp %s, %s, [sp, #%d]\n", Volej XA(predchozi), Volej XA(r), (k - 1) * 8) }
                Jinak { Volej Vystup3("    ldp %s, %s, [sp, #%d]\n", Volej XA(predchozi), Volej XA(r), (k - 1) * 8) }
                predchozi = 0 - 1
            } Jinak {
                predchozi = r
            }
            k = k + 1
        }
        r = r + 1
    }
    Pokud (predchozi >= 0) { Volej Vystup3("    %s %s, [sp, #%d]\n", instr, Volej XA(predchozi), (k - 1) * 8) }
    Vrat 0
}

Metoda PrelozIRDoARM(out) {
    ir_out = out
    Volej PripravJmenaA()
    Volej SpocitejDefinice()
    Lokalni m : AST_Node = ir_metoda
    Volej Vystup1("%s:\n", m->name)
    // Potrebuje metoda ramec? (vola nekoho, ma odlozene hodnoty / pole, uklada registry)
    ir_vola = 0
    a_ulozene = 0
    Lokalni r0 = 19
    Dokud (r0 <= 28) {
        Pokud (((ir_pouzite_reg >> r0) & 1) == 1) { a_ulozene = a_ulozene + 1 }
        r0 = r0 + 1
    }
    Lokalni i0 = 0
    Lokalni ma_pamet = 0
    Dokud (i0 < pocet_ir) {
        Lokalni ii0 : IR_Instrukce = pamet_ir + (i0 * 48)
        Pokud (ii0->opcode == 24) { ir_vola = 1 }
        Pokud (ii0->opcode == 2 || ii0->opcode == 3 || ii0->opcode == 41 || ii0->opcode == 55) { ma_pamet = 1 }
        i0 = i0 + 1
    }
    a_ma_ramec = 0
    Pokud (ir_vola == 1 || ramec_celkem > 0 || a_ulozene > 0 || ma_pamet == 1) { a_ma_ramec = 1 }
    Pokud (ma_pamet == 1 && ramec_celkem < ramec_lokalnich) { ramec_celkem = ((ramec_lokalnich + 15) / 16) * 16 }
    a_ramec = ((ramec_celkem + (a_ulozene * 8) + 15) / 16) * 16
    a_argumentu = 0
    Lokalni i = 0
    Dokud (i < pocet_ir) {
        Lokalni inst : IR_Instrukce = pamet_ir + (i * 48)
        Lokalni op = inst->opcode
        Lokalni d = inst->dest
        Lokalni s1 = inst->src1
        Lokalni t1 = inst->src1_typ
        Lokalni s2 = inst->src2
        Lokalni t2 = inst->src2_typ
        Pokud (op == 0) { i = i + 1; Pokracuj }
        Pokud (op == 98) { // prolog
            Pokud (a_ma_ramec == 1) {
                Lokalni rva : AST_Node = Volej RychlyVstup()
                Pokud (rva != 0) { Volej EmitujRychlyVstupARM(rva) }
                Volej Vystup("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n")
                Pokud (a_ramec > 0 && a_ramec < 4096) { Volej Vystup1("    sub sp, sp, #%d\n", a_ramec) }
                Pokud (a_ramec >= 4096) { Volej CisloA(16, a_ramec); Volej Vystup("    sub sp, sp, x16\n") }
                Volej UlozRegistryA("str")
                Pokud (kontroly == 1 && Volej JeJadro() == 0 && ir_vola == 1) {
                    Volej AdresaSymboluA(16, "pramen_mez_zasobniku")
                    Volej Vystup("    ldr x16, [x16]\n    mov x17, sp\n    cmp x17, x16\n    b.lo pramen_preteceni_zasobniku\n")
                }
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 97) { // epilog
            Pokud (a_ma_ramec == 1) {
                Volej UlozRegistryA("ldr")
                Volej Vystup("    mov sp, x29\n    ldp x29, x30, [sp], #16\n")
            }
            Volej Vystup("    ret\n")
            i = i + 1
            Pokracuj
        }
        Pokud (op == 11) {
            Pokud (Volej ZarovnatNavesti(i, d) == 1) { Volej Vystup("    .p2align 4\n") }
            Volej Vystup1(".L_label_%d:\n", d)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 10) {
            Pokud (Volej DalsiJeNavesti(i, d) == 0) { Volej Vystup1("    b .L_label_%d\n", d) }
            i = i + 1
            Pokracuj
        }
        Pokud (op >= 30 && op <= 35) {
            Pokud (t2 == 1 && s2 == 0 && (op == 30 || op == 31)) {
                Lokalni a30 = Volej OpA(s1, t1, 16)
                Pokud (op == 31) { Volej Vystup2("    cbz %s, .L_label_%d\n", Volej XA(a30), d) }
                Jinak { Volej Vystup2("    cbnz %s, .L_label_%d\n", Volej XA(a30), d) }
            } Jinak {
                Volej CmpA(s1, t1, s2, t2)
                Volej Vystup2("    b.%s .L_label_%d\n", Volej SkokNeplatiA(op), d)
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 54) { // kontrola mezi (bez znamenka)
            Volej CmpA(s1, t1, s2, t2)
            Volej Vystup1("    b.hs .L_label_%d\n", d)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 23 || op == 74) { // argument (74 = desetinny do d registru)
            Lokalni poz = d
            Pokud (t2 == 1) { poz = d + s2 }
            Pokud (op == 23) { Volej NactiDoA(d, s1, t1) } Jinak {
                Lokalni a74 = Volej DOpA(s1, t1, "d16")
                Volej Vystup2("    fmov d%d, %s\n", d, a74)
            }
            Volej ZapisUkazatel(a_druh_arg + (poz * 8), op)
            Volej ZapisUkazatel(a_reg_arg + (poz * 8), d)
            Pokud (poz + 1 > a_argumentu) { a_argumentu = poz + 1 }
            i = i + 1
            Pokracuj
        }
        // --- desetinna cisla primo v registrech d18-d31 ---
        Pokud (op >= 60 && op <= 63 && Volej JeDA(d) == 1) {
            Lokalni a60d = Volej DOpA(s1, t1, "d16")
            Lokalni b60d = Volej DOpA(s2, t2, "d17")
            Lokalni ins60d = "fadd"
            Pokud (op == 61) { ins60d = "fsub" }
            Pokud (op == 62) { ins60d = "fmul" }
            Pokud (op == 63) { ins60d = "fdiv" }
            Volej Vystup3("    %s %s, %s, ", ins60d, Volej DA(Volej RegVregA(d)), a60d)
            Volej Vystup1("%s\n", b60d)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 64 && Volej JeDA(d) == 1) {
            Lokalni a64d = Volej OpA(s1, t1, 16)
            Volej Vystup2("    scvtf %s, %s\n", Volej DA(Volej RegVregA(d)), Volej XA(a64d))
            i = i + 1
            Pokracuj
        }
        Pokud (op == 72 && Volej JeDA(d) == 1) {
            Pokud (cilova_platforma == 4) {
                Volej Vystup2("    adrp x8, %s@PAGE\n    ldr %s, ", s1, Volej DA(Volej RegVregA(d)))
                Volej Vystup1("[x8, %s@PAGEOFF]\n", s1)
            } Jinak {
                Volej Vystup2("    adrp x8, %s\n    ldr %s, ", s1, Volej DA(Volej RegVregA(d)))
                Volej Vystup1("[x8, :lo12:%s]\n", s1)
            }
            i = i + 1
            Pokracuj
        }
        Pokud ((op == 26 || op == 1) && Volej JeDA(d) == 1) {
            Lokalni src26 = Volej DOpA(s1, t1, "d16")
            Pokud (Volej strcmp(src26, Volej DA(Volej RegVregA(d))) != 0) { Volej Vystup2("    fmov %s, %s\n", Volej DA(Volej RegVregA(d)), src26) }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 26 && t1 == 0) {
            Pokud (Volej JeDA(s1) == 1) { // z registru d do obycejneho
                Lokalni w26d = Volej CilA(d, 16)
                Volej Vystup2("    fmov %s, %s\n", Volej XA(w26d), Volej DA(Volej RegVregA(s1)))
                Volej UlozA(d, w26d)
                i = i + 1
                Pokracuj
            }
        }
        Pokud (op >= 60 && op <= 63) { // + - * / desetinnych cisel
            Lokalni a60 = Volej OpA(s1, t1, 16)
            Volej Vystup1("    fmov d16, %s\n", Volej XA(a60))
            Lokalni b60 = Volej OpA(s2, t2, 17)
            Volej Vystup1("    fmov d17, %s\n", Volej XA(b60))
            Lokalni ins60 = "fadd"
            Pokud (op == 61) { ins60 = "fsub" }
            Pokud (op == 62) { ins60 = "fmul" }
            Pokud (op == 63) { ins60 = "fdiv" }
            Volej Vystup1("    %s d16, d16, d17\n", ins60)
            Lokalni w60 = Volej CilA(d, 16)
            Volej Vystup1("    fmov %s, d16\n", Volej XA(w60))
            Volej UlozA(d, w60)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 64) {
            Lokalni a64 = Volej OpA(s1, t1, 16)
            Volej Vystup1("    scvtf d16, %s\n", Volej XA(a64))
            Lokalni w64 = Volej CilA(d, 16)
            Volej Vystup1("    fmov %s, d16\n", Volej XA(w64))
            Volej UlozA(d, w64)
            i = i + 1
            Pokracuj
        }
        Pokud (op >= 66 && op <= 71) { // porovnani; pri NaN plati jen !=
            Lokalni a66 = Volej OpA(s1, t1, 16)
            Volej Vystup1("    fmov d16, %s\n", Volej XA(a66))
            Lokalni b66 = Volej OpA(s2, t2, 17)
            Volej Vystup1("    fmov d17, %s\n    fcmp d16, d17\n", Volej XA(b66))
            Lokalni c66 = "eq"
            Pokud (op == 67) { c66 = "ne" }
            Pokud (op == 68) { c66 = "mi" }
            Pokud (op == 69) { c66 = "gt" }
            Pokud (op == 70) { c66 = "ls" }
            Pokud (op == 71) { c66 = "ge" }
            Lokalni w66 = Volej CilA(d, 16)
            Volej Vystup2("    cset %s, %s\n", Volej XA(w66), c66)
            Volej UlozA(d, w66)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 72) {
            Lokalni w72 = Volej CilA(d, 16)
            Pokud (cilova_platforma == 4) {
                Volej Vystup2("    adrp x8, %s@PAGE\n    ldr %s, ", s1, Volej XA(w72))
                Volej Vystup1("[x8, %s@PAGEOFF]\n", s1)
            } Jinak {
                Volej Vystup2("    adrp x8, %s\n    ldr %s, ", s1, Volej XA(w72))
                Volej Vystup1("[x8, :lo12:%s]\n", s1)
            }
            Volej UlozA(d, w72)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 25) { Volej NactiDoA(0, s1, t1); i = i + 1; Pokracuj }
        Pokud (op == 39) {
            Lokalni w39 = Volej CilA(d, 16)
            Pokud (w39 != s1) { Volej Vystup2("    mov %s, %s\n", Volej XA(w39), Volej XA(s1)) }
            Volej UlozA(d, w39)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 24) { // volani
            Lokalni je_c = Volej JeCFunkceA(s1)
            Lokalni oblast = 0
            Pokud (je_c == 1 && cilova_platforma == 4) {
                // macOS: variadicke argumenty C funkce jdou na zasobnik
                Lokalni pevne = Volej PevneArgumenty(s1)
                Pokud (pevne >= 0 && a_argumentu > pevne) {
                    oblast = (((a_argumentu - pevne) * 8) + 15) / 16 * 16
                    Volej Vystup1("    sub sp, sp, #%d\n", oblast)
                    Lokalni va = pevne
                    Dokud (va < a_argumentu) {
                        Lokalni rr = CtiZAdresu(a_reg_arg + (va * 8))
                        Pokud (CtiZAdresu(a_druh_arg + (va * 8)) == 74) { Volej Vystup2("    str d%d, [sp, #%d]\n", rr, (va - pevne) * 8) }
                        Jinak { Volej Vystup2("    str %s, [sp, #%d]\n", Volej XA(rr), (va - pevne) * 8) }
                        va = va + 1
                    }
                }
            }
            Pokud (je_c == 1) { Volej Vystup1("    bl %s\n", Volej NazevC_ARM(s1)) } Jinak { Volej Vystup1("    bl %s\n", s1) }
            Pokud (oblast > 0) { Volej Vystup1("    add sp, sp, #%d\n", oblast) }
            a_argumentu = 0
            Pokud (d > 0 && d < citac_temp_reg) {
                Pokud (CtiZAdresu(ir_pocty_pouziti + (d * 8)) > 0) {
                    Lokalni w24 = Volej CilA(d, 16)
                    Pokud (je_c == 1 && Volej VraciCInt(s1) == 1) { Volej Vystup2("    sxtw %s, w0\n", Volej XA(w24), 0) }
                    Jinak Pokud (Volej JeFloatExtern(s1) == 1) { Volej Vystup2("    fmov %s, d0\n", Volej XA(w24), 0) }
                    Jinak Pokud (w24 != 0) { Volej Vystup2("    mov %s, x0\n", Volej XA(w24), 0) }
                    Volej UlozA(d, w24)
                }
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 1 || op == 26) {
            Lokalni w1 = Volej CilA(d, 16)
            Pokud (t1 == 1) { Volej CisloA(w1, s1) } Jinak {
                Lokalni a1 = Volej OpA(s1, t1, w1)
                Pokud (a1 != w1) { Volej Vystup2("    mov %s, %s\n", Volej XA(w1), Volej XA(a1)) }
            }
            Volej UlozA(d, w1)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 2) {
            Lokalni w2 = Volej CilA(d, 16)
            Volej RamecA("ldr", w2, s1)
            Volej UlozA(d, w2)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 3) {
            Lokalni h3 = Volej OpA(s2, t2, 17)
            Volej RamecA("str", h3, s1)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 36 || op == 37) { // globalni promenna
            Lokalni gj = Volej TrvalyText1("gvar_%s", s1)
            Pokud (op == 36) {
                Volej AdresaSymboluA(8, gj)
                Lokalni w36 = Volej CilA(d, 16)
                Volej Vystup1("    ldr %s, [x8]\n", Volej XA(w36))
                Volej UlozA(d, w36)
            } Jinak {
                Lokalni h37 = Volej OpA(s2, t2, 17)
                Volej AdresaSymboluA(8, gj)
                Volej Vystup1("    str %s, [x8]\n", Volej XA(h37))
            }
            i = i + 1
            Pokracuj
        }
        Pokud (op == 41) {
            Lokalni w41 = Volej CilA(d, 16)
            Pokud (s1 < 4096) { Volej Vystup2("    sub %s, x29, #%d\n", Volej XA(w41), s1) } Jinak {
                Volej CisloA(17, s1)
                Volej Vystup1("    sub %s, x29, x17\n", Volej XA(w41))
            }
            Volej UlozA(d, w41)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 44) {
            Lokalni w44 = Volej CilA(d, 16)
            Volej AdresaSymboluA(w44, s1)
            Volej UlozA(d, w44)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 55) { // vynulovani lokalniho pole: d = posun, s1 = pocet prvku
            Pokud (d < 4096) { Volej Vystup1("    sub x8, x29, #%d\n", d) } Jinak { Volej CisloA(8, d); Volej Vystup("    sub x8, x29, x8\n") }
            Volej CisloA(16, s1)
            Lokalni nn = Volej NoveNavesti()
            Volej Vystup1(".L_nul_%d:\n    str xzr, [x8], #8\n    subs x16, x16, #1\n", nn)
            Volej Vystup1("    b.ne .L_nul_%d\n", nn)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 58) { Volej Vystup("    dmb sy\n"); i = i + 1; Pokracuj }
        Pokud (op == 40 || op == 47) { // [s1 + s2*8] nebo jeho adresa
            Lokalni b40 = Volej OpA(s1, t1, 16)
            Lokalni x40 = Volej OpA(s2, t2, 17)
            // a = &p[i]; [a] = h  ->  str h, [p, i, lsl #3]
            Pokud (op == 47 && d > 0 && d < citac_temp_reg) {
                Pokud (CtiZAdresu(ir_pocty_pouziti + (d * 8)) == 1 && CtiZAdresu(ir_pocty_definic + (d * 8)) == 1) {
                    Lokalni j47 = i + 1
                    Lokalni n47 : IR_Instrukce = 0
                    Dokud (j47 < pocet_ir) {
                        n47 = pamet_ir + (j47 * 48)
                        Pokud (n47->opcode != 0) { Ukonci }
                        j47 = j47 + 1
                    }
                    Pokud (j47 < pocet_ir) {
                        Pokud (n47->opcode == 43 && n47->src1_typ == 0 && n47->src1 == d && !(n47->src2_typ == 0 && n47->src2 == d)) {
                            Lokalni h47 = Volej OpA(n47->src2, n47->src2_typ, 8)
                            Volej Vystup3("    str %s, [%s, %s, lsl #3]\n", Volej XA(h47), Volej XA(b40), Volej XA(x40))
                            i = j47 + 1
                            Pokracuj
                        }
                    }
                }
            }
            Lokalni w40 = Volej CilA(d, 16)
            Pokud (op == 40) { Volej Vystup3("    ldr %s, [%s, %s, lsl #3]\n", Volej XA(w40), Volej XA(b40), Volej XA(x40)) }
            Jinak { Volej Vystup3("    add %s, %s, %s, lsl #3\n", Volej XA(w40), Volej XA(b40), Volej XA(x40)) }
            Volej UlozA(d, w40)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 49) { // [s1 + c]
            Lokalni b49 = Volej OpA(s1, t1, 16)
            Lokalni w49 = Volej CilA(d, 16)
            Pokud (s2 >= 0 && s2 < 32760 && (s2 & 7) == 0) { Volej Vystup3("    ldr %s, [%s, #%lld]\n", Volej XA(w49), Volej XA(b49), s2) }
            Jinak Pokud (s2 >= 0 - 256 && s2 < 256) { Volej Vystup3("    ldur %s, [%s, #%lld]\n", Volej XA(w49), Volej XA(b49), s2) }
            Jinak {
                Volej CisloA(17, s2)
                Volej Vystup3("    ldr %s, [%s, %s]\n", Volej XA(w49), Volej XA(b49), "x17")
            }
            Volej UlozA(d, w49)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 50) { // bajt [s1 + s2]
            Lokalni b50 = Volej OpA(s1, t1, 16)
            Lokalni w50 = Volej CilA(d, 16)
            Pokud (t2 == 1 && s2 >= 0 && s2 < 4096) { Volej Vystup3("    ldrb %s, [%s, #%lld]\n", Volej WA(w50), Volej XA(b50), s2) }
            Jinak {
                Lokalni x50 = Volej OpA(s2, t2, 17)
                Volej Vystup3("    ldrb %s, [%s, %s]\n", Volej WA(w50), Volej XA(b50), Volej XA(x50))
            }
            Volej UlozA(d, w50)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 52) { // 32 bitu
            Lokalni b52 = Volej OpA(s1, t1, 16)
            Lokalni w52 = Volej CilA(d, 16)
            Volej Vystup2("    ldr %s, [%s]\n", Volej WA(w52), Volej XA(b52))
            Volej UlozA(d, w52)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 43 || op == 51 || op == 53) { // [s1] = s2 (8 / 1 / 4 bajty)
            Lokalni a43 = Volej OpA(s1, t1, 16)
            Lokalni h43 = Volej OpA(s2, t2, 17)
            Pokud (op == 43) { Volej Vystup2("    str %s, [%s]\n", Volej XA(h43), Volej XA(a43)) }
            Pokud (op == 51) { Volej Vystup2("    strb %s, [%s]\n", Volej WA(h43), Volej XA(a43)) }
            Pokud (op == 53) { Volej Vystup2("    str %s, [%s]\n", Volej WA(h43), Volej XA(a43)) }
            i = i + 1
            Pokracuj
        }
        Pokud (op >= 12 && op <= 17) {
            Volej CmpA(s1, t1, s2, t2)
            Lokalni w12 = Volej CilA(d, 16)
            Volej Vystup2("    cset %s, %s\n", Volej XA(w12), Volej PodminkaA(op))
            Volej UlozA(d, w12)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 28 || op == 29) {
            Lokalni a28 = Volej OpA(s1, t1, 16)
            Lokalni w28 = Volej CilA(d, 16)
            Pokud (op == 28) { Volej Vystup2("    neg %s, %s\n", Volej XA(w28), Volej XA(a28)) }
            Jinak { Volej Vystup2("    cmp %s, #0\n    cset %s, eq\n", Volej XA(a28), Volej XA(w28)) }
            Volej UlozA(d, w28)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 7 || op == 27) { // deleni a zbytek
            Lokalni w7 = Volej CilA(d, 16)
            Lokalni nez7 = 0
            Pokud (t2 == 5) { nez7 = 1; t2 = 1 }
            Pokud (t2 == 1 && Volej JeRychleDeleni(s2) == 1) {
                Lokalni x7 = Volej OpA(s1, t1, 16)
                Lokalni k7 = Volej LogDvou(s2)
                Pokud (k7 > 0 && nez7 == 1) { // nezaporny delenec: posun / maska
                    Pokud (op == 7) { Volej Vystup3("    lsr %s, %s, #%d\n", Volej XA(w7), Volej XA(x7), k7) }
                    Jinak { Volej Vystup3("    and %s, %s, #%lld\n", Volej XA(w7), Volej XA(x7), s2 - 1) }
                    Volej UlozA(d, w7)
                    i = i + 1
                    Pokracuj
                }
                Pokud (k7 > 0) {
                    Volej Vystup2("    asr x8, %s, #63\n    add x8, %s, ", Volej XA(x7), Volej XA(x7))
                    Volej Vystup2("x8, lsr #%d\n    asr x8, x8, #%d\n", 64 - k7, k7)
                } Jinak {
                    Lokalni m7 = Volej MagickeCislo(s2)
                    Volej CisloA(17, m7)
                    Volej Vystup1("    smulh x8, %s, x17\n", Volej XA(x7))
                    Pokud (m7 < 0) { Volej Vystup1("    add x8, x8, %s\n", Volej XA(x7)) }
                    Pokud (magie_posun > 0) { Volej Vystup1("    asr x8, x8, #%d\n", magie_posun) }
                    Pokud (nez7 == 0) { Volej Vystup1("    add x8, x8, %s, lsr #63\n", Volej XA(x7)) }
                }
                Pokud (op == 7) { Volej Vystup1("    mov %s, x8\n", Volej XA(w7)) }
                Jinak {
                    Volej CisloA(17, s2)
                    Volej Vystup2("    msub %s, x8, x17, %s\n", Volej XA(w7), Volej XA(x7))
                }
            } Jinak {
                Lokalni a7 = Volej OpA(s1, t1, 16)
                Lokalni b7 = Volej OpA(s2, t2, 17)
                Pokud (op == 7) { Volej Vystup3("    sdiv %s, %s, %s\n", Volej XA(w7), Volej XA(a7), Volej XA(b7)) }
                Jinak {
                    Volej Vystup2("    sdiv x8, %s, %s\n", Volej XA(a7), Volej XA(b7))
                    Volej Vystup3("    msub %s, x8, %s, %s\n", Volej XA(w7), Volej XA(b7), Volej XA(a7))
                }
            }
            Volej UlozA(d, w7)
            i = i + 1
            Pokracuj
        }
        Pokud (op == 21 || op == 22) { // posuny
            Lokalni a21 = Volej OpA(s1, t1, 16)
            Lokalni w21 = Volej CilA(d, 16)
            Lokalni ins21 = "lsl"
            Pokud (op == 22) { ins21 = "asr" }
            Pokud (t2 == 1) { Volej Vystup3("    %s %s, %s, ", ins21, Volej XA(w21), Volej XA(a21)); Volej Vystup1("#%lld\n", s2 & 63) }
            Jinak {
                Lokalni b21 = Volej OpA(s2, t2, 17)
                Volej Vystup3("    %s %s, %s, ", ins21, Volej XA(w21), Volej XA(a21))
                Volej Vystup1("%s\n", Volej XA(b21))
            }
            Volej UlozA(d, w21)
            i = i + 1
            Pokracuj
        }
        Pokud ((op >= 4 && op <= 6) || (op >= 18 && op <= 20)) { // + - * & | ^
            Lokalni a4 = Volej OpA(s1, t1, 16)
            Lokalni w4 = Volej CilA(d, 16)
            Pokud ((op == 4 || op == 5) && t2 == 1 && s2 >= 0 && s2 < 4096) {
                Lokalni ins_i = "add"
                Pokud (op == 5) { ins_i = "sub" }
                Volej Vystup3("    %s %s, %s, ", ins_i, Volej XA(w4), Volej XA(a4))
                Volej Vystup1("#%lld\n", s2)
            } Jinak Pokud ((op == 4 || op == 5) && t2 == 1 && s2 < 0 && s2 > 0 - 4096) {
                Lokalni ins_n = "sub"
                Pokud (op == 5) { ins_n = "add" }
                Volej Vystup3("    %s %s, %s, ", ins_n, Volej XA(w4), Volej XA(a4))
                Volej Vystup1("#%lld\n", 0 - s2)
            } Jinak {
                Lokalni b4 = Volej OpA(s2, t2, 17)
                Lokalni ins4 = "add"
                Pokud (op == 5) { ins4 = "sub" }
                Pokud (op == 6) { ins4 = "mul" }
                Pokud (op == 18) { ins4 = "and" }
                Pokud (op == 19) { ins4 = "orr" }
                Pokud (op == 20) { ins4 = "eor" }
                Volej Vystup3("    %s %s, %s, ", ins4, Volej XA(w4), Volej XA(a4))
                Volej Vystup1("%s\n", Volej XA(b4))
            }
            Volej UlozA(d, w4)
            i = i + 1
            Pokracuj
        }
        Volej printf("Interni chyba: ARM64 backend nezna IR instrukci %d\n", op)
        Volej exit(1)
    }
    // Chybove vetve (deleni nulou, meze, Alokuj...) za koncem metody
    Lokalni ci = 0
    Dokud (ci < ir_chyby_pocet) {
        Lokalni cb = ir_chyby_navesti + (ci * 24)
        Volej Vystup1(".L_label_%d:\n", CtiZAdresu(cb))
        Volej ChybaBehuA(CtiZAdresu(cb + 8), CtiZAdresu(cb + 16))
        ci = ci + 1
    }
    Vrat 0
}

// ==========================================
// Zapis celeho souboru (NASM)
// ==========================================
Metoda GeneratorASM_x86(ast_koren : AST_Node, vystupni_soubor) {
    Volej printf("Generator: Zapisuji do %s...\n", vystupni_soubor)
    Lokalni out = Volej fopen(vystupni_soubor, "w")
    Pokud (out == 0) {
        Volej printf("Chyba: Nelze vytvorit soubor '%s'.\n", vystupni_soubor)
        Volej exit(1)
    }
    Volej fputs("default rel\n", out)

    // Formaty pro Vypis: cela cisla jsou 64bitova (%lld, na Windows %I64d)
    Volej fputs("section .data\n", out)
    Pokud (cilova_platforma == 2) { Volej fputs("    fmt_int db 37, 73, 54, 52, 100, 10, 0\n", out) }
    Jinak { Volej fputs("    fmt_int db 37, 108, 108, 100, 10, 0\n", out) }
    Volej fputs("    fmt_flt db 37, 102, 10, 0\n    fmt_str db 37, 115, 10, 0\n", out)
    Lokalni i = 0
    Lokalni flt_id = 0
    Dokud (i < pocet_tokenu) {
        Lokalni t : Token = pamet_tokenu + (i * Velikost(Token))
        Pokud (t->type == TOKEN_STRING) {
            Volej fprintf(out, "    str%d db ", t->str_id)
            Volej ZapisBajtyTextu(out, t->value)
        }
        Pokud (t->type == TOKEN_FLOAT) {
            Volej fprintf(out, "    flt%d dq %s\n", flt_id, t->value)
            flt_id = flt_id + 1
        }
        i = i + 1
    }
    Lokalni sg = 0
    Dokud (sg < pocet_symbolu) {
        Lokalni sym : Symbol = pamet_symbolu + (sg * Velikost(Symbol))
        Pokud (sym->is_function == 1 && Volej strcmp(sym->init_str, "Pamatuj") == 0) {
            Volej fprintf(out, "    pam_%s times %d dq 0\n", sym->name, PAM_VELIKOST)
            Volej fprintf(out, "    pamok_%s times %d dq 0\n", sym->name, PAM_VELIKOST)
        }
        Pokud (sym->is_global == 1 && sym->is_const == 0 && sym->is_function == 0 && sym->dim1 > 0) {
            Volej fprintf(out, "    gvar_%s times %lld dq 0\n", sym->name, sym->dim1 * sym->dim2)
        } Jinak Pokud (sym->is_global == 1 && sym->is_const == 0 && sym->is_function == 0) {
            Pokud (Volej CtiByt(sym->init_str) != 0) { Volej fprintf(out, "    gvar_%s dq %s\n", sym->name, sym->init_str) }
            Jinak { Volej fprintf(out, "    gvar_%s dq %lld\n", sym->name, sym->const_val) }
        }
        sg = sg + 1
    }

    Lokalni pfx = ""
    Pokud (cilova_platforma == 0) { pfx = "_" }
    Volej fputs("\nsection .text\n", out)
    Pokud (cilova_platforma != 3) {
        Volej fprintf(out, "    extern %sprintf\n    extern %sexit\n    extern %sputs\n    extern %scalloc\n    extern %smalloc\n", pfx, pfx, pfx, pfx, pfx)
        Volej fprintf(out, "    extern %sfree\n    extern %sstrlen\n    extern %sstrcpy\n    extern %sstrcat\n    extern %sstrcmp\n", pfx, pfx, pfx, pfx, pfx)
        Volej fprintf(out, "    extern %smemcpy\n", pfx)
    }
    Lokalni k = 0
    Dokud (k < ast_koren->stmt_count) {
        Lokalni pod_uzel : AST_Node = Volej CtiUkazatel(ast_koren->stmts + (k * 8))
        Pokud (pod_uzel->type == AST_EXTERN_DECL) { Volej fprintf(out, "    extern %s%s\n", pfx, pod_uzel->name) }
        k = k + 1
    }

    Pokud (cilova_platforma == 3) {
        // Jadro OS: vlastni zasobnik, zadna knihovna C; po navratu z Hlavni procesor zastavime
        Volej fputs("    global _start\n\nsection .bss\nalign 16\njadro_zasobnik: resb 65536\njadro_zasobnik_vrchol:\n\nsection .text\n", out)
        Volej fputs("_start:\n    lea rsp, [rel jadro_zasobnik_vrchol]\n    xor ebp, ebp\n    sub rsp, 32\n    call Hlavni\n.stop:\n    cli\n    hlt\n    jmp .stop\n\n", out)
    } Jinak {
        Lokalni hlavni_label = "main"
        Pokud (cilova_platforma == 0) { hlavni_label = "_main" }
        Volej fprintf(out, "    global %s\n\n%s:\n    push rbp\n    mov rbp, rsp\n", hlavni_label, hlavni_label)
        Pokud (kontroly == 1) {
            // Mez zasobniku pro kontrolu hloubky rekurze (rezerva pro hlaseni chyby)
            Pokud (cilova_platforma == 2) {
                // Windows: spodni hranice vyhrazeneho zasobniku z TEB (DeallocationStack) + 256 KB
                Volej fputs("    mov rax, [gs:0x1478]\n    add rax, 262144\n    mov [rel pramen_mez_zasobniku], rax\n", out)
            } Jinak {
                // Linux/macOS: vychozi zasobnik je 8 MB, kontrola po 7 MB
                Volej fputs("    lea rax, [rsp - 7340032]\n    mov [rel pramen_mez_zasobniku], rax\n", out)
            }
        }
        Pokud (cilova_platforma == 2) {
            Volej fputs("    mov [rel gvar_sys_argc], rcx\n    mov [rel gvar_sys_argv], rdx\n", out)
        } Jinak {
            Volej fputs("    mov [rel gvar_sys_argc], rdi\n    mov [rel gvar_sys_argv], rsi\n", out)
        }
        Volej fputs("    sub rsp, 32\n    call Hlavni\n", out)
        Pokud (cilova_platforma == 2) { Volej fprintf(out, "    mov rcx, rax\n    call %sexit\n\n", pfx) }
        Jinak { Volej fprintf(out, "    mov rdi, rax\n    call %sexit\n\n", pfx) }
        // Preteceni zasobniku: hlaseni misto padu (zasobnik ma jeste rezervu)
        Volej fputs("pramen_preteceni_zasobniku:\n    and rsp, -16\n    sub rsp, 32\n", out)
        Volej fprintf(out, "    lea %s, [rel err_zasobnik]\n    call %sputs\n", Volej RegistrArgumentu(0, 1), pfx)
        Volej fprintf(out, "    mov %s, 1\n    call %sexit\n\n", Volej RegistrArgumentu(0, 1), pfx)
    }

    Volej GenerujAST_x86(out, ast_koren)

    Volej fputs("\nsection .data\n", out)
    Pokud (cilova_platforma != 3) {
        Volej fputs("    pramen_mez_zasobniku dq 0\n    err_zasobnik db ", out)
        Volej ZapisBajtyTextu(out, "Chyba za behu: preteceni zasobniku (prilis hluboka rekurze)")
    }
    Lokalni e = 0
    Dokud (e < pocet_chyb) {
        Volej fprintf(out, "    err_msg%d db ", e)
        Volej ZapisBajtyTextu(out, pamet_chyb + (e * 256))
        e = e + 1
    }
    Pokud (cilova_platforma == 1 || cilova_platforma == 3) { Volej fputs("section .note.GNU-stack noalloc noexec nowrite progbits\n", out) }
    Volej fclose(out)
    Vrat 0
}

// ==========================================
// ROZCESTNIKY ARCHITEKTUR
// ==========================================
Metoda GeneratorASM(ast_koren : AST_Node, vystupni_soubor) {
    Pokud (Volej JeARM() == 1) { Vrat Volej GeneratorASM_ARM(ast_koren, vystupni_soubor) }
    Vrat Volej GeneratorASM_x86(ast_koren, vystupni_soubor)
}

// ==========================================
// BACKEND PRO ARM64 (AArch64)
//   cilova_platforma 4 = macOS (Apple Silicon), 5 = jadro OS (bez knihoven), 6 = Linux
//
// Konvence volani metod Pramenu (stejna myslenka jako u x86):
//   - prvnich 8 argumentu v x0..x7, volajici nad navratovou adresou vyhradi 64 B
//     "domovske" oblasti, kam si je volana metoda ulozi -> parametr i je vzdy na [x29, #16 + 8*i]
//   - dalsi argumenty lezi hned za touto oblasti
//   - lokalni promenne jsou na [x29, #-offset], vysledek je v x0
//   - mezivysledky vyrazu se ukladaji na zasobnik po 16 B (sp je vzdy zarovnany)
// ==========================================
Metoda JeARM() {
    Pokud (cilova_platforma == 4 || cilova_platforma == 5 || cilova_platforma == 6) { Vrat 1 }
    Vrat 0
}

Metoda JeJadro() {
    Pokud (cilova_platforma == 3 || cilova_platforma == 5) { Vrat 1 }
    Vrat 0
}

// V rezimu jadra neni k dispozici knihovna C (printf, malloc...)
Metoda ZakazVJadru(radek, co) {
    Pokud (Volej JeJadro() == 1) {
        Volej printf("Chyba (radek %d): '%s' neni v rezimu jadra OS k dispozici (neni knihovna C).\n", radek, co)
        Volej exit(1)
    }
    Vrat 0
}

// Nacte 64bitove cislo do registru (movz/movk; bez literal poolu, funguje vsude)
Metoda EmitujCislo_ARM(reg, hodnota) {
    Pokud (hodnota >= 0 && hodnota < 65536) {
        Volej EmitujASM_2("    mov %s, #%lld\n", reg, hodnota)
        Vrat 0
    }
    Volej EmitujASM_2("    movz %s, #%lld\n", reg, hodnota & 65535)
    Lokalni k = 1
    Dokud (k < 4) {
        Lokalni kus = (hodnota >> (k * 16)) & 65535
        Pokud (kus != 0) { Volej EmitujASM_3("    movk %s, #%lld, lsl #%d\n", reg, kus, k * 16) }
        k = k + 1
    }
    Vrat 0
}

// Adresa symbolu (globalni promenna, text...) do registru
Metoda EmitujAdresuSymbolu_ARM(reg, symbol) {
    Pokud (cilova_platforma == 4) {
        Volej EmitujASM_2("    adrp %s, %s@PAGE\n", reg, symbol)
        Volej EmitujASM_3("    add %s, %s, %s@PAGEOFF\n", reg, reg, symbol)
    } Jinak {
        Volej EmitujASM_2("    adrp %s, %s\n", reg, symbol)
        Volej EmitujASM_3("    add %s, %s, :lo12:%s\n", reg, reg, symbol)
    }
    Vrat 0
}

// Adresa promenne (lokalni / parametr / globalni) do registru
Metoda EmitujAdresuPromenne_ARM(sym : Symbol, reg) {
    Pokud (sym->is_global) {
        Lokalni jm = Volej calloc(1, 300)
        Volej sprintf(jm, "gvar_%s", sym->name)
        Volej EmitujAdresuSymbolu_ARM(reg, jm)
        Volej free(jm)
        Vrat 0
    }
    Pokud (sym->offset < 0) { Volej EmitujASM_3("    add %s, x29, #%d\n", reg, 0 - sym->offset, 0); Vrat 0 }
    Pokud (sym->offset < 4096) { Volej EmitujASM_2("    sub %s, x29, #%d\n", reg, sym->offset); Vrat 0 }
    Volej EmitujCislo_ARM("x10", sym->offset)
    Volej EmitujASM_1("    sub %s, x29, x10\n", reg)
    Vrat 0
}

// Hodnota promenne do registru (pouziva x9 pro adresu)
Metoda NactiPromennou_ARM(sym : Symbol, reg) {
    Pokud (sym->is_global == 0 && sym->offset < 0) { Volej EmitujASM_2("    ldr %s, [x29, #%d]\n", reg, 0 - sym->offset); Vrat 0 }
    Pokud (sym->is_global == 0 && sym->offset < 256) { Volej EmitujASM_2("    ldur %s, [x29, #-%d]\n", reg, sym->offset); Vrat 0 }
    Volej EmitujAdresuPromenne_ARM(sym, "x9")
    Volej EmitujASM_1("    ldr %s, [x9]\n", reg)
    Vrat 0
}

// Ulozi x0 do promenne (pouziva x9 pro adresu)
Metoda UlozPromennou_ARM(sym : Symbol) {
    Pokud (sym->is_global == 0 && sym->offset < 0) { Volej EmitujASM_1("    str x0, [x29, #%d]\n", 0 - sym->offset); Vrat 0 }
    Pokud (sym->is_global == 0 && sym->offset < 256) { Volej EmitujASM_1("    stur x0, [x29, #-%d]\n", sym->offset); Vrat 0 }
    Volej EmitujAdresuPromenne_ARM(sym, "x9")
    Volej EmitujASM("    str x0, [x9]\n")
    Vrat 0
}

// Zakladni adresa pro a[i]: lokalni pole -> jeho misto ve ramci, jinak hodnota (ukazatel)
Metoda AdresaPole_ARM(sym : Symbol, reg) {
    Pokud (sym->dim1 > 0) { Volej EmitujAdresuPromenne_ARM(sym, reg); Vrat 0 }
    Volej NactiPromennou_ARM(sym, reg)
    Vrat 0
}

Metoda NazevC_ARM(nazev) {
    Pokud (cilova_platforma == 4) { Vrat Volej NazevSymbolu(nazev) }
    Vrat nazev
}

// Volani C funkce s argumenty uz pripravenymi v registrech
Metoda VolejC_ARM(nazev) {
    Volej EmitujASM_1("    bl %s\n", Volej NazevC_ARM(nazev))
    Vrat 0
}

// Chyba za behu: vypise hlasku a ukonci program (v jadru se zastavi v nekonecne smycce)
Metoda GenerujChybuBehu_ARM(radek, zprava) {
    Pokud (Volej JeJadro() == 1) { Volej EmitujASM("    b .\n"); Vrat 0 }
    Lokalni id = Volej PridejChybovouZpravu(radek, zprava)
    Lokalni jm = Volej calloc(1, 64)
    Volej sprintf(jm, "err_msg%d", id)
    Volej EmitujAdresuSymbolu_ARM("x0", jm)
    Volej free(jm)
    Volej VolejC_ARM("puts")
    Volej EmitujASM("    mov x0, #1\n")
    Volej VolejC_ARM("exit")
    Vrat 0
}

// Kontroly za behu na ARM (stejne jako na x86; vypne je --bez-kontrol)
Metoda KontrolaMeze_ARM(reg, idx_uzel : AST_Node, velikost, radek, jmeno) {
    Pokud (idx_uzel != 0) {
        Pokud (idx_uzel->type == AST_EXPR && idx_uzel->op == TOKEN_NUMBER) { // konstantni index: chyba uz pri prekladu
            Volej KontrolaMeze(Volej NaCislo(idx_uzel->name), 1, velikost, radek, jmeno)
            Vrat 0
        }
    }
    Pokud (kontroly == 0) { Vrat 0 }
    Lokalni ok = citac_navesti
    citac_navesti = citac_navesti + 1
    Volej EmitujCislo_ARM("x17", velikost)
    Volej EmitujASM_2("    cmp %s, x17\n    b.lo .L_ok_%d\n", reg, ok)
    Volej GenerujChybuBehu_ARM(radek, "index mimo meze pole")
    Volej EmitujASM_1(".L_ok_%d:\n", ok)
    Vrat 0
}
Metoda KontrolaUkazatele_ARM(reg, radek) {
    Pokud (kontroly == 0 || Volej JeJadro() == 1) { Vrat 0 }
    Lokalni ok = citac_navesti
    citac_navesti = citac_navesti + 1
    Volej EmitujASM_2("    cbnz %s, .L_ok_%d\n", reg, ok)
    Volej GenerujChybuBehu_ARM(radek, "pristup pres nulovy ukazatel (p->clen, kdyz p = 0)")
    Volej EmitujASM_1(".L_ok_%d:\n", ok)
    Vrat 0
}

Metoda GenerujKontroluNuly_ARM(radek, zprava) {
    Lokalni ok = citac_navesti
    citac_navesti = citac_navesti + 1
    Volej EmitujASM_1("    cbnz x0, .L_ok_%d\n", ok)
    Volej GenerujChybuBehu_ARM(radek, zprava)
    Volej EmitujASM_1(".L_ok_%d:\n", ok)
    Vrat 0
}

// Pocet pevnych argumentu variadicke C funkce (na macOS jdou dalsi argumenty na zasobnik)
Metoda PevneArgumenty(nazev) {
    Pokud (Volej strcmp(nazev, "printf") == 0 || Volej strcmp(nazev, "scanf") == 0) { Vrat 1 }
    Pokud (Volej strcmp(nazev, "sprintf") == 0 || Volej strcmp(nazev, "fprintf") == 0) { Vrat 2 }
    Pokud (Volej strcmp(nazev, "sscanf") == 0 || Volej strcmp(nazev, "fscanf") == 0) { Vrat 2 }
    Pokud (Volej strcmp(nazev, "snprintf") == 0) { Vrat 3 }
    Vrat 0 - 1
}

Metoda GenerujVolani_ARM(out, uzel : AST_Node) {
    Lokalni vest = Volej JeVestavena(uzel->name)
    Pokud (vest == 6) { Volej EmitujASM("    dmb sy\n    mov x0, #0\n"); Vrat 0 }
    Pokud (vest == 1 || vest == 2) {
        Volej GenerujVyraz_ARM(out, Volej CtiUkazatel(uzel->stmts))
        Pokud (vest == 1) { Volej EmitujASM("    ldrb w0, [x0]\n") } Jinak { Volej EmitujASM("    ldr w0, [x0]\n") }
        Vrat 0
    }
    Pokud (vest >= 3) {
        Volej GenerujVyraz_ARM(out, Volej CtiUkazatel(uzel->stmts))
        Volej EmitujASM("    str x0, [sp, #-16]!\n")
        Volej GenerujVyraz_ARM(out, Volej CtiUkazatel(uzel->stmts + 8))
        Volej EmitujASM("    ldr x1, [sp], #16\n")
        Pokud (vest == 3) { Volej EmitujASM("    strb w0, [x1]\n") }
        Pokud (vest == 4) { Volej EmitujASM("    str w0, [x1]\n") }
        Pokud (vest == 5) { Volej EmitujASM("    str x0, [x1]\n") }
        Volej EmitujASM("    mov x0, #0\n")
        Vrat 0
    }
    Lokalni n = uzel->stmt_count
    Lokalni sym_vol : Symbol = Volej NajdiSymbol(uzel->name)
    Lokalni pres_promennou = 0
    Pokud (sym_vol != 0) { Pokud (sym_vol->is_function == 0) { pres_promennou = 1 } }
    Lokalni je_externi = Volej JeExterniJmeno(uzel->name)
    Pokud (sym_vol == 0 && je_externi == 0) {
        Volej printf("Chyba (radek %d): Neznama metoda '%s' (chybi Metoda nebo Externi).\n", uzel->line, uzel->name)
        Volej exit(1)
    }
    // 1) Argumenty zprava doleva na zasobnik (kazdy 16 B) -> argument i lezi na [sp + 16*i]
    Lokalni ai = n - 1
    Dokud (ai >= 0) {
        Lokalni a_node : AST_Node = Volej CtiUkazatel(uzel->stmts + (ai * 8))
        Volej GenerujVyraz_ARM(out, a_node)
        Volej EmitujASM("    str x0, [sp, #-16]!\n")
        ai = ai - 1
    }
    Volej EmitujASM("    mov x10, sp\n")

    Pokud (je_externi == 1 && pres_promennou == 0) {
        // --- C funkce (AAPCS64): cela cisla x0-x7, desetinna d0-d7, zbytek na zasobnik ---
        Lokalni pevne = Volej PevneArgumenty(uzel->name)
        Lokalni na_zasobnik = Volej calloc(n + 1, 8)
        Lokalni pocet_z = 0
        Lokalni ni = 0
        Lokalni nf = 0
        Lokalni i = 0
        Dokud (i < n) {
            Lokalni arg_i : AST_Node = Volej CtiUkazatel(uzel->stmts + (i * 8))
            Lokalni je_f = 0
            Pokud (Volej strcmp(Volej ZiskejTypUzlu(arg_i), "Float") == 0) { je_f = 1 }
            Lokalni do_zas = 0
            Pokud (cilova_platforma == 4 && pevne >= 0 && i >= pevne) { do_zas = 1 } // macOS: variadicke na zasobnik
            Pokud (do_zas == 0 && je_f == 1 && nf < 8) { Volej EmitujASM_2("    ldr d%d, [x10, #%d]\n", nf, i * 16); nf = nf + 1 }
            Jinak Pokud (do_zas == 0 && je_f == 0 && ni < 8) { Volej EmitujASM_2("    ldr x%d, [x10, #%d]\n", ni, i * 16); ni = ni + 1 }
            Jinak { Volej ZapisUkazatel(na_zasobnik + (pocet_z * 8), i); pocet_z = pocet_z + 1 }
            i = i + 1
        }
        Lokalni oblast = ((pocet_z * 8) + 15) / 16 * 16
        Pokud (oblast > 0) {
            Volej EmitujASM_1("    sub sp, sp, #%d\n", oblast)
            Lokalni j = 0
            Dokud (j < pocet_z) {
                Volej EmitujASM_2("    ldr x11, [x10, #%d]\n    str x11, [sp, #%d]\n", Volej CtiUkazatel(na_zasobnik + (j * 8)) * 16, j * 8)
                j = j + 1
            }
        }
        Volej free(na_zasobnik)
        Volej VolejC_ARM(uzel->name)
        Pokud (oblast > 0) { Volej EmitujASM_1("    add sp, sp, #%d\n", oblast) }
        Pokud (Volej VraciCInt(uzel->name) == 1) { Volej EmitujASM("    sxtw x0, w0\n") }
        Pokud (Volej JeFloatExtern(uzel->name) == 1) { Volej EmitujASM("    fmov x0, d0\n") }
    } Jinak {
        // --- Metoda Pramenu (primo nebo pres ukazatel v promenne) ---
        Lokalni r = 0
        Dokud (r < n && r < 8) {
            Volej EmitujASM_2("    ldr x%d, [x10, #%d]\n", r, r * 16)
            r = r + 1
        }
        Lokalni k = n - 8
        Pokud (k < 0) { k = 0 }
        // argumenty 9+ lezi na [sp] v okamziku volani (domovskou oblast si vyhradi volany)
        Lokalni oblast2 = ((k * 8) + 15) / 16 * 16
        Pokud (oblast2 > 0) { Volej EmitujASM_1("    sub sp, sp, #%d\n", oblast2) }
        Lokalni j2 = 0
        Dokud (j2 < k) {
            Volej EmitujASM_2("    ldr x11, [x10, #%d]\n    str x11, [sp, #%d]\n", (8 + j2) * 16, j2 * 8)
            j2 = j2 + 1
        }
        Pokud (pres_promennou == 1) {
            Volej NactiPromennou_ARM(sym_vol, "x12")
            Volej EmitujASM("    blr x12\n")
        } Jinak {
            Volej EmitujASM_1("    bl %s\n", uzel->name)
        }
        Pokud (oblast2 > 0) { Volej EmitujASM_1("    add sp, sp, #%d\n", oblast2) }
    }
    Pokud (n > 0) { Volej EmitujASM_1("    add sp, sp, #%d\n", n * 16) } // uklid argumentu
    Vrat 0
}

// Spolecne: levy operand v x0, pravy v x1 (levy se vyhodnoti prvni)
Metoda DvaOperandy_ARM(out, uzel : AST_Node) {
    Volej GenerujVyraz_ARM(out, uzel->left)
    Volej EmitujASM("    str x0, [sp, #-16]!\n")
    Volej GenerujVyraz_ARM(out, uzel->right)
    Volej EmitujASM("    mov x1, x0\n    ldr x0, [sp], #16\n")
    Vrat 0
}

Metoda GenerujVyraz_ARM(out, uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    Pokud (uzel->type == AST_NOP) { Vrat 0 }
    Lokalni op = uzel->op

    Pokud (uzel->type == AST_EXPR) {
        Pokud (op == 34) { Volej EmitujCislo_ARM("x0", Volej NaCislo(uzel->name)); Vrat 0 }
        Pokud (op == 33) {
            Lokalni sj = Volej calloc(1, 64)
            Volej sprintf(sj, "str%d", uzel->int_val)
            Volej EmitujAdresuSymbolu_ARM("x0", sj)
            Volej free(sj)
            Vrat 0
        }
        Pokud (op == 98) {
            Lokalni fj = Volej calloc(1, 64)
            Volej sprintf(fj, "flt%d", uzel->int_val)
            Volej EmitujAdresuSymbolu_ARM("x9", fj)
            Volej free(fj)
            Volej EmitujASM("    ldr x0, [x9]\n")
            Vrat 0
        }
        Pokud (op == 35) {
            Lokalni sym_id : Symbol = Volej NajdiSymbol(uzel->name)
            Pokud (sym_id == 0) { Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", uzel->line, uzel->name); Volej exit(1) }
            Pokud (sym_id->is_function) { Volej EmitujAdresuSymbolu_ARM("x0", sym_id->name); Vrat 0 }
            Pokud (sym_id->is_const) { Volej EmitujCislo_ARM("x0", sym_id->const_val); Vrat 0 }
            Pokud (sym_id->dim1 > 0) { Volej EmitujAdresuPromenne_ARM(sym_id, "x0"); Vrat 0 }
            Volej NactiPromennou_ARM(sym_id, "x0")
            Vrat 0
        }
        Pokud (op == 53) { Volej GenerujVyraz_ARM(out, uzel->left); Volej EmitujASM("    ldr x0, [x0]\n"); Vrat 0 }
        Pokud (op == 44 && uzel->right == 0) {
            Volej GenerujVyraz_ARM(out, uzel->left)
            Pokud (Volej strcmp(Volej ZiskejTypUzlu(uzel->left), "Float") == 0) { Volej EmitujASM("    eor x0, x0, #0x8000000000000000\n") }
            Jinak { Volej EmitujASM("    neg x0, x0\n") }
            Vrat 0
        }
        Pokud (op == 81) { Volej GenerujVyraz_ARM(out, uzel->left); Volej EmitujASM("    cmp x0, #0\n    cset x0, eq\n"); Vrat 0 }
        Pokud (op == 47 || op == 48) { // && || se zkracenym vyhodnocenim
            Lokalni lbl = citac_navesti
            citac_navesti = citac_navesti + 1
            Volej GenerujVyraz_ARM(out, uzel->left)
            Pokud (op == 47) { Volej EmitujASM_1("    cbz x0, .L_lz_%d\n", lbl) } Jinak { Volej EmitujASM_1("    cbnz x0, .L_lz_%d\n", lbl) }
            Volej GenerujVyraz_ARM(out, uzel->right)
            Volej EmitujASM_1(".L_lz_%d:\n    cmp x0, #0\n    cset x0, ne\n", lbl)
            Vrat 0
        }
        Pokud (op == 95 || op == 96 || op == 97) { // texty
            Volej ZakazVJadru(uzel->line, "prace s texty")
            Volej DvaOperandy_ARM(out, uzel)
            Pokud (op == 95) {
                Volej EmitujASM("    stp x0, x1, [sp, #-16]!\n")          // [sp]=levy, [sp+8]=pravy
                Volej VolejC_ARM("strlen")
                Volej EmitujASM("    str x0, [sp, #-16]!\n    ldr x0, [sp, #24]\n")
                Volej VolejC_ARM("strlen")
                Volej EmitujASM("    ldr x1, [sp], #16\n    add x0, x0, x1\n    add x0, x0, #1\n")
                Volej VolejC_ARM("malloc")
                Volej GenerujKontroluNuly_ARM(uzel->line, "spojeni textu: nedostatek pameti")
                Volej EmitujASM("    str x0, [sp, #-16]!\n    ldr x1, [sp, #16]\n")
                Volej VolejC_ARM("strcpy")
                Volej EmitujASM("    ldr x0, [sp]\n    ldr x1, [sp, #24]\n")
                Volej VolejC_ARM("strcat")
                Volej EmitujASM("    ldr x0, [sp], #16\n    add sp, sp, #16\n")
            } Jinak {
                Volej VolejC_ARM("strcmp")
                Volej EmitujASM("    cmp w0, #0\n")
                Pokud (op == 96) { Volej EmitujASM("    cset x0, eq\n") } Jinak { Volej EmitujASM("    cset x0, ne\n") }
            }
            Vrat 0
        }
        // Binarni operace
        Pokud (uzel->left != 0 && uzel->right != 0) {
            Lokalni je_float = 0
            Lokalni lt = Volej ZiskejTypUzlu(uzel->left)
            Lokalni rt = Volej ZiskejTypUzlu(uzel->right)
            Pokud (Volej strcmp(lt, "Float") == 0 || Volej strcmp(rt, "Float") == 0) { je_float = 1 }
            Volej DvaOperandy_ARM(out, uzel)
            Pokud (je_float == 1 && (op == 67 || op == 44 || op == 49 || op == 50 || op == 43 || op == 64 || op == 45 || op == 46 || op == 61 || op == 62)) {
                // cele cislo na druhe strane prevedeme na desetinne
                Pokud (Volej strcmp(lt, "Float") == 0) { Volej EmitujASM("    fmov d0, x0\n") } Jinak { Volej EmitujASM("    scvtf d0, x0\n") }
                Pokud (Volej strcmp(rt, "Float") == 0) { Volej EmitujASM("    fmov d1, x1\n") } Jinak { Volej EmitujASM("    scvtf d1, x1\n") }
                Pokud (op == 67) { Volej EmitujASM("    fadd d0, d0, d1\n    fmov x0, d0\n") }
                Pokud (op == 44) { Volej EmitujASM("    fsub d0, d0, d1\n    fmov x0, d0\n") }
                Pokud (op == 49) { Volej EmitujASM("    fmul d0, d0, d1\n    fmov x0, d0\n") }
                Pokud (op == 50) { Volej EmitujASM("    fdiv d0, d0, d1\n    fmov x0, d0\n") }
                Pokud (op == 43) { Volej EmitujASM("    fcmp d0, d1\n    cset x0, eq\n") }
                Pokud (op == 64) { Volej EmitujASM("    fcmp d0, d1\n    cset x0, ne\n") }
                Pokud (op == 45) { Volej EmitujASM("    fcmp d0, d1\n    cset x0, mi\n") }
                Pokud (op == 46) { Volej EmitujASM("    fcmp d0, d1\n    cset x0, gt\n") }
                Pokud (op == 61) { Volej EmitujASM("    fcmp d0, d1\n    cset x0, ls\n") }
                Pokud (op == 62) { Volej EmitujASM("    fcmp d0, d1\n    cset x0, ge\n") }
                Vrat 0
            }
            Pokud (op == 67) { Volej EmitujASM("    add x0, x0, x1\n") }
            Pokud (op == 44) { Volej EmitujASM("    sub x0, x0, x1\n") }
            Pokud (op == 49) { Volej EmitujASM("    mul x0, x0, x1\n") }
            Pokud (op == 50 || op == 80) {
                // Deleni nulou: ARM by tise vratil 0 -> radeji srozumitelna chyba (jako na x86)
                Lokalni ok_d = citac_navesti
                citac_navesti = citac_navesti + 1
                Volej EmitujASM_1("    cbnz x1, .L_ok_%d\n", ok_d)
                Volej GenerujChybuBehu_ARM(uzel->line, "deleni nulou")
                Volej EmitujASM_1(".L_ok_%d:\n", ok_d)
                Pokud (op == 50) { Volej EmitujASM("    sdiv x0, x0, x1\n") }
                Jinak { Volej EmitujASM("    sdiv x2, x0, x1\n    msub x0, x2, x1, x0\n") }
            }
            Pokud (op == 58) { Volej EmitujASM("    and x0, x0, x1\n") }
            Pokud (op == 124) { Volej EmitujASM("    orr x0, x0, x1\n") }
            Pokud (op == 83) { Volej EmitujASM("    eor x0, x0, x1\n") }
            Pokud (op == 84) { Volej EmitujASM("    lsl x0, x0, x1\n") }
            Pokud (op == 85) { Volej EmitujASM("    asr x0, x0, x1\n") }
            Pokud (op == 43 || op == 64 || op == 45 || op == 46 || op == 61 || op == 62) {
                Volej EmitujASM("    cmp x0, x1\n")
                Pokud (op == 43) { Volej EmitujASM("    cset x0, eq\n") }
                Pokud (op == 64) { Volej EmitujASM("    cset x0, ne\n") }
                Pokud (op == 45) { Volej EmitujASM("    cset x0, lt\n") }
                Pokud (op == 46) { Volej EmitujASM("    cset x0, gt\n") }
                Pokud (op == 61) { Volej EmitujASM("    cset x0, le\n") }
                Pokud (op == 62) { Volej EmitujASM("    cset x0, ge\n") }
            }
            Vrat 0
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_CALL) { Volej GenerujVolani_ARM(out, uzel); Vrat 0 }

    Pokud (uzel->type == AST_ALLOC) { // Alokuj n -> vynulovana pamet
        Volej ZakazVJadru(uzel->line, "Alokuj")
        Volej GenerujVyraz_ARM(out, uzel->left)
        Volej EmitujASM("    mov x1, x0\n    mov x0, #1\n")
        Volej VolejC_ARM("calloc")
        Volej GenerujKontroluNuly_ARM(uzel->line, "Alokuj: nedostatek pameti")
        Vrat 0
    }

    Pokud (uzel->type == AST_PTR_MEMBER_READ) { // p->clen
        Lokalni sym_ptr : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_ptr == 0) { Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", uzel->line, uzel->name); Volej exit(1) }
        Volej NactiPromennou_ARM(sym_ptr, "x0")
        Volej KontrolaUkazatele_ARM("x0", uzel->line)
        Pokud (Volej JeClenPole(sym_ptr->type_name, uzel->sub_name) == 1) {
            Pokud (uzel->int_val != 0) { Volej EmitujASM_1("    add x0, x0, #%d\n", uzel->int_val) }
        } Jinak {
            Volej EmitujASM_1("    ldr x0, [x0, #%d]\n", uzel->int_val)
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_MEMBER_CHAIN) { // a->b->c (ARM64)
        Volej GenerujVyraz_ARM(out, uzel->left)
        Volej KontrolaUkazatele_ARM("x0", uzel->line)
        Pokud (Volej JeClenPole(uzel->name, uzel->sub_name) == 1) {
            Pokud (uzel->int_val != 0) { Volej EmitujASM_1("    add x0, x0, #%d\n", uzel->int_val) }
        } Jinak {
            Volej EmitujASM_1("    ldr x0, [x0, #%d]\n", uzel->int_val)
        }
        Vrat 0
    }

    Pokud (uzel->type == AST_ARRAY_READ) { // p->clen[i] (bajt)
        Lokalni sym_arr : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_arr == 0) { Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", uzel->line, uzel->name); Volej exit(1) }
        Pokud (Volej JeClenPole(sym_arr->type_name, uzel->sub_name) == 0) {
            Volej printf("Chyba (radek %d): '%s->%s' neni pole, nelze ho indexovat.\n", uzel->line, uzel->name, uzel->sub_name)
            Volej exit(1)
        }
        Volej GenerujVyraz_ARM(out, uzel->left)
        Volej KontrolaMeze_ARM("x0", uzel->left, Volej VelikostClenu(sym_arr->type_name, uzel->sub_name), uzel->line, uzel->sub_name)
        Volej EmitujASM("    mov x1, x0\n")
        Volej NactiPromennou_ARM(sym_arr, "x0")
        Volej KontrolaUkazatele_ARM("x0", uzel->line)
        Pokud (uzel->int_val != 0) { Volej EmitujASM_1("    add x0, x0, #%d\n", uzel->int_val) }
        Volej EmitujASM("    ldrb w0, [x0, x1]\n")
        Vrat 0
    }

    Pokud (uzel->type == AST_LOCAL_ARRAY_READ) { // a[i]
        Lokalni sym_loc : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_loc == 0) { Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", uzel->line, uzel->name); Volej exit(1) }
        Volej GenerujVyraz_ARM(out, uzel->left)
        Pokud (sym_loc->dim1 > 0) { Volej KontrolaMeze_ARM("x0", uzel->left, sym_loc->dim1 * sym_loc->dim2, uzel->line, uzel->name) }
        Volej EmitujASM("    mov x1, x0\n")
        Volej AdresaPole_ARM(sym_loc, "x0")
        Volej EmitujASM("    ldr x0, [x0, x1, lsl #3]\n")
        Vrat 0
    }
    Vrat 0
}

// Odlozene prikazy (Odloz) v opacnem poradi; x0 (navratova hodnota) se zachova
Metoda GenerujOdlozene_ARM(out) {
    Pokud (pocet_defer == 0) { Vrat 0 }
    Volej EmitujASM("    str x0, [sp, #-16]!\n")
    Lokalni d = pocet_defer - 1
    Dokud (d >= 0) {
        Volej GenerujAST_ARM(out, Volej CtiUkazatel(pamet_defer + (d * 8)))
        d = d - 1
    }
    Volej EmitujASM("    ldr x0, [sp], #16\n")
    Vrat 0
}

Metoda GenerujAST_ARM(out, uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    Lokalni t = uzel->type
    Pokud (t == 100) { Vrat 0 }

    Pokud (t == 0) { // PROGRAM
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Volej GenerujAST_ARM(out, Volej CtiUkazatel(uzel->stmts + (i * 8)))
            i = i + 1
        }
        Vrat 0
    }

    Pokud (t == 10) { // METODA
        // Nejdriv optimalizujici backend (IR -> registry); kdyz metodu neumi, jednoduchy generator
        Pokud (arm_ir == 1) {
            Pokud (Volej GenerujMetodu_x86(out, uzel) == 1) { Vrat 0 }
        }
        pocet_ir = 0
        pocet_defer = 0
        codegen_scoped = 1
        codegen_sym_start = uzel->sym_start
        codegen_sym_end = uzel->sym_end
        navesti_navratu = citac_navesti
        citac_navesti = citac_navesti + 1
        Volej EmitujASM_1("%s:\n", uzel->name)
        // Domovska oblast pro x0-x7 si metoda vyhradi sama (volajici ji nerezervuje)
        Volej EmitujASM("    sub sp, sp, #64\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n")
        // Parametry z registru do domovske oblasti nad ramcem
        Volej EmitujASM("    stp x0, x1, [x29, #16]\n    stp x2, x3, [x29, #32]\n    stp x4, x5, [x29, #48]\n    stp x6, x7, [x29, #64]\n")
        Lokalni ramec = ((uzel->int_val + 15) / 16) * 16
        Pokud (ramec > 0 && ramec < 4096) { Volej EmitujASM_1("    sub sp, sp, #%d\n", ramec) }
        Pokud (ramec >= 4096) { Volej EmitujCislo_ARM("x10", ramec); Volej EmitujASM("    sub sp, sp, x10\n") }
        // Kontrola hloubky rekurze (jen metody, ktere neco volaji)
        Pokud (kontroly == 1 && Volej JeJadro() == 0 && (Volej ObsahujeTyp(uzel->right, AST_CALL) == 1 || Volej ObsahujeTyp(uzel->right, AST_PRINT) == 1)) {
            Volej EmitujAdresuSymbolu_ARM("x16", "pramen_mez_zasobniku")
            Volej EmitujASM("    ldr x16, [x16]\n    mov x17, sp\n    cmp x17, x16\n    b.lo pramen_preteceni_zasobniku\n")
        }
        Volej GenerujAST_ARM(out, uzel->right)
        Volej EmitujASM("    mov x0, #0\n")
        Volej GenerujOdlozene_ARM(out)
        Volej EmitujASM_1(".L_ret_%d:\n", navesti_navratu)
        Volej EmitujASM("    mov sp, x29\n    ldp x29, x30, [sp], #16\n    add sp, sp, #64\n    ret\n\n")
        // vypis bufferu metody
        Lokalni k_ir = 0
        Dokud (k_ir < pocet_ir) {
            Lokalni inst : IR_Instrukce = pamet_ir + (k_ir * 48)
            Pokud (inst->opcode == 99) { Volej fputs(inst->src1, out); Volej free(inst->src1) }
            k_ir = k_ir + 1
        }
        pocet_ir = 0
        codegen_scoped = 0
        Vrat 0
    }

    Pokud (t == 34) { // Odloz
        Pokud (pocet_defer >= 499) { Volej printf("Kriticka chyba: Prekrocen limit 500 odlozenych prikazu!\n"); Volej exit(1) }
        Volej ZapisUkazatel(pamet_defer + (pocet_defer * 8), uzel->left)
        pocet_defer = pocet_defer + 1
        Vrat 0
    }

    Pokud (t == 26) { // Asm "arm:..." (x86 varianta se preskoci)
        Lokalni asm_text = uzel->name
        Lokalni z0 = Volej CtiByt(asm_text); Lokalni z1 = Volej CtiByt(asm_text + 1)
        Lokalni z2 = Volej CtiByt(asm_text + 2); Lokalni z3 = Volej CtiByt(asm_text + 3)
        Pokud (z0 == 120 && z1 == 56 && z2 == 54 && z3 == 58) { Vrat 0 }
        Pokud (z0 == 97 && z1 == 114 && z2 == 109 && z3 == 58) { asm_text = asm_text + 4 }
        Volej EmitujASM_1("    %s\n", asm_text)
        Vrat 0
    }

    Pokud (t == 1) { // BLOK
        Lokalni j = 0
        Dokud (j < uzel->stmt_count) {
            Volej GenerujAST_ARM(out, Volej CtiUkazatel(uzel->stmts + (j * 8)))
            j = j + 1
        }
        Vrat 0
    }

    Pokud (t == 3 || t == 4) { // Lokalni / prirazeni
        Lokalni sym_as : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_as == 0) { Volej printf("Chyba (radek %d): Prirazeni do nedeklarovane promenne '%s'.\n", uzel->line, uzel->name); Volej exit(1) }
        Pokud (t == 3 && sym_as->dim1 > 0) { // pole: vynulovat
            Lokalni nl = citac_navesti
            citac_navesti = citac_navesti + 1
            Volej EmitujAdresuPromenne_ARM(sym_as, "x0")
            Volej EmitujCislo_ARM("x1", sym_as->dim1 * sym_as->dim2)
            Volej EmitujASM_1(".L_nul_%d:\n    str xzr, [x0], #8\n    subs x1, x1, #1\n", nl)
            Volej EmitujASM_1("    b.ne .L_nul_%d\n", nl)
            Vrat 0
        }
        Pokud (uzel->right != 0) { Volej GenerujVyraz_ARM(out, uzel->right) } Jinak { Volej EmitujASM("    mov x0, #0\n") }
        Pokud (uzel->op == TOKEN_PLUSEQ || uzel->op == TOKEN_MINUSEQ) {
            Volej NactiPromennou_ARM(sym_as, "x1")
            Pokud (uzel->op == TOKEN_PLUSEQ) { Volej EmitujASM("    add x0, x1, x0\n") } Jinak { Volej EmitujASM("    sub x0, x1, x0\n") }
        }
        Volej UlozPromennou_ARM(sym_as)
        Vrat 0
    }

    Pokud (t == AST_MEMBER_CHAIN_ASSIGN) { // a->b->c = hodnota (ARM64, jednoduchy generator)
        Volej GenerujVyraz_ARM(out, uzel->right)
        Volej EmitujASM("    str x0, [sp, #-16]!\n")
        Volej GenerujVyraz_ARM(out, uzel->left)
        Volej KontrolaUkazatele_ARM("x0", uzel->line)
        Volej EmitujASM("    ldr x1, [sp], #16\n")
        Volej EmitujASM_1("    str x1, [x0, #%d]\n", uzel->int_val)
        Vrat 0
    }
    Pokud (t == 17) { // p->clen = hodnota
        Lokalni sym_z : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_z == 0) { Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", uzel->line, uzel->name); Volej exit(1) }
        Volej GenerujVyraz_ARM(out, uzel->right)
        Volej NactiPromennou_ARM(sym_z, "x1")
        Volej KontrolaUkazatele_ARM("x1", uzel->line)
        Volej EmitujASM_1("    str x0, [x1, #%d]\n", uzel->int_val)
        Vrat 0
    }

    Pokud (t == 19) { // p->clen[i] = hodnota (bajt)
        Lokalni sym_a : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_a == 0) { Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", uzel->line, uzel->name); Volej exit(1) }
        Pokud (Volej JeClenPole(sym_a->type_name, uzel->sub_name) == 0) {
            Volej printf("Chyba (radek %d): '%s->%s' neni pole, nelze ho indexovat.\n", uzel->line, uzel->name, uzel->sub_name)
            Volej exit(1)
        }
        Volej GenerujVyraz_ARM(out, uzel->right)
        Volej EmitujASM("    str x0, [sp, #-16]!\n")
        Volej GenerujVyraz_ARM(out, uzel->left)
        Volej KontrolaMeze_ARM("x0", uzel->left, Volej VelikostClenu(sym_a->type_name, uzel->sub_name), uzel->line, uzel->sub_name)
        Volej EmitujASM("    mov x2, x0\n")
        Volej NactiPromennou_ARM(sym_a, "x1")
        Volej KontrolaUkazatele_ARM("x1", uzel->line)
        Pokud (uzel->int_val != 0) { Volej EmitujASM_1("    add x1, x1, #%d\n", uzel->int_val) }
        Volej EmitujASM("    ldr x0, [sp], #16\n    strb w0, [x1, x2]\n")
        Vrat 0
    }

    Pokud (t == 33) { // a[i] = hodnota
        Lokalni sym_l : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym_l == 0) { Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", uzel->line, uzel->name); Volej exit(1) }
        Volej GenerujVyraz_ARM(out, uzel->right)
        Volej EmitujASM("    str x0, [sp, #-16]!\n")
        Volej GenerujVyraz_ARM(out, uzel->left)
        Pokud (sym_l->dim1 > 0) { Volej KontrolaMeze_ARM("x0", uzel->left, sym_l->dim1 * sym_l->dim2, uzel->line, uzel->name) }
        Volej EmitujASM("    mov x2, x0\n")
        Volej AdresaPole_ARM(sym_l, "x1")
        Volej EmitujASM("    ldr x0, [sp], #16\n    str x0, [x1, x2, lsl #3]\n")
        Vrat 0
    }

    Pokud (t == 20) { Volej GenerujVolani_ARM(out, uzel); Vrat 0 }

    Pokud (t == 25) { // Vypis
        Volej ZakazVJadru(uzel->line, "Vypis")
        Volej GenerujVyraz_ARM(out, uzel->left)
        Lokalni typ_p = Volej ZiskejTypUzlu(uzel->left)
        Lokalni fmt_jm = "fmt_int"
        Pokud (Volej strcmp(typ_p, "Float") == 0) { fmt_jm = "fmt_flt" }
        Pokud (Volej strcmp(typ_p, "String") == 0) { fmt_jm = "fmt_str" }
        Pokud (cilova_platforma == 4) { // macOS: variadicky argument jde na zasobnik
            Volej EmitujASM("    str x0, [sp, #-16]!\n")
            Volej EmitujAdresuSymbolu_ARM("x0", fmt_jm)
            Volej VolejC_ARM("printf")
            Volej EmitujASM("    add sp, sp, #16\n")
        } Jinak {
            Volej EmitujASM("    mov x1, x0\n    fmov d0, x0\n")
            Volej EmitujAdresuSymbolu_ARM("x0", fmt_jm)
            Volej VolejC_ARM("printf")
        }
        Vrat 0
    }

    Pokud (t == 31) { // Uvolni
        Volej ZakazVJadru(uzel->line, "Uvolni")
        Volej GenerujVyraz_ARM(out, uzel->left)
        Volej VolejC_ARM("free")
        Lokalni uv : AST_Node = uzel->left
        Pokud (uv->op == TOKEN_IDENTIFIER) {
            Lokalni uv_sym : Symbol = Volej NajdiSymbol(uv->name)
            Pokud (uv_sym != 0) {
                Pokud (uv_sym->is_function == 0 && uv_sym->is_const == 0 && uv_sym->dim1 == 0) {
                    Volej EmitujASM("    mov x0, #0\n")
                    Volej UlozPromennou_ARM(uv_sym)
                }
            }
        }
        Vrat 0
    }

    Pokud (t == 11) { // Vrat
        Pokud (uzel->left != 0) { Volej GenerujVyraz_ARM(out, uzel->left) } Jinak { Volej EmitujASM("    mov x0, #0\n") }
        Volej GenerujOdlozene_ARM(out)
        Volej EmitujASM_1("    b .L_ret_%d\n", navesti_navratu)
        Vrat 0
    }

    Pokud (t == 6) { // Pokud
        Lokalni lbl_else = citac_navesti; citac_navesti = citac_navesti + 1
        Lokalni lbl_end = citac_navesti; citac_navesti = citac_navesti + 1
        Volej GenerujVyraz_ARM(out, uzel->left)
        Volej EmitujASM_1("    cbz x0, .L_label_%d\n", lbl_else)
        Volej GenerujAST_ARM(out, uzel->right)
        Pokud (uzel->alt != 0) { Volej EmitujASM_1("    b .L_label_%d\n", lbl_end) }
        Volej EmitujASM_1(".L_label_%d:\n", lbl_else)
        Pokud (uzel->alt != 0) {
            Volej GenerujAST_ARM(out, uzel->alt)
            Volej EmitujASM_1(".L_label_%d:\n", lbl_end)
        }
        Vrat 0
    }

    Pokud (t == 7) { // Dokud
        Lokalni lbl_s = citac_navesti; citac_navesti = citac_navesti + 1
        Lokalni lbl_e = citac_navesti; citac_navesti = citac_navesti + 1
        Volej ZapisUkazatel(loop_label_stack + (loop_stack_depth * 8), lbl_e)
        Volej ZapisUkazatel(loop_continue_stack + (loop_stack_depth * 8), lbl_s)
        Volej VstupDoCyklu(uzel->line)
        loop_stack_depth = loop_stack_depth + 1
        Volej EmitujASM_1(".L_label_%d:\n", lbl_s)
        Volej GenerujVyraz_ARM(out, uzel->left)
        Volej EmitujASM_1("    cbz x0, .L_label_%d\n", lbl_e)
        Volej GenerujAST_ARM(out, uzel->right)
        Volej EmitujASM_1("    b .L_label_%d\n", lbl_s)
        Volej EmitujASM_1(".L_label_%d:\n", lbl_e)
        loop_stack_depth = loop_stack_depth - 1
        Vrat 0
    }

    Pokud (t == 8) { // Opakuj (start, podminka, krok)
        Lokalni lbl_fs = citac_navesti; citac_navesti = citac_navesti + 1
        Lokalni lbl_fe = citac_navesti; citac_navesti = citac_navesti + 1
        Lokalni lbl_fc = citac_navesti; citac_navesti = citac_navesti + 1
        Volej ZapisUkazatel(loop_label_stack + (loop_stack_depth * 8), lbl_fe)
        Volej ZapisUkazatel(loop_continue_stack + (loop_stack_depth * 8), lbl_fc)
        Volej VstupDoCyklu(uzel->line)
        loop_stack_depth = loop_stack_depth + 1
        Volej GenerujAST_ARM(out, uzel->left)
        Volej EmitujASM_1(".L_label_%d:\n", lbl_fs)
        Volej GenerujVyraz_ARM(out, uzel->right)
        Volej EmitujASM_1("    cbz x0, .L_label_%d\n", lbl_fe)
        Volej GenerujAST_ARM(out, Volej CtiUkazatel(uzel->stmts))
        Volej EmitujASM_1(".L_label_%d:\n", lbl_fc)
        Volej GenerujAST_ARM(out, uzel->alt)
        Volej EmitujASM_1("    b .L_label_%d\n", lbl_fs)
        Volej EmitujASM_1(".L_label_%d:\n", lbl_fe)
        loop_stack_depth = loop_stack_depth - 1
        Vrat 0
    }

    Pokud (t == 22 || t == 23) { // Ukonci / Pokracuj
        Pokud (loop_stack_depth == 0) {
            Volej printf("Chyba (radek %d): Ukonci/Pokracuj smi byt jen uvnitr cyklu.\n", uzel->line)
            Volej exit(1)
        }
        Lokalni cil = 0
        Pokud (t == 22) { cil = Volej CtiUkazatel(loop_label_stack + ((loop_stack_depth - 1) * 8)) }
        Jinak { cil = Volej CtiUkazatel(loop_continue_stack + ((loop_stack_depth - 1) * 8)) }
        Volej EmitujASM_1("    b .L_label_%d\n", cil)
        Vrat 0
    }

    Pokud (t == 28) { // Rozcestnik
        Lokalni sw = citac_navesti
        citac_navesti = citac_navesti + uzel->stmt_count + 2
        Volej GenerujVyraz_ARM(out, uzel->left)
        Lokalni c = 0
        Dokud (c < uzel->stmt_count) {
            Lokalni cesta : AST_Node = Volej CtiUkazatel(uzel->stmts + (c * 8))
            Lokalni hc : AST_Node = cesta->left
            Volej EmitujCislo_ARM("x1", Volej NaCislo(hc->name))
            Volej EmitujASM_1("    cmp x0, x1\n    b.eq .L_sw_%d\n", sw + c)
            c = c + 1
        }
        Volej EmitujASM_1("    b .L_sw_%d\n", sw + uzel->stmt_count)
        c = 0
        Dokud (c < uzel->stmt_count) {
            Lokalni cesta2 : AST_Node = Volej CtiUkazatel(uzel->stmts + (c * 8))
            Volej EmitujASM_1(".L_sw_%d:\n", sw + c)
            Volej GenerujAST_ARM(out, cesta2->right)
            Volej EmitujASM_1("    b .L_sw_%d\n", sw + uzel->stmt_count + 1)
            c = c + 1
        }
        Volej EmitujASM_1(".L_sw_%d:\n", sw + uzel->stmt_count)
        Pokud (uzel->alt != 0) { Volej GenerujAST_ARM(out, uzel->alt) }
        Volej EmitujASM_1(".L_sw_%d:\n", sw + uzel->stmt_count + 1)
        Vrat 0
    }
    Vrat 0
}

Metoda GeneratorASM_ARM(ast_koren : AST_Node, vystupni_soubor) {
    Volej printf("Generator ARM: Zapisuji do %s...\n", vystupni_soubor)
    Lokalni out = Volej fopen(vystupni_soubor, "w")
    Pokud (out == 0) {
        Volej printf("Chyba: Nelze vytvorit soubor '%s'.\n", vystupni_soubor)
        Volej exit(1)
    }
    Volej fputs(".data\n    .p2align 3\n", out)
    Volej fputs("fmt_int: .asciz \"%lld\\n\"\nfmt_flt: .asciz \"%f\\n\"\nfmt_str: .asciz \"%s\\n\"\n", out)
    Lokalni i = 0
    Lokalni flt_id = 0
    Dokud (i < pocet_tokenu) {
        Lokalni tk : Token = pamet_tokenu + (i * Velikost(Token))
        Pokud (tk->type == TOKEN_STRING) {
            Volej fprintf(out, "str%d: .byte ", tk->str_id)
            Volej ZapisBajtyTextu(out, tk->value)
        }
        Pokud (tk->type == TOKEN_FLOAT) {
            Volej fprintf(out, "    .p2align 3\nflt%d: .double %s\n", flt_id, tk->value)
            flt_id = flt_id + 1
        }
        i = i + 1
    }
    Volej fputs("    .p2align 3\n", out)
    Lokalni sg = 0
    Dokud (sg < pocet_symbolu) {
        Lokalni sym : Symbol = pamet_symbolu + (sg * Velikost(Symbol))
        Pokud (sym->is_function == 1 && Volej strcmp(sym->init_str, "Pamatuj") == 0) {
            Volej fprintf(out, "pam_%s: .zero %d\npamok_%s: .zero %d\n", sym->name, PAM_VELIKOST * 8, sym->name, PAM_VELIKOST * 8)
        }
        Pokud (sym->is_global == 1 && sym->is_const == 0 && sym->is_function == 0 && sym->dim1 > 0) {
            Volej fprintf(out, "gvar_%s: .zero %lld\n", sym->name, sym->dim1 * sym->dim2 * 8)
        } Jinak Pokud (sym->is_global == 1 && sym->is_const == 0 && sym->is_function == 0) {
            Pokud (Volej CtiByt(sym->init_str) != 0) {
                Pokud (Volej strcmp(sym->type_name, "Float") == 0) { Volej fprintf(out, "gvar_%s: .double %s\n", sym->name, sym->init_str) }
                Jinak { Volej fprintf(out, "gvar_%s: .quad %s\n", sym->name, sym->init_str) }
            } Jinak { Volej fprintf(out, "gvar_%s: .quad %lld\n", sym->name, sym->const_val) }
        }
        sg = sg + 1
    }
    Pokud (cilova_platforma == 5) { // zasobnik jadra (64 KiB)
        Volej fputs("    .p2align 4\njadro_zasobnik: .skip 65536\njadro_zasobnik_vrchol:\n", out)
    }

    Volej fputs("\n.text\n    .p2align 2\n", out)
    Pokud (cilova_platforma == 5) {
        // Jadro: vstupni bod _start, vlastni zasobnik, po navratu z Hlavni se procesor uspi
        Volej fputs(".global _start\n_start:\n", out)
        Volej fputs("    adrp x0, jadro_zasobnik_vrchol\n    add x0, x0, :lo12:jadro_zasobnik_vrchol\n    mov sp, x0\n", out)
        Volej fputs("    mov x29, #0\n    bl Hlavni\n1:  wfe\n    b 1b\n\n", out)
    } Jinak {
        Lokalni hl = "main"
        Pokud (cilova_platforma == 4) { hl = "_main" }
        Volej fprintf(out, ".global %s\n%s:\n", hl, hl)
        Volej fputs("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n", out)
        // Mez zasobniku: 7 MB pod vrcholem (vychozi zasobnik ma 8 MB)
        Volej fputs("    mov x9, sp\n    sub x9, x9, #0x700, lsl #12\n", out)
        Pokud (cilova_platforma == 4) {
            Volej fputs("    adrp x10, pramen_mez_zasobniku@PAGE\n    add x10, x10, pramen_mez_zasobniku@PAGEOFF\n    str x9, [x10]\n", out)
        } Jinak {
            Volej fputs("    adrp x10, pramen_mez_zasobniku\n    add x10, x10, :lo12:pramen_mez_zasobniku\n    str x9, [x10]\n", out)
        }
        Pokud (cilova_platforma == 4) {
            Volej fputs("    adrp x9, gvar_sys_argc@PAGE\n    add x9, x9, gvar_sys_argc@PAGEOFF\n    str x0, [x9]\n", out)
            Volej fputs("    adrp x9, gvar_sys_argv@PAGE\n    add x9, x9, gvar_sys_argv@PAGEOFF\n    str x1, [x9]\n", out)
        } Jinak {
            Volej fputs("    adrp x9, gvar_sys_argc\n    add x9, x9, :lo12:gvar_sys_argc\n    str x0, [x9]\n", out)
            Volej fputs("    adrp x9, gvar_sys_argv\n    add x9, x9, :lo12:gvar_sys_argv\n    str x1, [x9]\n", out)
        }
        Volej fputs("    sub sp, sp, #64\n    bl Hlavni\n    add sp, sp, #64\n", out)
        Volej fprintf(out, "    bl %s\n\n", Volej NazevC_ARM("exit"))
        Volej fputs("pramen_preteceni_zasobniku:\n", out)
        Pokud (cilova_platforma == 4) { Volej fputs("    adrp x0, err_zasobnik@PAGE\n    add x0, x0, err_zasobnik@PAGEOFF\n", out) }
        Jinak { Volej fputs("    adrp x0, err_zasobnik\n    add x0, x0, :lo12:err_zasobnik\n", out) }
        Volej fprintf(out, "    bl %s\n    mov x0, #1\n    bl %s\n\n", Volej NazevC_ARM("puts"), Volej NazevC_ARM("exit"))
    }

    Volej GenerujAST_ARM(out, ast_koren)

    Volej fputs("\n.data\n", out)
    Pokud (cilova_platforma != 5) {
        Volej fputs("    .p2align 3\npramen_mez_zasobniku: .quad 0\nerr_zasobnik: .byte ", out)
        Volej ZapisBajtyTextu(out, "Chyba za behu: preteceni zasobniku (prilis hluboka rekurze)")
    }
    Lokalni e = 0
    Dokud (e < pocet_chyb) {
        Volej fprintf(out, "err_msg%d: .byte ", e)
        Volej ZapisBajtyTextu(out, pamet_chyb + (e * 256))
        e = e + 1
    }
    Pokud (cilova_platforma == 6) { Volej fputs(".section .note.GNU-stack,\"\",@progbits\n", out) }
    Volej fclose(out)
    Vrat 0
}

Metoda Hlavni() {
    pamet_struktur_clenove = Volej calloc(500, 1032)
    pocet_struktur_clenu = 0
    pamet_struktur_def = Volej calloc(100, 520)
    pocet_struktur_def = 0

    pamet_symbolu = Volej calloc(kapacita_symbolu, Velikost(Symbol))
    hash_tabulka = Volej calloc(4096, 8)
    pamet_ir = Volej calloc(kapacita_ir, Velikost(IR_Instrukce))
    pamet_intervalu = Volej calloc(kapacita_intervalu, Velikost(LiveInterval))
    loop_label_stack = Volej calloc(200, 8)
    loop_continue_stack = Volej calloc(200, 8)
    loop_stack_depth = 0
    pamet_externu = Volej calloc(200, 256)
    pocet_externu = 0
    pamet_defer = Volej calloc(500, 8)
    pocet_defer = 0

    Volej PridejGlobalniSymbol("sys_argc", 0)
    Volej PridejGlobalniSymbol("sys_argv", 0)

    // --- Prikazova radka: pramen <zdroj.pra> [vystup] [--cil=...] [--jen-asm] [--podrobne] ---
    Lokalni nazev_zdrojaku = 0
    Lokalni nazev_vystupu = "program"
    Lokalni pozicni = 0
    Lokalni jen_asm = 0
    // Vychozi cil = system, na kterem kompilator bezi
    cilova_platforma = 1
    Lokalni test_win = Volej fopen("C:\\Windows\\System32\\cmd.exe", "r")
    Lokalni host_is_win = 0
    Pokud (test_win != 0) { host_is_win = 1; cilova_platforma = 2; Volej fclose(test_win) }

    Lokalni ai = 1
    Dokud (ai < sys_argc) {
        Lokalni arg = CtiZAdresu(sys_argv + (ai * 8))
        Pokud (Volej CtiByt(arg) == 45 && Volej CtiByt(arg + 1) == 45) { // "--"
            Pokud (Volej strcmp(arg, "--cil=apple") == 0 || Volej strcmp(arg, "--cil=macos") == 0) { cilova_platforma = 0 }
            Jinak Pokud (Volej strcmp(arg, "--cil=linux") == 0) { cilova_platforma = 1 }
            Jinak Pokud (Volej strcmp(arg, "--cil=windows") == 0) { cilova_platforma = 2 }
            Jinak Pokud (Volej strcmp(arg, "--cil=kernel") == 0) { cilova_platforma = 3 }
            Jinak Pokud (Volej strcmp(arg, "--cil=apple-arm") == 0 || Volej strcmp(arg, "--cil=macos-arm") == 0) { cilova_platforma = 4 }
            Jinak Pokud (Volej strcmp(arg, "--cil=kernel-arm") == 0) { cilova_platforma = 5 }
            Jinak Pokud (Volej strcmp(arg, "--cil=linux-arm") == 0) { cilova_platforma = 6 }
            Jinak Pokud (Volej strcmp(arg, "--jen-asm") == 0) { jen_asm = 1 }
            Jinak Pokud (Volej strcmp(arg, "--podrobne") == 0) { podrobny_vypis = 1 }
            Jinak Pokud (Volej strcmp(arg, "--vypis-ir") == 0) { vypis_ir = 1 }
            Jinak Pokud (Volej strcmp(arg, "--bez-vektorizace") == 0) { vek_vypnuto = 1 }
            Jinak Pokud (Volej strcmp(arg, "--bez-rekurence") == 0) { rek_vypnuto = 1 }
            Jinak Pokud (Volej strcmp(arg, "--bez-zarovnani") == 0) { zarovnani_vypnuto = 1 }
            Jinak Pokud (Volej strcmp(arg, "--bez-vkladani") == 0) { inl_vypnuto = 1 }
            Jinak Pokud (Volej strcmp(arg, "--bez-redukce") == 0) { sr_vypnuto = 1 }
            Jinak Pokud (Volej strcmp(arg, "--bez-arm-ir") == 0) { arm_ir = 0 }
            Jinak Pokud (Volej strcmp(arg, "--bez-kontrol") == 0) { kontroly = 0 }
            Jinak {
                Volej printf("Neznamy prepinac '%s'.\n", arg)
                Volej exit(1)
            }
        } Jinak {
            Pokud (pozicni == 0) { nazev_zdrojaku = arg }
            Jinak Pokud (pozicni == 1) { nazev_vystupu = arg }
            Jinak { Volej printf("Prilis mnoho argumentu ('%s').\n", arg); Volej exit(1) }
            pozicni = pozicni + 1
        }
        ai = ai + 1
    }
    Pokud (nazev_zdrojaku == 0) {
        Volej printf("Pramen - kompilator\n")
        Volej printf("Pouziti: pramen <program.pra> [vystup] [--cil=linux|windows|macos|linux-arm|macos-arm|kernel|kernel-arm]\n")
        Volej printf("        [--jen-asm] [--podrobne] [--bez-kontrol] [--bez-vkladani]\n")
        Volej exit(1)
    }

    Pokud (cilova_platforma == 0) { Volej printf("Cilova platforma: macOS (x86-64)\n") }
    Jinak Pokud (cilova_platforma == 1) { Volej printf("Cilova platforma: Linux (x86-64)\n") }
    Jinak Pokud (cilova_platforma == 2) { Volej printf("Cilova platforma: Windows (x86-64)\n") }
    Jinak Pokud (cilova_platforma == 3) { Volej printf("Cilova platforma: JADRO OS (x86-64, bez knihovny C)\n") }
    Jinak Pokud (cilova_platforma == 4) { Volej printf("Cilova platforma: macOS (Apple Silicon, ARM64)\n") }
    Jinak Pokud (cilova_platforma == 5) { Volej printf("Cilova platforma: JADRO OS (ARM64, bez knihovny C)\n") }
    Jinak Pokud (cilova_platforma == 6) { Volej printf("Cilova platforma: Linux (ARM64)\n") }
    Volej fflush(0)

    Volej printf("--- START KOMPILACE ---\n")
    Volej fflush(0)

    pamet_tokenu = Volej calloc(kapacita_tokenu, Velikost(Token))
    
    Volej Lexer(nazev_zdrojaku)
    Lokalni ast = Volej Parser()
    Lokalni hl_sym : Symbol = Volej NajdiSymbol("Hlavni")
    Lokalni ma_hlavni = 0
    Pokud (hl_sym != 0) { Pokud (hl_sym->is_function == 1) { ma_hlavni = 1 } }
    Pokud (ma_hlavni == 0) {
        Volej printf("Chyba: Program nema metodu 'Hlavni' (tam program zacina).\n")
        Volej exit(1)
    }
    
    Volej printf("Typova kontrola...\n")
    Volej ZkontrolujAST(ast)
    Volej printf("Spoustim Middle-End optimalizace...\n")
    
    Volej OptimalizujBezpecnyInlining(ast)
    Volej OptimalizujGCP(ast)
    Volej OptimalizujDCE(ast)
    Volej OptimalizujCSE(ast)

    Lokalni asm_soub = Volej calloc(1, 512)
    Lokalni obj_soub = Volej calloc(1, 512)
    Lokalni exe_soub = Volej calloc(1, 512)
    Lokalni cmd_asm = Volej calloc(1, 2048)
    Lokalni cmd_link = Volej calloc(1, 2048)
    Pokud (Volej strlen(nazev_vystupu) > 400) { Volej printf("Chyba: Prilis dlouhe jmeno vystupu.\n"); Volej exit(1) }
    // Jmeno vystupu se vklada do prikazu pro shell -> povolime jen bezpecne znaky
    Lokalni zi = 0
    Lokalni zn = Volej CtiByt(nazev_vystupu)
    Dokud (zn != 0) {
        Lokalni ok_znak = 0
        Pokud ((zn >= 48 && zn <= 57) || (zn >= 65 && zn <= 90) || (zn >= 97 && zn <= 122)) { ok_znak = 1 }
        Pokud (zn == 95 || zn == 45 || zn == 46 || zn == 47 || zn == 92 || zn == 58) { ok_znak = 1 }
        Pokud (ok_znak == 0) {
            Volej printf("Chyba: Jmeno vystupu smi obsahovat jen pismena, cislice a znaky _ - . / \\ :\n")
            Volej exit(1)
        }
        zi = zi + 1
        zn = Volej CtiByt(nazev_vystupu + zi)
    }

    Pokud (Volej JeARM() == 1) { Volej sprintf(asm_soub, "%s.s", nazev_vystupu) } Jinak { Volej sprintf(asm_soub, "%s.asm", nazev_vystupu) }
    Pokud (cilova_platforma == 2) {
        Volej sprintf(obj_soub, "%s.obj", nazev_vystupu)
        Volej sprintf(exe_soub, "%s.exe", nazev_vystupu)
    } Jinak {
        Volej sprintf(obj_soub, "%s.o", nazev_vystupu)
        Volej sprintf(exe_soub, "%s", nazev_vystupu)
    }

    Volej GeneratorASM(ast, asm_soub)
    Pokud (jen_asm == 1) {
        Volej printf("--- DOKONCENO (jen assembler: %s) ---\n", asm_soub)
        Vrat 0
    }

    Pokud (cilova_platforma == 0) {
        Volej sprintf(cmd_asm, "nasm -f macho64 \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_link, "clang -arch x86_64 \"%s\" -o \"%s\"", obj_soub, exe_soub)
    } Jinak Pokud (cilova_platforma == 1) {
        Volej sprintf(cmd_asm, "nasm -f elf64 \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_link, "gcc -no-pie \"%s\" -o \"%s\" -lm", obj_soub, exe_soub)
    } Jinak Pokud (cilova_platforma == 2) {
        Volej sprintf(cmd_asm, "nasm -f win64 \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_link, "gcc \"%s\" -o \"%s\"", obj_soub, exe_soub)
    } Jinak Pokud (cilova_platforma == 3) {
        Volej sprintf(cmd_asm, "nasm -f elf64 \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_link, "ld -nostdlib -static -e _start -Ttext 0x100000 \"%s\" -o \"%s.elf\"", obj_soub, exe_soub)
    } Jinak Pokud (cilova_platforma == 4) {
        Volej sprintf(cmd_asm, "as -arch arm64 \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_link, "clang -arch arm64 \"%s\" -o \"%s\"", obj_soub, exe_soub)
    } Jinak Pokud (cilova_platforma == 5) {
        Pokud (host_is_win == 1) {
            Volej sprintf(cmd_asm, "aarch64-none-elf-as \"%s\" -o \"%s\"", asm_soub, obj_soub)
            Volej sprintf(cmd_link, "aarch64-none-elf-ld -nostdlib -e _start -Ttext 0x40080000 \"%s\" -o \"%s.elf\"", obj_soub, exe_soub)
        } Jinak {
            Volej sprintf(cmd_asm, "aarch64-linux-gnu-as \"%s\" -o \"%s\"", asm_soub, obj_soub)
            Volej sprintf(cmd_link, "aarch64-linux-gnu-ld -nostdlib -e _start -Ttext 0x40080000 \"%s\" -o \"%s.elf\"", obj_soub, exe_soub)
        }
    } Jinak Pokud (cilova_platforma == 6) {
        Volej sprintf(cmd_asm, "aarch64-linux-gnu-as \"%s\" -o \"%s\"", asm_soub, obj_soub)
        Volej sprintf(cmd_link, "aarch64-linux-gnu-gcc -static \"%s\" -o \"%s\" -lm", obj_soub, exe_soub)
    }

    Pokud (Volej system(cmd_asm) != 0) {
        Volej printf("Chyba: Assembler selhal (%s).\n", cmd_asm)
        Volej exit(1)
    }
    Pokud (Volej system(cmd_link) != 0) {
        Volej printf("Chyba: Linker selhal (%s).\n", cmd_link)
        Volej exit(1)
    }
    Volej printf("--- DOKONCENO ---\n")
    Vrat 0
}
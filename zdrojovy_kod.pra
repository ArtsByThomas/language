// 3. Definice Struktur
Struktura Symbol {
    name[256]
    is_global
    is_const
    const_val
    init_str[64]
    offset
    dim1
    dim2
    type_name[64]
    scope_depth
    is_active
    is_function   // <-- NOVÉ: Příznak, že jde o metodu
    func_node     // <-- NOVÉ: Odkaz na AST uzel metody s detaily o argumentech
}

Struktura AST_Node {
    type
    left
    right
    stmts
    stmt_count
    stmt_capacity
    name[256]
    sub_name[64]
    int_val
    op
    line
    sym_start
    sym_end
    alt
    arg_count       // <-- NOVÉ: Počet argumentů metody
    type_name[64]   // <-- NOVÉ: Návratový typ metody
}

// Přidejte tuto proměnnou mezi ostatní 'Globalni' definice (např. pod aktualni_hloubka_bloku)
Globalni kontrola_aktualni_typ_metody = 0
Struktura Token {
    type
    value[256]
    str_id
    line
}



Struktura StructMember {
    name[64]
    value[64]
    offset
}

Struktura StructDef {
    name[64]
    size
}


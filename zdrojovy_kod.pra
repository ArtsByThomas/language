// ==========================================
// CONTROL FLOW GRAPH (CFG) A LIVENESS ALCHYMIE
// ==========================================
Globalni pamet_bloku = 0
Globalni pocet_bloku = 0
Metoda VycistiSymbol(sym) {
    Lokalni z = 0
    Dokud (z < Velikost(Symbol)) { // <-- OPRAVA ZDE
        Volej ZapisByte(sym + z, 0)
        z = z + 1
    }
}
// ==========================================
// MIDDLE-END: OPTIMALIZACE NA URovni AST
// ==========================================
// Zasada: optimalizace NESMI zmenit vyznam programu. Kazda proto overuje sve
// predpoklady a pri nejistote radeji nic nedela. Prikaz Asm je pro vsechny
// optimalizace bariera (muze menit cokoli), stejne tak CtiZAdresu (hardware).

// Obsahuje podstrom uzel daneho typu? (prochazi i tela cyklu a Cesty Rozcestniku)
Metoda ObsahujeTyp(uzel : AST_Node, typ) {
    Pokud (uzel == 0) { Vrat 0 }
    Pokud (uzel->type == typ) { Vrat 1 }
    Pokud (Volej ObsahujeTyp(uzel->left, typ) == 1) { Vrat 1 }
    Pokud (Volej ObsahujeTyp(uzel->right, typ) == 1) { Vrat 1 }
    Pokud (Volej ObsahujeTyp(uzel->alt, typ) == 1) { Vrat 1 }
    Pokud (uzel->stmts != 0) {
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Pokud (Volej ObsahujeTyp(Volej CtiUkazatel(uzel->stmts + (i * 8)), typ) == 1) { Vrat 1 }
            i = i + 1
        }
    }
    Vrat 0
}

// Prirazuje podstrom (kdekoli) do promenne daneho jmena?
Metoda PrirazujeDo(uzel : AST_Node, jmeno) {
    Pokud (uzel == 0) { Vrat 0 }
    Pokud (uzel->type == AST_VAR_DECL || uzel->type == AST_ASSIGN || uzel->type == AST_FREE) {
        Pokud (Volej strcmp(uzel->name, jmeno) == 0) { Vrat 1 }
    }
    Pokud (uzel->type == AST_FREE) { // Uvolni x -> x = 0
        Lokalni uv : AST_Node = uzel->left
        Pokud (uv != 0) { Pokud (Volej strcmp(uv->name, jmeno) == 0) { Vrat 1 } }
    }
    Pokud (uzel->type == AST_ASM_NODE) { Vrat 1 } // Asm muze zmenit cokoli
    Pokud (Volej PrirazujeDo(uzel->left, jmeno) == 1) { Vrat 1 }
    Pokud (Volej PrirazujeDo(uzel->right, jmeno) == 1) { Vrat 1 }
    Pokud (Volej PrirazujeDo(uzel->alt, jmeno) == 1) { Vrat 1 }
    Pokud (uzel->stmts != 0) {
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Pokud (Volej PrirazujeDo(Volej CtiUkazatel(uzel->stmts + (i * 8)), jmeno) == 1) { Vrat 1 }
            i = i + 1
        }
    }
    Vrat 0
}

Metoda JePrimePrirazeni(p : AST_Node) {
    // AST_ASSIGN s operatorem '=' (ne += / -=)
    Pokud (p == 0) { Vrat 0 }
    Pokud (p->type != AST_ASSIGN) { Vrat 0 }
    Pokud (p->op == TOKEN_PLUSEQ || p->op == TOKEN_MINUSEQ) { Vrat 0 }
    Vrat 1
}

// --- SCEV: cykly "i = i + 1" s predvidatelnym vysledkem prepocitame v O(1) ---
//   Dokud (i < MAX) { i = i + 1 }                -> Pokud (i < MAX) { i = MAX }
//   Dokud (i < MAX) { s = s + X; i = i + 1 }     -> Pokud (i < MAX) { s = s + (MAX - i) * X; i = MAX }
// Obal "Pokud (i < MAX)" je nutny: kdyz uz plati i >= MAX, puvodni cyklus neudela nic.
Metoda OptimalizujSCEV(uzel_cyklu : AST_Node) {
    Pokud (uzel_cyklu->type != AST_WHILE) { Vrat 0 }
    Lokalni podminka : AST_Node = uzel_cyklu->left
    Pokud (podminka == 0 || podminka->op != TOKEN_LESS) { Vrat 0 } // jen "<"
    Lokalni iter_uzel : AST_Node = podminka->left
    Lokalni max_uzel : AST_Node = podminka->right
    Pokud (iter_uzel == 0 || max_uzel == 0) { Vrat 0 }
    Pokud (iter_uzel->op != TOKEN_IDENTIFIER) { Vrat 0 }
    Pokud (max_uzel->op != TOKEN_NUMBER && max_uzel->op != TOKEN_IDENTIFIER) { Vrat 0 }
    Lokalni iter_jmeno = iter_uzel->name
    Pokud (max_uzel->op == TOKEN_IDENTIFIER && Volej strcmp(max_uzel->name, iter_jmeno) == 0) { Vrat 0 }
    Lokalni iter_sym : Symbol = Volej NajdiSymbol(iter_jmeno)
    Pokud (iter_sym == 0) { Vrat 0 }
    Pokud (iter_sym->is_global == 1 || iter_sym->dim1 > 0) { Vrat 0 }
    Pokud (Volej strcmp(iter_sym->type_name, "Float") == 0) { Vrat 0 }

    Lokalni telo : AST_Node = uzel_cyklu->right
    Pokud (telo == 0 || telo->type != AST_BLOCK) { Vrat 0 }
    Pokud (telo->stmt_count == 0 || telo->stmt_count > 2) { Vrat 0 }

    // Posledni prikaz: i = i + 1
    Lokalni posl_prikaz : AST_Node = Volej CtiUkazatel(telo->stmts + ((telo->stmt_count - 1) * 8))
    Pokud (Volej JePrimePrirazeni(posl_prikaz) == 0) { Vrat 0 }
    Pokud (Volej strcmp(posl_prikaz->name, iter_jmeno) != 0) { Vrat 0 }
    Lokalni inkrement : AST_Node = posl_prikaz->right
    Pokud (inkrement == 0 || inkrement->op != TOKEN_PLUS) { Vrat 0 }
    Lokalni ink_l : AST_Node = inkrement->left
    Lokalni ink_p : AST_Node = inkrement->right
    Pokud (ink_l == 0 || ink_p == 0) { Vrat 0 }
    Pokud (ink_l->op != TOKEN_IDENTIFIER || Volej strcmp(ink_l->name, iter_jmeno) != 0) { Vrat 0 }
    Pokud (ink_p->op != TOKEN_NUMBER || Volej NaCislo(ink_p->name) != 1) { Vrat 0 }

    // Novy uzel "i = MAX"
    Lokalni a_iter : AST_Node = Volej VytvorUzel(AST_ASSIGN, uzel_cyklu->line)
    a_iter->op = TOKEN_EQ
    Volej strncpy(a_iter->name, iter_jmeno, 255)
    a_iter->right = Volej KopirujUzel(max_uzel)

    Lokalni nove_telo : AST_Node = Volej VytvorUzel(AST_BLOCK, uzel_cyklu->line)

    Pokud (telo->stmt_count == 1) {
        // Prazdny cyklus. Na jadru OS muze jit o zamerne cekani -> nechame ho byt.
        Pokud (cilova_platforma == 3 || cilova_platforma == 5) { Vrat 0 }
        nove_telo->stmts = Volej calloc(1, 8)
        nove_telo->stmt_count = 1
        Volej ZapisUkazatel(nove_telo->stmts, a_iter)
        Volej printf(">> SCEV Magie (-O3): Prazdny cyklus '%s' preveden na O(1) cas!\n", iter_jmeno)
    } Jinak {
        Lokalni prvni_prikaz : AST_Node = Volej CtiUkazatel(telo->stmts)
        Pokud (Volej JePrimePrirazeni(prvni_prikaz) == 0) { Vrat 0 }
        Lokalni suma_jmeno = prvni_prikaz->name
        Pokud (Volej strcmp(suma_jmeno, iter_jmeno) == 0) { Vrat 0 }
        Pokud (max_uzel->op == TOKEN_IDENTIFIER && Volej strcmp(max_uzel->name, suma_jmeno) == 0) { Vrat 0 }
        Lokalni suma_sym : Symbol = Volej NajdiSymbol(suma_jmeno)
        Pokud (suma_sym == 0) { Vrat 0 }
        Pokud (suma_sym->dim1 > 0) { Vrat 0 }
        Pokud (Volej strcmp(suma_sym->type_name, "") != 0 && Volej strcmp(suma_sym->type_name, "Cislo") != 0) { Vrat 0 }
        Lokalni s_vyraz : AST_Node = prvni_prikaz->right
        Pokud (s_vyraz == 0 || s_vyraz->op != TOKEN_PLUS) { Vrat 0 }
        Lokalni s_levy : AST_Node = s_vyraz->left
        Lokalni s_pravy : AST_Node = s_vyraz->right
        Pokud (s_levy == 0 || s_pravy == 0) { Vrat 0 }
        Pokud (s_levy->op != TOKEN_IDENTIFIER || Volej strcmp(s_levy->name, suma_jmeno) != 0) { Vrat 0 }
        Pokud (s_pravy->op != TOKEN_NUMBER) { Vrat 0 }

        // s = s + (MAX - i) * X
        Lokalni a_suma : AST_Node = Volej VytvorUzel(AST_ASSIGN, uzel_cyklu->line)
        a_suma->op = TOKEN_EQ
        Volej strncpy(a_suma->name, suma_jmeno, 255)
        Lokalni st_plus : AST_Node = Volej VytvorUzel(AST_EXPR, uzel_cyklu->line); st_plus->op = TOKEN_PLUS
        Lokalni st_mul : AST_Node = Volej VytvorUzel(AST_EXPR, uzel_cyklu->line); st_mul->op = TOKEN_MUL
        Lokalni st_sub : AST_Node = Volej VytvorUzel(AST_EXPR, uzel_cyklu->line); st_sub->op = TOKEN_MINUS
        st_sub->left = Volej KopirujUzel(max_uzel)
        st_sub->right = Volej KopirujUzel(iter_uzel)
        st_mul->left = st_sub
        st_mul->right = Volej KopirujUzel(s_pravy)
        st_plus->left = Volej KopirujUzel(s_levy)
        st_plus->right = st_mul
        a_suma->right = st_plus

        nove_telo->stmts = Volej calloc(2, 8)
        nove_telo->stmt_count = 2
        Volej ZapisUkazatel(nove_telo->stmts + 0, a_suma)
        Volej ZapisUkazatel(nove_telo->stmts + 8, a_iter)
        Volej printf(">> SCEV Magie (-O3): Soucet v cyklu '%s' preveden na O(1) matematiku!\n", iter_jmeno)
    }
    // Dokud -> Pokud se stejnou podminkou
    uzel_cyklu->type = AST_IF
    uzel_cyklu->right = nove_telo
    uzel_cyklu->alt = 0
    Vrat 1
}

// --- Rozbaleni kratkych cyklu Opakuj (i = A; i < B; i = i + 1) s nejvyse 10 pruchody ---
Metoda OptimalizujRozbaleniOpakuj(uzel_for : AST_Node) {
    Pokud (uzel_for->type != AST_FOR) { Vrat 0 }
    Lokalni init_uzel : AST_Node = uzel_for->left
    Lokalni cond_uzel : AST_Node = uzel_for->right
    Lokalni inc_uzel : AST_Node = uzel_for->alt
    Pokud (init_uzel == 0) { Vrat 0 }
    Pokud (init_uzel->type != AST_ASSIGN && init_uzel->type != AST_VAR_DECL) { Vrat 0 }
    Pokud (init_uzel->type == AST_ASSIGN && Volej JePrimePrirazeni(init_uzel) == 0) { Vrat 0 }
    Lokalni start_vyraz : AST_Node = init_uzel->right
    Pokud (start_vyraz == 0 || start_vyraz->op != TOKEN_NUMBER) { Vrat 0 }
    Lokalni iter_jmeno = init_uzel->name
    Lokalni start_val = Volej NaCislo(start_vyraz->name)

    Pokud (cond_uzel == 0 || cond_uzel->op != TOKEN_LESS) { Vrat 0 }
    Lokalni cond_l : AST_Node = cond_uzel->left
    Lokalni cond_p : AST_Node = cond_uzel->right
    Pokud (cond_l == 0 || cond_p == 0) { Vrat 0 }
    Pokud (cond_l->op != TOKEN_IDENTIFIER || Volej strcmp(cond_l->name, iter_jmeno) != 0) { Vrat 0 }
    Pokud (cond_p->op != TOKEN_NUMBER) { Vrat 0 }
    Lokalni end_val = Volej NaCislo(cond_p->name)

    Pokud (Volej JePrimePrirazeni(inc_uzel) == 0) { Vrat 0 }
    Pokud (Volej strcmp(inc_uzel->name, iter_jmeno) != 0) { Vrat 0 }
    Lokalni inc_vyraz : AST_Node = inc_uzel->right
    Pokud (inc_vyraz == 0 || inc_vyraz->op != TOKEN_PLUS) { Vrat 0 }
    Lokalni inc_l : AST_Node = inc_vyraz->left
    Lokalni inc_p : AST_Node = inc_vyraz->right
    Pokud (inc_l == 0 || inc_p == 0) { Vrat 0 }
    Pokud (inc_l->op != TOKEN_IDENTIFIER || Volej strcmp(inc_l->name, iter_jmeno) != 0) { Vrat 0 }
    Pokud (inc_p->op != TOKEN_NUMBER || Volej NaCislo(inc_p->name) != 1) { Vrat 0 }

    Lokalni telo : AST_Node = Volej CtiUkazatel(uzel_for->stmts)
    // Ukonci/Pokracuj by po rozbaleni skocily jinam; Odloz/Asm nechavame byt;
    // telo nesmi samo menit ridici promennou.
    Pokud (Volej ObsahujeTyp(telo, 22) == 1) { Vrat 0 }
    Pokud (Volej ObsahujeTyp(telo, 23) == 1) { Vrat 0 }
    Pokud (Volej ObsahujeTyp(telo, 26) == 1) { Vrat 0 }
    Pokud (Volej ObsahujeTyp(telo, 34) == 1) { Vrat 0 }
    Pokud (Volej PrirazujeDo(telo, iter_jmeno) == 1) { Vrat 0 }

    Lokalni pocet_iteraci = end_val - start_val
    Pokud (pocet_iteraci <= 0 || pocet_iteraci > 10) { Vrat 0 }
    Volej printf(">> Unrolling Magie (-O3): Opakuj cyklus '%s' se %d iteracemi rozbalen!\n", iter_jmeno, pocet_iteraci)

    Lokalni prikazu_v_tele = 1
    Pokud (telo->type == AST_BLOCK) { prikazu_v_tele = telo->stmt_count }
    Lokalni celkem_prikazu = 1 + (pocet_iteraci * (prikazu_v_tele + 1))
    Lokalni nove_stmts = Volej calloc(celkem_prikazu, 8)
    Lokalni idx = 0
    Volej ZapisUkazatel(nove_stmts + (idx * 8), init_uzel)
    idx = idx + 1
    Lokalni iter = 0
    Dokud (iter < pocet_iteraci) {
        Pokud (telo->type == AST_BLOCK) {
            Lokalni p = 0
            Dokud (p < prikazu_v_tele) {
                Volej ZapisUkazatel(nove_stmts + (idx * 8), Volej KopirujUzel(Volej CtiUkazatel(telo->stmts + (p * 8))))
                idx = idx + 1
                p = p + 1
            }
        } Jinak {
            Volej ZapisUkazatel(nove_stmts + (idx * 8), Volej KopirujUzel(telo))
            idx = idx + 1
        }
        Volej ZapisUkazatel(nove_stmts + (idx * 8), Volej KopirujUzel(inc_uzel))
        idx = idx + 1
        iter = iter + 1
    }
    uzel_for->type = AST_BLOCK
    uzel_for->stmts = nove_stmts
    uzel_for->stmt_count = idx
    uzel_for->left = 0
    uzel_for->right = 0
    uzel_for->alt = 0
    Vrat 1
}

// --- DCE: prikazy za Vrat / Ukonci / Pokracuj ve stejnem bloku se nikdy neprovedou ---
Metoda OptimalizujDCE(uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    Lokalni typ = uzel->type
    Pokud (typ == 1 || typ == 0) {
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Lokalni prikaz : AST_Node = Volej CtiUkazatel(uzel->stmts + (i * 8))
            Pokud (prikaz != 0) {
                Volej OptimalizujDCE(prikaz)
                Pokud (typ == 1 && (prikaz->type == AST_RETURN || prikaz->type == AST_BREAK || prikaz->type == AST_CONTINUE)) {
                    Pokud (i + 1 < uzel->stmt_count) {
                        uzel->stmt_count = i + 1
                        Volej printf(">> DCE Magie (-O3): Odstranen mrtvy kod za Ukonci/Vrat!\n")
                    }
                }
            }
            i = i + 1
        }
        Vrat 0
    }
    Pokud (typ == 6) { Volej OptimalizujDCE(uzel->right); Volej OptimalizujDCE(uzel->alt) }
    Pokud (typ == 7) { Volej OptimalizujDCE(uzel->right) }
    Pokud (typ == 8) { Pokud (uzel->stmts != 0) { Volej OptimalizujDCE(Volej CtiUkazatel(uzel->stmts)) } }
    Pokud (typ == 10) { Volej OptimalizujDCE(uzel->right) }
    Pokud (typ == 28) {
        Lokalni c = 0
        Dokud (c < uzel->stmt_count) {
            Lokalni cesta : AST_Node = Volej CtiUkazatel(uzel->stmts + (c * 8))
            Volej OptimalizujDCE(cesta->right)
            c = c + 1
        }
        Volej OptimalizujDCE(uzel->alt)
    }
    Vrat 0
}

// --- Bezpecny inlining: volani kratke metody bez argumentu a bez lokalnich promennych ---
Metoda JeLokalniVMetode(metoda : AST_Node, jmeno) {
    Lokalni i = metoda->sym_start
    Dokud (i < metoda->sym_end) {
        Lokalni sym : Symbol = pamet_symbolu + (i * Velikost(Symbol))
        Pokud (sym->is_global == 0 && Volej strcmp(sym->name, jmeno) == 0) { Vrat 1 }
        i = i + 1
    }
    Vrat 0
}

// Pouziva telo nejake jmeno, ktere by ve volajici metode zastinila lokalni promenna?
Metoda MaKolizniJmena(uzel : AST_Node, volajici : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    Lokalni t = uzel->type
    Pokud (t == 3 || t == 4 || t == 16 || t == 17 || t == 19 || t == 20 || t == 27 || t == 32 || t == 33 || (t == 5 && uzel->op == TOKEN_IDENTIFIER)) {
        Pokud (Volej JeLokalniVMetode(volajici, uzel->name) == 1) { Vrat 1 }
    }
    Pokud (Volej MaKolizniJmena(uzel->left, volajici) == 1) { Vrat 1 }
    Pokud (Volej MaKolizniJmena(uzel->right, volajici) == 1) { Vrat 1 }
    Pokud (Volej MaKolizniJmena(uzel->alt, volajici) == 1) { Vrat 1 }
    Pokud (uzel->stmts != 0) {
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Pokud (Volej MaKolizniJmena(Volej CtiUkazatel(uzel->stmts + (i * 8)), volajici) == 1) { Vrat 1 }
            i = i + 1
        }
    }
    Vrat 0
}

Metoda LzeVlozit(func_ast : AST_Node, volajici : AST_Node) {
    Pokud (func_ast == 0 || func_ast == volajici) { Vrat 0 }  // ne rekurze
    Pokud (func_ast->arg_count != 0 || func_ast->int_val != 0) { Vrat 0 }
    Lokalni telo : AST_Node = func_ast->right
    Pokud (telo == 0 || telo->type != AST_BLOCK) { Vrat 0 }
    Pokud (telo->stmt_count > 20) { Vrat 0 }                 // jen kratke metody
    Pokud (Volej ObsahujeTyp(telo, 26) == 1) { Vrat 0 }      // Asm (pracuje s ramcem metody)
    Pokud (Volej ObsahujeTyp(telo, 34) == 1) { Vrat 0 }      // Odloz
    Pokud (Volej ObsahujeTyp(telo, 22) == 1) { Vrat 0 }
    Pokud (Volej ObsahujeTyp(telo, 23) == 1) { Vrat 0 }
    // Vrat smi byt jen jako posledni prikaz a bez hodnoty s vedlejsim ucinkem
    Lokalni i = 0
    Dokud (i < telo->stmt_count) {
        Lokalni pr : AST_Node = Volej CtiUkazatel(telo->stmts + (i * 8))
        Lokalni posledni = 0
        Pokud (i == telo->stmt_count - 1) { posledni = 1 }
        Pokud (posledni == 1 && pr->type == AST_RETURN) {
            Pokud (Volej JeCistyVyraz(pr->left) == 0) { Vrat 0 }
        } Jinak {
            Pokud (Volej ObsahujeTyp(pr, 11) == 1) { Vrat 0 }
        }
        i = i + 1
    }
    Pokud (Volej MaKolizniJmena(telo, volajici) == 1) { Vrat 0 }
    Vrat 1
}

Metoda VlozVBloku(blok : AST_Node, volajici : AST_Node) {
    Pokud (blok == 0) { Vrat 0 }
    Pokud (blok->type == AST_BLOCK) {
        Lokalni i = 0
        Dokud (i < blok->stmt_count) {
            Lokalni adr = blok->stmts + (i * 8)
            Lokalni prikaz : AST_Node = Volej CtiUkazatel(adr)
            Pokud (prikaz != 0) {
                Pokud (prikaz->type == AST_CALL) {
                    Lokalni sym : Symbol = Volej NajdiSymbol(prikaz->name)
                    Pokud (sym != 0 && sym->is_function == 1 && prikaz->stmt_count == 0) {
                        Lokalni func_ast : AST_Node = sym->func_node
                        Pokud (Volej LzeVlozit(func_ast, volajici) == 1) {
                            Volej printf(">> Safe Inlining (-O3): Vkladam telo metody '%s'!\n", prikaz->name)
                            Lokalni klon : AST_Node = Volej KopirujUzel(func_ast->right)
                            Pokud (klon->stmt_count > 0) {
                                Lokalni posl : AST_Node = Volej CtiUkazatel(klon->stmts + ((klon->stmt_count - 1) * 8))
                                Pokud (posl->type == AST_RETURN) { klon->stmt_count = klon->stmt_count - 1 }
                            }
                            Volej ZapisUkazatel(adr, klon)
                        }
                    }
                } Jinak {
                    Volej VlozVBloku(prikaz, volajici)
                }
            }
            i = i + 1
        }
        Vrat 0
    }
    Pokud (blok->type == AST_IF) { Volej VlozVBloku(blok->right, volajici); Volej VlozVBloku(blok->alt, volajici) }
    Pokud (blok->type == AST_WHILE) { Volej VlozVBloku(blok->right, volajici) }
    Pokud (blok->type == AST_FOR) { Pokud (blok->stmts != 0) { Volej VlozVBloku(Volej CtiUkazatel(blok->stmts), volajici) } }
    Pokud (blok->type == AST_SWITCH) {
        Lokalni c = 0
        Dokud (c < blok->stmt_count) {
            Lokalni cesta : AST_Node = Volej CtiUkazatel(blok->stmts + (c * 8))
            Volej VlozVBloku(cesta->right, volajici)
            c = c + 1
        }
        Volej VlozVBloku(blok->alt, volajici)
    }
    Vrat 0
}

Metoda OptimalizujBezpecnyInlining(koren : AST_Node) {
    Lokalni i = 0
    Dokud (i < koren->stmt_count) {
        Lokalni metoda : AST_Node = Volej CtiUkazatel(koren->stmts + (i * 8))
        Pokud (metoda->type == AST_METHOD) {
            codegen_scoped = 1
            codegen_sym_start = metoda->sym_start
            codegen_sym_end = metoda->sym_end
            Volej VlozVBloku(metoda->right, metoda)
            codegen_scoped = 0
        }
        i = i + 1
    }
    Vrat 0
}

// --- CSE: "a = x OP y" hned nasledovane "b = x OP y" -> "b = a" ---
// Plati jen kdyz se mezi vypocty x ani y nezmenily (tedy a neni x ani y)
Metoda OptimalizujCSE(blok : AST_Node) {
    Pokud (blok == 0) { Vrat 0 }
    Pokud (blok->type == AST_PROGRAM) {
        Lokalni m = 0
        Dokud (m < blok->stmt_count) {
            Lokalni met : AST_Node = Volej CtiUkazatel(blok->stmts + (m * 8))
            Pokud (met->type == AST_METHOD) {
                codegen_scoped = 1
                codegen_sym_start = met->sym_start
                codegen_sym_end = met->sym_end
                Volej OptimalizujCSE(met->right)
                codegen_scoped = 0
            }
            m = m + 1
        }
        Vrat 0
    }
    Pokud (blok->type == AST_BLOCK) {
        Lokalni i = 0
        Dokud (i < blok->stmt_count) {
            Lokalni prikaz1 : AST_Node = Volej CtiUkazatel(blok->stmts + (i * 8))
            Pokud (i + 1 < blok->stmt_count) {
                Lokalni prikaz2 : AST_Node = Volej CtiUkazatel(blok->stmts + ((i + 1) * 8))
                Volej ZkusCSE(prikaz1, prikaz2)
            }
            Volej OptimalizujCSE(prikaz1)
            i = i + 1
        }
        Vrat 0
    }
    Pokud (blok->type == AST_IF) { Volej OptimalizujCSE(blok->right); Volej OptimalizujCSE(blok->alt) }
    Pokud (blok->type == AST_WHILE) { Volej OptimalizujCSE(blok->right) }
    Pokud (blok->type == AST_FOR) { Pokud (blok->stmts != 0) { Volej OptimalizujCSE(Volej CtiUkazatel(blok->stmts)) } }
    Vrat 0
}

Metoda ZkusCSE(prikaz1 : AST_Node, prikaz2 : AST_Node) {
    Pokud (prikaz1 == 0 || prikaz2 == 0) { Vrat 0 }
    Pokud (prikaz1->type != AST_ASSIGN && prikaz1->type != AST_VAR_DECL) { Vrat 0 }
    Pokud (prikaz2->type != AST_ASSIGN && prikaz2->type != AST_VAR_DECL) { Vrat 0 }
    Pokud (prikaz1->op == TOKEN_PLUSEQ || prikaz1->op == TOKEN_MINUSEQ || prikaz2->op == TOKEN_PLUSEQ || prikaz2->op == TOKEN_MINUSEQ) { Vrat 0 }
    Lokalni vyraz1 : AST_Node = prikaz1->right
    Lokalni vyraz2 : AST_Node = prikaz2->right
    Pokud (vyraz1 == 0 || vyraz2 == 0) { Vrat 0 }
    Pokud (vyraz1->type != AST_EXPR || vyraz2->type != AST_EXPR) { Vrat 0 }
    Pokud (vyraz1->op != vyraz2->op || vyraz1->left == 0 || vyraz1->right == 0 || vyraz2->left == 0 || vyraz2->right == 0) { Vrat 0 }
    Pokud (vyraz1->op == OP_SPOJ_TEXTY || vyraz1->op == TOKEN_AND || vyraz1->op == TOKEN_OR) { Vrat 0 } // spojeni textu vytvari novou pamet
    Lokalni l1 : AST_Node = vyraz1->left
    Lokalni r1 : AST_Node = vyraz1->right
    Lokalni l2 : AST_Node = vyraz2->left
    Lokalni r2 : AST_Node = vyraz2->right
    // Operandy smi byt jen cisla nebo jednoduche promenne
    Pokud (l1->type != AST_EXPR || r1->type != AST_EXPR || l2->type != AST_EXPR || r2->type != AST_EXPR) { Vrat 0 }
    Pokud (l1->op != TOKEN_NUMBER && l1->op != TOKEN_IDENTIFIER) { Vrat 0 }
    Pokud (r1->op != TOKEN_NUMBER && r1->op != TOKEN_IDENTIFIER) { Vrat 0 }
    Pokud (l1->op != l2->op || r1->op != r2->op) { Vrat 0 }
    Pokud (Volej strcmp(l1->name, l2->name) != 0 || Volej strcmp(r1->name, r2->name) != 0) { Vrat 0 }
    // Prvni prirazeni nesmi zmenit sve vlastni operandy (x = x + 1; y = x + 1 NENI totez)
    Pokud (l1->op == TOKEN_IDENTIFIER && Volej strcmp(l1->name, prikaz1->name) == 0) { Vrat 0 }
    Pokud (r1->op == TOKEN_IDENTIFIER && Volej strcmp(r1->name, prikaz1->name) == 0) { Vrat 0 }
    // Vysledek musi byt v obycejne promenne (ne pole)
    Lokalni sym1 : Symbol = Volej NajdiSymbol(prikaz1->name)
    Pokud (sym1 == 0) { Vrat 0 }
    Pokud (sym1->dim1 > 0 || sym1->is_function == 1) { Vrat 0 }
    Volej printf(">> CSE Magie (-O3): Nalezen shodny vypocet, pouzivam predchozi vysledek '%s'!\n", prikaz1->name)
    vyraz2->op = TOKEN_IDENTIFIER
    Volej strncpy(vyraz2->name, prikaz1->name, 255)
    vyraz2->left = 0
    vyraz2->right = 0
    Vrat 1
}

// --- GCP: sireni konstant v lokalnich promennych uvnitr metody ---
//   x = 5; y = x * 2   ->   y = 10
// Sleduji se jen lokalni promenne a parametry (globalni muze zmenit volana metoda).
// Po Pokud/Dokud/Opakuj/Rozcestnik a po Asm se vse zapomene; podminky cyklu se
// nikdy nenahrazuji (meni se v kazdem pruchodu).
Metoda NahradKonstanty(vyraz : AST_Node, gcp_vals, gcp_flags) {
    Pokud (vyraz == 0) { Vrat 0 }
    Pokud (vyraz->type == AST_EXPR && vyraz->op == TOKEN_IDENTIFIER) {
        Lokalni sym : Symbol = Volej NajdiSymbol(vyraz->name)
        Pokud (sym != 0) {
            Lokalni id_sym = (sym - pamet_symbolu) / Velikost(Symbol)
            Pokud (Volej CtiByt(gcp_flags + id_sym) == 1) {
                Lokalni hodnota = Volej CtiUkazatel(gcp_vals + (id_sym * 8))
                vyraz->op = TOKEN_NUMBER
                Volej sprintf(vyraz->name, "%lld", hodnota)
            }
        }
        Vrat 0
    }
    Volej NahradKonstanty(vyraz->left, gcp_vals, gcp_flags)
    Volej NahradKonstanty(vyraz->right, gcp_vals, gcp_flags)
    Pokud (vyraz->type == AST_CALL) { // argumenty volani
        Lokalni a = 0
        Dokud (a < vyraz->stmt_count) {
            Volej NahradKonstanty(Volej CtiUkazatel(vyraz->stmts + (a * 8)), gcp_vals, gcp_flags)
            a = a + 1
        }
    }
    Vrat 0
}

// Po nahrazeni zkusime vyraz znovu slozit (napr. 5 * 2 -> 10)
Metoda SlozVyraz(vyraz : AST_Node) {
    Pokud (vyraz == 0) { Vrat 0 }
    Pokud (vyraz->type != AST_EXPR) { Vrat vyraz }
    vyraz->left = Volej SlozVyraz(vyraz->left)
    vyraz->right = Volej SlozVyraz(vyraz->right)
    Pokud (vyraz->left != 0 && vyraz->right != 0) { Vrat Volej OptimalizujUzel(vyraz) }
    Vrat vyraz
}

Metoda CistiGCP(gcp_flags) {
    Lokalni i = 0
    Dokud (i < pocet_symbolu) {
        Volej ZapisByte(gcp_flags + i, 0)
        i = i + 1
    }
    Vrat 0
}

Metoda GcpZapomen(jmeno, gcp_flags) {
    Lokalni sym : Symbol = Volej NajdiSymbol(jmeno)
    Pokud (sym != 0) { Volej ZapisByte(gcp_flags + ((sym - pamet_symbolu) / Velikost(Symbol)), 0) }
    Vrat 0
}

Metoda ProvedGCP_Blok(blok : AST_Node, gcp_vals, gcp_flags) {
    Pokud (blok == 0) { Vrat 0 }
    Pokud (blok->type != AST_BLOCK) { Volej ProvedGCP_Prikaz(blok, gcp_vals, gcp_flags); Vrat 0 }
    Lokalni i = 0
    Dokud (i < blok->stmt_count) {
        Lokalni pr : AST_Node = Volej CtiUkazatel(blok->stmts + (i * 8))
        Volej ProvedGCP_Prikaz(pr, gcp_vals, gcp_flags)
        i = i + 1
    }
    Vrat 0
}

Metoda ProvedGCP_Prikaz(prikaz : AST_Node, gcp_vals, gcp_flags) {
    Pokud (prikaz == 0) { Vrat 0 }
    Lokalni t = prikaz->type
    Pokud (t == 3 || t == 4) { // Lokalni / prirazeni
        Volej NahradKonstanty(prikaz->right, gcp_vals, gcp_flags)
        prikaz->right = Volej SlozVyraz(prikaz->right)
        Lokalni sym : Symbol = Volej NajdiSymbol(prikaz->name)
        Pokud (sym == 0) { Vrat 0 }
        Lokalni idx = (sym - pamet_symbolu) / Velikost(Symbol)
        Lokalni sledovat = 1
        Pokud (sym->is_global == 1 || sym->is_const == 1 || sym->is_function == 1 || sym->dim1 > 0) { sledovat = 0 }
        Pokud (prikaz->op == TOKEN_PLUSEQ || prikaz->op == TOKEN_MINUSEQ) { sledovat = 0 }
        Pokud (Volej strcmp(sym->type_name, "Float") == 0 || Volej strcmp(sym->type_name, "String") == 0) { sledovat = 0 }
        Lokalni pr_right : AST_Node = prikaz->right
        Pokud (sledovat == 1 && pr_right != 0) {
            Pokud (pr_right->type == AST_EXPR && pr_right->op == TOKEN_NUMBER) {
                Volej ZapisByte(gcp_flags + idx, 1)
                Volej ZapisUkazatel(gcp_vals + (idx * 8), Volej NaCislo(pr_right->name))
                Vrat 0
            }
        }
        Pokud (sledovat == 1 && pr_right == 0 && t == 3) { // Lokalni bez hodnoty = 0
            Volej ZapisByte(gcp_flags + idx, 1)
            Volej ZapisUkazatel(gcp_vals + (idx * 8), 0)
            Vrat 0
        }
        Volej ZapisByte(gcp_flags + idx, 0)
        Vrat 0
    }
    Pokud (t == 20 || t == 25 || t == 11) { // volani, Vypis, Vrat: jen dosadime
        Volej NahradKonstanty(prikaz, gcp_vals, gcp_flags)
        Pokud (t != 20) { prikaz->left = Volej SlozVyraz(prikaz->left) }
        Vrat 0
    }
    Pokud (t == 17 || t == 19 || t == 33) { // zapis do struktury / pole
        Volej NahradKonstanty(prikaz->right, gcp_vals, gcp_flags)
        Volej NahradKonstanty(prikaz->left, gcp_vals, gcp_flags)
        Vrat 0
    }
    Pokud (t == 31) { // Uvolni p -> p = 0
        Volej NahradKonstanty(prikaz->left, gcp_vals, gcp_flags)
        Lokalni uv : AST_Node = prikaz->left
        Pokud (uv != 0) { Volej GcpZapomen(uv->name, gcp_flags) }
        Vrat 0
    }
    Pokud (t == 6) { // Pokud: podminka se vyhodnoti jednou, pred vetvemi
        Volej NahradKonstanty(prikaz->left, gcp_vals, gcp_flags)
        prikaz->left = Volej SlozVyraz(prikaz->left)
        Volej CistiGCP(gcp_flags)
        Volej ProvedGCP_Blok(prikaz->right, gcp_vals, gcp_flags)
        Volej CistiGCP(gcp_flags)
        Volej ProvedGCP_Blok(prikaz->alt, gcp_vals, gcp_flags)
        Volej CistiGCP(gcp_flags)
        Vrat 0
    }
    Pokud (t == 7) { // Dokud: podminku NEnahrazujeme
        Volej CistiGCP(gcp_flags)
        Volej ProvedGCP_Blok(prikaz->right, gcp_vals, gcp_flags)
        Volej CistiGCP(gcp_flags)
        Vrat 0
    }
    Pokud (t == 8) { // Opakuj: inicializace probehne jednou, pak cyklus
        Volej ProvedGCP_Prikaz(prikaz->left, gcp_vals, gcp_flags)
        Volej CistiGCP(gcp_flags)
        Pokud (prikaz->stmts != 0) { Volej ProvedGCP_Blok(Volej CtiUkazatel(prikaz->stmts), gcp_vals, gcp_flags) }
        Volej CistiGCP(gcp_flags)
        Vrat 0
    }
    Pokud (t == 28) { // Rozcestnik
        Volej NahradKonstanty(prikaz->left, gcp_vals, gcp_flags)
        Lokalni c = 0
        Dokud (c < prikaz->stmt_count) {
            Lokalni cesta : AST_Node = Volej CtiUkazatel(prikaz->stmts + (c * 8))
            Volej CistiGCP(gcp_flags)
            Volej ProvedGCP_Blok(cesta->right, gcp_vals, gcp_flags)
            c = c + 1
        }
        Volej CistiGCP(gcp_flags)
        Volej ProvedGCP_Blok(prikaz->alt, gcp_vals, gcp_flags)
        Volej CistiGCP(gcp_flags)
        Vrat 0
    }
    Pokud (t == 1) { Volej ProvedGCP_Blok(prikaz, gcp_vals, gcp_flags); Vrat 0 }
    Pokud (t == 22 || t == 23 || t == 34 || t == 100) { Vrat 0 } // Ukonci, Pokracuj, Odloz (provede se az na konci), NOP
    // Asm a cokoli neznameho: vse zapomenout
    Volej CistiGCP(gcp_flags)
    Vrat 0
}

Metoda OptimalizujGCP(koren : AST_Node) {
    Lokalni gcp_vals = Volej calloc(pocet_symbolu + 1, 8)
    Lokalni gcp_flags = Volej calloc(pocet_symbolu + 1, 1)
    Lokalni i = 0
    Dokud (i < koren->stmt_count) {
        Lokalni metoda : AST_Node = Volej CtiUkazatel(koren->stmts + (i * 8))
        Pokud (metoda->type == AST_METHOD) {
            codegen_scoped = 1
            codegen_sym_start = metoda->sym_start
            codegen_sym_end = metoda->sym_end
            Volej CistiGCP(gcp_flags)
            // Metoda s Asm muze menit promenne "za zady" -> v ni GCP nedelame
            Pokud (Volej ObsahujeTyp(metoda->right, 26) == 0) {
                Volej ProvedGCP_Blok(metoda->right, gcp_vals, gcp_flags)
            }
            codegen_scoped = 0
        }
        i = i + 1
    }
    Volej free(gcp_vals)
    Volej free(gcp_flags)
    Vrat 0
}

Metoda KopirujUzel(uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    
    Lokalni kopie : AST_Node = Volej VytvorUzel(uzel->type, uzel->line)
    kopie->op = uzel->op
    kopie->int_val = uzel->int_val
    Volej strncpy(kopie->name, uzel->name, 255)
    Volej strncpy(kopie->sub_name, uzel->sub_name, 63)
    Volej strncpy(kopie->type_name, uzel->type_name, 63)

    kopie->left = Volej KopirujUzel(uzel->left)
    kopie->right = Volej KopirujUzel(uzel->right)
    kopie->alt = Volej KopirujUzel(uzel->alt)

    Pokud (uzel->stmt_count > 0) {
        kopie->stmts = Volej calloc(uzel->stmt_count, 8)
        kopie->stmt_count = uzel->stmt_count
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Lokalni adr = uzel->stmts + (i * 8)
            Lokalni pod_uzel : AST_Node = Volej CtiUkazatel(adr)
            Lokalni p_kopie = Volej KopirujUzel(pod_uzel)
            Volej ZapisUkazatel(kopie->stmts + (i * 8), p_kopie)
            i = i + 1
        }
    }
    Vrat kopie
}
Metoda ZkontrolujKapacituSymbolu() {
    Pokud (pocet_symbolu >= (kapacita_symbolu - 10)) {
        kapacita_symbolu = kapacita_symbolu * 2
        pamet_symbolu = Volej realloc(pamet_symbolu, kapacita_symbolu * Velikost(Symbol))
    }
    Vrat 0
}
Globalni ir_hloubka_cyklu = 0     // pro kazdou IR instrukci: zanoreni v cyklech (vaha pro alokator)
Globalni ir_cekajici_push = 0     // pro kazdou IR instrukci: kolik 8B hodnot ma surovy kod na zasobniku
Globalni surove_push = 0          // aktualni pocet takovych hodnot
Metoda ZkontrolujKapacituIR_N(n) {
    Dokud (pocet_ir + n >= (kapacita_ir - 10)) {
        kapacita_ir = kapacita_ir * 2
        pamet_ir = Volej realloc(pamet_ir, kapacita_ir * Velikost(IR_Instrukce))
        ir_hloubka_cyklu = Volej realloc(ir_hloubka_cyklu, kapacita_ir * 8)
        ir_cekajici_push = Volej realloc(ir_cekajici_push, kapacita_ir * 8)
    }
    Vrat 0
}

Metoda ZkontrolujKapacituIR() {
    Pokud (ir_hloubka_cyklu == 0) {
        ir_hloubka_cyklu = Volej calloc(kapacita_ir, 8)
        ir_cekajici_push = Volej calloc(kapacita_ir, 8)
    }
    Pokud (pocet_ir >= (kapacita_ir - 10)) {
        kapacita_ir = kapacita_ir * 2
        pamet_ir = Volej realloc(pamet_ir, kapacita_ir * Velikost(IR_Instrukce))
        ir_hloubka_cyklu = Volej realloc(ir_hloubka_cyklu, kapacita_ir * 8)
        ir_cekajici_push = Volej realloc(ir_cekajici_push, kapacita_ir * 8)
    }
    Vrat 0
}

Metoda NaCislo(text) {
    Vrat Volej strtoll(text, 0, 10)
}

// C funkce, ktere vraceji 32bitovy int: vysledek je nutne znamenkove rozsirit na 64 bitu,
// jinak napr. -1 z fgetc vypada jako 4294967295.
Metoda VraciCInt(nazev) {
    Pokud (Volej JeCFunkceA(nazev) == 0) { Vrat 0 }
    Pokud (Volej strcmp(nazev, "strcmp") == 0 || Volej strcmp(nazev, "strncmp") == 0 || Volej strcmp(nazev, "memcmp") == 0) { Vrat 1 }
    Pokud (Volej strcmp(nazev, "fgetc") == 0 || Volej strcmp(nazev, "getchar") == 0 || Volej strcmp(nazev, "getc") == 0) { Vrat 1 }
    Pokud (Volej strcmp(nazev, "fputc") == 0 || Volej strcmp(nazev, "putchar") == 0 || Volej strcmp(nazev, "puts") == 0 || Volej strcmp(nazev, "fputs") == 0) { Vrat 1 }
    Pokud (Volej strcmp(nazev, "printf") == 0 || Volej strcmp(nazev, "sprintf") == 0 || Volej strcmp(nazev, "fprintf") == 0 || Volej strcmp(nazev, "snprintf") == 0) { Vrat 1 }
    Pokud (Volej strcmp(nazev, "atoi") == 0 || Volej strcmp(nazev, "system") == 0 || Volej strcmp(nazev, "fclose") == 0 || Volej strcmp(nazev, "fflush") == 0) { Vrat 1 }
    Pokud (Volej strcmp(nazev, "fseek") == 0 || Volej strcmp(nazev, "abs") == 0 || Volej strcmp(nazev, "rand") == 0 || Volej strcmp(nazev, "feof") == 0) { Vrat 1 }
    Pokud (cilova_platforma == 2 && Volej strcmp(nazev, "ftell") == 0) { Vrat 1 } // long je na Windows 32bitovy
    Vrat 0
}

// ==========================================
// CONTROL FLOW GRAPH (CFG) A LIVENESS ALCHYMIE
// ==========================================

// Pomocne metody pro nativni IR Tisk
Metoda EmitujASM(text) {
    Volej ZkontrolujKapacituIR()
    Lokalni inst : IR_Instrukce = pamet_ir + (pocet_ir * 48)
    inst->opcode = 99 // Nativni ASM Text
    inst->src1 = Volej calloc(1, 256)
    Volej strncpy(inst->src1, text, 255)
    pocet_ir = pocet_ir + 1
    Vrat 0
}
Metoda EmitujASM_1(fmt, a) { Lokalni b = Volej calloc(1,256); Volej sprintf(b,fmt,a); Volej EmitujASM(b); Volej free(b); Vrat 0 }
Metoda EmitujASM_2(fmt, a, c) { Lokalni b = Volej calloc(1,256); Volej sprintf(b,fmt,a,c); Volej EmitujASM(b); Volej free(b); Vrat 0 }
Metoda EmitujASM_3(fmt, a, c, d) { Lokalni b = Volej calloc(1,256); Volej sprintf(b,fmt,a,c,d); Volej EmitujASM(b); Volej free(b); Vrat 0 }

// Nativni BitSet

Metoda SpocitejHash(slovo) {
    Lokalni hash = 5381
    Lokalni c = Volej CtiByt(slovo)
    Lokalni i = 0
    Dokud (c != 0) {
        // OPRAVA: Rozložení složeného výrazu zabrání pádu lineárního alokátoru při výpočtu v pramen2
        hash = hash * 33
        hash = hash + c
        
        hash = hash & 2147483647 // Ochrana proti proteceni do zaporu
        i = i + 1
        c = Volej CtiByt(slovo + i)
    }
    Vrat hash % 4096
}

Metoda ZaregistrujDoHashe(sym_index) {
    Lokalni sym : Symbol = pamet_symbolu + (sym_index * Velikost(Symbol))
    Lokalni h = Volej SpocitejHash(sym->name)
    Lokalni adresa_bucketu = hash_tabulka + (h * 8)
    
    Lokalni prvni_plus_jedna = Volej CtiUkazatel(adresa_bucketu)
    sym->hash_next = prvni_plus_jedna
    Volej ZapisUkazatel(adresa_bucketu, sym_index + 1)
    Vrat 0
}
Metoda ZiskejTypKlicovehoSlova(slovo) {
    Lokalni delka = 0
    Dokud (Volej CtiByt(slovo + delka) != 0) { delka = delka + 1 }
    
    Pokud (delka == 3) {
        Pokud (Volej strcmp(slovo, "Asm") == 0) { Vrat TOKEN_ASM }
    } Jinak Pokud (delka == 4) {
        Pokud (Volej strcmp(slovo, "Vrat") == 0) { Vrat TOKEN_VRAT }
    } Jinak Pokud (delka == 5) {
        Pokud (Volej strcmp(slovo, "Pokud") == 0) { Vrat TOKEN_POKUD }
        Pokud (Volej strcmp(slovo, "Dokud") == 0) { Vrat TOKEN_DOKUD }
        Pokud (Volej strcmp(slovo, "Volej") == 0) { Vrat TOKEN_VOLEJ }
        Pokud (Volej strcmp(slovo, "Vypis") == 0) { Vrat TOKEN_VYPIS }
        Pokud (Volej strcmp(slovo, "Jinak") == 0) { Vrat TOKEN_JINAK }
        Pokud (Volej strcmp(slovo, "Cesta") == 0) { Vrat TOKEN_CESTA }
        Pokud (Volej strcmp(slovo, "Zahrn") == 0) { Vrat 999 }
        Pokud (Volej strcmp(slovo, "Odloz") == 0) { Vrat TOKEN_Odloz } // drive omylem mezi 7znakovymi slovy
    } Jinak Pokud (delka == 6) {
        Pokud (Volej strcmp(slovo, "Opakuj") == 0) { Vrat TOKEN_OPAKUJ }
        Pokud (Volej strcmp(slovo, "Metoda") == 0) { Vrat TOKEN_METODA }
        Pokud (Volej strcmp(slovo, "Alokuj") == 0) { Vrat TOKEN_ALOKUJ }
        Pokud (Volej strcmp(slovo, "Uvolni") == 0) { Vrat TOKEN_UVOLNI }
        Pokud (Volej strcmp(slovo, "Ukonci") == 0) { Vrat TOKEN_UKONCI }
    } Jinak Pokud (delka == 7) {
        Pokud (Volej strcmp(slovo, "Lokalni") == 0) { Vrat TOKEN_LOKALNI }
        Pokud (Volej strcmp(slovo, "Externi") == 0) { Vrat TOKEN_EXTERNI }
        Pokud (Volej strcmp(slovo, "Skupina") == 0) { Vrat TOKEN_SKUPINA }
    } Jinak Pokud (delka == 8) {
        Pokud (Volej strcmp(slovo, "Globalni") == 0) { Vrat TOKEN_GLOBALNI }
        Pokud (Volej strcmp(slovo, "Velikost") == 0) { Vrat TOKEN_VELIKOST }
        Pokud (Volej strcmp(slovo, "Pokracuj") == 0) { Vrat TOKEN_POKRACUJ }
    } Jinak Pokud (delka == 9) {
        Pokud (Volej strcmp(slovo, "Konstanta") == 0) { Vrat TOKEN_KONSTANTA }
        Pokud (Volej strcmp(slovo, "Struktura") == 0) { Vrat TOKEN_STRUKTURA }
    } Jinak Pokud (delka == 10) {
        Pokud (Volej strcmp(slovo, "Rozcestnik") == 0) { Vrat TOKEN_ROZCESTNIK }
        Pokud (Volej strcmp(slovo, "CtiZAdresu") == 0) { Vrat TOKEN_CTI_ADRESU }
    } Jinak Pokud (delka == 12) {
        Pokud (Volej strcmp(slovo, "Hlavni_cesta") == 0) { Vrat TOKEN_HLAVNI_CESTA }
    }
    Vrat TOKEN_IDENTIFIER
}

// ==========================================
// PRIMY PRISTUP DO PAMETI (bez Asm, funguje na x86 i ARM)
// ==========================================
Struktura PametSlovo { hodnota }     // 8 bajtu na dane adrese
Struktura PametBajt { value[1] }     // 1 bajt na dane adrese

Metoda CtiUkazatel(adresa) {
    Vrat CtiZAdresu(adresa)
}

Metoda ZapisUkazatel(adresa, hodnota) {
    Lokalni p : PametSlovo = adresa
    p->hodnota = hodnota
    Vrat 0
}

Metoda CtiByt(adresa) {
    Lokalni p : PametBajt = adresa
    Vrat p->value[0]
}

Metoda ZapisByte(adresa, hodnota) {
    Lokalni p : PametBajt = adresa
    p->value[0] = hodnota
    Vrat 0
}

Metoda PridejClenaStruktury(s_name, m_name, off, je_pole, velikost) {
    Pokud (pocet_struktur_clenu >= 499) {
        Volej printf("Kriticka chyba: prekrocen maximalni pocet clenu struktur (500)!\n")
        Volej exit(1)
    }
    Lokalni base = pamet_struktur_clenove + (pocet_struktur_clenu * 1032)
    Volej strncpy(base + 0, s_name, 63)
    Volej ZapisByte(base + 63, 0)
    Volej strncpy(base + 512, m_name, 63)
    Volej ZapisByte(base + 575, 0)
    Volej ZapisUkazatel(base + 1024, off)
    Volej ZapisByte(base + 64, je_pole) // 1 = clen je pole (text) -> p->clen je adresa, p->clen[i] je bajt
    Volej ZapisUkazatel(base + 72, velikost) // velikost v bajtech (kontrola mezi p->clen[i])
    pocet_struktur_clenu = pocet_struktur_clenu + 1
    Vrat 0
}

// Je jmeno typem struktury (ma aspon jeden clen)?
Metoda JeStruktura(typ) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_clenu) {
        Pokud (Volej strcmp(pamet_struktur_clenove + (i * 1032), typ) == 0) { Vrat 1 }
        i = i + 1
    }
    Vrat 0
}

// Ma struktura dany clen?
Metoda MaClen(typ, vlastnost) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_clenu) {
        Lokalni base = pamet_struktur_clenove + (i * 1032)
        Pokud (Volej strcmp(base + 0, typ) == 0) { Pokud (Volej strcmp(base + 512, vlastnost) == 0) { Vrat 1 } }
        i = i + 1
    }
    Vrat 0
}

// Typ clenu struktury ("" = nezadan); deklaruje se "clen : Typ"
Metoda TypClenu(typ, vlastnost) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_clenu) {
        Lokalni base = pamet_struktur_clenove + (i * 1032)
        Pokud (Volej strcmp(base + 0, typ) == 0) {
            Pokud (Volej strcmp(base + 512, vlastnost) == 0) { Vrat base + 128 }
        }
        i = i + 1
    }
    Vrat ""
}

// Velikost clenu struktury v bajtech (0 = nenalezen)
Metoda VelikostClenu(typ, vlastnost) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_clenu) {
        Lokalni base = pamet_struktur_clenove + (i * 1032)
        Pokud (Volej strcmp(base + 0, typ) == 0) {
            Pokud (Volej strcmp(base + 512, vlastnost) == 0) { Vrat CtiZAdresu(base + 72) }
        }
        i = i + 1
    }
    Vrat 0
}

// Je clen struktury deklarovan jako pole (napr. "jmeno[64]")?
Metoda JeClenPole(typ, vlastnost) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_clenu) {
        Lokalni base = pamet_struktur_clenove + (i * 1032)
        Pokud (Volej strcmp(base + 0, typ) == 0) {
            Pokud (Volej strcmp(base + 512, vlastnost) == 0) { Vrat Volej CtiByt(base + 64) }
        }
        i = i + 1
    }
    Vrat 0
}

Metoda ZaregistrujStrukturu(s_name, size) {
    Pokud (pocet_struktur_def >= 99) {
        Volej printf("Kriticka chyba: prekrocen maximalni pocet definic struktur (100)!\n")
        Volej exit(1)
    }
    Lokalni base = pamet_struktur_def + (pocet_struktur_def * 520)
    Volej strncpy(base + 0, s_name, 63)
    Volej ZapisByte(base + 63, 0)
    Volej ZapisUkazatel(base + 512, size)
    pocet_struktur_def = pocet_struktur_def + 1
    Vrat 0
}

Metoda ZiskejOffset(typ, vlastnost) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_clenu) {
        Lokalni base = pamet_struktur_clenove + (i * 1032)
        Pokud (Volej strcmp(base + 0, typ) == 0) {
            Pokud (Volej strcmp(base + 512, vlastnost) == 0) {
                Vrat Volej CtiUkazatel(base + 1024)
            }
        }
        i = i + 1
    }
    // Zásadní oprava: Pokud offset nenajdeme, nesmíme vrátit 0 (což je platný offset pro typ!)
    Volej printf("Kriticka chyba: Clen '%s' ve strukture '%s' neexistuje!\n", vlastnost, typ)
    Volej exit(1)
    Vrat 0
}

Metoda ZiskejVelikostStruktury(typ) {
    Lokalni i = 0
    Dokud (i < pocet_struktur_def) {
        Lokalni base = pamet_struktur_def + (i * 520)
        Pokud (Volej strcmp(base + 0, typ) == 0) {
            Vrat Volej CtiUkazatel(base + 512)
        }
        i = i + 1
    }
    Vrat 8
}



// ==========================================
// VYLEPSENI: registr Externi jmen (pro Apple name-mangling pri "Volej")
// ==========================================
Globalni externi_float = 0     // pro kazde Externi: 1 = vraci desetinne cislo ("Externi sqrt : Float")
Metoda JeFloatExtern(nazev) {
    Pokud (externi_float == 0) { Vrat 0 }
    Lokalni i = 0
    Dokud (i < pocet_externu) {
        Pokud (Volej strcmp(pamet_externu + (i * 256), nazev) == 0) { Vrat CtiZAdresu(externi_float + (i * 8)) }
        i = i + 1
    }
    Vrat 0
}

Metoda PridejExterniJmeno(nazev) {
    Pokud (pocet_externu >= 199) {
        Volej printf("Kriticka chyba: prilis mnoho Externi deklaraci (max 200)!\n")
        Volej exit(1)
    }
    Lokalni base = pamet_externu + (pocet_externu * 256)
    Volej strncpy(base, nazev, 255)
    pocet_externu = pocet_externu + 1
    Vrat 0
}

Metoda JeExterniJmeno(nazev) {
    // printf a exit generator vzdy prida sam, i kdyz je uzivatel nedeklaroval
    Pokud (Volej strcmp(nazev, "printf") == 0) { Vrat 1 }
    Pokud (Volej strcmp(nazev, "exit") == 0) { Vrat 1 }
    Lokalni i = 0
    Dokud (i < pocet_externu) {
        Lokalni base = pamet_externu + (i * 256)
        Pokud (Volej strcmp(base, nazev) == 0) { Vrat 1 }
        i = i + 1
    }
    Vrat 0
}

// Na Apple (Mach-O) potrebuji C symboly s podtrzitkem na zacatku (_printf, _main, ...)
Metoda NazevSymbolu(nazev) {
    Pokud (cilova_platforma == CIL_APPLE || cilova_platforma == CIL_APPLE_ARM) {
        Lokalni vysledek = Volej malloc(300)
        Volej sprintf(vysledek, "_%s", nazev)
        Vrat vysledek
    }
    Vrat nazev
}

// ==========================================
// VYLEPSENI: vyhodnoceni konstantniho vyrazu (pro "Globalni x = <vyraz>")
// Smi pouzivat jen cisla, jmenovane Konstanty a +,-,*,/,% na jiz slozenych konstantach
// (OptimalizujUzel uz vetsinu ciste-konstantnich podstromu slozi behem parsovani).
// ==========================================
Metoda VyhodnotKonstantu(uzel : AST_Node) {
    Pokud (uzel == 0) {
        Volej printf("Kriticka chyba: prazdny inicializacni vyraz globalni promenne!\n")
        Volej exit(1)
    }
    Pokud (uzel->op == TOKEN_NUMBER) { Vrat Volej NaCislo(uzel->name) }
    Pokud (uzel->op == TOKEN_IDENTIFIER) {
        Lokalni sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym != 0 && sym->is_const == 1) { Vrat sym->const_val }
        Volej printf("Chyba (radek %d): '%s' neni Konstanta, nelze ji pouzit v konstantnim vyrazu.\n", uzel->line, uzel->name)
        Volej exit(1)
    }
    Pokud (uzel->op == TOKEN_MINUS && uzel->left != 0 && uzel->right == 0) {
        Vrat 0 - (Volej VyhodnotKonstantu(uzel->left))
    }
    Volej printf("Chyba (radek %d): Hodnota musi byt konstantni vyraz (cisla, Konstanty a operatory).\n", uzel->line)
    Volej exit(1)
    Vrat 0
}

// Velikost pole v deklaraci: cele cislo nebo jmeno Konstanty
Metoda VelikostZTokenu(tok : Token) {
    Pokud (tok->type == TOKEN_NUMBER) { Vrat Volej NaCislo(tok->value) }
    Pokud (tok->type == TOKEN_IDENTIFIER) {
        Lokalni sym : Symbol = Volej NajdiSymbol(tok->value)
        Pokud (sym != 0) { Pokud (sym->is_const == 1) { Vrat sym->const_val } }
    }
    Volej printf("Chyba (radek %d): Velikost pole musi byt cislo nebo Konstanta (nasel jsem '%s').\n", tok->line, tok->value)
    Volej exit(1)
    Vrat 0
}

Globalni aktualni_radek_parseru = 0
Metoda PridejLokalniSymbol(nazev, velikost_v_bajtech) {
    Lokalni existuje : Symbol = Volej NajdiSymbol(nazev)
    Pokud (existuje != 0) {
        // Zastineni (stejne jmeno uvnitr vnoreneho bloku) by bylo matouci -> zakazano
        Pokud (existuje->is_global == 0) {
            Volej printf("Chyba (radek %d): Promenna '%s' uz v teto metode existuje (zvolte jine jmeno).\n", aktualni_radek_parseru, nazev)
            Volej exit(1)
        }
    }

    Volej ZkontrolujKapacituSymbolu()
    Lokalni novy_symbol : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
            Volej VycistiSymbol(novy_symbol)

    Volej strncpy(novy_symbol->name, nazev, 255)
    novy_symbol->is_global = 0
    novy_symbol->is_const = 0
    current_local_offset = current_local_offset + velikost_v_bajtech
    novy_symbol->offset = current_local_offset
    
    novy_symbol->scope_depth = aktualni_hloubka_bloku
    novy_symbol->is_active = 1
    
    pocet_symbolu = pocet_symbolu + 1
    Volej ZaregistrujDoHashe(pocet_symbolu - 1)
    Vrat 0
}

Metoda PridejGlobalniSymbol(nazev, hodnota) {
    Lokalni existuje = Volej NajdiSymbol(nazev)
    Pokud (existuje != 0) {
        Vrat 0
    }

    Volej ZkontrolujKapacituSymbolu()
    Lokalni novy_symbol : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
    Volej VycistiSymbol(novy_symbol)
    Volej strncpy(novy_symbol->name, nazev, 255)
    novy_symbol->is_global = 1
    novy_symbol->is_const = 0
    novy_symbol->const_val = hodnota
    pocet_symbolu = pocet_symbolu + 1
    Volej ZaregistrujDoHashe(pocet_symbolu - 1)
    Vrat 0
}

Metoda PridejKonstantu(nazev, hodnota) {
    Volej ZkontrolujKapacituSymbolu()
    Lokalni novy_symbol : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
        Volej VycistiSymbol(novy_symbol)

    Volej strncpy(novy_symbol->name, nazev, 255)
    novy_symbol->is_global = 1
    novy_symbol->is_const = 1
    novy_symbol->const_val = hodnota
    pocet_symbolu = pocet_symbolu + 1
    Volej ZaregistrujDoHashe(pocet_symbolu - 1)
    Vrat 0
}


Metoda NajdiSymbol(nazev) {
    Lokalni h = Volej SpocitejHash(nazev)
    Lokalni adresa_bucketu = hash_tabulka + (h * 8)
    Lokalni aktualni_plus_jedna = Volej CtiUkazatel(adresa_bucketu)
    
    Dokud (aktualni_plus_jedna != 0) {
        Lokalni index = aktualni_plus_jedna - 1
        Lokalni sym : Symbol = pamet_symbolu + (index * Velikost(Symbol))
        
        Pokud (Volej strcmp(sym->name, nazev) == 0) {
            Pokud (codegen_scoped == 1) {
                Pokud (sym->is_global == 1 || (index >= codegen_sym_start && index < codegen_sym_end)) {
                    Vrat sym
                }
            } Jinak {
                Pokud (sym->is_global == 1 || (index >= parse_sym_start && sym->is_active == 1)) {
                    Vrat sym
                }
            }
        }
        aktualni_plus_jedna = sym->hash_next
    }
    Vrat 0
}

// ==========================================
// LEXER (Zpracovani zdrojoveho kodu)
// ==========================================
// Escape sekvence za zpetnym lomitkem: \n \t \r \0 \\ \" \'
Metoda EscapeZnak(znak, radek) {
    Pokud (znak == 110) { Vrat 10 }
    Pokud (znak == 116) { Vrat 9 }
    Pokud (znak == 114) { Vrat 13 }
    Pokud (znak == 48) { Vrat 0 }
    Pokud (znak == 92) { Vrat 92 }
    Pokud (znak == 34) { Vrat 34 }
    Pokud (znak == 39) { Vrat 39 }
    Volej printf("Chyba (radek %d): Neznama escape sekvence (povolene: \\n \\t \\r \\0 \\\\ \\\" \\').\n", radek)
    Volej exit(1)
    Vrat 0
}

Globalni pamet_zahrnutych = 0
Globalni pocet_zahrnutych = 0

Metoda LexerCore(nazev_souboru, is_main) {
    Pokud (pamet_zahrnutych == 0) { pamet_zahrnutych = Volej calloc(256, 256) }
    Volej printf("Lexer: Oteviram %s...\n", nazev_souboru)
    Lokalni soubor = Volej fopen(nazev_souboru, "r")
    Pokud (soubor == 0) { Volej printf("Chyba: Soubor '%s' nelze otevrit.\n", nazev_souboru); Volej exit(1) }

    Volej fseek(soubor, 0, 2)
    Lokalni velikost = Volej ftell(soubor)
    Volej rewind(soubor)

    Lokalni zdroj_buffer = Volej calloc(1, velikost + 2)
    Volej fread(zdroj_buffer, 1, velikost, soubor)
    Volej fclose(soubor)

    Lokalni radek = 1
    Lokalni pos = 0
    Lokalni znak = Volej CtiByt(zdroj_buffer + pos)
    Lokalni i = 0

    Dokud (znak != 0) {
        Pokud (pocet_tokenu >= (kapacita_tokenu - 10)) {
            kapacita_tokenu = kapacita_tokenu * 2
            pamet_tokenu = Volej realloc(pamet_tokenu, kapacita_tokenu * Velikost(Token))
        }

        Pokud (znak == 32 || znak == 9 || znak == 13) { pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); Pokracuj }
        Pokud (znak == 10) { radek = radek + 1; pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); Pokracuj }

        Pokud (znak == 47) {
            pos = pos + 1
            znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 47) {
                Dokud (znak != 10 && znak != 0) { pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
                Pokracuj
            } Jinak Pokud (znak == 42) { // blokovy komentar /* ... */
                Lokalni zacatek_kom = radek
                pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                Lokalni konec_kom = 0
                Dokud (konec_kom == 0) {
                    Pokud (znak == 0) {
                        Volej printf("Chyba (radek %d): Neukonceny komentar /* ... */.\n", zacatek_kom)
                        Volej exit(1)
                    }
                    Pokud (znak == 10) { radek = radek + 1 }
                    Pokud (znak == 42 && Volej CtiByt(zdroj_buffer + pos + 1) == 47) { konec_kom = 1; pos = pos + 1 }
                    pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                }
                Pokracuj
            } Jinak {
                Lokalni div_token : Token = pamet_tokenu + (pocet_tokenu * Velikost(Token))
                div_token->line = radek
                div_token->type = TOKEN_DIV
                Volej strncpy(div_token->value, "/", 2)
                pocet_tokenu = pocet_tokenu + 1
                Pokracuj
            }
        }

        Lokalni aktualni_token : Token = pamet_tokenu + (pocet_tokenu * Velikost(Token))
        aktualni_token->line = radek

        // --- SESTNACTKOVA CISLA: 0x1F -> prevedeme na desitkovy text ---
        Pokud (znak == 48 && (Volej CtiByt(zdroj_buffer + pos + 1) == 120 || Volej CtiByt(zdroj_buffer + pos + 1) == 88)) {
            pos = pos + 2; znak = Volej CtiByt(zdroj_buffer + pos)
            Lokalni hex_hodnota = 0
            Lokalni hex_cislic = 0
            Lokalni hex_dal = 1
            Dokud (hex_dal == 1) {
                Lokalni cifra = 0 - 1
                Pokud (znak >= 48 && znak <= 57) { cifra = znak - 48 }
                Pokud (znak >= 97 && znak <= 102) { cifra = znak - 87 }
                Pokud (znak >= 65 && znak <= 70) { cifra = znak - 55 }
                Pokud (cifra < 0) { hex_dal = 0 } Jinak {
                    Pokud (hex_cislic >= 16) {
                        Volej printf("Chyba (radek %d): Sestnactkove cislo je prilis dlouhe (max. 16 cislic).\n", radek)
                        Volej exit(1)
                    }
                    hex_hodnota = (hex_hodnota << 4) | cifra
                    hex_cislic = hex_cislic + 1
                    pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                }
            }
            Pokud (hex_cislic == 0) {
                Volej printf("Chyba (radek %d): Za 0x chybi sestnactkove cislice.\n", radek)
                Volej exit(1)
            }
            aktualni_token->type = TOKEN_NUMBER
            Volej sprintf(aktualni_token->value, "%lld", hex_hodnota)
            pocet_tokenu = pocet_tokenu + 1
            Pokracuj
        }

        // --- CTENI CISEL (CELA I DESETINNA) ---
        Pokud (znak >= 48 && znak <= 57) {
            aktualni_token->type = TOKEN_NUMBER
            i = 0
            Lokalni ma_tecku = 0
            
            // Cteme cislice nebo tecku (znak 46)
            Dokud ((znak >= 48 && znak <= 57) || znak == 46) {
                Pokud (znak == 46) {
                    Pokud (ma_tecku == 1) {
                        Volej printf("Lexikalni chyba na radku %d: Cislo ma vice nez jednu tecku!\n", radek)
                        Volej exit(1)
                    }
                    ma_tecku = 1
                    aktualni_token->type = TOKEN_FLOAT // Jakmile najdeme tecku, menime typ tokenu
                }
                Pokud (i < 254) { aktualni_token->value[i] = znak; i = i + 1 }
                pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            }
            aktualni_token->value[i] = 0
            // Cele cislo vetsi nez 2^63 - 1 by se tise oriznulo -> chyba
            Pokud (aktualni_token->type == TOKEN_NUMBER) {
                Lokalni bez_nul = aktualni_token->value
                Dokud (CtiByt(bez_nul) == 48 && CtiByt(bez_nul + 1) != 0) { bez_nul = bez_nul + 1 }
                Lokalni delka_c = Volej strlen(bez_nul)
                Pokud (delka_c > 19 || (delka_c == 19 && Volej strcmp(bez_nul, "9223372036854775807") > 0)) {
                    Volej printf("Chyba (radek %d): Cislo %s je prilis velke (nejvic 9223372036854775807).\n", radek, aktualni_token->value)
                    Volej exit(1)
                }
            }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }

        // --- ZNAKOVY LITERAL: 'a', '\n' -> cislo (kod znaku) ---
        Pokud (znak == 39) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Lokalni kod_znaku = znak
            Pokud (znak == 92) {
                pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                kod_znaku = Volej EscapeZnak(znak, radek)
            }
            Pokud (znak == 0 || znak == 10 || znak >= 128) {
                Volej printf("Chyba (radek %d): Neplatny znak v apostrofech (jeden znak bez diakritiky).\n", radek)
                Volej exit(1)
            }
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak != 39) {
                Volej printf("Chyba (radek %d): Chybi uzaviraci apostrof.\n", radek)
                Volej exit(1)
            }
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            aktualni_token->type = TOKEN_NUMBER
            Volej sprintf(aktualni_token->value, "%lld", kod_znaku)
            pocet_tokenu = pocet_tokenu + 1
            Pokracuj
        }

        Pokud (znak == 34) {
            aktualni_token->type = TOKEN_STRING; aktualni_token->str_id = globalni_str_id; globalni_str_id = globalni_str_id + 1
            i = 0; pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Dokud (znak != 34) {
                Pokud (znak == 0 || znak == 10) {
                    Volej printf("Chyba (radek %d): Neukonceny text (chybi uzaviraci uvozovky).\n", radek)
                    Volej exit(1)
                }
                Pokud (i >= 254) {
                    Volej printf("Chyba (radek %d): Text je delsi nez 254 znaku.\n", radek)
                    Volej exit(1)
                }
                Pokud (znak == 92) {
                    pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                    Pokud (i < 254) {
                        aktualni_token->value[i] = Volej EscapeZnak(znak, radek)
                        i = i + 1
                    }
                    pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                } Jinak {
                    Pokud (i < 254) { aktualni_token->value[i] = znak; i = i + 1 }
                    pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
                }
            }
            aktualni_token->value[i] = 0; pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            
            Pokud (cekam_na_zahrn == 1) {
                cekam_na_zahrn = 0
                // Kazdy soubor se vlozi jen jednou (jinak by vznikly dvojite definice metod)
                Lokalni uz_byl = 0
                Lokalni zi = 0
                Dokud (zi < pocet_zahrnutych) {
                    Pokud (Volej strcmp(pamet_zahrnutych + (zi * 256), aktualni_token->value) == 0) { uz_byl = 1 }
                    zi = zi + 1
                }
                Pokud (uz_byl == 0) {
                    Pokud (pocet_zahrnutych >= 255) {
                        Volej printf("Chyba (radek %d): Prilis mnoho souboru vlozenych pres Zahrn (max. 255).\n", radek)
                        Volej exit(1)
                    }
                    Volej strncpy(pamet_zahrnutych + (pocet_zahrnutych * 256), aktualni_token->value, 255)
                    pocet_zahrnutych = pocet_zahrnutych + 1
                    Lokalni temp_nazev = Volej malloc(256)
                    Volej strncpy(temp_nazev, aktualni_token->value, 255)
                    Volej LexerCore(temp_nazev, 0)
                    Volej free(temp_nazev)
                }
                Pokracuj
            }
            
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }

        Pokud (znak == 61) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_EQEQ; Volej strncpy(aktualni_token->value, "==", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_EQ; Volej strncpy(aktualni_token->value, "=", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 33) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_NEQ; Volej strncpy(aktualni_token->value, "!=", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_NOT; Volej strncpy(aktualni_token->value, "!", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 60) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_LESSEQ; Volej strncpy(aktualni_token->value, "<=", 3); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak Pokud (znak == 60) { aktualni_token->type = TOKEN_SHL; Volej strncpy(aktualni_token->value, "<<", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_LESS; Volej strncpy(aktualni_token->value, "<", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 62) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_GREATEREQ; Volej strncpy(aktualni_token->value, ">=", 3); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak Pokud (znak == 62) { aktualni_token->type = TOKEN_SHR; Volej strncpy(aktualni_token->value, ">>", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_GREATER; Volej strncpy(aktualni_token->value, ">", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 38) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 38) { aktualni_token->type = TOKEN_AND; Volej strncpy(aktualni_token->value, "&&", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_AMPER; Volej strncpy(aktualni_token->value, "&", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 124) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 124) { aktualni_token->type = TOKEN_OR; Volej strncpy(aktualni_token->value, "||", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_PIPE; Volej strncpy(aktualni_token->value, "|", 1) }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 94) { aktualni_token->type = TOKEN_CARET; Volej strncpy(aktualni_token->value, "^", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 37) { aktualni_token->type = TOKEN_MOD; Volej strncpy(aktualni_token->value, "%", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }

        Pokud (znak == 43) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_PLUSEQ; Volej strncpy(aktualni_token->value, "+=", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_PLUS }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }
        Pokud (znak == 45) {
            pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            Pokud (znak == 61) { aktualni_token->type = TOKEN_MINUSEQ; Volej strncpy(aktualni_token->value, "-=", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak Pokud (znak == 62) { aktualni_token->type = TOKEN_ARROW; Volej strncpy(aktualni_token->value, "->", 2); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos) }
            Jinak { aktualni_token->type = TOKEN_MINUS }
            pocet_tokenu = pocet_tokenu + 1; Pokracuj
        }

        Pokud (znak == 58) { aktualni_token->type = TOKEN_COLON; Volej strncpy(aktualni_token->value, ":", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 123) { aktualni_token->type = TOKEN_LBRACE; Volej strncpy(aktualni_token->value, "{", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 125) { aktualni_token->type = TOKEN_RBRACE; Volej strncpy(aktualni_token->value, "}", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 40) { aktualni_token->type = TOKEN_LPAREN; Volej strncpy(aktualni_token->value, "(", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 41) { aktualni_token->type = TOKEN_RPAREN; Volej strncpy(aktualni_token->value, ")", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 91) { aktualni_token->type = TOKEN_LBRACKET; Volej strncpy(aktualni_token->value, "[", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 93) { aktualni_token->type = TOKEN_RBRACKET; Volej strncpy(aktualni_token->value, "]", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 44) { aktualni_token->type = TOKEN_COMMA; Volej strncpy(aktualni_token->value, ",", 1); pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }
        Pokud (znak == 42) { aktualni_token->type = TOKEN_MUL; pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); pocet_tokenu = pocet_tokenu + 1; Pokracuj }

        Pokud ((znak >= 65 && znak <= 90) || (znak >= 97 && znak <= 122) || znak == 95) {
            i = 0
            Dokud ((znak >= 65 && znak <= 90) || (znak >= 97 && znak <= 122) || znak == 95 || (znak >= 48 && znak <= 57)) {
                Pokud (i < 254) { aktualni_token->value[i] = znak; i = i + 1 }
                Jinak {
                    // Delsi jmena by se oriznula a dve ruzna jmena by mohla splynout
                    Volej printf("Chyba (radek %d): Jmeno je delsi nez 254 znaku.\n", radek)
                    Volej exit(1)
                }
                pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos)
            }
            aktualni_token->value[i] = 0
            
            Lokalni typ_klic = Volej ZiskejTypKlicovehoSlova(aktualni_token->value)
            Pokud (typ_klic == 999) {
                cekam_na_zahrn = 1
                Pokracuj
            } Jinak {
                aktualni_token->type = typ_klic
            }
            
            pocet_tokenu = pocet_tokenu + 1
            Pokracuj
        }
        Pokud (znak == 59) { pos = pos + 1; znak = Volej CtiByt(zdroj_buffer + pos); Pokracuj } // ';' je nepovinny oddelovac
        Pokud (znak >= 128) {
            Volej printf("Chyba (radek %d): Znak s diakritikou je povolen jen v textu a komentari.\n", radek)
        } Jinak {
            Volej printf("Chyba (radek %d): Neznamy znak '%c'.\n", radek, znak)
        }
        Volej exit(1)
    }
    
    Volej free(zdroj_buffer)
    
    Pokud (is_main == 1) {
        Pokud (pocet_tokenu >= kapacita_tokenu) {
            kapacita_tokenu = kapacita_tokenu + 10
            pamet_tokenu = Volej realloc(pamet_tokenu, kapacita_tokenu * Velikost(Token))
        }
        Lokalni eof_token : Token = pamet_tokenu + (pocet_tokenu * Velikost(Token))
        eof_token->type = TOKEN_EOF
        Volej printf("Lexer dokoncil cteni. Celkovy pocet tokenu: %d\n", pocet_tokenu)
    }
    Vrat 0
}

Metoda Lexer(nazev_souboru) {
    cekam_na_zahrn = 0
    Volej LexerCore(nazev_souboru, 1)
    Vrat 0
}

// ==========================================
// PARSER (Sestaveni AST stromu a Precedence)
// ==========================================
Metoda VytvorUzel(typ_uzlu, radek) {
    Lokalni uzel : AST_Node = Volej calloc(1, Velikost(AST_Node))
    uzel->type = typ_uzlu
    uzel->line = radek
    Vrat uzel
}

Metoda ZiskejToken(index) {
    // Vylepseni: ochrana proti cteni mimo alokovany buffer tokenu.
    // pamet_tokenu[pocet_tokenu] je vzdy platny EOF sentinel (viz LexerCore),
    // takze mimo rozsah bezpecne vratime prave jeho.
    Lokalni bezpecny_index = index
    Pokud (bezpecny_index < 0) { bezpecny_index = 0 }
    Pokud (bezpecny_index > pocet_tokenu) { bezpecny_index = pocet_tokenu }
    Lokalni t : Token = pamet_tokenu + (bezpecny_index * Velikost(Token))
    Vrat t
}

// Vyraz bez vedlejsich ucinku (zadne volani, alokace ani cteni pameti):
// smi se pri optimalizaci zahodit nebo prepocitat.
Metoda JeCistyVyraz(u : AST_Node) {
    Pokud (u == 0) { Vrat 1 }
    Pokud (u->type != AST_EXPR) { Vrat 0 }   // volani, pole, struktury, Alokuj...
    Pokud (u->op == TOKEN_CTI_ADRESU) { Vrat 0 }    // CtiZAdresu (napr. hardwarovy registr)
    Pokud (Volej JeCistyVyraz(u->left) == 0) { Vrat 0 }
    Vrat Volej JeCistyVyraz(u->right)
}

Metoda OptimalizujUzel(binarni_uzel : AST_Node) {
    Pokud (binarni_uzel->left != 0 && binarni_uzel->right != 0) {
        Lokalni l_uzel : AST_Node = binarni_uzel->left
        Lokalni r_uzel : AST_Node = binarni_uzel->right
        
        // --- BOOLEOVSKE IDENTITY S PROMENNYMI (x == x) ---
        Pokud (l_uzel->op == TOKEN_IDENTIFIER && r_uzel->op == TOKEN_IDENTIFIER && Volej strcmp(Volej ZiskejTypUzlu(l_uzel), "Float") != 0) { // 35 = TOKEN_IDENTIFIER
            Pokud (Volej strcmp(l_uzel->name, r_uzel->name) == 0) {
                Pokud (binarni_uzel->op == TOKEN_EQEQ || binarni_uzel->op == TOKEN_LESSEQ || binarni_uzel->op == TOKEN_GREATEREQ) { // EQEQ, LESSEQ, GREATEREQ
                    binarni_uzel->op = TOKEN_NUMBER; Volej strncpy(binarni_uzel->name, "1", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel
                }
                Pokud (binarni_uzel->op == TOKEN_NEQ || binarni_uzel->op == TOKEN_LESS || binarni_uzel->op == TOKEN_GREATER) { // NEQ, LESS, GREATER
                    binarni_uzel->op = TOKEN_NUMBER; Volej strncpy(binarni_uzel->name, "0", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel
                }
            }
        }
        
        // --- ZCELA KONSTANTNI VYRAZ (Slozeni 2 cisel) ---
        Pokud (l_uzel->op == TOKEN_NUMBER && r_uzel->op == TOKEN_NUMBER) { // 34 = TOKEN_NUMBER
            Lokalni l_val = Volej NaCislo(l_uzel->name)
            Lokalni r_val = Volej NaCislo(r_uzel->name)
            Lokalni vys = 0
            Lokalni lze_opt = 1
            
            Pokud (binarni_uzel->op == TOKEN_PLUS) { vys = l_val + r_val } // PLUS
            Jinak Pokud (binarni_uzel->op == TOKEN_MINUS) { vys = l_val - r_val } // MINUS
            Jinak Pokud (binarni_uzel->op == TOKEN_MUL) { vys = l_val * r_val } // MUL
            Jinak Pokud (binarni_uzel->op == TOKEN_DIV) { // DIV (deleni nulou nechame na behu programu)
                Pokud (r_val == 0) { lze_opt = 0 } Jinak Pokud (r_val == 0 - 1) { vys = 0 - l_val } Jinak { vys = l_val / r_val }
            }
            Jinak Pokud (binarni_uzel->op == TOKEN_MOD) { // MOD
                Pokud (r_val == 0) { lze_opt = 0 } Jinak Pokud (r_val == 0 - 1) { vys = 0 } Jinak { vys = l_val % r_val }
            }
            Jinak Pokud (binarni_uzel->op == TOKEN_LESS) { Pokud (l_val < r_val) { vys = 1 } Jinak { vys = 0 } }
            Jinak Pokud (binarni_uzel->op == TOKEN_GREATER) { Pokud (l_val > r_val) { vys = 1 } Jinak { vys = 0 } }
            Jinak Pokud (binarni_uzel->op == TOKEN_LESSEQ) { Pokud (l_val <= r_val) { vys = 1 } Jinak { vys = 0 } }
            Jinak Pokud (binarni_uzel->op == TOKEN_GREATEREQ) { Pokud (l_val >= r_val) { vys = 1 } Jinak { vys = 0 } }
            Jinak Pokud (binarni_uzel->op == TOKEN_AMPER) { vys = l_val & r_val }
            Jinak Pokud (binarni_uzel->op == TOKEN_PIPE) { vys = l_val | r_val }
            Jinak Pokud (binarni_uzel->op == TOKEN_CARET) { vys = l_val ^ r_val }
            Jinak Pokud (binarni_uzel->op == TOKEN_SHL) { vys = l_val << (r_val & 63) }
            Jinak Pokud (binarni_uzel->op == TOKEN_SHR) { vys = l_val >> (r_val & 63) }
            Jinak Pokud (binarni_uzel->op == TOKEN_EQEQ) { Pokud (l_val == r_val) { vys = 1 } Jinak { vys = 0 } }
            Jinak Pokud (binarni_uzel->op == TOKEN_NEQ) { Pokud (l_val != r_val) { vys = 1 } Jinak { vys = 0 } }
            Jinak Pokud (binarni_uzel->op == TOKEN_AND) { Pokud (l_val != 0 && r_val != 0) { vys = 1 } Jinak { vys = 0 } } // AND
            Jinak Pokud (binarni_uzel->op == TOKEN_OR) { Pokud (l_val != 0 || r_val != 0) { vys = 1 } Jinak { vys = 0 } } // OR
            Jinak { lze_opt = 0 }
            
            Pokud (lze_opt == 1) {
                binarni_uzel->op = TOKEN_NUMBER
                Volej sprintf(binarni_uzel->name, "%lld", vys)
                binarni_uzel->left = 0
                binarni_uzel->right = 0
            }
            Vrat binarni_uzel
        }
        
        // --- ALGEBRAICKE ZJEDNODUSENI (prava strana je cislo) ---
        Pokud (r_uzel->op == TOKEN_NUMBER) {
            Lokalni r_cislo = Volej NaCislo(r_uzel->name)
            
            // Nasobeni, scitani
            Pokud (binarni_uzel->op == TOKEN_MUL && r_cislo == 0 && Volej JeCistyVyraz(l_uzel) == 1) { binarni_uzel->op = TOKEN_NUMBER; Volej strncpy(binarni_uzel->name, "0", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
            Jinak Pokud (binarni_uzel->op == TOKEN_MUL && r_cislo == 1) { Vrat l_uzel }
            Jinak Pokud (binarni_uzel->op == TOKEN_PLUS && r_cislo == 0) { Vrat l_uzel }
            Jinak Pokud (binarni_uzel->op == TOKEN_MINUS && r_cislo == 0) { Vrat l_uzel }
            Jinak Pokud (binarni_uzel->op == TOKEN_DIV && r_cislo == 1) { Vrat l_uzel }
            
            // Logika (AND, OR)
            Jinak Pokud (binarni_uzel->op == TOKEN_AND && r_cislo == 1) { Vrat l_uzel } // x && 1 = x
            Jinak Pokud (binarni_uzel->op == TOKEN_AND && r_cislo == 0 && Volej JeCistyVyraz(l_uzel) == 1) { binarni_uzel->op = TOKEN_NUMBER; Volej strncpy(binarni_uzel->name, "0", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
            Jinak Pokud (binarni_uzel->op == TOKEN_OR && r_cislo == 0) { Vrat l_uzel } // x || 0 = x
            Jinak Pokud (binarni_uzel->op == TOKEN_OR && r_cislo == 1 && Volej JeCistyVyraz(l_uzel) == 1) { binarni_uzel->op = TOKEN_NUMBER; Volej strncpy(binarni_uzel->name, "1", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
            
            // Strength Reduction (Bitove posuny) - jen pro cela cisla, ne pro Float!
            Pokud (binarni_uzel->op == TOKEN_MUL && Volej strcmp(Volej ZiskejTypUzlu(l_uzel), "Float") != 0) {
                Pokud (r_cislo == 2) { binarni_uzel->op = TOKEN_SHL; Volej strncpy(r_uzel->name, "1", 2); Vrat binarni_uzel }
                Pokud (r_cislo == 4) { binarni_uzel->op = TOKEN_SHL; Volej strncpy(r_uzel->name, "2", 2); Vrat binarni_uzel }
                Pokud (r_cislo == 8) { binarni_uzel->op = TOKEN_SHL; Volej strncpy(r_uzel->name, "3", 2); Vrat binarni_uzel }
            }
            // Deleni mocninou dvou NEPREVADIME na posun (pro zaporna cisla by vysel jiny vysledek)
        }
        
        // --- ALGEBRAICKE ZJEDNODUSENI (leva strana je cislo) ---
        Pokud (l_uzel->op == TOKEN_NUMBER) {
            Lokalni l_cislo = Volej NaCislo(l_uzel->name)
            Pokud (binarni_uzel->op == TOKEN_AND && l_cislo == 1) { Vrat r_uzel }
            Pokud (binarni_uzel->op == TOKEN_AND && l_cislo == 0) { binarni_uzel->op = TOKEN_NUMBER; Volej strncpy(binarni_uzel->name, "0", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
            Pokud (binarni_uzel->op == TOKEN_OR && l_cislo == 0) { Vrat r_uzel }
            Pokud (binarni_uzel->op == TOKEN_OR && l_cislo == 1) { binarni_uzel->op = TOKEN_NUMBER; Volej strncpy(binarni_uzel->name, "1", 2); binarni_uzel->left = 0; binarni_uzel->right = 0; Vrat binarni_uzel }
        }
    }
    Vrat binarni_uzel
}
// Volani metody: aktualni token je jmeno, za nim nasleduji argumenty v zavorkach
Metoda ParseVolani() {
    Lokalni nazev_token : Token = Volej ZiskejToken(aktualni_token_idx)
    Lokalni uzel : AST_Node = Volej VytvorUzel(AST_CALL, nazev_token->line)
    Pokud (nazev_token->type != TOKEN_IDENTIFIER) {
        Volej printf("Chyba (radek %d): Za 'Volej' ocekavam jmeno metody.\n", nazev_token->line)
        Volej exit(1)
    }
    Volej strncpy(uzel->name, nazev_token->value, 255)
    aktualni_token_idx = aktualni_token_idx + 1
    Lokalni lp : Token = Volej ZiskejToken(aktualni_token_idx)
    Pokud (lp->type != TOKEN_LPAREN) {
        Volej printf("Chyba (radek %d): Za jmenem metody '%s' ocekavam '('.\n", lp->line, uzel->name)
        Volej exit(1)
    }
    aktualni_token_idx = aktualni_token_idx + 1
    uzel->stmts = Volej calloc(16, 8)
    Lokalni kapacita_arg = 16
    uzel->stmt_count = 0
    Lokalni arg_token : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (arg_token->type != TOKEN_RPAREN) {
        Pokud (arg_token->type == TOKEN_EOF) {
            Volej printf("Chyba (radek %d): Neukoncene volani '%s' (chybi ')').\n", uzel->line, uzel->name)
            Volej exit(1)
        }
        Lokalni arg_vyraz = Volej ParseVyraz()
        Pokud (uzel->stmt_count >= kapacita_arg) {
            kapacita_arg = kapacita_arg * 2
            uzel->stmts = Volej realloc(uzel->stmts, kapacita_arg * 8)
        }
        Volej ZapisUkazatel(uzel->stmts + (uzel->stmt_count * 8), arg_vyraz)
        uzel->stmt_count = uzel->stmt_count + 1
        arg_token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (arg_token->type == TOKEN_COMMA) {
            aktualni_token_idx = aktualni_token_idx + 1
        } Jinak Pokud (arg_token->type != TOKEN_RPAREN) {
            Volej printf("Chyba (radek %d): V argumentech '%s' ocekavam ',' nebo ')'.\n", arg_token->line, uzel->name)
            Volej exit(1)
        }
        arg_token = Volej ZiskejToken(aktualni_token_idx)
    }
    aktualni_token_idx = aktualni_token_idx + 1
    Vrat uzel
}

Metoda ParseFaktor() {
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Lokalni uzel : AST_Node = 0

    Pokud (token->type == TOKEN_LPAREN) { // TOKEN_LPAREN
        aktualni_token_idx = aktualni_token_idx + 1
        uzel = Volej ParseVyraz()
        Lokalni rp_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (rp_token->type == TOKEN_RPAREN) { aktualni_token_idx = aktualni_token_idx + 1 }
    } Jinak Pokud (token->type == TOKEN_MINUS) { // TOKEN_MINUS
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_MINUS
        aktualni_token_idx = aktualni_token_idx + 1
        uzel->left = Volej ParseFaktor()
    } Jinak Pokud (token->type == TOKEN_NOT) { // TOKEN_NOT
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_NOT
        aktualni_token_idx = aktualni_token_idx + 1
        uzel->left = Volej ParseFaktor()
    } Jinak Pokud (token->type == TOKEN_STRING) { // TOKEN_STRING
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_STRING
        uzel->int_val = token->str_id
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == TOKEN_NUMBER) { // TOKEN_NUMBER
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_NUMBER
        Volej strncpy(uzel->name, token->value, 255)
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == TOKEN_FLOAT) { // TOKEN_FLOAT
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_FLOAT
        Volej strncpy(uzel->name, token->value, 255) 
        uzel->int_val = globalni_float_id 
        globalni_float_id = globalni_float_id + 1
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == TOKEN_VELIKOST) { // TOKEN_VELIKOST
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_NUMBER
        Lokalni typ_str : Token = Volej ZiskejToken(aktualni_token_idx + 2)
        Lokalni vel = Volej ZiskejVelikostStruktury(typ_str->value)
        Volej sprintf(uzel->name, "%lld", vel)
        aktualni_token_idx = aktualni_token_idx + 4
    } Jinak Pokud (token->type == TOKEN_CTI_ADRESU) { // TOKEN_CTI_ADRESU
        uzel = Volej VytvorUzel(AST_EXPR, token->line)
        uzel->op = TOKEN_CTI_ADRESU
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParseVyraz()
        aktualni_token_idx = aktualni_token_idx + 1
    } Jinak Pokud (token->type == TOKEN_ALOKUJ) { // TOKEN_ALOKUJ: "Alokuj n * 8" alokuje n*8 bajtu (cely vyraz)
        uzel = Volej VytvorUzel(AST_ALLOC, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        uzel->left = Volej ParseVyraz()
    } Jinak Pokud (token->type == TOKEN_VOLEJ) { // TOKEN_VOLEJ
        aktualni_token_idx = aktualni_token_idx + 1
        uzel = Volej ParseVolani()
    } Jinak Pokud (token->type == TOKEN_IDENTIFIER) { // TOKEN_IDENTIFIER
        Lokalni po_ident : Token = Volej ZiskejToken(aktualni_token_idx + 1)
        Pokud (po_ident->type == TOKEN_LPAREN) { // jmeno( ... ) = volani i bez slova Volej
            uzel = Volej ParseVolani()
        } Jinak Pokud (po_ident->type == TOKEN_ARROW) { // TOKEN_ARROW
            Lokalni vlastnost : Token = Volej ZiskejToken(aktualni_token_idx + 2)
            Lokalni ctvrty_token : Token = Volej ZiskejToken(aktualni_token_idx + 3)
            
            Pokud (ctvrty_token->type == TOKEN_LBRACKET) { // TOKEN_LBRACKET
                uzel = Volej VytvorUzel(AST_ARRAY_READ, token->line)
                Volej strncpy(uzel->name, token->value, 255)
                Volej strncpy(uzel->sub_name, vlastnost->value, 63)
                Lokalni sym_arr : Symbol = Volej NajdiSymbol(token->value)
                Pokud (sym_arr != 0) { uzel->int_val = Volej ZiskejOffset(sym_arr->type_name, vlastnost->value) }
                
                aktualni_token_idx = aktualni_token_idx + 4
                uzel->left = Volej ParseVyraz()
                
                Lokalni po_idx : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (po_idx->type == TOKEN_RBRACKET) { aktualni_token_idx = aktualni_token_idx + 1 }
            } Jinak {
                uzel = Volej VytvorUzel(AST_PTR_MEMBER_READ, token->line)
                Volej strncpy(uzel->name, token->value, 255)
                Volej strncpy(uzel->sub_name, vlastnost->value, 63)
                Lokalni sym : Symbol = Volej NajdiSymbol(token->value)
                Pokud (sym != 0) { uzel->int_val = Volej ZiskejOffset(sym->type_name, vlastnost->value) }
                aktualni_token_idx = aktualni_token_idx + 3
                // Retezeni a->b->c: clen b musi mit ve strukture uvedeny typ ("b : Typ")
                Lokalni sipka2 : Token = Volej ZiskejToken(aktualni_token_idx)
                Dokud (sipka2->type == TOKEN_ARROW) {
                    Lokalni typ_pred = Volej ZiskejTypUzlu(uzel)
                    Lokalni clen2 : Token = Volej ZiskejToken(aktualni_token_idx + 1)
                    Pokud (Volej strcmp(typ_pred, "") == 0 || Volej JeStruktura(typ_pred) == 0) {
                        Volej printf("Chyba (radek %d): Pred '->%s' musi byt clen s typem struktury. Ve strukture uvedte typ clenu, napr. 'dalsi : Uzel'.\n", token->line, clen2->value)
                        Volej exit(1)
                    }
                    Pokud (Volej MaClen(typ_pred, clen2->value) == 0) {
                        Volej printf("Chyba (radek %d): Struktura '%s' nema clen '%s'.\n", token->line, typ_pred, clen2->value)
                        Volej exit(1)
                    }
                    Lokalni ret : AST_Node = Volej VytvorUzel(AST_MEMBER_CHAIN, token->line)
                    ret->left = uzel
                    Volej strncpy(ret->name, typ_pred, 255)
                    Volej strncpy(ret->sub_name, clen2->value, 63)
                    ret->int_val = Volej ZiskejOffset(typ_pred, clen2->value)
                    uzel = ret
                    aktualni_token_idx = aktualni_token_idx + 2
                    sipka2 = Volej ZiskejToken(aktualni_token_idx)
                }
            }
        } Jinak Pokud (po_ident->type == TOKEN_LBRACKET) { // TOKEN_LBRACKET
            uzel = Volej VytvorUzel(AST_LOCAL_ARRAY_READ, token->line)
            Volej strncpy(uzel->name, token->value, 255)
            aktualni_token_idx = aktualni_token_idx + 2
            Lokalni idx_vyraz = Volej ParseVyraz()
            
            Lokalni po_idx2 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (po_idx2->type == TOKEN_RBRACKET) { aktualni_token_idx = aktualni_token_idx + 1 }
            
            // --- 2D POLE ---
            Lokalni po_idx3 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (po_idx3->type == TOKEN_LBRACKET) {
                aktualni_token_idx = aktualni_token_idx + 1
                Lokalni y_vyraz = Volej ParseVyraz()
                Lokalni po_idx4 : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (po_idx4->type == TOKEN_RBRACKET) { aktualni_token_idx = aktualni_token_idx + 1 }
                
                Lokalni sym_arr_2 : Symbol = Volej NajdiSymbol(token->value)
                Lokalni dim2_val = 1
                Pokud (sym_arr_2 != 0) { dim2_val = sym_arr_2->dim2 }
                
                Lokalni u_mul : AST_Node = Volej VytvorUzel(AST_EXPR, token->line); u_mul->op = TOKEN_MUL
                u_mul->left = idx_vyraz
                Lokalni u_d2 : AST_Node = Volej VytvorUzel(AST_EXPR, token->line); u_d2->op = TOKEN_NUMBER
                Volej sprintf(u_d2->name, "%d", dim2_val)
                u_mul->right = u_d2
                
                Lokalni u_add : AST_Node = Volej VytvorUzel(AST_EXPR, token->line); u_add->op = TOKEN_PLUS
                u_add->left = u_mul; u_add->right = y_vyraz
                idx_vyraz = u_add
            }
            uzel->left = idx_vyraz
            
        } Jinak {
            Lokalni sym_id_opt : Symbol = Volej NajdiSymbol(token->value)
            Pokud (sym_id_opt != 0 && sym_id_opt->is_const == 1) {
                uzel = Volej VytvorUzel(AST_EXPR, token->line)
                uzel->op = TOKEN_NUMBER
                Volej sprintf(uzel->name, "%lld", sym_id_opt->const_val)
                aktualni_token_idx = aktualni_token_idx + 1
            } Jinak {
                uzel = Volej VytvorUzel(AST_EXPR, token->line)
                uzel->op = TOKEN_IDENTIFIER
                Volej strncpy(uzel->name, token->value, 255)
                aktualni_token_idx = aktualni_token_idx + 1
            }
        }
    } Jinak {
        Volej printf("Chyba (radek %d): Neocekavany token '%s' ve vyrazu.\n", token->line, token->value)
        Volej exit(1)
    }

    Vrat uzel
}
Metoda ParseNasobeni() {
    Lokalni uzel = Volej ParseFaktor()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_MUL || t->type == TOKEN_DIV || t->type == TOKEN_MOD) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseFaktor()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseScitani() {
    Lokalni uzel = Volej ParseNasobeni()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_PLUS || t->type == TOKEN_MINUS) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseNasobeni()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParsePosun() {
    Lokalni uzel = Volej ParseScitani()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_SHL || t->type == TOKEN_SHR) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseScitani()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParsePorovnani() {
    Lokalni uzel = Volej ParsePosun()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_LESS || t->type == TOKEN_LESSEQ || t->type == TOKEN_GREATER || t->type == TOKEN_GREATEREQ) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParsePosun()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseRovnost() {
    Lokalni uzel = Volej ParsePorovnani()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_EQEQ || t->type == TOKEN_NEQ) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParsePorovnani()
        bin_uzel = Volej OptimalizujUzel(bin_uzel)
        uzel = bin_uzel
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseBitAND() {
    Lokalni uzel = Volej ParseRovnost()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_AMPER) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseRovnost()
        uzel = Volej OptimalizujUzel(bin_uzel)
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseBitXOR() {
    Lokalni uzel = Volej ParseBitAND()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_CARET) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseBitAND()
        uzel = Volej OptimalizujUzel(bin_uzel)
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseBitOR() {
    Lokalni uzel = Volej ParseBitXOR()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_PIPE) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseBitXOR()
        uzel = Volej OptimalizujUzel(bin_uzel)
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

// Priorita: && vaze silneji nez || (jako v C), tedy a || b && c = a || (b && c)
Metoda ParseLogickeA() {
    Lokalni uzel = Volej ParseBitOR()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_AND) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseBitOR()
        uzel = Volej OptimalizujUzel(bin_uzel)
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}

Metoda ParseVyraz() {
    Lokalni uzel = Volej ParseLogickeA()
    Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (t->type == TOKEN_OR) {
        Lokalni bin_uzel : AST_Node = Volej VytvorUzel(AST_EXPR, t->line)
        bin_uzel->op = t->type
        bin_uzel->left = uzel
        aktualni_token_idx = aktualni_token_idx + 1
        bin_uzel->right = Volej ParseLogickeA()
        uzel = Volej OptimalizujUzel(bin_uzel)
        t = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat uzel
}
Metoda ZiskejTypUzlu(u : AST_Node) {
    Pokud (u == 0) { Vrat "" }
    Pokud (u->op == TOKEN_STRING || u->op == OP_SPOJ_TEXTY) { Vrat "String" }
    Pokud (u->op == TOKEN_FLOAT) { Vrat "Float" }
    
    // Pro matematicke operatory odvodime typ z leve/prave strany
    Pokud (u->op == TOKEN_NUMBER || u->op == TOKEN_PLUS || u->op == TOKEN_MINUS || u->op == TOKEN_MUL || u->op == TOKEN_DIV || u->op == TOKEN_MOD) {
        Lokalni lt = Volej ZiskejTypUzlu(u->left)
        Lokalni rt = Volej ZiskejTypUzlu(u->right)
        Pokud (Volej strcmp(lt, "Float") == 0 || Volej strcmp(rt, "Float") == 0) { Vrat "Float" }
        Pokud (Volej strcmp(lt, "String") == 0 || Volej strcmp(rt, "String") == 0) { Vrat "String" }
        Vrat "Cislo"
    }
    Pokud (u->op == TOKEN_IDENTIFIER) { // IDENTIFIER
        Lokalni sym : Symbol = Volej NajdiSymbol(u->name)
        Pokud (sym != 0) { Vrat sym->type_name }
    }
    Pokud (u->type == AST_PTR_MEMBER_READ) { // p->text (pole ve strukture) je text
        Lokalni psym : Symbol = Volej NajdiSymbol(u->name)
        Pokud (psym != 0) {
            Pokud (Volej JeClenPole(psym->type_name, u->sub_name) == 1) { Vrat "String" }
            Vrat Volej TypClenu(psym->type_name, u->sub_name)
        }
        Vrat ""
    }
    Pokud (u->type == AST_MEMBER_CHAIN) {
        Pokud (Volej JeClenPole(u->name, u->sub_name) == 1) { Vrat "String" }
        Vrat Volej TypClenu(u->name, u->sub_name)
    }
    Pokud (u->type == AST_CALL) { // AST_CALL
        Pokud (Volej JeFloatExtern(u->name) == 1) { Vrat "Float" }
        Lokalni fsym : Symbol = Volej NajdiSymbol(u->name)
        Pokud (fsym != 0 && fsym->is_function == 1) {
            Lokalni fnode : AST_Node = fsym->func_node
            Vrat fnode->type_name
        }
    }
    Vrat ""
}

// ==========================================
// TYPOVA KONTROLA (prochazi cely strom, vcetne tel metod)
// ==========================================
Metoda ZkontrolujAST(uzel : AST_Node) {
    Pokud (uzel == 0) { Vrat 0 }
    Pokud (uzel->type == AST_NOP) { Vrat 0 }
    Lokalni t = uzel->type

    Pokud (t == AST_METHOD) {
        kontrola_aktualni_typ_metody = uzel->type_name
        codegen_scoped = 1
        codegen_sym_start = uzel->sym_start
        codegen_sym_end = uzel->sym_end
        Volej ZkontrolujAST(uzel->right)
        codegen_scoped = 0
        kontrola_aktualni_typ_metody = 0
        Vrat 0
    }

    // 1) Nejdriv vsechny podstromy (typ vyrazu zavisi na typech jeho casti)
    Volej ZkontrolujAST(uzel->left)
    Volej ZkontrolujAST(uzel->right)
    Volej ZkontrolujAST(uzel->alt)
    Pokud (uzel->stmts != 0) {
        Lokalni i = 0
        Dokud (i < uzel->stmt_count) {
            Volej ZkontrolujAST(Volej CtiUkazatel(uzel->stmts + (i * 8)))
            i = i + 1
        }
    }

    // 2) Pretezovani operatoru pro texty: "a" + "b", "a" == "b", "a" != "b"
    Pokud (t == 5) {
        Pokud (uzel->op == TOKEN_PLUS || uzel->op == TOKEN_EQEQ || uzel->op == TOKEN_NEQ) {
            Lokalni l_typ = Volej ZiskejTypUzlu(uzel->left)
            Lokalni r_typ = Volej ZiskejTypUzlu(uzel->right)
            Pokud (Volej strcmp(l_typ, "String") == 0 && Volej strcmp(r_typ, "String") == 0) {
                Pokud (uzel->op == TOKEN_PLUS) { uzel->op = OP_SPOJ_TEXTY }   // spojeni textu
                Pokud (uzel->op == TOKEN_EQEQ) { uzel->op = OP_TEXTY_ROVNO }   // texty se rovnaji
                Pokud (uzel->op == TOKEN_NEQ) { uzel->op = OP_TEXTY_NEROVNO }   // texty se lisi
            }
        }
    }

    // 3) Volani: pocet a typy argumentu
    Pokud (t == AST_CALL && Volej JeVestavena(uzel->name) > 0) {
        Lokalni vk = Volej JeVestavena(uzel->name)
        Pokud (uzel->stmt_count != Volej PocetArgVestavene(vk)) {
            Volej printf("Chyba (radek %d): Vestavena metoda '%s' ocekava %d argumentu.\n", uzel->line, uzel->name, Volej PocetArgVestavene(vk))
            Volej exit(1)
        }
        Vrat 0
    }
    Pokud (t == AST_CALL) {
        Lokalni met_sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (met_sym == 0 && Volej JeExterniJmeno(uzel->name) == 0) {
            Volej printf("Chyba (radek %d): Neznama metoda '%s' (chybi Metoda nebo Externi).\n", uzel->line, uzel->name)
            Volej exit(1)
        }
        Pokud (met_sym != 0 && met_sym->is_function == 1) {
            Lokalni def_uzel : AST_Node = met_sym->func_node
            Pokud (uzel->stmt_count != def_uzel->arg_count) {
                Volej printf("Typova chyba (radek %d): Metoda '%s' ocekava %d argumentu, ale bylo predano %d.\n", uzel->line, uzel->name, def_uzel->arg_count, uzel->stmt_count)
                Volej exit(1)
            }
            Lokalni k = 0
            Dokud (k < def_uzel->arg_count) {
                Lokalni ocekavany_sym : Symbol = pamet_symbolu + ((def_uzel->sym_start + k) * Velikost(Symbol))
                Lokalni dodany_uzel : AST_Node = Volej CtiUkazatel(uzel->stmts + (k * 8))
                Lokalni ocek = ocekavany_sym->type_name
                Lokalni dod = Volej ZiskejTypUzlu(dodany_uzel)
                Pokud (Volej TypyKonfliktni(ocek, dod) == 1) {
                    Volej printf("Typova chyba (radek %d): Argument %d pro '%s' ma byt typu '%s', ale byl predan '%s'.\n", uzel->line, k + 1, uzel->name, ocek, dod)
                    Volej exit(1)
                }
                k = k + 1
            }
        }
    }

    // 4) Vrat: typ navratove hodnoty
    Pokud (t == AST_RETURN && uzel->left != 0) {
        Pokud (kontrola_aktualni_typ_metody != 0) {
            Lokalni ret_typ = Volej ZiskejTypUzlu(uzel->left)
            Pokud (Volej TypyKonfliktni(kontrola_aktualni_typ_metody, ret_typ) == 1) {
                Volej printf("Typova chyba (radek %d): Metoda ma vracet typ '%s', ale vraci '%s'.\n", uzel->line, kontrola_aktualni_typ_metody, ret_typ)
                Volej exit(1)
            }
        }
    }

    // 5) Prirazeni: typ promenne vs. typ hodnoty
    Pokud ((t == AST_ASSIGN || t == AST_VAR_DECL) && uzel->right != 0) {
        Lokalni levy_sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (levy_sym == 0) {
            Volej printf("Chyba (radek %d): Nedeklarovana promenna '%s'.\n", uzel->line, uzel->name)
            Volej exit(1)
        }
        Pokud (levy_sym->is_const == 1 || levy_sym->is_function == 1) {
            Volej printf("Chyba (radek %d): Do '%s' nelze prirazovat (je to Konstanta nebo Metoda).\n", uzel->line, uzel->name)
            Volej exit(1)
        }
        Lokalni odvozeny_typ = Volej ZiskejTypUzlu(uzel->right)
        Pokud (Volej TypyKonfliktni(levy_sym->type_name, odvozeny_typ) == 1) {
            Volej printf("Typova chyba (radek %d): Nelze priradit '%s' do promenne '%s' (ocekava '%s').\n", uzel->line, odvozeny_typ, levy_sym->name, levy_sym->type_name)
            Pokud (Volej strcmp(levy_sym->type_name, "Float") == 0 && Volej strcmp(odvozeny_typ, "Cislo") == 0) {
                Volej printf("Tip: desetinne cislo se pise s teckou, napr. 0.0 misto 0.\n")
            }
            Volej exit(1)
        }
    }
    Vrat 0
}

// Dva typy jsou v konfliktu, kdyz jsou oba znamy a jeden z nich je Float nebo String
// a druhy ne. Cisla, struktury a ukazatele jsou navzajem slucitelne (vse je 64bitove slovo).
Metoda TypyKonfliktni(a, b) {
    Pokud (a == 0 || b == 0) { Vrat 0 }
    Pokud (Volej strcmp(a, "") == 0 || Volej strcmp(b, "") == 0) { Vrat 0 }
    Lokalni a_spec = 0
    Lokalni b_spec = 0
    Pokud (Volej strcmp(a, "Float") == 0 || Volej strcmp(a, "String") == 0) { a_spec = 1 }
    Pokud (Volej strcmp(b, "Float") == 0 || Volej strcmp(b, "String") == 0) { b_spec = 1 }
    Pokud (a_spec == 0 && b_spec == 0) { Vrat 0 }
    Pokud (Volej strcmp(a, b) == 0) { Vrat 0 }
    Vrat 1
}

Metoda ParseBlok() {
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Lokalni blok : AST_Node = Volej VytvorUzel(AST_BLOCK, token->line) // 1 = AST_BLOCK
    
    Volej ZapisUkazatel(blok + 40, 10)
    blok->stmts = Volej calloc(10, 8)
    blok->stmt_count = 0

    aktualni_hloubka_bloku = aktualni_hloubka_bloku + 1
    aktualni_token_idx = aktualni_token_idx + 1

    token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (token->type != TOKEN_RBRACE && token->type != TOKEN_EOF) { // 37 = RBRACE, 55 = EOF
        Lokalni prikaz = Volej ParsePrikaz()
        Pokud (prikaz != 0) {
            Lokalni aktualni_kapacita = Volej CtiUkazatel(blok + 40)
            Pokud (blok->stmt_count >= aktualni_kapacita) {
                aktualni_kapacita = aktualni_kapacita * 2
                Volej ZapisUkazatel(blok + 40, aktualni_kapacita)
                blok->stmts = Volej realloc(blok->stmts, aktualni_kapacita * 8)
            }
            Lokalni adresa_v_poli = blok->stmts + (blok->stmt_count * 8)
            Volej ZapisUkazatel(adresa_v_poli, prikaz)
            blok->stmt_count = blok->stmt_count + 1
        }
        token = Volej ZiskejToken(aktualni_token_idx)
    }
    
    aktualni_token_idx = aktualni_token_idx + 1
    
    Lokalni i = pocet_symbolu - 1
    Dokud (i >= parse_sym_start) {
        Lokalni sym : Symbol = pamet_symbolu + (i * Velikost(Symbol))
        // OPRAVA: Pro jistotu odkazovat explicitně přes hloubku, předejde zacyklení scope
        Lokalni depth = sym->scope_depth
        Pokud (depth == aktualni_hloubka_bloku) {
            sym->is_active = 0
        }
        i = i - 1
    }
    
    aktualni_hloubka_bloku = aktualni_hloubka_bloku - 1
    Vrat blok
}
Metoda ParsePrikaz() {
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Lokalni uzel : AST_Node = 0
    Lokalni str_token : Token = 0

    Pokud (token->type == TOKEN_ASM) { // TOKEN_ASM
        uzel = Volej VytvorUzel(AST_ASM_NODE, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        str_token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (str_token->type == TOKEN_STRING) { Volej strncpy(uzel->name, str_token->value, 255) } Jinak { Volej strncpy(uzel->name, "nop", 255) }
        aktualni_token_idx = aktualni_token_idx + 1
        Vrat uzel
    }
    
    Pokud (token->type == TOKEN_Odloz) { // TOKEN_Odloz
        // Odloz smi byt jen primo v tele metody (ne uvnitr Pokud/Dokud...),
        // jinak by se provedl i tehdy, kdyz se k nemu program vubec nedostal.
        Pokud (aktualni_hloubka_bloku != 1) {
            Volej printf("Chyba (radek %d): Odloz smi byt jen primo v tele metody, ne uvnitr bloku.\n", token->line)
            Volej exit(1)
        }
        uzel = Volej VytvorUzel(AST_DEFER, token->line) // AST_DEFER = 34
        aktualni_token_idx = aktualni_token_idx + 1
        uzel->left = Volej ParsePrikaz() // Nacte prikaz, ktery se ma Odloz
        Vrat uzel
    }
    
    Pokud (token->type == TOKEN_VRAT) { // Vrat [vyraz]
        uzel = Volej VytvorUzel(AST_RETURN, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni za_vrat : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (za_vrat->type != TOKEN_RBRACE && za_vrat->line == token->line) { uzel->left = Volej ParseVyraz() } // "Vrat" bez hodnoty vraci 0
        Vrat uzel
    }
    Pokud (token->type == TOKEN_UKONCI) { uzel = Volej VytvorUzel(AST_BREAK, token->line); aktualni_token_idx = aktualni_token_idx + 1; Vrat uzel }
    Pokud (token->type == TOKEN_POKRACUJ) { uzel = Volej VytvorUzel(AST_CONTINUE, token->line); aktualni_token_idx = aktualni_token_idx + 1; Vrat uzel }
    Pokud (token->type == TOKEN_UVOLNI) { uzel = Volej VytvorUzel(AST_FREE, token->line); aktualni_token_idx = aktualni_token_idx + 1; uzel->left = Volej ParseVyraz(); Vrat uzel }

    Pokud (token->type == TOKEN_LOKALNI) { // TOKEN_LOKALNI
        uzel = Volej VytvorUzel(AST_VAR_DECL, token->line)
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni nazev_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Volej strncpy(uzel->name, nazev_token->value, 255)
        aktualni_token_idx = aktualni_token_idx + 1

        Lokalni velikost_bajtu = 8
        Lokalni token_zavor : Token = Volej ZiskejToken(aktualni_token_idx)
        Lokalni d1 = 0 // 0 = obycejna promenna, > 0 = pole
        Lokalni d2 = 1
        
        Pokud (token_zavor->type == TOKEN_LBRACKET) { // LBRACKET
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni cislo_tok : Token = Volej ZiskejToken(aktualni_token_idx)
            d1 = Volej VelikostZTokenu(cislo_tok)
            aktualni_token_idx = aktualni_token_idx + 2
            
            Lokalni token_zavor2 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (token_zavor2->type == TOKEN_LBRACKET) { // 2. Rozmer
                aktualni_token_idx = aktualni_token_idx + 1
                Lokalni cislo_tok2 : Token = Volej ZiskejToken(aktualni_token_idx)
                d2 = Volej VelikostZTokenu(cislo_tok2)
                aktualni_token_idx = aktualni_token_idx + 2
            }
            Pokud (d1 < 1 || d2 < 1) {
                Volej printf("Chyba (radek %d): Velikost pole '%s' musi byt kladne cislo.\n", token->line, uzel->name)
                Volej exit(1)
            }
            velikost_bajtu = (d1 * d2) * 8
        }

        Lokalni dvojtecka : Token = Volej ZiskejToken(aktualni_token_idx)
        Lokalni typ_promenne = ""
        Pokud (dvojtecka->type == TOKEN_COLON) { 
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni typ_token : Token = Volej ZiskejToken(aktualni_token_idx)
            typ_promenne = typ_token->value
            aktualni_token_idx = aktualni_token_idx + 1
        }

        Lokalni eq_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (eq_token->type == TOKEN_EQ) { // EQ
            aktualni_token_idx = aktualni_token_idx + 1
            uzel->right = Volej ParseVyraz()
        } Jinak {
            uzel->right = 0
        }

        aktualni_radek_parseru = token->line
        Volej PridejLokalniSymbol(uzel->name, velikost_bajtu)
        
        Lokalni sym : Symbol = Volej NajdiSymbol(uzel->name)
        Pokud (sym != 0) {
            sym->dim1 = d1
            sym->dim2 = d2
            Pokud (Volej strcmp(typ_promenne, "") != 0) {
                Volej strncpy(sym->type_name, typ_promenne, 63)
            } Jinak Pokud (uzel->right != 0) {
                Lokalni odvozeny = Volej ZiskejTypUzlu(uzel->right)
                Pokud (Volej strcmp(odvozeny, "") != 0) {
                    Volej strncpy(sym->type_name, odvozeny, 63)
                }
            }
        }
        Vrat uzel
    }
    
    Pokud (token->type == TOKEN_VYPIS) { uzel = Volej VytvorUzel(AST_PRINT, token->line); aktualni_token_idx = aktualni_token_idx + 1; uzel->left = Volej ParseVyraz(); Vrat uzel }

    Pokud (token->type == TOKEN_IDENTIFIER) { // IDENTIFIER
        Lokalni dalsi_token : Token = Volej ZiskejToken(aktualni_token_idx + 1)
        Pokud (dalsi_token->type == TOKEN_LPAREN) { Vrat Volej ParseVolani() } // jmeno(...) bez slova Volej
        Pokud (dalsi_token->type == TOKEN_EQ || dalsi_token->type == TOKEN_PLUSEQ || dalsi_token->type == TOKEN_MINUSEQ) {
            uzel = Volej VytvorUzel(AST_ASSIGN, token->line)
            uzel->op = dalsi_token->type
            Volej strncpy(uzel->name, token->value, 255)
            aktualni_token_idx = aktualni_token_idx + 2
            uzel->right = Volej ParseVyraz()
            Lokalni sym_as : Symbol = Volej NajdiSymbol(uzel->name)
            // Typ promenne se urcuje jen pri deklaraci (Lokalni / Globalni), ne pri prirazeni
            Vrat uzel
        } Jinak Pokud (dalsi_token->type == TOKEN_ARROW) { // ARROW
            Lokalni vlastnost : Token = Volej ZiskejToken(aktualni_token_idx + 2)
            Lokalni treti_token : Token = Volej ZiskejToken(aktualni_token_idx + 3)
            Pokud (treti_token->type == TOKEN_ARROW) { // a->b->c = hodnota
                Lokalni lev : AST_Node = Volej ParseVyraz()
                Lokalni rovn : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (lev->type != AST_MEMBER_CHAIN || rovn->type != TOKEN_EQ) {
                    Volej printf("Chyba (radek %d): Za '%s->%s->...' ocekavam '='.\n", token->line, token->value, vlastnost->value)
                    Volej exit(1)
                }
                uzel = Volej VytvorUzel(AST_MEMBER_CHAIN_ASSIGN, token->line)
                uzel->left = lev->left
                Volej strncpy(uzel->name, lev->name, 255)
                Volej strncpy(uzel->sub_name, lev->sub_name, 63)
                uzel->int_val = lev->int_val
                aktualni_token_idx = aktualni_token_idx + 1
                uzel->right = Volej ParseVyraz()
                Vrat uzel
            }
            
            Pokud (treti_token->type == TOKEN_EQ) { // EQ
                uzel = Volej VytvorUzel(AST_PTR_MEMBER_ASSIGN, token->line)
                Volej strncpy(uzel->name, token->value, 255)
                Lokalni sym2 : Symbol = Volej NajdiSymbol(token->value)
                Pokud (sym2 != 0) { uzel->int_val = Volej ZiskejOffset(sym2->type_name, vlastnost->value) }
                aktualni_token_idx = aktualni_token_idx + 4
                uzel->right = Volej ParseVyraz()
                Vrat uzel
            } Jinak Pokud (treti_token->type == TOKEN_LBRACKET) { // LBRACKET
                uzel = Volej VytvorUzel(AST_ARRAY_ASSIGN, token->line)
                Volej strncpy(uzel->name, token->value, 255)
                Volej strncpy(uzel->sub_name, vlastnost->value, 63)
                Lokalni sym_arr : Symbol = Volej NajdiSymbol(token->value)
                Pokud (sym_arr != 0) { uzel->int_val = Volej ZiskejOffset(sym_arr->type_name, vlastnost->value) }
                aktualni_token_idx = aktualni_token_idx + 4
                uzel->left = Volej ParseVyraz()
                Lokalni po_idx : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (po_idx->type == TOKEN_RBRACKET) { aktualni_token_idx = aktualni_token_idx + 1 }
                Lokalni r_eq : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (r_eq->type == TOKEN_EQ) { aktualni_token_idx = aktualni_token_idx + 1 }
                uzel->right = Volej ParseVyraz()
                Vrat uzel
            }
        } Jinak Pokud (dalsi_token->type == TOKEN_LBRACKET) { // LBRACKET
            uzel = Volej VytvorUzel(AST_LOCAL_ARRAY_ASSIGN, token->line)
            Volej strncpy(uzel->name, token->value, 255)
            aktualni_token_idx = aktualni_token_idx + 2
            Lokalni idx_vyraz = Volej ParseVyraz()
            Lokalni po_idx2 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (po_idx2->type == TOKEN_RBRACKET) { aktualni_token_idx = aktualni_token_idx + 1 }
            
            // --- 2D MATICE ---
            Lokalni po_idx3 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (po_idx3->type == TOKEN_LBRACKET) {
                aktualni_token_idx = aktualni_token_idx + 1
                Lokalni y_vyraz = Volej ParseVyraz()
                Lokalni po_idx4 : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (po_idx4->type == TOKEN_RBRACKET) { aktualni_token_idx = aktualni_token_idx + 1 }
                
                Lokalni sym_arr_2 : Symbol = Volej NajdiSymbol(token->value)
                Lokalni dim2_val = 1
                Pokud (sym_arr_2 != 0) { dim2_val = sym_arr_2->dim2 }
                
                Lokalni u_mul : AST_Node = Volej VytvorUzel(AST_EXPR, token->line); u_mul->op = TOKEN_MUL
                u_mul->left = idx_vyraz
                Lokalni u_d2 : AST_Node = Volej VytvorUzel(AST_EXPR, token->line); u_d2->op = TOKEN_NUMBER
                Volej sprintf(u_d2->name, "%d", dim2_val)
                u_mul->right = u_d2
                
                Lokalni u_add : AST_Node = Volej VytvorUzel(AST_EXPR, token->line); u_add->op = TOKEN_PLUS
                u_add->left = u_mul; u_add->right = y_vyraz
                idx_vyraz = u_add
            }
            
            uzel->left = idx_vyraz
            Lokalni r_eq2 : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (r_eq2->type == TOKEN_EQ) { aktualni_token_idx = aktualni_token_idx + 1 }
            uzel->right = Volej ParseVyraz()
            Vrat uzel
        }
    }

    Pokud (token->type == TOKEN_POKUD) { // POKUD
        uzel = Volej VytvorUzel(AST_IF, token->line)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParseVyraz()
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni pb_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (pb_token->type == TOKEN_LBRACE) { uzel->right = Volej ParseBlok() } Jinak { uzel->right = Volej ParsePrikaz() }
        Lokalni jinak_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (jinak_token->type == TOKEN_JINAK) { // JINAK
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni eb_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (eb_token->type == TOKEN_LBRACE) { uzel->alt = Volej ParseBlok() } Jinak { uzel->alt = Volej ParsePrikaz() }
        }
        Vrat uzel
    }
    
    Pokud (token->type == TOKEN_DOKUD) { // DOKUD
        uzel = Volej VytvorUzel(AST_WHILE, token->line)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParseVyraz()
        aktualni_token_idx = aktualni_token_idx + 1
        Lokalni db_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (db_token->type == TOKEN_LBRACE) { uzel->right = Volej ParseBlok() } Jinak { uzel->right = Volej ParsePrikaz() }
        Volej OptimalizujSCEV(uzel)
        Vrat uzel
    }

    Pokud (token->type == TOKEN_OPAKUJ) { // OPAKUJ
        uzel = Volej VytvorUzel(AST_FOR, token->line)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParsePrikaz()
        Lokalni carka1 : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (carka1->type == TOKEN_COMMA) { aktualni_token_idx = aktualni_token_idx + 1 }
        uzel->right = Volej ParseVyraz()
        Lokalni carka2 : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (carka2->type == TOKEN_COMMA) { aktualni_token_idx = aktualni_token_idx + 1 }
        uzel->alt = Volej ParsePrikaz()
        Lokalni rp_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (rp_token->type == TOKEN_RPAREN) { aktualni_token_idx = aktualni_token_idx + 1 }
        Lokalni blok_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (blok_token->type == TOKEN_LBRACE) {
            Lokalni telo1 = Volej ParseBlok()
            uzel->stmts = Volej calloc(1, 8)
            uzel->stmt_count = 1
            Volej ZapisUkazatel(uzel->stmts, telo1)
        } Jinak {
            Lokalni telo2 = Volej ParsePrikaz()
            uzel->stmts = Volej calloc(1, 8)
            uzel->stmt_count = 1
            Volej ZapisUkazatel(uzel->stmts, telo2)
        }
        Volej OptimalizujRozbaleniOpakuj(uzel)
        Vrat uzel
    }

    Pokud (token->type == TOKEN_ROZCESTNIK) { // ROZCESTNIK
        uzel = Volej VytvorUzel(AST_SWITCH, token->line)
        aktualni_token_idx = aktualni_token_idx + 2
        uzel->left = Volej ParseVyraz()
        Lokalni rp : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (rp->type == TOKEN_RPAREN) { aktualni_token_idx = aktualni_token_idx + 1 }
        Lokalni lb : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (lb->type == TOKEN_LBRACE) { aktualni_token_idx = aktualni_token_idx + 1 }
        uzel->stmts = Volej calloc(8, 8)
        uzel->stmt_count = 0
        Lokalni t : Token = Volej ZiskejToken(aktualni_token_idx)
        Dokud (t->type != TOKEN_RBRACE && t->type != TOKEN_EOF) { 
            Pokud (t->type == TOKEN_CESTA) { // CESTA
                Lokalni c_uzel : AST_Node = Volej VytvorUzel(AST_CASE, t->line)
                aktualni_token_idx = aktualni_token_idx + 1
                c_uzel->left = Volej ParseVyraz()
                Lokalni hodnota_c : AST_Node = c_uzel->left
                Pokud (hodnota_c->op != TOKEN_NUMBER) {
                    Volej printf("Chyba (radek %d): Hodnota za 'Cesta' musi byt cele cislo nebo Konstanta.\n", t->line)
                    Volej exit(1)
                }
                Lokalni col : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (col->type == TOKEN_COLON) { aktualni_token_idx = aktualni_token_idx + 1 }
                Lokalni akce_token : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (akce_token->type == TOKEN_LBRACE) { c_uzel->right = Volej ParseBlok() } Jinak { c_uzel->right = Volej ParsePrikaz() }
                Volej PridejDoSeznamu(uzel, c_uzel)
            } Jinak Pokud (t->type == TOKEN_HLAVNI_CESTA) { // HLAVNI_CESTA
                aktualni_token_idx = aktualni_token_idx + 1
                Lokalni col2 : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (col2->type == TOKEN_COLON) { aktualni_token_idx = aktualni_token_idx + 1 } 
                Lokalni akce_token2 : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (akce_token2->type == TOKEN_LBRACE) { uzel->alt = Volej ParseBlok() } Jinak { uzel->alt = Volej ParsePrikaz() }
            } Jinak {
                Volej printf("Chyba (radek %d): V Rozcestniku ocekavam 'Cesta hodnota:' nebo 'Hlavni_cesta:'.\n", t->line)
                Volej exit(1)
            }
            t = Volej ZiskejToken(aktualni_token_idx)
        }
        aktualni_token_idx = aktualni_token_idx + 1
        Vrat uzel
    }

    Pokud (token->type == TOKEN_VOLEJ) { // Volej jmeno(...)
        aktualni_token_idx = aktualni_token_idx + 1
        Vrat Volej ParseVolani()
    }

    Volej printf("Chyba (radek %d): Neocekavany prikaz '%s'.\n", token->line, token->value)
    Volej exit(1)
    Vrat 0
}
Metoda ParseMetoda() {
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    
    Pokud (token->type == TOKEN_METODA) { // 65 = TOKEN_METODA
        Lokalni uzel : AST_Node = Volej VytvorUzel(AST_METHOD, token->line) // 10 = AST_METHOD
        aktualni_token_idx = aktualni_token_idx + 1
        
        Lokalni nazev_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (podrobny_vypis == 1) { Volej printf("Parsuji metodu: %s\n", nazev_token->value) }
        Volej strncpy(uzel->name, nazev_token->value, 255)
        Pokud (nazev_token->type != TOKEN_IDENTIFIER) {
            Volej printf("Chyba (radek %d): Za 'Metoda' ocekavam jmeno metody, nasel jsem '%s'.\n", nazev_token->line, nazev_token->value)
            Volej exit(1)
        }
        Lokalni zavorka_m : Token = Volej ZiskejToken(aktualni_token_idx + 1)
        Pokud (zavorka_m->type != TOKEN_LPAREN) {
            Volej printf("Chyba (radek %d): Za jmenem metody '%s' ocekavam '('.\n", nazev_token->line, nazev_token->value)
            Volej exit(1)
        }
        Lokalni drivejsi : Symbol = Volej NajdiSymbol(nazev_token->value)
        Pokud (drivejsi != 0) {
            Pokud (drivejsi->is_global == 1) {
                Volej printf("Chyba (radek %d): Jmeno '%s' uz je pouzite (metoda nebo globalni promenna se stejnym jmenem).\n", nazev_token->line, nazev_token->value)
                Volej exit(1)
            }
        }
        aktualni_token_idx = aktualni_token_idx + 2
        
        Volej ZkontrolujKapacituSymbolu()
        Lokalni met_sym : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
                Volej VycistiSymbol(met_sym)

        Volej strncpy(met_sym->name, nazev_token->value, 255)
        met_sym->is_global = 1
        met_sym->is_function = 1
        met_sym->is_active = 1
        met_sym->func_node = uzel
        Pokud (pam_dalsi == 1) { Volej strncpy(met_sym->init_str, "Pamatuj", 63) }
        pocet_symbolu = pocet_symbolu + 1
        Volej ZaregistrujDoHashe(pocet_symbolu - 1)
        
        current_local_offset = 0
        Lokalni arg_idx = 0
        uzel->sym_start = pocet_symbolu
        parse_sym_start = pocet_symbolu
        
        Lokalni arg_token : Token = Volej ZiskejToken(aktualni_token_idx)
        Dokud (arg_token->type != TOKEN_RPAREN && arg_token->type != TOKEN_EOF) { // 41 = RPAREN, 55 = EOF
            Pokud (arg_token->type == TOKEN_IDENTIFIER) { // 35 = TOKEN_IDENTIFIER
                Volej ZkontrolujKapacituSymbolu()
                Lokalni novy_param : Symbol = pamet_symbolu + (pocet_symbolu * Velikost(Symbol))
                Volej strncpy(novy_param->name, arg_token->value, 255)
                novy_param->is_global = 0
                novy_param->is_const = 0
                novy_param->offset = 0 - ((arg_idx + 2) * 8)
                novy_param->scope_depth = 0
                novy_param->is_active = 1
                
                pocet_symbolu = pocet_symbolu + 1
                Volej ZaregistrujDoHashe(pocet_symbolu - 1)
                
                arg_idx = arg_idx + 1
                aktualni_token_idx = aktualni_token_idx + 1
                
                Lokalni dvojtecka_token : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (dvojtecka_token->type == TOKEN_COLON) { // 57 = TOKEN_COLON
                    aktualni_token_idx = aktualni_token_idx + 1
                    Lokalni typ_token : Token = Volej ZiskejToken(aktualni_token_idx)
                    Pokud (typ_token->type == TOKEN_IDENTIFIER) {
                        Volej strncpy(novy_param->type_name, typ_token->value, 63)
                        aktualni_token_idx = aktualni_token_idx + 1
                    }
                }
            }
            Jinak {
                Volej printf("Chyba (radek %d): V parametrech metody ocekavam jmeno, nasel jsem '%s'.\n", arg_token->line, arg_token->value)
                Volej exit(1)
            }
            Lokalni carka_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (carka_token->type == TOKEN_COMMA) { aktualni_token_idx = aktualni_token_idx + 1 } // 51 = TOKEN_COMMA
            Jinak Pokud (carka_token->type != TOKEN_RPAREN) {
                Volej printf("Chyba (radek %d): V parametrech metody ocekavam ',' nebo ')', nasel jsem '%s'.\n", carka_token->line, carka_token->value)
                Volej exit(1)
            }
            arg_token = Volej ZiskejToken(aktualni_token_idx)
        }
        aktualni_token_idx = aktualni_token_idx + 1
        
        Lokalni navr_dvojtecka : Token = Volej ZiskejToken(aktualni_token_idx)
        Pokud (navr_dvojtecka->type == TOKEN_COLON) {
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni navr_typ_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (navr_typ_token->type == TOKEN_IDENTIFIER) {
                Volej strncpy(uzel->type_name, navr_typ_token->value, 63)
                aktualni_token_idx = aktualni_token_idx + 1
            }
        }
        
        uzel->arg_count = arg_idx
        uzel->right = Volej ParseBlok()
        uzel->int_val = current_local_offset
        uzel->sym_end = pocet_symbolu
        Vrat uzel
    }
    
    Vrat 0
}

// Prida prvek na konec seznamu uzlu (pole roste po mocninach dvou: 8, 16, 32, ...)
Metoda PridejDoSeznamu(uzel : AST_Node, prvek) {
    Lokalni n = uzel->stmt_count
    Pokud (n >= 8 && (n & (n - 1)) == 0) { uzel->stmts = Volej realloc(uzel->stmts, n * 2 * 8) }
    Volej ZapisUkazatel(uzel->stmts + (n * 8), prvek)
    uzel->stmt_count = n + 1
    Vrat 0
}

// Vnoreni cyklu (zasobnik navesti pro Ukonci/Pokracuj ma 200 mist)
Metoda VstupDoCyklu(radek) {
    Pokud (loop_stack_depth >= 199) {
        Volej printf("Chyba (radek %d): Prilis hluboko vnorene cykly (nejvic 200).\n", radek)
        Volej exit(1)
    }
    Vrat 0
}

Metoda Parser() {
    Volej printf("Parser: Sestavuji AST...\n")
    Lokalni koren : AST_Node = Volej VytvorUzel(AST_PROGRAM, 1) // AST_PROGRAM = 0
    koren->stmts = Volej calloc(8, 8)
    koren->stmt_count = 0
    aktualni_token_idx = 0
    
    Lokalni token : Token = Volej ZiskejToken(aktualni_token_idx)
    Dokud (token->type != TOKEN_EOF && aktualni_token_idx < pocet_tokenu) { // TOKEN_EOF = 55
        Pokud (podrobny_vypis == 1) { Volej printf("  top-level radek %d typ %d\n", token->line, token->type) }

        Pokud (token->type == TOKEN_EXTERNI) { // TOKEN_EXTERNI
            Lokalni ext_uzel : AST_Node = Volej VytvorUzel(AST_EXTERN_DECL, token->line)
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni ext_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            Volej strncpy(ext_uzel->name, ext_nazev->value, 255)
            Volej PridejExterniJmeno(ext_nazev->value)
            aktualni_token_idx = aktualni_token_idx + 1
            // Externi sqrt : Float  -> funkce vraci desetinne cislo (v xmm0 / d0)
            Lokalni ext_dv : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (ext_dv->type == TOKEN_COLON) {
                Lokalni ext_typ : Token = Volej ZiskejToken(aktualni_token_idx + 1)
                Pokud (Volej strcmp(ext_typ->value, "Float") == 0) {
                    Pokud (externi_float == 0) { externi_float = Volej calloc(200, 8) }
                    Volej ZapisUkazatel(externi_float + ((pocet_externu - 1) * 8), 1)
                }
                aktualni_token_idx = aktualni_token_idx + 2
            }
            
            Volej PridejDoSeznamu(koren, ext_uzel)
        } Jinak Pokud (token->type == TOKEN_GLOBALNI) { // TOKEN_GLOBALNI
            aktualni_token_idx = aktualni_token_idx + 1
            // Globalni jmeno [: Typ] [= cislo | konstantni vyraz | "text" | desetinne cislo]
            Lokalni glob_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (glob_nazev->type != TOKEN_IDENTIFIER) {
                Volej printf("Chyba (radek %d): Za 'Globalni' ocekavam jmeno promenne.\n", glob_nazev->line)
                Volej exit(1)
            }
            Pokud (Volej NajdiSymbol(glob_nazev->value) != 0) {
                Volej printf("Chyba (radek %d): Jmeno '%s' uz je pouzito.\n", glob_nazev->line, glob_nazev->value)
                Volej exit(1)
            }
            aktualni_token_idx = aktualni_token_idx + 1
            // Globalni pole: Globalni tabulka[100] nebo [10][20] (vynulovane)
            Lokalni g_dim1 = 0
            Lokalni g_dim2 = 1
            Lokalni zav_g : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (zav_g->type == TOKEN_LBRACKET) {
                g_dim1 = Volej VelikostZTokenu(Volej ZiskejToken(aktualni_token_idx + 1))
                aktualni_token_idx = aktualni_token_idx + 3
                Lokalni zav_g2 : Token = Volej ZiskejToken(aktualni_token_idx)
                Pokud (zav_g2->type == TOKEN_LBRACKET) {
                    g_dim2 = Volej VelikostZTokenu(Volej ZiskejToken(aktualni_token_idx + 1))
                    aktualni_token_idx = aktualni_token_idx + 3
                }
                Pokud (g_dim1 < 1 || g_dim2 < 1) {
                    Volej printf("Chyba (radek %d): Velikost pole '%s' musi byt kladne cislo.\n", glob_nazev->line, glob_nazev->value)
                    Volej exit(1)
                }
            }
            Lokalni glob_typ = ""
            Lokalni dvoj_tok : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (dvoj_tok->type == TOKEN_COLON) {
                Lokalni typ_tok : Token = Volej ZiskejToken(aktualni_token_idx + 1)
                glob_typ = typ_tok->value
                aktualni_token_idx = aktualni_token_idx + 2
            }
            Lokalni eq_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Lokalni init_hodnota = 0
            Lokalni init_text = ""
            Pokud (eq_token->type == TOKEN_EQ) {
                aktualni_token_idx = aktualni_token_idx + 1
                Lokalni init_vyraz : AST_Node = Volej ParseVyraz()
                Pokud (init_vyraz->op == TOKEN_STRING) {
                    init_text = Volej TrvalyText1("str%d", init_vyraz->int_val)
                    Pokud (Volej strcmp(glob_typ, "") == 0) { glob_typ = "String" }
                } Jinak Pokud (init_vyraz->op == TOKEN_FLOAT) {
                    init_text = Volej TrvalyText1("%s", init_vyraz->name)
                    Pokud (Volej strcmp(glob_typ, "") == 0) { glob_typ = "Float" }
                } Jinak {
                    init_hodnota = Volej VyhodnotKonstantu(init_vyraz)
                }
            }
            Volej PridejGlobalniSymbol(glob_nazev->value, init_hodnota)
            Lokalni gsym : Symbol = Volej NajdiSymbol(glob_nazev->value)
            Volej strncpy(gsym->type_name, glob_typ, 63)
            Volej strncpy(gsym->init_str, init_text, 63)
            gsym->dim1 = g_dim1
            gsym->dim2 = g_dim2
        } Jinak Pokud (token->type == TOKEN_KONSTANTA) { // Konstanta JMENO = konstantni vyraz
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni konst_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (konst_nazev->type != TOKEN_IDENTIFIER) {
                Volej printf("Chyba (radek %d): Za 'Konstanta' ocekavam jmeno.\n", konst_nazev->line)
                Volej exit(1)
            }
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni rovna_se : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (rovna_se->type != TOKEN_EQ) {
                Volej printf("Chyba (radek %d): Za 'Konstanta %s' ocekavam '='.\n", rovna_se->line, konst_nazev->value)
                Volej exit(1)
            }
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni konst_cislo = Volej VyhodnotKonstantu(Volej ParseVyraz())
            Pokud (Volej NajdiSymbol(konst_nazev->value) != 0) {
                Volej printf("Chyba (radek %d): Jmeno '%s' uz je pouzito.\n", konst_nazev->line, konst_nazev->value)
                Volej exit(1)
            }
            Volej PridejKonstantu(konst_nazev->value, konst_cislo)
        } Jinak Pokud (token->type == TOKEN_STRUKTURA) { // TOKEN_STRUKTURA
            aktualni_token_idx = aktualni_token_idx + 1
            Lokalni struktura_nazev : Token = Volej ZiskejToken(aktualni_token_idx)
            aktualni_token_idx = aktualni_token_idx + 2
            Lokalni akt_offset = 0
            
            Lokalni s_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Dokud (s_token->type != TOKEN_RBRACE && s_token->type != TOKEN_EOF) { // RBRACE, EOF
                Lokalni arr_size = 1
                Lokalni clen_je_pole = 0
                Pokud (s_token->type != TOKEN_IDENTIFIER) {
                    Volej printf("Chyba (radek %d): Ve strukture '%s' ocekavam jmeno clenu, nasel jsem '%s'.\n", s_token->line, struktura_nazev->value, s_token->value)
                    Volej exit(1)
                }
                Lokalni dalsi_s : Token = Volej ZiskejToken(aktualni_token_idx + 1)
                Pokud (dalsi_s->type == TOKEN_LBRACKET) { // LBRACKET
                    Lokalni cislo_tok : Token = Volej ZiskejToken(aktualni_token_idx + 2)
                    arr_size = Volej VelikostZTokenu(cislo_tok)
                    Pokud (arr_size < 1) {
                        Volej printf("Chyba (radek %d): Velikost pole '%s' musi byt kladne cislo.\n", s_token->line, s_token->value)
                        Volej exit(1)
                    }
                    clen_je_pole = 1
                    aktualni_token_idx = aktualni_token_idx + 3
                }
                
                Volej PridejClenaStruktury(struktura_nazev->value, s_token->value, akt_offset, clen_je_pole, arr_size * 8)
                akt_offset = akt_offset + (arr_size * 8)
                // Volitelny typ clenu: "dalsi : Uzel" (umozni p->dalsi->hodnota)
                Lokalni dvoj_c : Token = Volej ZiskejToken(aktualni_token_idx + 1)
                Pokud (dvoj_c->type == TOKEN_COLON) {
                    Lokalni typ_c : Token = Volej ZiskejToken(aktualni_token_idx + 2)
                    Pokud (typ_c->type != TOKEN_IDENTIFIER) {
                        Volej printf("Chyba (radek %d): Za ':' u clenu '%s' ocekavam typ.\n", typ_c->line, s_token->value)
                        Volej exit(1)
                    }
                    Volej strncpy(pamet_struktur_clenove + ((pocet_struktur_clenu - 1) * 1032) + 128, typ_c->value, 63)
                    aktualni_token_idx = aktualni_token_idx + 2
                }
                
                aktualni_token_idx = aktualni_token_idx + 1
                s_token = Volej ZiskejToken(aktualni_token_idx)
            }
            Volej ZaregistrujStrukturu(struktura_nazev->value, akt_offset)
            aktualni_token_idx = aktualni_token_idx + 1
        } Jinak Pokud (token->type == TOKEN_SKUPINA) { // TOKEN_SKUPINA
            aktualni_token_idx = aktualni_token_idx + 1
            
            Lokalni skupina_nazev2 : Token = Volej ZiskejToken(aktualni_token_idx)
            Lokalni typ_skupiny = ""
            Pokud (skupina_nazev2->type == TOKEN_IDENTIFIER) { // TOKEN_IDENTIFIER
                typ_skupiny = skupina_nazev2->value
                aktualni_token_idx = aktualni_token_idx + 1
            }
            
            Lokalni lb_token : Token = Volej ZiskejToken(aktualni_token_idx)
            Pokud (lb_token->type == TOKEN_LBRACE) { // TOKEN_LBRACE
                aktualni_token_idx = aktualni_token_idx + 1
            }
            
            Lokalni hodnota_skupiny = 0
            Lokalni v_token : Token = Volej ZiskejToken(aktualni_token_idx)
            
            Dokud (v_token->type != TOKEN_RBRACE && v_token->type != TOKEN_EOF) {
                Pokud (v_token->type == TOKEN_IDENTIFIER) { // TOKEN_IDENTIFIER
                    Lokalni jmeno_konstanty = v_token->value
                    aktualni_token_idx = aktualni_token_idx + 1
                    
                    Lokalni dalsi_tok : Token = Volej ZiskejToken(aktualni_token_idx)
                    Pokud (dalsi_tok->type == TOKEN_EQ) {
                        aktualni_token_idx = aktualni_token_idx + 1
                        hodnota_skupiny = Volej VyhodnotKonstantu(Volej ParseVyraz())
                    }
                    
                    Volej PridejKonstantu(jmeno_konstanty, hodnota_skupiny)
                    Lokalni sym_konst : Symbol = Volej NajdiSymbol(jmeno_konstanty)
                    Pokud (sym_konst != 0 && Volej strcmp(typ_skupiny, "") != 0) {
                        Volej strncpy(sym_konst->type_name, typ_skupiny, 63)
                    }
                    hodnota_skupiny = hodnota_skupiny + 1
                    
                } Jinak {
                    aktualni_token_idx = aktualni_token_idx + 1
                }
                v_token = Volej ZiskejToken(aktualni_token_idx)
            }
            aktualni_token_idx = aktualni_token_idx + 1
        } Jinak {
            // "Pamatuj Metoda ..." = cista metoda, jejiz vysledky si program pamatuje
            Pokud (token->type == TOKEN_IDENTIFIER && Volej strcmp(token->value, "Pamatuj") == 0) {
                pam_dalsi = 1
                aktualni_token_idx = aktualni_token_idx + 1
            }
            Lokalni metoda = Volej ParseMetoda()
            pam_dalsi = 0
            Pokud (metoda != 0) {
                Volej PridejDoSeznamu(koren, metoda)
            } Jinak {
                Volej printf("Chyba (radek %d): Na nejvyssi urovni ocekavam Metoda, Globalni, Konstanta, Struktura, Skupina nebo Externi (nasel jsem '%s').\n", token->line, token->value)
                Volej exit(1)
            }
        }
        token = Volej ZiskejToken(aktualni_token_idx)
    }
    Vrat koren
}


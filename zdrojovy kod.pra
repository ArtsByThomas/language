Konstanta TOKEN_COLON = 57
Konstanta TOKEN_AMPER = 58
Konstanta TOKEN_KONSTANTA = 59
Konstanta TOKEN_STRUKTURA = 60
Konstanta TOKEN_LESSEQ = 61
Konstanta TOKEN_GREATEREQ = 62
Konstanta AST_BREAK = 22
Konstanta AST_CONTINUE = 23
Konstanta AST_PTR_MEMBER_ASSIGN = 17
Konstanta AST_PTR_MEMBER_READ = 16
Konstanta TOKEN_NEQ = 64
Konstanta TOKEN_LESS = 45
Konstanta TOKEN_GREATER = 46
Konstanta TOKEN_AND = 47
Konstanta TOKEN_OR = 48
Konstanta TOKEN_VELIKOST = 52
Konstanta TOKEN_CTI_ADRESU = 53
Konstanta TOKEN_UKONCI = 54
Konstanta TOKEN_POKRACUJ = 56
Konstanta TOKEN_METODA = 65
Konstanta TOKEN_VRAT = 66
Konstanta TOKEN_PLUSEQ = 69
Konstanta TOKEN_MINUSEQ = 70
Konstanta TOKEN_ROZCESTNIK = 71
Konstanta TOKEN_CESTA = 72
Konstanta TOKEN_HLAVNI_CESTA = 73

Konstanta AST_METHOD = 10
Konstanta AST_RETURN = 11
Konstanta TOKEN_LOKALNI = 15
Konstanta TOKEN_POKUD = 21
Konstanta TOKEN_JINAK = 22
Konstanta TOKEN_DOKUD = 7
Konstanta TOKEN_OPAKUJ = 8
Konstanta TOKEN_LBRACE = 36
Konstanta TOKEN_RBRACE = 37
Konstanta TOKEN_LPAREN = 40
Konstanta TOKEN_RPAREN = 41
Konstanta TOKEN_EQ = 42
Konstanta TOKEN_EQEQ = 43
Konstanta TOKEN_MUL = 49
Konstanta TOKEN_DIV = 50
